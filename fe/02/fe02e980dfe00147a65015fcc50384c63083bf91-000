            cmd = t; i += 1\n        rel = cmd.islower()\n        c = cmd.upper()\n        if c == 'M':\n            x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel and start else (x, y)\n            if start is None:\n                start = cur\n            cmd = 'l' if rel else 'L'\n        elif c == 'L':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'H':\n            x = num(); cur = (cur[0] + x, cur[1]) if rel else (x, cur[1])\n        elif c == 'V':\n            y = num(); cur = (cur[0], cur[1] + y) if rel else (cur[0], y)\n        elif c == 'C':\n            num(); num(); num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'S':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Q':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'T':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Z':\n            pass\n        else:\n            i += 1\n    return start, cur\n\n\ndef arrow(start, end):\n    dx = end[0] - start[0]; dy = end[1] - start[1]\n    ang = math.degrees(math.atan2(dy, dx))  # y vers le bas\n    dirs = [(0, '→'), (45, '↘'), (90, '↓'), (135, '↙'),\n            (180, '←'), (-135, '↖'), (-90, '↑'), (-45, '↗')]\n    best = min(dirs, key=lambda d: abs((ang - d[0] + 180) % 360 - 180))\n    return best[1]\n\n\ndef build_svg(ch, paths, nums):\n    n = len(paths)\n    cols = 6\n    rows = math.ceil(n / cols)\n    W = 8 + cols * 117\n    H = 26 + rows * 117\n    out = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\" width=\"{W}\" height=\"{H}\">']\n    out.append('<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>')\n    out.append(f'<text x=\"8\" y=\"13\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#444\" font-weight=\"bold\">{ch}  ({n} strokes)</text>')\n    for i in range(n):\n        col = i % cols; row = i // cols\n        tx = 8 + col * 117; ty = 26 + row * 117\n        out.append(f'<g transform=\"translate({tx},{ty})\"><rect x=\"0\" y=\"0\" width=\"109\" height=\"109\" fill=\"none\" stroke=\"#eeeeee\" stroke-width=\"1\"/>')\n        for j in range(i + 1, n):  # futurs (gris clair)\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#d6d6d6\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        for j in range(0, i):  # passés (gris foncé)\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#1a1a1a\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        out.append(f'<path d=\"{paths[i]}\" stroke=\"#000000\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')  # courant\n        s, e = path_endpoints(paths[i])\n        ar = arrow(s, e)\n        lx, ly = nums[i] if i < len(nums) else (max(6, s[0] - 4), max(8, s[1] - 4))\n        out.append(f'<text x=\"{lx:.2f}\" y=\"{ly:.2f}\" font-family=\"sans-serif\" font-size=\"9\" font-weight=\"bold\" fill=\"#cc0033\">{i + 1}{ar}</text></g>')\n    out.append('</svg>')\n    return \"\\n\".join(out)\n\n\nCSS = ('body{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:980px;margin:2rem auto;padding:0 1.5rem;color:#1a1a1a;line-height:1.55}'\n       'header{border-bottom:2px solid #1a1a1a;padding-bottom:.8rem;margin-bottom:1.4rem}h1{margin:0;font-size:2.2rem;font-weight:600}'\n       '.meta{color:#555;font-size:.95rem;margin-top:.4rem}.meta span{margin-right:1.2rem}'\n       '.strokes{background:#fafafa;border:1px solid #e8e8e8;padding:1rem;border-radius:8px;text-align:center;margin-bottom:1.4rem}.strokes svg{max-width:100%;height:auto}'\n       'h2{font-size:1.15rem;font-weight:600;margin-top:1.6rem;margin-bottom:.5rem;color:#2a2a2a}'\