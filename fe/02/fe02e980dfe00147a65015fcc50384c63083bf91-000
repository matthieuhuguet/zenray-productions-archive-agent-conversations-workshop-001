iVG/kanjivg/master/kanji/{cp}.svg\"\n\n\ndef codepoint(char):\n    \"\"\"'止' -> '06b62' (format de nom de fichier KanjiVG).\"\"\"\n    return format(ord(char), \"05x\")\n\n\ndef parse_paths(svg):\n    \"\"\"Liste des attributs d des <path>, dans l'ordre des traits.\"\"\"\n    return re.findall(r'<path[^>]*\\bd=\"([^\"]+)\"', svg)\n\n\ndef parse_numbers(svg):\n    \"\"\"Positions (x,y) des numéros de traits KanjiVG, dans l'ordre.\"\"\"\n    out = []\n    for m in re.finditer(r'<text[^>]*transform=\"matrix\\(1 0 0 1 ([\\d.]+) ([\\d.]+)\\)\"', svg):\n        out.append((float(m.group(1)), float(m.group(2))))\n    return out\n\n\ndef path_endpoints(d):\n    \"\"\"Interprète un path SVG (M absolu + commandes rel/abs) -> (start, end) absolus.\"\"\"\n    tokens = re.findall(r'[MmLlCcSsQqTtHhVvZz]|[-+]?\\d*\\.?\\d+(?:e[-+]?\\d+)?', d)\n    i = 0\n    cur = (0.0, 0.0)\n    start = None\n    cmd = None\n\n    def num():\n        nonlocal i\n        v = float(tokens[i]); i += 1; return v\n\n    while i < len(tokens):\n        t = tokens[i]\n        if re.match(r'[A-Za-z]', t):\n            cmd = t; i += 1\n        rel = cmd.islower()\n        c = cmd.upper()\n        if c == 'M':\n            x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel and start else (x, y)\n            if start is None:\n                start = cur\n            cmd = 'l' if rel else 'L'\n        elif c == 'L':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'H':\n            x = num(); cur = (cur[0] + x, cur[1]) if rel else (x, cur[1])\n        elif c == 'V':\n            y = num(); cur = (cur[0], cur[1] + y) if rel else (cur[0], y)\n        elif c == 'C':\n            num(); num(); num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'S':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Q':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'T':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Z':\n            pass\n        else:\n            i += 1\n    return start, cur\n\n\ndef arrow(start, end):\n    dx = end[0] - start[0]; dy = end[1] - start[1]\n    ang = math.degrees(math.atan2(dy, dx))  # y vers le bas\n    dirs = [(0, '→'), (45, '↘'), (90, '↓'), (135, '↙'),\n            (180, '←'), (-135, '↖'), (-90, '↑'), (-45, '↗')]\n    best = min(dirs, key=lambda d: abs((ang - d[0] + 180) % 360 - 180))\n    return best[1]\n\n\ndef build_svg(ch, paths, nums):\n    n = len(paths)\n    cols = 6\n    rows = math.ceil(n / cols)\n    W = 8 + cols * 117\n    H = 26 + rows * 117\n    out = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\" width=\"{W}\" height=\"{H}\">']\n    out.append('<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>')\n    out.append(f'<text x=\"8\" y=\"13\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#444\" font-weight=\"bold\">{ch}  ({n} strokes)</text>')\n    for i in range(n):\n        col = i % cols; row = i // cols\n        tx = 8 + col * 117; ty = 26 + row * 117\n        out.append(f'<g transform=\"translate({tx},{ty})\"><rect x=\"0\" y=\"0\" width=\"109\" height=\"109\" fill=\"none\" stroke=\"#eeeeee\" stroke-width=\"1\"/>')\n        for j in range(i + 1, n):  # futurs (gris clair)\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#d6d6d6\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        for j in range(0, i):  # passés (gris foncé)\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#1a1a1a\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        out.append(f'<path d=\"{paths[i]}\" stroke=\"#000000\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')  # courant\n        s, e = path_endpoints(paths[i])\n        ar = arrow(s, e)\n        lx, ly = nums[i] if i < len(nums) else (max(6, s[0] - 4), max(8, s[1] - 4))\n        out.append(f'<text x=\"{lx:.2f}\" y=\"{ly:.2f}\" font-family=\"sans-serif\" font-size=\"9\" font-weight=\"bold\" fill=\"#cc0033\">{i + 1}{ar}</text></g>')\n    out.append('</svg>')\n    return \"\\n\".join(out)\n\n\nCSS = ('body{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:980px;margin:2rem auto;padding:0 1.5rem;color:#1a1a1a;line-height:1.55}'\n       'header{border-bottom:2px solid #1a1a1a;padding-bottom:.8rem;margin-bottom:1.4rem}h1{margin:0;font-size:2.2rem;font-weight:600}'\n       '.meta{color:#555;font-size:.95rem;margin-top:.4rem}.meta span{margin-right:1.2rem}'\n       '.strokes{background:#fafafa;border:1px solid #e8e8e8;padding:1rem;border-radius:8px;text-align:center;margin-bottom:1.4rem}.strokes svg{max-width:100%;height:auto}'\n       'h2{font-size:1.15rem;font-weight:600;margin-top:1.6rem;margin-bottom:.5rem;color:#2a2a2a}'\n       '.mnemo{background:#fff8e6;padding:.9rem 1.1rem;border-left:3px solid #d4a017;border-radius:4px}'\n       'table{width:100%;border-collapse:collapse;margin-top:.4rem}td{padding:.4rem .6rem;border-bottom:1px solid #eee}td:first-child{font-weight:500;width:35%}'\n       '.phrase{background:#f0f4ff;padding:.9rem 1.1rem;border-left:3px solid #4a6fa5;border-radius:4px;font-size:1.05rem}')\n\n\ndef build_html(k, svg, n):\n    rows = \"\".join(f\"<tr><td>{a}</td><td>{b}</td></tr>\" for a, b in k[\"examples\"])\n    return (f'<!DOCTYPE html>\\n<html lang=\"fr\"><head><meta charset=\"UTF-8\">'\n            f'<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">'\n            f'<title>{k[\"num\"]} — {k[\"char\"]} ({k[\"meaning\"]})</title>\\n'\n            f'<style>{CSS}</style></head>\\n'\n            f'<body><header><h1>{k[\"num\"]} — {k[\"char\"]} · {k[\"meaning\"]}</h1>'\n            f'<div class=\"meta\"><span><strong>ON :</strong> {k[\"on\"]}</span><span><strong>KUN :</strong> {k[\"kun\"]}</span>'\n            f'<span><strong>{n} traits</strong></span><span><strong>Radical :</strong> {k[\"radical\"]}</span></div></header>\\n'\n            f'<div class=\"strokes\">{svg}</div>\\n'\n            f'<h2>Mnémo (histoire de composants)</h2><div class=\"mnemo\">{k[\"mnemo\"]}</div>\\n'\n            f'<h2>Exemples</h2><table>{rows}</table>\\n'\n            f'<h2>Phrase</h2><div class=\"phrase\">{k[\"phrase_jp\"]} — <em>{k[\"phrase_fr\"]}</em></div></body></html>\\n')\n\n\ndef generate_one(k):\n    svg_src = urllib.request.urlopen(KANJIVG_URL.format(cp=codepoint(k[\"char\"])), timeout=20).read().decode(\"utf-8\")\n    paths = parse_paths(svg_src)\n    nums = parse_numbers(svg_src)\n    n = len(paths)\n    html = build_html(k, build_svg(k[\"char\"], paths, nums), n)\n    out_dir = k.get(\"out_dir\") or os.path.join(_KANJIPROGRESS, \"101-200 N4\")\n    if not os.path.isabs(out_dir):\n        out_dir = os.path.join(_KANJIPROGRESS, out_dir)\n    os.makedirs(out_dir, exist_ok=True)\n    fname = (k.get(\"file\") or f'{k[\"num\"]} {k[\"char\"]}') + \".html\"\n    path = os.path.join(out_dir, fname)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(html)\n    return n, path\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.exit(\"usage: python3 generate_kanji_card.py spec.json\")\n    with open(sys.argv[1], encoding=\"utf-8\") as f:\n        spec = json.load(f)\n    items = spec if isinstance(spec, list) else [spec]\n    for k in items:\n        n, path = generate_one(k)\n        print(f'{k[\"char\"]} -> {n} traits -> {os.path.basename(path)}')\n    print(f\"OK ({len(items)} fiche·s)\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":9,"oldLines":9,"newStart":9,"newLines":11,"lines":[" \"\"\""," import re, math, os, sys, json, urllib.request"," ","-# Dossier KanjiProgress par défaut, relatif à ce scr