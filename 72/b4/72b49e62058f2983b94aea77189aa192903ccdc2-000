i\nconst TRAINEE = /stage|intern|apprentice|alternance/i\nconst FREELANCE = /freelance|\\bb2b\\b|independent contractor/i\nconst NOT_FREELANCE = /freelance\\s+(?:non|not)|non\\s+freelance|not\\s+(?:a\\s+)?freelance/i\n\nexport const offerId = (sourceId) => 'job_' + createHash('sha256').update(String(sourceId)).digest('hex').slice(0, 20)\n\nexport function classify({ title = '', contract = '' }) {\n  const text = `${contract} ${title}`\n  const spontaneous = SPONTANEOUS.test(title)\n  const freelance = FREELANCE.test(text) && !NOT_FREELANCE.test(text)\n  const trainee = TRAINEE.test(text)\n  return { kind: spontaneous ? 'spontaneous' : trainee ? 'internship' : 'offer', freelance, trainee, spontaneous, salaried: !freelance && !trainee && !spontaneous }\n}\n\nexport function skillsOf(text) { return Object.entries(SKILLS).filter(([, pattern]) => pattern.test(text)).map(([name]) => name) }\n\n/** Years explicitly demanded, the smallest plausible figure first (an \"or\" in the text usually lowers the bar). */\nexport function yearsRequired(text) {\n  const found = [...String(text).matchAll(/\\b(\\d{1,2})\\s*\\+?\\s*(?:years|ans)\\b/gi)].map((match) => Number(match[1])).filter((years) => years >= 1 && years <= 15)\n  return found.length ? Math.min(...found) : null\n}\n\nconst FRENCH_WORDS = /\\b(vous|nous|votre|notre|poste|expérience|compétences|rejoindre|studio de|mission|profil|candidature|équipe)\\b/gi\nexport function languageOf({ country = '', text = '' }) {\n  if (/^(FR|BE|CH|LU)$/i.test(country) && (String(text).match(FRENCH_WORDS) || []).length >= 3) return 'fr'\n  return (String(text).match(FRENCH_WORDS) || []).length >= 6 ? 'fr' : 'en'\n}\n\nfunction remoteNote(text, workplace, location) {\n  if (/only able to hire.*canada|reside within canada|legally eligible to work in canada/i.test(text)) return 'Canada : résidence et autorisation de travail requises ; remote limité au Canada'\n  if (/full.time.*(?:in.office|onsite|on.site)|relocat.{0,80}copenhagen|based in ou