\\b/i, HLSL: /\\bhlsl\\b/i, Niagara: /\\bniagara\\b/i, Unity: /\\bunity\\b/i, Substance: /\\bsubstance\\b/i, Blender: /\\bblender\\b/i,\n  Maya: /\\bmaya\\b/i, 'C++': /c\\+\\+/i, 'C#': /c#/i,\n}\n\nconst SPONTANEOUS = /open application|candidature spontan|talent pool|talent pipe|pipeline|vivier|speculative/i\nconst TRAINEE = /stage|intern|apprentice|alternance/i\nconst FREELANCE = /freelance|\\bb2b\\b|independent contractor/i\nconst NOT_FREELANCE = /freelance\\s+(?:non|not)|non\\s+freelance|not\\s+(?:a\\s+)?freelance/i\n\nexport const offerId = (sourceId) => 'job_' + createHash('sha256').update(String(sourceId)).digest('hex').slice(0, 20)\n\nexport function classify({ title = '', contract = '' }) {\n  const text = `${contract} ${title}`\n  const spontaneous = SPONTANEOUS.test(title)\n  const freelance = FREELANCE.test(text) && !NOT_FREELANCE.test(text)\n  const trainee = TRAINEE.test(text)\n  return { kind: spontaneous ? 'spontaneous' : trainee ? 'internship' : 'offer', freelance, trainee, spontaneous, salaried: !freelance && !trainee && !spontaneous }\n}\n\nexport function skillsOf(text) { return Object.entries(SKILLS).filter(([, pattern]) => pattern.test(text)).map(([name]) => name) }\n\n/** Years explicitly demanded, the smallest plausible figure first (an \"or\" in the text usually lowers the bar). */\nexport function yearsRequired(text) {\n  const found = [...String(text).matchAll(/\\b(\\d{1,2})\\s*\\+?\\s*(?:years|ans)\\b/gi)].map((match) => Number(match[1])).filter((years) => years >= 1 && years <= 15)\n  return found.length ? Math.min(...found) : null\n}\n\nconst FRENCH_WORDS = /\\b(vous|nous|votre|notre|poste|expérience|compétences|rejoindre|studio de|mission|profil|candidature|équipe)\\b/gi\nexport function languageOf({ country = '', text = '' }) {\n  if (/^(FR|BE|CH|LU)$/i.test(country) && (String(text).match(FRENCH_WORDS) || []).length >= 3) return 'fr'\n  return (String(text).match(FRENCH_WORDS) || []).length >= 6 ? 'fr' : 'en'\n}\n\nfunction remoteNote(text, workplace, location) {\n  if (/only able to hire.*canada|reside within canada|legally eligible to work in canada/i.test(text)) return 'Canada : résidence et autorisation de travail requises ; remote limité au Canada'\n  if (/full.time.*(?:in.office|onsite|on.site)|relocat.{0,80}copenhagen|based in our.{0,30}copenhagen/i.test(text)) return 'Présence locale ou relocalisation à confirmer ; ne pas supposer le télétravail international'\n  if (/eligible to work.{0,20}uk|right to work.{0,20}uk/i.test(text)) return 'Éligibilité à travailler au Royaume-Uni demandée'\n  if (/remote/i.test(workplace) || /télétravail/i.test(location)) return 'Télétravail annoncé ; pays autorisés et fuseaux à confirmer'\n  return 'Non précisé ; demander avant de candidater'\n}\n\n/** 0 to 100 from the published text only; every point is explained so the number can be argued with. */\nexport function scoreOffer({ title, text, contract, country, workplace }, config, flags = classify({ title, contract })) {\n  const rel = config.relevance\n  const why = []\n  let score = 0\n  const tier = rel.roleTiers.find((entry) => new RegExp(entry.pattern, 'i').test(title))\n  if (tier) { score += tier.weight; why.push(`Poste proche du métier (+${tier.weight})`) }\n  const skills = skillsOf(`${title} ${text}`)\n  let skillPoints = 0\n  for (const name of skills) skillPoints += rel.skillWeights[name] || 0\n  skillPoints = Math.min(skillPoints, 38)\n  if (skillPoints) { score += skillPoints; why.push(`Compétences citées : ${skills.join(', ')} (+${skillPoints})`) }\n  const kind = flags.freelance ? 'freelance' : flags.trainee ? 'trainee' : flags.salaried ? 'salaried' : null\n  if (kind && rel.contractBonus[kind]) { score += rel.contractBonus[kind]; why.push(`Contrat : ${kind} (+${rel.contractBonus[kind]})`) }\n  const years = yearsRequired(text)\n  if (years && years > config.profile.yearsOfProfessionalExperience + 1) {\n    const penalty = Math.min(rel.seniorityPenaltyCap, Math.round((years - config.profile.yearsOfProfessionalExperience - 1) * rel.seniorityPenaltyPerYearAbove))\n    score -= penalty; why.push(`${years} ans d’expérience demandés (-${penalty})`)\n  }\n  if (country && config.profile.countriesOpen.includes(String(country).toUpperCase())) { score += rel.countryBonus; why.push(`Pays ouvert (+${rel.countryBonus})`) }\n  if (/remote|télétravail/i.test(`${workplace} ${text.slice(0, 600)}`) && config.profile.remoteOk) { score += rel.remoteBonus; why.push(`Télétravail (+${rel.remoteBonus})`) }\n  score = Math.max(0, Math.min(100, score))\n  return { score, tier: score >= rel.highScore ? 'high' : score >= rel.mediumScore ? 'medium' : 'low', why, skills, years }\n}\n\n/**\n * Listing (what a source published) -> studio record with notes + engine block.\n * `now` is injected so the record is reproducible in tests.\n */\nexport function buildOffer(listing, config, { now = new Date() } = {}) {\n  const { name, url, applyUrl = '', sourceId = url, sourceKey, sourceLabel, location = '', country = '', contract = '', workplace = '', published = '', extra = '', evidence = '' } = listing\n  const title = noLongDash(String(listing.title || '').trim())\n  const text = clean(listing.text)\n  const today = englishDay(now)\n  const flags = classify({ title, contract })\n  const verdict = scoreOffer({ title, text, contract, country, workplace }, config, flags)\n  const emails = recruiterEmails(text)\n  const priority = flags.freelance ? 'P1 : mission freelance explicite' : flags.trainee ? 'P4 : stage, signal studio' : verdict.skills.some((s) => s === 'Houdini' || s === 'Unreal Engine') ? 'P2 : besoin Houdini ou Unreal confirmé' : 'P3 : métier proche, besoin à qualifier'\n  const constraints = text.split(/(?<=[.!?])\\s+/).filter((sentence) => /right to work|work permit|visa sponsorship|legally eligible|reside|days per week|remote.*(?:only|within)|hybrid.*(?:only|studio)|\\brelocat/i.test(sentence))\n  const lines = [\n    `Recensement vérifié le ${today}. Source : ${evidence || sourceLabel}.`,\n    `Priorité commerciale estimée : ${priority}. (${today})`,\n    `Offre : ${title}. Contrat publié : ${contract || 'Non précisé'}. (${today})`,\n    `Lieu : ${location || 'Non précisé'}. Pays : ${country || 'Non précisé'}. Organisation : ${workplace || 'Non précisée'}. (${today})`,\n    `Publication : ${dateLabel(published)}. Annonce présente dans la liste active de la source à la vérification. (${today})`,\n    `Compétences citées dans la fiche : ${verdict.skills.join(', ') || 'À confirmer'}. (${today})`,\n    `Expérience explicitement citée : ${verdict.years ? `${verdict.years} ans` : 'Non extraite ; consulter la fiche'}. (${today})`,\n    `Conditions : ${remoteNote(text, workplace, location)}. (${today})`,\n    `Salaire et TJM : ${/Rémunération publiée/.test(extra) ? 'rémunération publiée ci-dessous' : 'non relevés'} ; ne pas déduire un TJM freelance d’un salaire salarié. (${today})`,\n    `Contact public : ${emails.join(', ') || 'Aucun mail de recrutement publié relevé ; utiliser le formulaire'}. (${today})`,\n    `Source exacte : ${url} (${today})`,\n    `Candidature : ${applyUrl || url} (${today})`,\n    `Action : ${flags.freelance ? 'proposer la prestation demandée' : 'demander si un renfort freelance est envisageable ; le contrat publié ne garantit pas son acceptation'}. (${today})`,\n    `Suivi : aucun envoi effectué ; brouillon uniquement. (${today})`,\n  ]\n  if (extra) lines.push(`${extra} (${today})`)\n  if (constraints.length) lines.push(`Extraits des conditions publiées : ${constraints.slice(0, 4).map((s) => s.slice(0, 450)).join(' / ')}. (${today})`)\n  const day = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`\n  return {\n    id: offerId(sourceId), name, role: title, link: url, city: location, status: 'to_contact', createdAt: day, contactedAt: '', messages: [], history: [],\n    notes: noLongDash(lines.join('\\n\\n')),\n    engine: {\n      source: sourceKey, sourceLabel, externalId: String(sourceId), kind: flags.kind, freelance: flags.freelance, trainee: flags.trainee,\n      contract: contract || '', country: country || '', workplace: workplace || '', publishedAt: published ? String(published) : '',\n      skills: verdict.skills, yearsRequired: verdict.years, score: verdict.score, tier: verdict.tier, scoreWhy: verdict.why,\n      applyUrl: applyUrl || url, employerUrl: listing.employerUrl || '', contactEmails: emails, language: languageOf({ country, text }),\n      firstSeenAt: day, lastSeenAt: day, missedRuns: 0, closedAt: '',\n    },\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"3578e55d-7a1a-43cf-af36-5d05a8007bff","context":{"git_state":{"cwd":"/Users/zenray/.claude/Memory1","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/Users/zenray/.claude/Memory1","platform":"macos"}},"sourceToolAssistantUUID":"abad8078-7071-4137-b3c4-ca090a592ebb","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/.claude/Memory1","sessionId":"5fd92a10-03f3-4126-89e0-4dfe033274bd","version":"2.1.286","gitBranch":"main"}
