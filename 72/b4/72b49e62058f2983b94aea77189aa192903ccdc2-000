{"parentUuid":"7a992f83-dbe2-4bf2-abd1-53905f782cc1","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CfgsqXjsUotA5jk5bULcn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Pw7LR55oprRNgNJfGegHov","name":"Write","input":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/src/components/FreelanceView.jsx","content":"// ZENRAY FREELANCE v3 (4 October 2026).\n//\n// The engine on the Mac searches the boards every six hours and writes what it finds next to the studios (`studio.engine`, one letter\n// archive per vacancy, `freelance/engine.json`). This page shows it: one button to search now, the vacancies sorted by how well they fit\n// the published CV, a letter already written for each, the studio's own application page, and the trail of everything sent.\n// Storage is the drive file `freelance/applications.json`, written through the read-modify-write helper so two tabs never lose a message.\n//\n// FR : le moteur du Mac cherche toutes les six heures et ecrit ce qu'il trouve a cote des studios. Cette page le montre : un bouton pour\n// chercher maintenant, les annonces triees par adequation au CV publie, une lettre deja ecrite pour chacune, la page de candidature\n// du studio, et la trace de tout ce qui a ete envoye.\nimport React, { useCallback, useEffect, useMemo, useState } from 'react'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { urlLectureAffichage } from '../lib/urlLecture.js'\nimport { createFreelanceBridge } from '../lib/freelanceBridge.js'\nimport { UI } from '../config/colors.js'\nimport { notify } from './Notifications.jsx'\nimport FreelanceOfferDetails from './FreelanceOfferDetails.jsx'\nimport FreelanceEngineBar from './freelance/FreelanceEngineBar.jsx'\nimport FreelanceLetter from './freelance/FreelanceLetter.jsx'\nimport FreelanceSources from './freelance/FreelanceSources.jsx'\nimport FreelanceTemplate from './freelance/FreelanceTemplate.jsx'\nimport { Button, Field, GlassPill, P, Panel, SectionTitle, glassStyle, textareaStyle } from './freelance/ui.jsx'\nimport {\n  STATUSES, normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage, applyStudioChange,\n  groupByStatus, counts, timeline, searchStudios, readableDate, isoDay,\n} from '../lib/freelanceStudios.js'\nimport {\n  DEFAULT_FILTERS, KINDS, TIERS, isClosedStudio, isNewStudio, kindLabel, matchesFilters, scoreOf, sortStudios, sourceLabelOf, sourceOptions, sourceProblems, tierOf,\n} from '../lib/freelanceEngineModel.js'\n\nconst PATHS = { store: 'freelance/applications.json', engine: 'freelance/engine.json', template: 'freelance/letter-template.json' }\nconst FILTERS_KEY = 'zr:freelance:filters'\nconst TIER_COLOR = { high: UI.green, medium: UI.orange, low: UI.gray }\n\nconst readStoredFilters = () => { try { return { ...DEFAULT_FILTERS, ...JSON.parse(localStorage.getItem(FILTERS_KEY) || '{}') } } catch { return DEFAULT_FILTERS } }\nconst storeFilters = (filters) => { try { localStorage.setItem(FILTERS_KEY, JSON.stringify(filters)) } catch {} }\n\n/** A small state read, outside the GitHub quota; a missing or unreadable file is just \"not published yet\". */\nasync function readDisplay(path) {\n  try {\n    const response = await fetch(urlLectureAffichage(path, { fresh: true }), { cache: 'no-cache' })\n    if (!response.ok) return null\n    const result = await response.json()\n    return result.missing || typeof result.markdown !== 'string' ? null : JSON.parse(result.markdown)\n  } catch { return null }\n}\n\nfunction Badge({ t, color, children, title }) {\n  return <span title={title} style={{ ...glassStyle(t, color), padding: '2px 9px', fontSize: 11.5 }}>{children}</span>\n}\n\n/** One studio card: name, role, how well it fits, what it is, and the beginning of the last message sent. */\nfunction StudioCard({ t, studio, onOpen, today }) {\n  const msg = lastMessage(studio)\n  const engine = studio.engine\n  const closed = isClosedStudio(studio, today)\n  const score = scoreOf(studio)\n  return (\n    <button type=\"button\" onClick={onOpen} title={studio.name}\n      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0, opacity: closed ? 0.6 : 1 }}>\n      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n        {score !== null && (\n          <span title={`Adéquation avec ton CV : ${score} sur 100`} style={{ marginLeft: 'auto', display: 'inline-flex', alignItems: 'center', gap: 6, fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textPrimary }}>\n            <span aria-hidden=\"true\" style={{ width: 9, height: 9, borderRadius: 999, background: TIER_COLOR[tierOf(studio)] || UI.gray }} />{score}\n          </span>\n        )}\n      </span>\n      <span style={{ fontFamily: P.sans, fontSize: 13, color: t.textPrimary, overflow: 'hidden', textOverflow: 'ellipsis', display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical' }}>{studio.role || 'poste à préciser'}</span>\n      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n        {[studio.city, kindLabel(studio), sourceLabelOf(studio)].filter(Boolean).join(' · ')}\n      </span>\n      <span style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>\n        {isNewStudio(studio, today) && <Badge t={t} color={UI.blue}>Nouveau</Badge>}\n        {closed && <Badge t={t} color={UI.gray} title=\"L’annonce n’est plus dans la liste du site source\">Fermée</Badge>}\n        {engine && engine.letterPath && studio.status === 'to_contact' && <Badge t={t} color={UI.green} title=\"Une lettre est déjà écrite\">Lettre prête</Badge>}\n        {engine && engine.freelance && <Badge t={t} color={UI.purple}>Freelance</Badge>}\n      </span>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary }}>\n        {studio.contactedAt ? `contacté le ${readableDate(studio.contactedAt)}` : 'jamais contacté'}\n        {studio.messages.length ? ` · ${studio.messages.length} message${studio.messages.length > 1 ? 's' : ''}` : ''}\n      </span>\n      {msg && (\n        <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary, display: '-webkit-box', WebkitLineClamp: P.messageLines, WebkitBoxOrient: 'vertical', overflow: 'hidden', lineHeight: 1.45 }}>{msg.text}</span>\n      )}\n    </button>\n  )\n}\n\n/** One studio, opened in place: its application, its messages, its dated history, its notes. */\nfunction StudioDetail({ t, studio, onBack, onChange, onDelete, engineFile, template, bridge, onTemplateSaved, today }) {\n  const [draft, setDraft] = useState('')\n  const [channel, setChannel] = useState('mail')\n  const [notes, setNotes] = useState(studio.notes)\n  useEffect(() => { setNotes(studio.notes) }, [studio.id])\n\n  const send = async () => {\n    if (!draft.trim()) return\n    if (!await onChange(addMessage(studio, { text: draft, channel }))) return\n    setDraft('')\n    notify({ title: 'Message enregistré', body: 'Le texte exact est gardé avec sa date.' })\n  }\n  const logSent = async ({ text, channel: used }) => {\n    if (!await onChange(addMessage(studio, { text, channel: used }))) return\n    notify({ title: 'Candidature enregistrée', body: 'La lettre exacte est gardée avec sa date dans les messages envoyés.' })\n  }\n  const copy = (text) => { try { navigator.clipboard.writeText(text) } catch {} notify({ title: 'Message copié', body: 'Collé tel quel, prêt à envoyer.' }) }\n\n  const engine = studio.engine\n  const closed = isClosedStudio(studio, today)\n  const events = timeline([studio], 40)\n  return (\n    <>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 18, flexWrap: 'wrap' }}>\n        <button type=\"button\" onClick={onBack} style={{ background: 'none', border: 'none', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les studios</button>\n        <span style={{ flex: 1 }} />\n        {studio.link && <a href={studio.link} target=\"_blank\" rel=\"noreferrer\" style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>site ou offre ↗</a>}\n        <button type=\"button\" onClick={onDelete} style={{ background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>supprimer</button>\n      </div>\n\n      <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: '0 0 6px' }}>{studio.name}</h2>\n      <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, marginBottom: 8 }}>\n        {[studio.role, studio.city, kindLabel(studio), sourceLabelOf(studio)].filter(Boolean).join(' · ')}\n        {studio.contactedAt ? ` · premier contact le ${readableDate(studio.contactedAt)}` : ''}\n      </div>\n      {closed && <p role=\"status\" style={{ fontFamily: P.sans, fontSize: 13, color: '#d68c00', margin: '0 0 8px' }}>Cette annonce n’apparaît plus sur le site source{engine && engine.closedAt ? ` depuis le ${readableDate(engine.closedAt)}` : ''} : vérifie avant d’écrire.</p>}\n      {engine && engine.score !== undefined && engine.scoreWhy && engine.scoreWhy.length > 0 && (\n        <details style={{ margin: '0 0 14px' }}>\n          <summary style={{ cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>Adéquation avec ton CV : <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight }}>{engine.score}</span> sur 100, pourquoi ?</summary>\n          <ul style={{ margin: '8px 0 0', paddingLeft: 18, fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.6 }}>{engine.scoreWhy.map((line) => <li key={line}>{line}</li>)}</ul>\n        </details>\n      )}\n\n      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 22 }}>\n        {STATUSES.map((s) => <GlassPill key={s.key} t={t} statusKey={s.key} active={studio.status === s.key} onClick={() => onChange(setStatus(studio, s.key))} />)}\n      </div>\n\n      <FreelanceLetter t={t} studio={studio} engine={engineFile} template={template} bridge={bridge} onSent={logSent} onTemplateSaved={onTemplateSaved} templatePath={PATHS.template} />\n\n      <FreelanceOfferDetails key={studio.id} path={studio.offerDetailsPath} t={t} />\n\n      <SectionTitle t={t} title=\"Messages envoyés\" count={studio.messages.length} />\n      <div style={{ display: 'grid', gap: 10, marginBottom: 18 }}>\n        {studio.messages.slice().reverse().map((m, i) => (\n          <div key={`${m.at}-${i}`} style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding }}>\n            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 6 }}>\n              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{readableDate(m.at)}</span>\n              <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{m.channel}</span>\n              <button type=\"button\" onClick={() => copy(m.text)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12 }}>copier</button>\n            </div>\n            <div style={{ fontFamily: P.sans, fontSize: 13, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{m.text}</div>\n          </div>\n        ))}\n        {!studio.messages.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Aucun message pour l'instant. « Marquer comme envoyée » ci-dessus garde la lettre exacte ; tu peux aussi coller ici un autre message envoyé.</div>}\n      </div>\n\n      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} placeholder=\"Un autre message envoyé, collé tel quel…\" aria-label=\"Message envoyé\"\n        style={{ ...textareaStyle(t), minHeight: 120 }} />\n      <div style={{ display: 'flex', gap: 8, alignItems: 'center', margin: '10px 0 24px', flexWrap: 'wrap' }}>\n        {['mail', 'linkedin', 'instagram', 'discord', 'en personne'].map((c) => <GlassPill key={c} t={t} onClick={() => setChannel(c)} active={channel === c}>{c}</GlassPill>)}\n        <span style={{ flex: 1 }} />\n        <Button t={t} primary onClick={send}>Enregistrer le message</Button>\n      </div>\n\n      <SectionTitle t={t} title=\"Historique\" count={events.length} />\n      <div style={{ display: 'grid', gap: 6, marginBottom: 24 }}>\n        {events.map((e, i) => (\n          <div key={i} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n            <span>{e.label}</span>\n          </div>\n        ))}\n        {!events.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Rien encore.</div>}\n      </div>\n\n      <SectionTitle t={t} title=\"Notes\" count=\"\" />\n      <textarea value={notes} onChange={(e) => setNotes(e.target.value)} onBlur={() => { if (notes !== studio.notes) onChange({ ...studio, notes }) }} aria-label=\"Notes\"\n        placeholder=\"Contact, salaire, retour reçu…\" style={{ ...textareaStyle(t), minHeight: 90 }} />\n    </>\n  )\n}\n\nexport default function FreelanceView({ t }) {\n  const [store, setStore] = useState(null)\n  const [sha, setSha] = useState(null)\n  const [engineFile, setEngineFile] = useState(null)\n  const [template, setTemplate] = useState(null)\n  const [openId, setOpenId] = useState(null)\n  const [query, setQuery] = useState('')\n  const [statusFilter, setStatusFilter] = useState('all')\n  const [filters, setFilters] = useState(readStoredFilters)\n  const [form, setForm] = useState({ name: '', role: '', link: '' })\n  const [saving, setSaving] = useState('')\n  const [panels, setPanels] = useState({ sources: false, template: false })\n  const bridge = useMemo(() => createFreelanceBridge(), [])\n  const today = isoDay()\n\n  const loadStore = useCallback(async () => {\n    try { const r = await readJson(PATHS.store); setSha(r.sha); setStore(normalizeStore(r.data)) } catch { setStore((current) => current || { v: 2, studios: [] }) }\n  }, [])\n  const loadAux = useCallback(async () => { setEngineFile(await readDisplay(PATHS.engine)); setTemplate(await readDisplay(PATHS.template)) }, [])\n  useEffect(() => { loadStore(); loadAux() }, [loadStore, loadAux])\n  const afterRun = useCallback(() => { loadStore(); loadAux() }, [loadStore, loadAux])\n\n  const changeFilters = (patch) => setFilters((current) => { const next = { ...current, ...patch }; storeFilters(next); return next })\n\n  // 30 September 2026, 19:45 Europe/Paris: Retry the intended change against the latest catalogue.\n  async function persist(mutate) {\n    setSaving('…')\n    try {\n      const r = await saveJsonWithRetry(PATHS.store, (current) => mutate(normalizeStore(current)), { sha, data: store })\n      if (!r.ok) throw new Error(String(r.error || 'Enregistrement impossible'))\n      setSha(r.sha); setStore(normalizeStore(r.data)); setSaving('enregistré')\n      return true\n    } catch (error) {\n      setSaving('erreur'); notify({ title: 'Enregistrement impossible', body: error.message })\n      return false\n    }\n  }\n\n  const studios = store ? store.studios : []\n  const open = studios.find((s) => s.id === openId) || null\n  const shown = useMemo(() => {\n    const list = searchStudios(studios, query).filter((s) => matchesFilters(s, filters, today))\n    return statusFilter === 'all' ? list : list.filter((s) => s.status === statusFilter)\n  }, [studios, query, filters, statusFilter, today])\n  const c = counts(studios)\n  const events = useMemo(() => timeline(studios, 24), [studios])\n  const newCount = studios.filter((s) => isNewStudio(s, today)).length\n  const sources = useMemo(() => sourceOptions(studios), [studios])\n  const problems = sourceProblems(engineFile).length\n\n  const addStudio = () => {\n    const s = normalizeStudio({ ...form, createdAt: isoDay(), status: 'to_contact' })\n    if (!s) return\n    setForm({ name: '', role: '', link: '' })\n    persist((current) => ({ ...current, studios: [s, ...current.studios] }))\n  }\n  const updateStudio = (next) => persist((current) => applyStudioChange(current, studios.find((studio) => studio.id === next.id), next))\n  const removeStudio = (id) => { if (!window.confirm('Supprimer ce studio et son historique ?')) return; setOpenId(null); persist((current) => ({ ...current, studios: current.studios.filter((studio) => studio.id !== id) })) }\n  const toggle = (name) => setPanels((current) => ({ ...current, [name]: !current[name] }))\n\n  return (\n    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '6px 2px 60px', color: t.textPrimary }}>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, flexWrap: 'wrap', marginBottom: 6 }}>\n        <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 30, letterSpacing: '-0.02em', margin: 0 }}>ZenRay <span style={{ fontStyle: 'italic' }}>Freelance</span></h1>\n        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>\n          {c.toContact} à contacter{newCount ? ` (${newCount} nouvelle${newCount > 1 ? 's' : ''})` : ''} · {c.contacted} contactés · {c.answered} réponses · {c.messages} messages\n        </span>\n        <span style={{ marginLeft: 'auto', fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{saving}</span>\n      </div>\n\n      <FreelanceEngineBar t={t} engine={engineFile} bridge={bridge} onFinished={afterRun} sourcesOpen={panels.sources} onToggleSources={() => toggle('sources')} problems={problems} />\n      {panels.sources && !open && <div style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: '18px 18px 8px', marginBottom: 22 }}><FreelanceSources t={t} engine={engineFile} /></div>}\n\n      {store === null && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>chargement…</div>}\n\n      {store !== null && open && (\n        <StudioDetail t={t} studio={open} onBack={() => setOpenId(null)} onChange={updateStudio} onDelete={() => removeStudio(open.id)}\n          engineFile={engineFile} template={template} bridge={bridge} onTemplateSaved={setTemplate} today={today} />\n      )}\n\n      {store !== null && !open && (\n        <>\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', margin: '4px 0 14px' }}>\n            <Field t={t} value={form.name} onChange={(v) => setForm({ ...form, name: v })} placeholder=\"Studio\" onKeyDown={(e) => { if (e.key === 'Enter') addStudio() }} />\n            <Field t={t} value={form.role} onChange={(v) => setForm({ ...form, role: v })} placeholder=\"Poste visé\" width={150} />\n            <Field t={t} value={form.link} onChange={(v) => setForm({ ...form, link: v })} placeholder=\"Site ou offre\" width={200} />\n            <Button t={t} primary onClick={addStudio}>+ studio</Button>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 10 }}>\n            <GlassPill t={t} onClick={() => setStatusFilter('all')} active={statusFilter === 'all'}>Tous {studios.length}</GlassPill>\n            {groupByStatus(studios).map((g) => (\n              <GlassPill key={g.key} t={t} statusKey={g.key} active={statusFilter === g.key} onClick={() => setStatusFilter(statusFilter === g.key ? 'all' : g.key)}>{g.label} {g.items.length}</GlassPill>\n            ))}\n            <span style={{ flex: 1, minWidth: 140 }}>\n              <Field t={t} value={query} onChange={setQuery} placeholder=\"Chercher un studio, un message…\" width={200} />\n            </span>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 22 }} aria-label=\"Filtres des annonces\">\n            <GlassPill t={t} onClick={() => changeFilters({ tier: 'all' })} active={filters.tier === 'all'}>Toutes les annonces</GlassPill>\n            <GlassPill t={t} color={UI.green} onClick={() => changeFilters({ tier: filters.tier === 'high' ? 'all' : 'high' })} active={filters.tier === 'high'}>{TIERS[0].label}</GlassPill>\n            <GlassPill t={t} color={UI.orange} onClick={() => changeFilters({ tier: filters.tier === 'medium' ? 'all' : 'medium' })} active={filters.tier === 'medium'}>Pertinent et plus</GlassPill>\n            <span style={{ width: 8 }} />\n            {KINDS.map((kind) => <GlassPill key={kind.key} t={t} onClick={() => changeFilters({ kind: filters.kind === kind.key ? 'all' : kind.key })} active={filters.kind === kind.key}>{kind.label}</GlassPill>)}\n            <span style={{ width: 8 }} />\n            <GlassPill t={t} color={UI.blue} onClick={() => changeFilters({ onlyNew: !filters.onlyNew })} active={filters.onlyNew}>Nouveau</GlassPill>\n            <GlassPill t={t} color={UI.gray} onClick={() => changeFilters({ showClosed: !filters.showClosed })} active={filters.showClosed}>Fermées</GlassPill>\n            {sources.length > 1 && (\n              <select value={filters.source} onChange={(e) => changeFilters({ source: e.target.value })} aria-label=\"Source\"\n                style={{ background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: 999, padding: '4px 10px', fontFamily: P.sans, fontSize: 12.5 }}>\n                <option value=\"all\">Toutes les sources</option>\n                {sources.map((name) => <option key={name} value={name}>{name}</option>)}\n              </select>\n            )}\n            <GlassPill t={t} onClick={() => changeFilters({ sort: filters.sort === 'score' ? 'recent' : 'score' })}>{filters.sort === 'score' ? 'Tri : adéquation' : 'Tri : plus récent'}</GlassPill>\n          </div>\n\n          {groupByStatus(shown).map((g) => (\n            <div key={g.key} style={{ marginBottom: 26 }}>\n              <SectionTitle t={t} title={g.label} count={g.items.length} />\n              <div style={{ display: 'grid', gridTemplateColumns: P.studioGrid, gap: P.gap }}>\n                {(g.key === 'to_contact' ? sortStudios(g.items, filters.sort) : g.items).map((s) => <StudioCard key={s.id} t={t} studio={s} today={today} onOpen={() => setOpenId(s.id)} />)}\n              </div>\n            </div>\n          ))}\n\n          {!shown.length && studios.length > 0 && (\n            <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, lineHeight: 1.6 }}>\n              Aucune fiche avec ces filtres. <button type=\"button\" onClick={() => { setFilters(DEFAULT_FILTERS); storeFilters(DEFAULT_FILTERS); setStatusFilter('all'); setQuery('') }} style={{ background: 'none', border: 'none', color: 'inherit', textDecoration: 'underline', cursor: 'pointer', font: 'inherit' }}>Tout afficher</button>\n            </div>\n          )}\n          {!studios.length && (\n            <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, lineHeight: 1.6 }}>\n              Aucun studio pour l'instant. Lance « Rechercher maintenant » : le moteur remplit la liste, ou ajoute le premier ci-dessus.\n            </div>\n          )}\n\n          <div style={{ marginTop: 34 }}>\n            <Panel t={t} title=\"Modèle de lettre\" open={panels.template} onToggle={() => toggle('template')} aside={template ? (template.status === 'seed' ? 'ta lettre Asobo, à adapter' : 'personnalisé') : 'pas encore publié'}>\n              <FreelanceTemplate t={t} template={template} templatePath={PATHS.template} bridge={bridge} onSaved={setTemplate} />\n            </Panel>\n          </div>\n\n          {events.length > 0 && (\n            <div style={{ marginTop: 20 }}>\n              <SectionTitle t={t} title=\"Progression\" count={events.length} />\n              <div style={{ display: 'grid', gap: 6 }}>\n                {events.map((e, i) => (\n                  <div key={i} onClick={() => setOpenId(e.id)} style={{ display: 'flex', gap: 10, alignItems: 'baseline', cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n                    <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n                    <span style={{ color: t.textPrimary }}>{e.studio}</span>\n                    <span>{e.label}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </>\n      )}\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6399,"cache_read_input_tokens":606543,"output_tokens":11776,"output_tokens_details":{"thinking_tokens":1077},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6399,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":11776,"cache_read_input_tokens":606543,"cache_creation_input_tokens":6399,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6399},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Pw7LR55oprRNgNJfGegHov":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/src/components/FreelanceView.jsx","content":"// ZENRAY FREELANCE v3 (4 October 2026).\n//\n// The engine on the Mac searches the boards every six hours and writes what it finds next to the studios (`studio.engine`, one letter\n// archive per vacancy, `freelance/engine.json`). This page shows it: one button to search now, the vacancies sorted by how well they fit\n// the published CV, a letter already written for each, the studio's own application page, and the trail of everything sent.\n// Storage is the drive file `freelance/applications.json`, written through the read-modify-write helper so two tabs never lose a message.\n//\n// FR : le moteur du Mac cherche toutes les six heures et ecrit ce qu'il trouve a cote des studios. Cette page le montre : un bouton pour\n// chercher maintenant, les annonces triees par adequation au CV publie, une lettre deja ecrite pour chacune, la page de candidature\n// du studio, et la trace de tout ce qui a ete envoye.\nimport React, { useCallback, useEffect, useMemo, useState } from 'react'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { urlLectureAffichage } from '../lib/urlLecture.js'\nimport { createFreelanceBridge } from '../lib/freelanceBridge.js'\nimport { UI } from '../config/colors.js'\nimport { notify } from './Notifications.jsx'\nimport FreelanceOfferDetails from './FreelanceOfferDetails.jsx'\nimport FreelanceEngineBar from './freelance/FreelanceEngineBar.jsx'\nimport FreelanceLetter from './freelance/FreelanceLetter.jsx'\nimport FreelanceSources from './freelance/FreelanceSources.jsx'\nimport FreelanceTemplate from './freelance/FreelanceTemplate.jsx'\nimport { Button, Field, GlassPill, P, Panel, SectionTitle, glassStyle, textareaStyle } from './freelance/ui.jsx'\nimport {\n  STATUSES, normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage, applyStudioChange,\n  groupByStatus, counts, timeline, searchStudios, readableDate, isoDay,\n} from '../lib/freelanceStudios.js'\nimport {\n  DEFAULT_FILTERS, KINDS, TIERS, isClosedStudio, isNewStudio, kindLabel, matchesFilters, scoreOf, sortStudios, sourceLabelOf, sourceOptions, sourceProblems, tierOf,\n} from '../lib/freelanceEngineModel.js'\n\nconst PATHS = { store: 'freelance/applications.json', engine: 'freelance/engine.json', template: 'freelance/letter-template.json' }\nconst FILTERS_KEY = 'zr:freelance:filters'\nconst TIER_COLOR = { high: UI.green, medium: UI.orange, low: UI.gray }\n\nconst readStoredFilters = () => { try { return { ...DEFAULT_FILTERS, ...JSON.parse(localStorage.getItem(FILTERS_KEY) || '{}') } } catch { return DEFAULT_FILTERS } }\nconst storeFilters = (filters) => { try { localStorage.setItem(FILTERS_KEY, JSON.stringify(filters)) } catch {} }\n\n/** A small state read, outside the GitHub quota; a missing or unreadable file is just \"not published yet\". */\nasync function readDisplay(path) {\n  try {\n    const response = await fetch(urlLectureAffichage(path, { fresh: true }), { cache: 'no-cache' })\n    if (!response.ok) return null\n    const result = await response.json()\n    return result.missing || typeof result.markdown !== 'string' ? null : JSON.parse(result.markdown)\n  } catch { return null }\n}\n\nfunction Badge({ t, color, children, title }) {\n  return <span title={title} style={{ ...glassStyle(t, color), padding: '2px 9px', fontSize: 11.5 }}>{children}</span>\n}\n\n/** One studio card: name, role, how well it fits, what it is, and the beginning of the last message sent. */\nfunction StudioCard({ t, studio, onOpen, today }) {\n  const msg = lastMessage(studio)\n  const engine = studio.engine\n  const closed = isClosedStudio(studio, today)\n  const score = scoreOf(studio)\n  return (\n    <button type=\"button\" onClick={onOpen} title={studio.name}\n      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0, opacity: closed ? 0.6 : 1 }}>\n      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n        {score !== null && (\n          <span title={`Adéquation avec ton CV : ${score} sur 100`} style={{ marginLeft: 'auto', display: 'inline-flex', alignItems: 'center', gap: 6, fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textPrimary }}>\n            <span aria-hidden=\"true\" style={{ width: 9, height: 9, borderRadius: 999, background: TIER_COLOR[tierOf(studio)] || UI.gray }} />{score}\n          </span>\n        )}\n      </span>\n      <span style={{ fontFamily: P.sans, fontSize: 13, color: t.textPrimary, overflow: 'hidden', textOverflow: 'ellipsis', display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical' }}>{studio.role || 'poste à préciser'}</span>\n      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n        {[studio.city, kindLabel(studio), sourceLabelOf(studio)].filter(Boolean).join(' · ')}\n      </span>\n      <span style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>\n        {isNewStudio(studio, today) && <Badge t={t} color={UI.blue}>Nouveau</Badge>}\n        {closed && <Badge t={t} color={UI.gray} title=\"L’annonce n’est plus dans la liste du site source\">Fermée</Badge>}\n        {engine && engine.letterPath && studio.status === 'to_contact' && <Badge t={t} color={UI.green} title=\"Une lettre est déjà écrite\">Lettre prête</Badge>}\n        {engine && engine.freelance && <Badge t={t} color={UI.purple}>Freelance</Badge>}\n      </span>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary }}>\n        {studio.contactedAt ? `contacté le ${readableDate(studio.contactedAt)}` : 'jamais contacté'}\n        {studio.messages.length ? ` · ${studio.messages.length} message${studio.messages.length > 1 ? 's' : ''}` : ''}\n      </span>\n      {msg && (\n        <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary, display: '-webkit-box', WebkitLineClamp: P.messageLines, WebkitBoxOrient: 'vertical', overflow: 'hidden', lineHeight: 1.45 }}>{msg.text}</span>\n      )}\n    </button>\n  )\n}\n\n/** One studio, opened in place: its application, its messages, its dated history, its notes. */\nfunction StudioDetail({ t, studio, onBack, onChange, onDelete, engineFile, template, bridge, onTemplateSaved, today }) {\n  const [draft, setDraft] = useState('')\n  const [channel, setChannel] = useState('mail')\n  const [notes, setNotes] = useState(studio.notes)\n  useEffect(() => { setNotes(studio.notes) }, [studio.id])\n\n  const send = async () => {\n    if (!draft.trim()) return\n    if (!await onChange(addMessage(studio, { text: draft, channel }))) return\n    setDraft('')\n    notify({ title: 'Message enregistré', body: 'Le texte exact est gardé avec sa date.' })\n  }\n  const logSent = async ({ text, channel: used }) => {\n    if (!await onChange(addMessage(studio, { text, channel: used }))) return\n    notify({ title: 'Candidature enregistrée', body: 'La lettre exacte est gardée avec sa date dans les messages envoyés.' })\n  }\n  const copy = (text) => { try { navigator.clipboard.writeText(text) } catch {} notify({ title: 'Message copié', body: 'Collé tel quel, prêt à envoyer.' }) }\n\n  const engine = studio.engine\n  const closed = isClosedStudio(studio, today)\n  const events = timeline([studio], 40)\n  return (\n    <>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 18, flexWrap: 'wrap' }}>\n        <button type=\"button\" onClick={onBack} style={{ background: 'none', border: 'none', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les studios</button>\n        <span style={{ flex: 1 }} />\n        {studio.link && <a href={studio.link} target=\"_blank\" rel=\"noreferrer\" style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>site ou offre ↗</a>}\n        <button type=\"button\" onClick={onDelete} style={{ background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>supprimer</button>\n      </div>\n\n      <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: '0 0 6px' }}>{studio.name}</h2>\n      <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, marginBottom: 8 }}>\n        {[studio.role, studio.city, kindLabel(studio), sourceLabelOf(studio)].filter(Boolean).join(' · ')}\n        {studio.contactedAt ? ` · premier contact le ${readableDate(studio.contactedAt)}` : ''}\n      </div>\n      {closed && <p role=\"status\" style={{ fontFamily: P.sans, fontSize: 13, color: '#d68c00', margin: '0 0 8px' }}>Cette annonce n’apparaît plus sur le site source{engine && engine.closedAt ? ` depuis le ${readableDate(engine.closedAt)}` : ''} : vérifie avant d’écrire.</p>}\n      {engine && engine.score !== undefined && engine.scoreWhy && engine.scoreWhy.length > 0 && (\n        <details style={{ margin: '0 0 14px' }}>\n          <summary style={{ cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>Adéquation avec ton CV : <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight }}>{engine.score}</span> sur 100, pourquoi ?</summary>\n          <ul style={{ margin: '8px 0 0', paddingLeft: 18, fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.6 }}>{engine.scoreWhy.map((line) => <li key={line}>{line}</li>)}</ul>\n        </details>\n      )}\n\n      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 22 }}>\n        {STATUSES.map((s) => <GlassPill key={s.key} t={t} statusKey={s.key} active={studio.status === s.key} onClick={() => onChange(setStatus(studio, s.key))} />)}\n      </div>\n\n      <FreelanceLetter t={t} studio={studio} engine={engineFile} template={template} bridge={bridge} onSent={logSent} onTemplateSaved={onTemplateSaved} templatePath={PATHS.template} />\n\n      <FreelanceOfferDetails key={studio.id} path={studio.offerDetailsPath} t={t} />\n\n      <SectionTitle t={t} title=\"Messages envoyés\" count={studio.messages.length} />\n      <div style={{ display: 'grid', gap: 10, marginBottom: 18 }}>\n        {studio.messages.slice().reverse().map((m, i) => (\n          <div key={`${m.at}-${i}`} style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding }}>\n            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 6 }}>\n              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{readableDate(m.at)}</span>\n              <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{m.channel}</span>\n              <button type=\"button\" onClick={() => copy(m.text)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12 }}>copier</button>\n            </div>\n            <div style={{ fontFamily: P.sans, fontSize: 13, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{m.text}</div>\n          </div>\n        ))}\n        {!studio.messages.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Aucun message pour l'instant. « Marquer comme envoyée » ci-dessus garde la lettre exacte ; tu peux aussi coller ici un autre message envoyé.</div>}\n      </div>\n\n      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} placeholder=\"Un autre message envoyé, collé tel quel…\" aria-label=\"Message envoyé\"\n        style={{ ...textareaStyle(t), minHeight: 120 }} />\n      <div style={{ display: 'flex', gap: 8, alignItems: 'center', margin: '10px 0 24px', flexWrap: 'wrap' }}>\n        {['mail', 'linkedin', 'instagram', 'discord', 'en personne'].map((c) => <GlassPill key={c} t={t} onClick={() => setChannel(c)} active={channel === c}>{c}</GlassPill>)}\n        <span style={{ flex: 1 }} />\n        <Button t={t} primary onClick={send}>Enregistrer le message</Button>\n      </div>\n\n      <SectionTitle t={t} title=\"Historique\" count={events.length} />\n      <div style={{ display: 'grid', gap: 6, marginBottom: 24 }}>\n        {events.map((e, i) => (\n          <div key={i} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n            <span>{e.label}</span>\n          </div>\n        ))}\n        {!events.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Rien encore.</div>}\n      </div>\n\n      <SectionTitle t={t} title=\"Notes\" count=\"\" />\n      <textarea value={notes} onChange={(e) => setNotes(e.target.value)} onBlur={() => { if (notes !== studio.notes) onChange({ ...studio, notes }) }} aria-label=\"Notes\"\n        placeholder=\"Contact, salaire, retour reçu…\" style={{ ...textareaStyle(t), minHeight: 90 }} />\n    </>\n  )\n}\n\nexport default function FreelanceView({ t }) {\n  const [store, setStore] = useState(null)\n  const [sha, setSha] = useState(null)\n  const [engineFile, setEngineFile] = useState(null)\n  const [template, setTemplate] = useState(null)\n  const [openId, setOpenId] = useState(null)\n  const [query, setQuery] = useState('')\n  const [statusFilter, setStatusFilter] = useState('all')\n  const [filters, setFilters] = useState(readStoredFilters)\n  const [form, setForm] = useState({ name: '', role: '', link: '' })\n  const [saving, setSaving] = useState('')\n  const [panels, setPanels] = useState({ sources: false, template: false })\n  const bridge = useMemo(() => createFreelanceBridge(), [])\n  const today = isoDay()\n\n  const loadStore = useCallback(async () => {\n    try { const r = await readJson(PATHS.store); setSha(r.sha); setStore(normalizeStore(r.data)) } catch { setStore((current) => current || { v: 2, studios: [] }) }\n  }, [])\n  const loadAux = useCallback(async () => { setEngineFile(await readDisplay(PATHS.engine)); setTemplate(await readDisplay(PATHS.template)) }, [])\n  useEffect(() => { loadStore(); loadAux() }, [loadStore, loadAux])\n  const afterRun = useCallback(() => { loadStore(); loadAux() }, [loadStore, loadAux])\n\n  const changeFilters = (patch) => setFilters((current) => { const next = { ...current, ...patch }; storeFilters(next); return next })\n\n  // 30 September 2026, 19:45 Europe/Paris: Retry the intended change against the latest catalogue.\n  async function persist(mutate) {\n    setSaving('…')\n    try {\n      const r = await saveJsonWithRetry(PATHS.store, (current) => mutate(normalizeStore(current)), { sha, data: store })\n      if (!r.ok) throw new Error(String(r.error || 'Enregistrement impossible'))\n      setSha(r.sha); setStore(normalizeStore(r.data)); setSaving('enregistré')\n      return true\n    } catch (error) {\n      setSaving('erreur'); notify({ title: 'Enregistrement impossible', body: error.message })\n      return false\n    }\n  }\n\n  const studios = store ? store.studios : []\n  const open = studios.find((s) => s.id === openId) || null\n  const shown = useMemo(() => {\n    const list = searchStudios(studios, query).filter((s) => matchesFilters(s, filters, today))\n    return statusFilter === 'all' ? list : list.filter((s) => s.status === statusFilter)\n  }, [studios, query, filters, statusFilter, today])\n  const c = counts(studios)\n  const events = useMemo(() => timeline(studios, 24), [studios])\n  const newCount = studios.filter((s) => isNewStudio(s, today)).length\n  const sources = useMemo(() => sourceOptions(studios), [studios])\n  const problems = sourceProblems(engineFile).length\n\n  const addStudio = () => {\n    const s = normalizeStudio({ ...form, createdAt: isoDay(), status: 'to_contact' })\n    if (!s) return\n    setForm({ name: '', role: '', link: '' })\n    persist((current) => ({ ...current, studios: [s, ...current.studios] }))\n  }\n  const updateStudio = (next) => persist((current) => applyStudioChange(current, studios.find((studio) => studio.id === next.id), next))\n  const removeStudio = (id) => { if (!window.confirm('Supprimer ce studio et son historique ?')) return; setOpenId(null); persist((current) => ({ ...current, studios: current.studios.filter((studio) => studio.id !== id) })) }\n  const toggle = (name) => setPanels((current) => ({ ...current, [name]: !current[name] }))\n\n  return (\n    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '6px 2px 60px', color: t.textPrimary }}>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, flexWrap: 'wrap', marginBottom: 6 }}>\n        <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 30, letterSpacing: '-0.02em', margin: 0 }}>ZenRay <span style={{ fontStyle: 'italic' }}>Freelance</span></h1>\n        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>\n          {c.toContact} à contacter{newCount ? ` (${newCount} nouvelle${newCount > 1 ? 's' : ''})` : ''} · {c.contacted} contactés · {c.answered} réponses · {c.messages} messages\n        </span>\n        <span style={{ marginLeft: 'auto', fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{saving}</span>\n      </div>\n\n      <FreelanceEngineBar t={t} engine={engineFile} bridge={bridge} onFinished={afterRun} sourcesOpen={panels.sources} onToggleSources={() => toggle('sources')} problems={problems} />\n      {panels.sources && !open && <div style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: '18px 18px 8px', marginBottom: 22 }}><FreelanceSources t={t} engine={engineFile} /></div>}\n\n      {store === null && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>chargement…</div>}\n\n      {store !== null && open && (\n        <StudioDetail t={t} studio={open} onBack={() => setOpenId(null)} onChange={updateStudio} onDelete={() => removeStudio(open.id)}\n          engineFile={engineFile} template={template} bridge={bridge} onTemplateSaved={setTemplate} today={today} />\n      )}\n\n      {store !== null && !open && (\n        <>\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', margin: '4px 0 14px' }}>\n            <Field t={t} value={form.name} onChange={(v) => setForm({ ...form, name: v })} placeholder=\"Studio\" onKeyDown={(e) => { if (e.key === 'Enter') addStudio() }} />\n            <Field t={t} value={form.role} onChange={(v) => setForm({ ...form, role: v })} placeholder=\"Poste visé\" width={150} />\n            <Field t={t} value={form.link} onChange={(v) => setForm({ ...form, link: v })} placeholder=\"Site ou offre\" width={200} />\n            <Button t={t} primary onClick={addStudio}>+ studio</Button>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 10 }}>\n            <GlassPill t={t} onClick={() => setStatusFilter('all')} active={statusFilter === 'all'}>Tous {studios.length}</GlassPill>\n            {groupByStatus(studios).map((g) => (\n              <GlassPill key={g.key} t={t} statusKey={g.key} active={statusFilter === g.key} onClick={() => setStatusFilter(statusFilter === g.key ? 'all' : g.key)}>{g.label} {g.items.length}</GlassPill>\n            ))}\n            <span style={{ flex: 1, minWidth: 140 }}>\n              <Field t={t} value={query} onChange={setQuery} placeholder=\"Chercher un studio, un message…\" width={200} />\n            </span>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 22 }} aria-label=\"Filtres des annonces\">\n            <GlassPill t={t} onClick={() => changeFilters({ tier: 'all' })} active={filters.tier === 'all'}>Toutes les annonces</GlassPill>\n            <GlassPill t={t} color={UI.green} onClick={() => changeFilters({ tier: filters.tier === 'high' ? 'all' : 'high' })} active={filters.tier === 'high'}>{TIERS[0].label}</GlassPill>\n            <GlassPill t={t} color={UI.orange} onClick={() => changeFilters({ tier: filters.tier === 'medium' ? 'all' : 'medium' })} active={filters.tier === 'medium'}>Pertinent et plus</GlassPill>\n            <span style={{ width: 8 }} />\n            {KINDS.map((kind) => <GlassPill key={kind.key} t={t} onClick={() => changeFilters({ kind: filters.kind === kind.key ? 'all' : kind.key })} active={filters.kind === kind.key}>{kind.label}</GlassPill>)}\n            <span style={{ width: 8 }} />\n            <GlassPill t={t} color={UI.blue} onClick={() => changeFilters({ onlyNew: !filters.onlyNew })} active={filters.onlyNew}>Nouveau</GlassPill>\n            <GlassPill t={t} color={UI.gray} onClick={() => changeFilters({ showClosed: !filters.showClosed })} active={filters.showClosed}>Fermées</GlassPill>\n            {sources.length > 1 && (\n              <select value={filters.source} onChange={(e) => changeFilters({ source: e.target.value })} aria-label=\"Source\"\n                style={{ background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: 999, padding: '4px 10px', fontFamily: P.sans, fontSize: 12.5 }}>\n                <option value=\"all\">Toutes les sources</option>\n                {sources.map((name) => <option key={name} value={name}>{name}</option>)}\n              </select>\n            )}\n            <GlassPill t={t} onClick={() => changeFilters({ sort: filters.sort === 'score' ? 'recent' : 'score' })}>{filters.sort === 'score' ? 'Tri : adéquation' : 'Tri : plus récent'}</GlassPill>\n          </div>\n\n          {groupByStatus(shown).map((g) => (\n            <div key={g.key} style={{ marginBottom: 26 }}>\n              <SectionTitle t={t} title={g.label} count={g.items.length} />\n              <div style={{ display: 'grid', gridTemplateColumns: P.studioGrid, gap: P.gap }}>\n                {(g.key === 'to_contact' ? sortStudios(g.items, filters.sort) : g.items).map((s) => <StudioCard key={s.id} t={t} studio={s} today={today} onOpen={() => setOpenId(s.id)} />)}\n              </div>\n            </div>\n          ))}\n\n          {!shown.length && studios.length > 0 && (\n            <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, lineHeight: 1.6 }}>\n              Aucune fiche avec ces filtres. <button type=\"button\" onClick={() => { setFilters(DEFAULT_FILTERS); storeFilters(DEFAULT_FILTERS); setStatusFilter('all'); setQuery('') }} style={{ background: 'none', border: 'none', color: 'inherit', textDecoration: 'underline', cursor: 'pointer', font: 'inherit' }}>Tout afficher</button>\n            </div>\n          )}\n          {!studios.length && (\n            <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, lineHeight: 1.6 }}>\n              Aucun studio pour l'instant. Lance « Rechercher maintenant » : le moteur remplit la liste, ou ajoute le premier ci-dessus.\n            </div>\n          )}\n\n          <div style={{ marginTop: 34 }}>\n            <Panel t={t} title=\"Modèle de lettre\" open={panels.template} onToggle={() => toggle('template')} aside={template ? (template.status === 'seed' ? 'ta lettre Asobo, à adapter' : 'personnalisé') : 'pas encore publié'}>\n              <FreelanceTemplate t={t} template={template} templatePath={PATHS.template} bridge={bridge} onSaved={setTemplate} />\n            </Panel>\n          </div>\n\n          {events.length > 0 && (\n            <div style={{ marginTop: 20 }}>\n              <SectionTitle t={t} title=\"Progression\" count={events.length} />\n              <div style={{ display: 'grid', gap: 6 }}>\n                {events.map((e, i) => (\n                  <div key={i} onClick={() => setOpenId(e.id)} style={{ display: 'flex', gap: 10, alignItems: 'baseline', cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n                    <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n                    <span style={{ color: t.textPrimary }}>{e.studio}</span>\n                    <span>{e.label}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </>\n      )}\n    </div>\n  )\n}\n"}},"serverClassifierRequest":"cc77f18f-e897-4040-9eda-374e733ca931","apiBlockIndex":1,"requestId":"req_011CfgsqXLZLnYga8oW5LPwx","attributionSkill":"prompt-stacking","type":"assistant","uuid":"1d924558-2804-4a06-ad99-e55135231797","timestamp":"2026-10-04T08:26:14.804Z","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/.claude/Memory1","sessionId":"5fd92a10-03f3-4126-89e0-4dfe033274bd","version":"2.1.286","gitBranch":"main"}
