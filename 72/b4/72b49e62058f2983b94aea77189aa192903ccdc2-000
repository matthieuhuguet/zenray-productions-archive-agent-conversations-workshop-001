el.countryBonus})`) }\n  if (/remote|télétravail/i.test(`${workplace} ${text.slice(0, 600)}`) && config.profile.remoteOk) { score += rel.remoteBonus; why.push(`Télétravail (+${rel.remoteBonus})`) }\n  score = Math.max(0, Math.min(100, score))\n  return { score, tier: score >= rel.highScore ? 'high' : score >= rel.mediumScore ? 'medium' : 'low', why, skills, years }\n}\n\n/**\n * Listing (what a source published) -> studio record with notes + engine block.\n * `now` is injected so the record is reproducible in tests.\n */\nexport function buildOffer(listing, config, { now = new Date() } = {}) {\n  const { name, url, applyUrl = '', sourceId = url, sourceKey, sourceLabel, location = '', country = '', contract = '', workplace = '', published = '', extra = '', evidence = '' } = listing\n  const title = noLongDash(String(listing.title || '').trim())\n  const text = clean(listing.text)\n  const today = englishDay(now)\n  const flags = classify({ title, contract })\n  const verdict = scoreOffer({ title, text, contract, country, workplace }, config, flags)\n  const emails = recruiterEmails(text)\n  const priority = flags.freelance ? 'P1 : mission freelance explicite' : flags.trainee ? 'P4 : stage, signal studio' : verdict.skills.some((s) => s === 'Houdini' || s === 'Unreal Engine') ? 'P2 : besoin Houdini ou Unreal confirmé' : 'P3 : métier proche, besoin à qualifier'\n  const constraints = text.split(/(?<=[.!?])\\s+/).filter((sentence) => /right to work|work permit|visa sponsorship|legally eligible|reside|days per week|remote.*(?:only|within)|hybrid.*(?:only|studio)|\\brelocat/i.test(sentence))\n  const lines = [\n    `Recensement vérifié le ${today}. Source : ${evidence || sourceLabel}.`,\n    `Priorité commerciale estimée : ${priority}. (${today})`,\n    `Offre : ${title}. Contrat publié : ${contract || 'Non précisé'}. (${today})`,\n    `Lieu : ${location || 'Non précisé'}. Pays : ${country || 'Non précisé'}. Organisation : ${workplace || 'Non précisée'}. (${today})`,\n    