{"parentUuid":"ddd0abd5-e7bb-439d-92fc-203b34019237","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CfgsZGb7E2gArnJewfwZE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RdWhzmoEqsBgvmCyu2T8yt","name":"Write","input":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/src/lib/freelanceEngineModel.js","content":"// 4 October 2026: the page's reading of the engine's data. Pure strings, dates and objects, no browser API, so it is fully testable.\n// The engine (scripts/Freelance) writes `studio.engine`, `freelance/engine.json` and one letter archive per vacancy; this file only reads them.\n// FR : la lecture par la page des donnees du moteur. Module pur, entierement testable. Le moteur ecrit, ce fichier lit.\n\nexport const TIERS = [\n  { key: 'high', label: 'Très pertinent' },\n  { key: 'medium', label: 'Pertinent' },\n  { key: 'low', label: 'Peu adapté' },\n]\nexport const KINDS = [\n  { key: 'freelance', label: 'Freelance' },\n  { key: 'internship', label: 'Stage' },\n  { key: 'spontaneous', label: 'Vivier ou spontanée' },\n  { key: 'offer', label: 'Offre' },\n]\n\nexport const engineOf = (studio) => (studio && studio.engine) || null\n\n/** The kind of a studio as the page shows it: a studio without any engine block is a prospect Matthieu added by hand. */\nexport function kindOf(studio) {\n  const engine = engineOf(studio)\n  if (!engine) return 'prospect'\n  if (/^Vivier de candidatures/i.test(studio.role || '') || engine.kind === 'spontaneous') return 'spontaneous'\n  if (engine.freelance) return 'freelance'\n  if (engine.kind === 'internship' || engine.trainee) return 'internship'\n  return 'offer'\n}\nexport const kindLabel = (studio) => ({ prospect: 'Studio à démarcher', spontaneous: 'Vivier ou spontanée', freelance: 'Freelance', internship: 'Stage', offer: 'Offre' }[kindOf(studio)])\n\nexport function isClosedStudio(studio, today) {\n  const engine = engineOf(studio)\n  if (!engine) return false\n  return Boolean(engine.closedAt) || Boolean(engine.validThrough && String(engine.validThrough).slice(0, 10) < today)\n}\n\nconst dayNumber = (iso) => Math.floor(new Date(`${String(iso).slice(0, 10)}T00:00:00Z`).getTime() / 86400000)\nexport function isNewStudio(studio, today, days = 3) {\n  const engine = engineOf(studio)\n  if (!engine || engine.legacy || !engine.firstSeenAt || studio.status !== 'to_contact') return false\n  return dayNumber(today) - dayNumber(engine.firstSeenAt) < days\n}\n\nexport const tierOf = (studio) => engineOf(studio)?.tier || null\nexport const scoreOf = (studio) => engineOf(studio)?.score ?? null\nexport const sourceLabelOf = (studio) => engineOf(studio)?.sourceLabel || ''\n\nexport const DEFAULT_FILTERS = { tier: 'all', kind: 'all', source: 'all', onlyNew: false, showClosed: false, sort: 'score' }\n\nexport function matchesFilters(studio, filters, today) {\n  if (!filters.showClosed && isClosedStudio(studio, today)) return false\n  if (filters.onlyNew && !isNewStudio(studio, today)) return false\n  if (filters.tier === 'high' && tierOf(studio) !== 'high') return false\n  if (filters.tier === 'medium' && !['high', 'medium'].includes(tierOf(studio))) return false\n  if (filters.kind !== 'all' && kindOf(studio) !== filters.kind) return false\n  if (filters.source !== 'all' && sourceLabelOf(studio) !== filters.source) return false\n  return true\n}\n\nexport function sortStudios(list, sort = 'score') {\n  const copy = [...list]\n  if (sort === 'recent') return copy.sort((a, b) => String(engineOf(b)?.firstSeenAt || b.createdAt).localeCompare(String(engineOf(a)?.firstSeenAt || a.createdAt)) || (scoreOf(b) ?? -1) - (scoreOf(a) ?? -1))\n  return copy.sort((a, b) => (scoreOf(b) ?? -1) - (scoreOf(a) ?? -1) || String(a.name).localeCompare(String(b.name)))\n}\n\nexport const sourceOptions = (studios) => [...new Set(studios.map(sourceLabelOf).filter(Boolean))].sort((a, b) => a.localeCompare(b))\n\n/** \"il y a 2 h\" from an ISO time; coarse on purpose, the exact time is one hover away. */\nexport function relativeTime(iso, now = new Date()) {\n  if (!iso) return 'jamais'\n  const minutes = Math.round((new Date(now).getTime() - new Date(iso).getTime()) / 60000)\n  if (Number.isNaN(minutes)) return ''\n  if (minutes < 1) return 'à l’instant'\n  if (minutes < 60) return `il y a ${minutes} min`\n  const hours = Math.round(minutes / 60)\n  if (hours < 24) return `il y a ${hours} h`\n  const days = Math.round(hours / 24)\n  return days === 1 ? 'hier' : `il y a ${days} jours`\n}\n\n/** In how long the next automatic search runs, from the service's own due time. */\nexport function untilLabel(iso, now = new Date()) {\n  if (!iso) return ''\n  const minutes = Math.round((new Date(iso).getTime() - new Date(now).getTime()) / 60000)\n  if (minutes <= 0) return 'dès que le Mac est disponible'\n  if (minutes < 60) return `dans ${minutes} min`\n  return `dans ${Math.round(minutes / 60)} h`\n}\n\n/** The mail link: only when a recruiter address is known; the body is capped, the page copies the whole letter anyway. */\nexport function mailtoUrl({ to, subject, body, limit = 1800 }) {\n  if (!to) return ''\n  const text = String(body || '')\n  const cut = text.length > limit ? `${text.slice(0, limit)}…` : text\n  return `mailto:${encodeURIComponent(to).replace(/%40/g, '@')}?subject=${encodeURIComponent(subject || '')}&body=${encodeURIComponent(cut)}`\n}\n\n// ─── Letter archive: versions only ever grow ──────────────────────────────────────────────────────────\n\nexport const versionsOf = (archive) => (archive && Array.isArray(archive.versions) ? archive.versions : [])\nexport const currentVersion = (archive) => versionsOf(archive).at(-1) || null\nexport const suggestionOf = (archive) => (archive && archive.suggested) || null\n\n/** Matthieu's own edit: a new version by him, never an overwrite. Returns the same archive when nothing changed. */\nexport function addUserVersion(archive, { text