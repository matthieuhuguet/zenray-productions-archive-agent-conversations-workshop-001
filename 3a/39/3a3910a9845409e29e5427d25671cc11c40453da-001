  return (\n74\t    <button onClick={onClick} style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 15px', cursor: 'pointer', fontFamily: P.sans, fontSize: 13.5 }}>{children}</button>\n75\t  )\n76\t}\n77\t\n78\tfunction SectionTitle({ t, title, count }) {\n79\t  return (\n80\t    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>\n81\t      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>\n82\t      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{count}</span>\n83\t      <span style={{ flex: 1, height: 1, background: t.border }} />\n84\t    </div>\n85\t  )\n86\t}\n87\t\n88\t/** One studio card: name, role, state pill, and the beginning of the last message sent. */\n89\tfunction StudioCard({ t, studio, onOpen }) {\n90\t  const msg = lastMessage(studio)\n91\t  return (\n92\t    <button type=\"button\" onClick={onOpen} title={studio.name}\n93\t      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0 }}>\n94\t      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n95\t        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n96\t        <span style={{ marginLeft: 'auto' }}><GlassPill t={t} statusKey={studio.status} /></span>\n97\t      </span>\n98\t      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n99\t        {[studio.role, studio.city].fi