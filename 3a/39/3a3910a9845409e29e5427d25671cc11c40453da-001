{"parentUuid":"5c4516e0-9752-4c65-be6a-80c75d3baf22","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/.claude/skills/zenray-houdini/scripts/capture_archive.py","snippet":"1\t#!/usr/bin/env python3\n2\t\"\"\"Archive every OpenGL verification capture as JPEG inside this skill, project by project.\n3\t\n4\t2026-09-12. A capture proves a state of the model at a date. Left in /tmp it dies with the session,\n5\tso the breakdown cannot be replayed later. This tool copies each capture into\n6\t`<skill>/<project>-captures/`, names it by time and label, and appends one line to the project index\n7\tso the evolution reads in order.\n8\t\n9\tFR : chaque capture de verification part dans le skill, en JPEG, nommee par date et par intention,\n10\tavec un index par projet, pour relire l evolution du breakdown dans le temps.\n11\t\n12\tUsage:\n13\t  python3 capture_archive.py add <project> <label> <image> [<image> ...]\n14\t  python3 capture_archive.py list <project>\n15\t\"\"\"\n16\timport argparse\n17\timport hashlib\n18\timport json\n19\timport subprocess\n20\timport sys\n21\tfrom datetime import datetime\n22\tfrom pathlib import Path\n23\t\n24\tSKILL_ROOT = Path(__file__).resolve().parents[1]\n25\tQUALITY = 88           # JPEG quality: readable breakdown, small files\n26\tMAX_SIDE = 2400        # longest side in pixels, enough to read a shingle, light enough to keep forever\n27\tINDEX_NAME = 'captures.json'\n28\t\n29\t\n30\tdef slug(text):\n31\t    keep = [c if (c.isalnum() or c in '-_') else '-' for c in text.strip().lower()]\n32\t    return ''.join(keep).strip('-') or 'capture'\n33\t\n34\t\n35\tdef project_slug(project):\n36\t    \"\"\"The folder keeps the project's own capitals: `LouisianaBayou-captures` reads better than a flat one.\"\"\"\n37\t    keep = [c if (c.isalnum() or c in '-_') else '-' for c in project.strip()]\n38\t    return ''.join(keep).strip('-') or 'projet'\n39\t\n40\t\n41\tdef project_dir(project):\n42\t    d = SKILL_ROOT / f'{project_slug(project)}-captures'\n43\t    d.mkdir(parents=True, exist_ok=True)\n44\t    return d\n45\t\n46\t\n47\tdef read_index(d):\n48\t    path = d / INDEX_NAME\n49\t    if not path.exists():\n50\t        return {'project': d.name.replace('-captures', ''), 'captures': []}\n51\t    try:\n52\t        return json.loads(path.read_text())\n53\t    except Exception:\n54\t        return {'project': d.name.replace('-captures', ''), 'captures': []}\n55\t\n56\t\n57\tdef write_index(d, index):\n58\t    (d / INDEX_NAME).write_text(json.dumps(index, indent=1, ensure_ascii=False))\n59\t\n60\t\n61\tdef digest(path):\n62\t    h = hashlib.sha256()\n63\t    with Path(path).open('rb') as f:\n64\t        for chunk in iter(lambda: f.read(1 << 20), b''):\n65\t            h.update(chunk)\n66\t    return h.hexdigest()\n67\t\n68\t\n69\tdef to_jpeg(src, dst):\n70\t    \"\"\"Convert with Pillow when available, fall back to macOS sips, never silently skip.\"\"\"\n71\t    try:\n72\t        from PIL import Image\n73\t        im = Image.open(src)\n74\t        im = im.convert('RGB') if im.mode not in ('RGB', 'L') else im\n75\t        w, h = im.size\n76\t        if max(w, h) > MAX_SIDE:\n77\t            scale = MAX_SIDE / float(max(w, h))\n78\t            im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))))\n79\t        im.save(dst, 'JPEG', quality=QUALITY, optimize=True)\n80\t        return im.size\n81\t    except ImportError:\n82\t        subprocess.run(['sips', '-s', 'format', 'jpeg', '-Z', str(MAX_SIDE), str(src), '--out', str(dst)],\n83\t                       check=True, capture_output=True)\n84\t        out = subprocess.run(['sips', '-g', 'pixelWidth', '-g', 'pixelHeight', str(dst)],\n85\t                             check=True, capture_output=True, text=True).stdout\n86\t        nums = [int(x.split(':')[1]) for x in out.strip().splitlines() if ':' in x and x.split(':')[1].strip().isdigit()]\n87\t        return tuple(nums[:2]) if len(nums) >= 2 else (0, 0)\n88\t\n89\t\n90\tdef add(project, label, images, note=''):\n91\t    d = project_dir(project)\n92\t    index = read_index(d)\n93\t    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')\n94\t    added = []\n95\t    for i, src in enumerate(images, 1):\n96\t        src = Path(src).expanduser()\n97\t        if not src.exists():\n98\t            raise SystemExit(f'capture introuvable : {src}')\n99\t        name = f'{stamp}-{i:02d}-{slug(label)}.jpg'\n100\t        dst = d / name\n101\t        size = to_jpeg(src, dst)\n102\t        entry = {'file': name, 'at': datetime.now().isoformat(timespec='seconds'), 'label': label,\n103\t                 'source': str(src), 'width': size[0], 'height': size[1],\n104\t                 'bytes': dst.stat().st_size, 'sha256': digest(dst)[:16], 'note': note}\n105\t        index['captures'].append(entry)\n106\t        added.append(entry)\n107\t    write_index(d, index)\n108\t    print(json.dumps({'dir': str(d), 'added': added, 'total': len(index['captures'])}, indent=1, ensure_ascii=False))\n109\t\n110\t\n111\tdef show(project):\n112\t    d = project_dir(project)\n113\t    index = read_index(d)\n114\t    for c in index['captures']:\n115\t        print(f\"{c['at']}  {c['width']}x{c['height']:<6} {c['file']:<44} {c['label']}\")\n116\t    print(f\"{len(index['captures'])} capture(s) dans {d}\")\n117\t\n118\t\n119\tdef main():\n120\t    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n121\t    sub = p.add_subparsers(dest='mode', required=True)\n122\t    a = sub.add_parser('add'); a.add_argument('project'); a.add_argument('label'); a.add_argument('images', nargs='+'); a.add_argument('--note', default='')\n123\t    l = sub.add_parser('list'); l.add_argument('project')\n124\t    args = p.parse_args()\n125\t    if args.mode == 'add':\n126\t        add(args.project, args.label, args.images, args.note)\n127\t    else:\n128\t        show(args.project)\n129\t\n130\t\n131\tif __name__ == '__main__':\n132\t    main()