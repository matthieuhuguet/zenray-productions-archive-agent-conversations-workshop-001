nterface of the page: every value judged by eye lives here and nowhere else.\n// FR : l'interface de parametres de la page, toute valeur jugee a l'oeil vit ici.\nconst P = {\n  serif: 'var(--zr-police-serif)',\n  sans: 'var(--zr-police-sans)',\n  mono: 'var(--zr-police-mono)',\n  serifWeight: 350,\n  numberWeight: 400,\n  column: 1240,\n  studioGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',\n  radius: 8,\n  cardPadding: '16px 18px',\n  gap: 14,\n  messageLines: 3,\n}\n\nconst glassStyle = (t, color) => ({\n  display: 'inline-flex', alignItems: 'center', gap: DOT.gap,\n  padding: '4px 11px', borderRadius: 999,\n  background: (t.glass && t.glass.bg) || t.surface,\n  backdropFilter: (t.glass && t.glass.filter) || 'none',\n  WebkitBackdropFilter: (t.glass && t.glass.filter) || 'none',\n  boxShadow: (t.glass && t.glass.edge) || 'none',\n  border: `1px solid ${t.border}`,\n  color: t.textPrimary, fontFamily: P.sans, fontSize: 12.5, whiteSpace: 'nowrap',\n  ...(color ? { borderColor: color + '55' } : null),\n})\n\nfunction Dot({ color }) {\n  return <span aria-hidden=\"true\" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />\n}\n\n/** The liquid glass pill: the state of one studio, readable in one glance. */\nfunction GlassPill({ t, statusKey, children, onClick, active }) {\n  const color = statusColor(statusKey)\n  return (\n    <span onClick={onClick} style={{ ...glassStyle(t, color), cursor: onClick ? 'pointer' : 'default', opacity: active === false ? 0.55 : 1, fontWeight: active ? 600 : 400 }}>\n      <Dot color={color} />{children || statusLabel(statusKey)}\n    </span>\n  )\n}\n\nfunction Field({ t, value, onChange, placeholder, width = 180, onKeyDown }) {\n  return (\n    <input value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} onKeyDown={onKeyDown}\n      style={{ flex: `1 1 ${width}px`, minWidth: 120, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 12px', fontFamily: P.sans, fontSize: 13.5, outline: 'none' }} />\n  )\n}\n\nfunction Button({ t, onClick, children, primary }) {\n  return (\n    <button onClick={onClick} style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 15px', cursor: 'pointer', fontFamily: P.sans, fontSize: 13.5 }}>{children}</button>\n  )\n}\n\nfunction SectionTitle({ t, title, count }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>\n      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{count}</span>\n      <span style={{ flex: 1, height: 1, background: t.border }} />\n    </div>\n  )\n}\n\n/** One studio card: name, role, state pill, and the beginning of the last message sent. */\nfunction StudioCard({ t, studio, onOpen }) {\n  const msg = lastMessage(studio)\n  return (\n    <button type=\"button\" onClick={onOpen} title={studio.name}\n      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0 }}>\n      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n        <span style={{ marginLeft: 'auto' }}><GlassPill t={t} statusKey={studio.status} /></span>\n      </span>\n      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ') || 'poste à préciser'}\n      </span>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary }}>\n        {studio.contactedAt ? `contacté le ${readableDate(studio.contactedAt)}` : 'jamais contacté'}\n        {studio.messages.length ? ` · ${studio.messages.length} message${studio.messages.length > 1 ? 's' : ''}` : ''}\n      </span>\n      {msg && (\n        <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary, display: '-webkit-box', WebkitLineClamp: P.messageLines, WebkitBoxOrient: 'vertical', overflow: 'hidden', lineHeight: 1.45 }}>{msg.text}</span>\n      )}\n    </button>\n  )\n}\n\n/** One studio, opened in place: its messages, its dated history, its notes. */\nfunction StudioDetail({ t, studio, onBack, onChange, onDelete }) {\n  const [draft, setDraft] = useState('')\n  const [channel, setChannel] = useState('mail')\n  const [notes, setNotes] = useState(studio.notes)\n  useEffect(() => { setNotes(studio.notes) }, [studio.id])\n\n  const send = () => {\n    if (!draft.trim()) return\n    onChange(addMessage(studio, { text: draft, channel }))\n    setDraft('')\n    notify('Message enregistré', 'Le texte exact est gardé avec sa date.')\n  }\n  const copy = (text) => { try { navigator.clipboard.writeText(text) } catch {} notify('Message copié', 'Collé tel quel, prêt à envoyer.') }\n\n  const events = timeline([studio], 40)\n  return (\n    <>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 18, flexWrap: 'wrap' }}>\n        <button type=\"button\" onClick={onBack} style={{ background: 'none', border: 'none', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les studios</button>\n        <span style={{ flex: 1 }} />\n        {studio.link && <a href={studio.link} target=\"_blank\" rel=\"noreferrer\" style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>site ou offre ↗</a>}\n        <button type=\"button\" onClick={onDelete} style={{ background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>supprimer</button>\n      </div>\n\n      <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: '0 0 6px' }}>{studio.name}</h2>\n      <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, marginBottom: 16 }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ')}\n        {studio.contactedAt ? `${studio.role || studio.city ? ' · ' : ''}premier contact le ${readableDate(studio.contactedAt)}` : ''}\n      </div>\n\n      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 22 }}>\n        {STATUSES.map((s) => (\n          <GlassPill key={s.key} t={t} statusKey={s.key} active={studio.status === s.key}\n            onClick={() => onChange(setStatus(studio, s.key))} />\n        ))}\n      </div>\n\n      <SectionTitle t={t} title=\"Messages envoyés\" count={studio.messages.length} />\n      <div style={{ display: 'grid', gap: 10, marginBottom: 18 }}>\n        {studio.messages.slice().reverse().map((m, i) => (\n          <div key={`${m.at}-${i}`} style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding }}>\n            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 6 }}>\n              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{readableDate(m.at)}</span>\n              <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{m.channel}</span>\n              <button type=\"button\" onClick={() => copy(m.text)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12 }}>copier</button>\n            </div>\n            <div style={{ fontFamily: P.sans, fontSize: 13, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{m.text}</div>\n          </div>\n        ))}\n        {!studio.messages.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Aucun message pour l'instant. Colle ci-dessous celui que tu envoies, il sera gardé avec sa date.</div>}\n      </div>\n\n      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} placeholder=\"Le message envoyé, collé tel quel…\"\n        style={{ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, minHeight: 120, resize: 'vertical', outline: 'none', boxSizing: 'border-box' }} />\n      <div style={{ display: 'flex', gap: 8, alignItems: 'center', margin: '10px 0 24px', flexWrap: 'wrap' }}>\n        {['mail', 'linkedin', 'instagram', 'discord', 'en personne'].map((c) => (\n          <span key={c} onClick={() => setChannel(c)} style={{ ...glassStyle(t), cursor: 'pointer', opacity: channel === c ? 1 : 0.55, fontWeight: channel === c ? 600 : 400 }}>{c}</span>\n        ))}\n        <span style={{ flex: 1 }} />\n        <Button t={t} primary onClick={send}>Enregistrer le message</Button>\n      </div>\n\n      <SectionTitle t={t} title=\"Historique\" count={events.length} />\n      <div style={{ display: 'grid', gap: 6, marginBottom: 24 }}>\n        {events.map((e, i) => (\n          <div key={i} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n            <span>{e.label}</span>\n          </div>\n        ))}\n        {!events.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Rien encore.</div>}\n      </div>\n\n      <SectionTi