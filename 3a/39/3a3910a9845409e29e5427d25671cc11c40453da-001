{"parentUuid":"57c46296-194f-4cd9-89a6-4ae1b74e0395","isSidechain":false,"attachment":{"type":"file","filename":"/Users/zenray/.claude/skills/zenray-houdini/scripts/capture_archive.py","content":{"type":"text","file":{"filePath":"/Users/zenray/.claude/skills/zenray-houdini/scripts/capture_archive.py","content":"#!/usr/bin/env python3\n\"\"\"Archive every OpenGL verification capture as JPEG inside this skill, project by project.\n\n2026-09-12. A capture proves a state of the model at a date. Left in /tmp it dies with the session,\nso the breakdown cannot be replayed later. This tool copies each capture into\n`<skill>/<project>-captures/`, names it by time and label, and appends one line to the project index\nso the evolution reads in order.\n\nFR : chaque capture de verification part dans le skill, en JPEG, nommee par date et par intention,\navec un index par projet, pour relire l evolution du breakdown dans le temps.\n\nUsage:\n  python3 capture_archive.py add <project> <label> <image> [<image> ...]\n  python3 capture_archive.py list <project>\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport subprocess\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\n\nSKILL_ROOT = Path(__file__).resolve().parents[1]\nQUALITY = 88           # JPEG quality: readable breakdown, small files\nMAX_SIDE = 2400        # longest side in pixels, enough to read a shingle, light enough to keep forever\nINDEX_NAME = 'captures.json'\n\n\ndef slug(text):\n    keep = [c if (c.isalnum() or c in '-_') else '-' for c in text.strip().lower()]\n    return ''.join(keep).strip('-') or 'capture'\n\n\ndef project_slug(project):\n    \"\"\"The folder keeps the project's own capitals: `LouisianaBayou-captures` reads better than a flat one.\"\"\"\n    keep = [c if (c.isalnum() or c in '-_') else '-' for c in project.strip()]\n    return ''.join(keep).strip('-') or 'projet'\n\n\ndef project_dir(project):\n    d = SKILL_ROOT / f'{project_slug(project)}-captures'\n    d.mkdir(parents=True, exist_ok=True)\n    return d\n\n\ndef read_index(d):\n    path = d / INDEX_NAME\n    if not path.exists():\n        return {'project': d.name.replace('-captures', ''), 'captures': []}\n    try:\n        return json.loads(path.read_text())\n    except Exception:\n        return {'project': d.name.replace('-captures', ''), 'captures': []}\n\n\ndef write_index(d, index):\n    (d / INDEX_NAME).write_text(json.dumps(index, indent=1, ensure_ascii=False))\n\n\ndef digest(path):\n    h = hashlib.sha256()\n    with Path(path).open('rb') as f:\n        for chunk in iter(lambda: f.read(1 << 20), b''):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef to_jpeg(src, dst):\n    \"\"\"Convert with Pillow when available, fall back to macOS sips, never silently skip.\"\"\"\n    try:\n        from PIL import Image\n        im = Image.open(src)\n        im = im.convert('RGB') if im.mode not in ('RGB', 'L') else im\n        w, h = im.size\n        if max(w, h) > MAX_SIDE:\n            scale = MAX_SIDE / float(max(w, h))\n            im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))))\n        im.save(dst, 'JPEG', quality=QUALITY, optimize=True)\n        return im.size\n    except ImportError:\n        subprocess.run(['sips', '-s', 'format', 'jpeg', '-Z', str(MAX_SIDE), str(src), '--out', str(dst)],\n                       check=True, capture_output=True)\n        out = subprocess.run(['sips', '-g', 'pixelWidth', '-g', 'pixelHeight', str(dst)],\n                             check=True, capture_output=True, text=True).stdout\n        nums = [int(x.split(':')[1]) for x in out.strip().splitlines() if ':' in x and x.split(':')[1].strip().isdigit()]\n        return tuple(nums[:2]) if len(nums) >= 2 else (0, 0)\n\n\ndef add(project, label, images, note=''):\n    d = project_dir(project)\n    index = read_index(d)\n    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')\n    added = []\n    for i, src in enumerate(images, 1):\n        src = Path(src).expanduser()\n        if not src.exists():\n            raise SystemExit(f'capture introuvable : {src}')\n        name = f'{stamp}-{i:02d}-{slug(label)}.jpg'\n        dst = d / name\n        size = to_jpeg(src, dst)\n        entry = {'file': name, 'at': datetime.now().isoformat(timespec='seconds'), 'label': label,\n                 'source': str(src), 'width': size[0], 'height': size[1],\n                 'bytes': dst.stat().st_size, 'sha256': digest(dst)[:16], 'note': note}\n        index['captures'].append(entry)\n        added.append(entry)\n    write_index(d, index)\n    print(json.dumps({'dir': str(d), 'added': added, 'total': len(index['captures'])}, indent=1, ensure_ascii=False))\n\n\ndef show(project):\n    d = project_dir(project)\n    index = read_index(d)\n    for c in index['captures']:\n        print(f\"{c['at']}  {c['width']}x{c['height']:<6} {c['file']:<44} {c['label']}\")\n    print(f\"{len(index['captures'])} capture(s) dans {d}\")\n\n\ndef main():\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    sub = p.add_subparsers(dest='mode', required=True)\n    a = sub.add_parser('add'); a.add_argument('project'); a.add_argument('label'); a.add_argument('images', nargs='+'); a.add_argument('--note', default='')\n    l = sub.add_parser('list'); l.add_argument('project')\n    args = p.parse_args()\n    if args.mode == 'add':\n        add(args.project, args.label, args.images, args.note)\n    else:\n        show(args.project)\n\n\nif __name__ == '__main__':\n    main()\n","numLines":133,"startLine":1,"totalLines":133}},"displayPath":"../skills/zenray-houdini/scripts/capture_archive.py"},"type":"attachment","uuid":"bf7f4cb8-a38c-4a21-984d-7bbcfc84b165","timestamp":"2026-09-14T10:11:14.849Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/zenray/.claude/skills/zenray-houdini/scripts/capture_archive.py\"}\n</system-reminder>"},{"content":"<syste