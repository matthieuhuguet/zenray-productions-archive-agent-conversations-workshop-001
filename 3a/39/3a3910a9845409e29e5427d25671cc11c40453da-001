{"parentUuid":"6d021325-7ee5-406e-958d-537a1e1f28cf","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/components/FreelanceView.jsx","snippet":"1\t// ZENRAY FREELANCE v2 (2026-09-12).\n2\t//\n3\t// A dashboard of studios: the ones still to contact, the ones already contacted with the exact\n4\t// message that was sent, and a dated trail of every change, so the progress survives the months.\n5\t// The look follows ZenRay Assets: one column, serif titles, cards, and a liquid glass pill for the\n6\t// state. Storage is the drive file `freelance/applications.json`, written through the\n7\t// read-modify-write helper so two tabs never lose a message.\n8\t//\n9\t// FR : le tableau de bord des studios, ceux a contacter et ceux deja contactes, avec le message\n10\t// exact envoye et la trace datee de chaque changement. Meme esthetique que ZenRay Assets, meme\n11\t// fichier de stockage qu'avant, ecrit sans jamais ecraser une modification concurrente.\n12\timport React, { useEffect, useMemo, useState } from 'react'\n13\timport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\n14\timport { DOT } from '../config/colors.js'\n15\timport { notify } from './Notifications.jsx'\n16\timport {\n17\t  STATUSES, normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage,\n18\t  groupByStatus, counts, timeline, searchStudios, readableDate, statusLabel, statusColor, isoDay,\n19\t} from '../lib/freelanceStudios.js'\n20\t\n21\tconst STORE_PATH = 'freelance/applications.json'\n22\t\n23\t// The parameter interface of the page: every value judged by eye lives here and nowhere else.\n24\t// FR : l'interface de parametres de la page, toute valeur jugee a l'oeil vit ici.\n25\tconst P = {\n26\t  serif: 'var(--zr-police-serif)',\n27\t  sans: 'var(--zr-police-sans)',\n28\t  mono: 'var(--zr-police-mono)',\n29\t  serifWeight: 350,\n30\t  numberWeight: 400,\n31\t  column: 1240,\n32\t  stu