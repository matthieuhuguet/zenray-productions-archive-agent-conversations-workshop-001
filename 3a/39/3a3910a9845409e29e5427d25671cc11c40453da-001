{"parentUuid":"3af2bd09-1be8-43b0-8de7-9e2a158ab1aa","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CeyW57azXW7B5QALdaxic","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015NWB73BoTABGGeUeYBpvYW","name":"Write","input":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/components/FreelanceView.jsx","content":"// ZENRAY FREELANCE v2 (2026-09-12).\n//\n// A dashboard of studios: the ones still to contact, the ones already contacted with the exact\n// message that was sent, and a dated trail of every change, so the progress survives the months.\n// The look follows ZenRay Assets: one column, serif titles, cards, and a liquid glass pill for the\n// state. Storage is the drive file `freelance/applications.json`, written through the\n// read-modify-write helper so two tabs never lose a message.\n//\n// FR : le tableau de bord des studios, ceux a contacter et ceux deja contactes, avec le message\n// exact envoye et la trace datee de chaque changement. Meme esthetique que ZenRay Assets, meme\n// fichier de stockage qu'avant, ecrit sans jamais ecraser une modification concurrente.\nimport React, { useEffect, useMemo, useState } from 'react'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { DOT } from '../config/colors.js'\nimport { notify } from './Notifications.jsx'\nimport {\n  STATUSES, normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage,\n  groupByStatus, counts, timeline, searchStudios, readableDate, statusLabel, statusColor, isoDay,\n} from '../lib/freelanceStudios.js'\n\nconst STORE_PATH = 'freelance/applications.json'\n\n// The parameter interface of the page: every value judged by eye lives here and nowhere else.\n// FR : l'interface de parametres de la page, toute valeur jugee a l'oeil vit ici.\nconst P = {\n  serif: 'var(--zr-police-serif)',\n  sans: 'var(--zr-police-sans)',\n  mono: 'var(--zr-police-mono)',\n  serifWeight: 350,\n  numberWeight: 400,\n  column: 1240,\n  studioGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',\n  radius: 8,\n  cardPadding: '16px 18px',\n  gap: 14,\n  messageLines: 3,\n}\n\nconst glassStyle = (t, color) => ({\n  display: 'inline-flex', alignItems: 'center', gap: DOT.gap,\n  padding: '4px 11px', borderRadius: 999,\n  background: (t.glass && t.glass.bg) || t.surface,\n  backdropFilter: (t.glass && t.glass.filter) || 'none',\n  WebkitBackdropFilter: (t.glass && t.glass.filter) || 'none',\n  boxShadow: (t.glass && t.glass.edge) || 'none',\n  border: `1px solid ${t.border}`,\n  color: t.textPrimary, fontFamily: P.sans, fontSize: 12.5, whiteSpace: 'nowrap',\n  ...(color ? { borderColor: color + '55' } : null),\n})\n\nfunction Dot({ color }) {\n  return <span aria-hidden=\"true\" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />\n}\n\n/** The liquid glass pill: the state of one studio, readable in one glance. */\nfunction GlassPill({ t, statusKey, children, onClick, active }) {\n  const color = statusColor(statusKey)\n  return (\n    <span onClick={onClick} style={{ ...glassStyle(t, color), cursor: onClick ? 'pointer' : 'default', opacity: active === false ? 0.55 : 1, fontWeight: active ? 600 : 400 }}>\n      <Dot color={color} />{children || statusLabel(statusKey)}\n    </span>\n  )\n}\n\nfunction Field({ t, value, onChange, placeholder, width = 180, onKeyDown }) {\n  return (\n    <input value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} onKeyDown={onKeyDown}\n      style={{ flex: `1 1 ${width}px`, minWidth: 120, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 12px', fontFamily: P.sans, fontSize: 13.5, outline: 'none' }} />\n  )\n}\n\nfunction Button({ t, onClick, children, primary }) {\n  return (\n    <button onClick={onClick} style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 15px', cursor: 'pointer', fontFamily: P.sans, fontSize: 13.5 }}>{children}</button>\n  )\n}\n\nfunction SectionTitle({ t, title, count }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>\n      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{count}</span>\n      <span style={{ flex: 1, height: 1, background: t.border }} />\n    </div>\n  )\n}\n\n/** One studio card: name, role, state pill, and the beginning of the last message sent. */\nfunction StudioCard({ t, studio, onOpen }) {\n  const msg = lastMessage(studio)\n  return (\n    <button type=\"button\" onClick={onOpen} title={studio.name}\n      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0 }}>\n      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n        <span style={{ marginLeft: 'auto' }}><GlassPill t={t} statusKey={studio.status} /></span>\n      </span>\n      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ') || 'poste à préciser'}\n      </span>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary }}>\n        {studio.contactedAt ? `contacté le ${readableDate(studio.contactedAt)}` : 'jamais contacté'}\n        {studio.messages.length ? ` · ${studio.messages.length} message${studio.messages.length > 1 ? 's' : ''}` : ''}\n      </span>\n      {msg && (\n        <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary, display: '-webkit-box', WebkitLineClamp: P.messageLines, WebkitBoxOrient: 'vertical', overflow: 'hidden', lineHeight: 1.45 }}>{msg.text}</span>\n      )}\n    </button>\n  )\n}\n\n/** One studio, opened in place: its messages, its dated history, its notes. */\nfunction StudioDetail({ t, studio, onBack, onChange, onDelete }) {\n  const [draft, setDraft] = useState('')\n  const [channel, setChannel] = useState('mail')\n  const [notes, setNotes] = useState(studio.notes)\n  useEffect(() => { setNotes(studio.notes) }, [studio.id])\n\n  const send = () => {\n    if (!draft.trim()) return\n    onChange(addMessage(studio, { text: draft, channel }))\n    setDraft('')\n    notify('Message enregistré', 'Le texte exact est gardé avec sa date.')\n  }\n  const copy = (text) => { try { navigator.clipboard.writeText(text) } catch {} notify('Message copié', 'Collé tel quel, prêt à envoyer.') }\n\n  const events = timeline([studio], 40)\n  return (\n    <>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 18, flexWrap: 'wrap' }}>\n        <button type=\"button\" onClick={onBack} style={{ background: 'none', border: 'none', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les studios</button>\n        <span style={{ flex: 1 }} />\n        {studio.link && <a href={studio.link} target=\"_blank\" rel=\"noreferrer\" style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>site ou offre ↗</a>}\n        <button type=\"button\" onClick={onDelete} style={{ background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>supprimer</button>\n      </div>\n\n      <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: '0 0 6px' }}>{studio.name}</h2>\n      <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, marginBottom: 16 }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ')}\n        {studio.contactedAt ? `${studio.role || studio.city ? ' · ' : ''}premier contact le ${readableDate(studio.contactedAt)}` : ''}\n      </div>\n\n      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 22 }}>\n        {STATUSES.map((s) => (\n          <GlassPill key={s.key} t={t} statusKey={s.key} active={studio.status === s.key}\n            onClick={() => onChange(setStatus(studio, s.key))} />\n        ))}\n      </div>\n\n      <SectionTitle t={t} title=\"Messages envoyés\" count={studio.messages.length} />\n      <div style={{ display: 'grid', gap: 10, marginBottom: 18 }}>\n        {studio.messages.slice().reverse().map((m, i) => (\n          <div key={`${m.at}-${i}`} style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding }}>\n            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 6 }}>\n              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{readableDate(m.at)}</span>\n              <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{m.channel}</span>\n              <button type=\"button\" onClick={() => copy(m.text)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12 }}>copier</button>\n            </div>\n            <div style={{ fontFamily: P.sans, fontSize: 13, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{m.text}</div>\n          </div>\n        ))}\n        {!studio.messages.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Aucun message pour l'instant. Colle ci-dessous celui que tu envoies, il sera gardé avec sa date.</div>}\n      </div>\n\n      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} placeholder=\"Le message envoyé, collé tel quel…\"\n        style={{ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, minHeight: 120, resize: 'vertical', outline: 'none', boxSizing: 'border-box' }} />\n      <div style={{ display: 'flex', gap: 8, alignItems: 'center', margin: '10px 0 24px', flexWrap: 'wrap' }}>\n        {['mail', 'linkedin', 'instagram', 'discord', 'en personne'].map((c) => (\n          <span key={c} onClick={() => setChannel(c)} style={{ ...glassStyle(t), cursor: 'pointer', opacity: channel === c ? 1 : 0.55, fontWeight: channel === c ? 600 : 400 }}>{c}</span>\n        ))}\n        <span style={{ flex: 1 }} />\n        <Button t={t} primary onClick={send}>Enregistrer le message</Button>\n      </div>\n\n      <SectionTitle t={t} title=\"Historique\" count={events.length} />\n      <div style={{ display: 'grid', gap: 6, marginBottom: 24 }}>\n        {events.map((e, i) => (\n          <div key={i} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n            <span>{e.label}</span>\n          </div>\n        ))}\n        {!events.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Rien encore.</div>}\n      </div>\n\n      <SectionTitle t={t} title=\"Notes\" count=\"\" />\n      <textarea value={notes} onChange={(e) => setNotes(e.target.value)} onBlur={() => { if (notes !== studio.notes) onChange({ ...studio, notes }) }}\n        placeholder=\"Contact, salaire, retour reçu…\"\n        style={{ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, minHeight: 90, resize: 'vertical', outline: 'none', boxSizing: 'border-box' }} />\n    </>\n  )\n}\n\nexport default function FreelanceView({ t }) {\n  const [store, setStore] = useState(null)\n  const [sha, setSha] = useState(null)\n  const [openId, setOpenId] = useState(null)\n  const [query, setQuery] = useState('')\n  const [filter, setFilter] = useState('all')\n  const [form, setForm] = useState({ name: '', role: '', link: '' })\n  const [saving, setSaving] = useState('')\n\n  useEffect(() => { let alive = true\n    readJson(STORE_PATH).then((r) => { if (!alive) return; setSha(r.sha); setStore(normalizeStore(r.data)) }).catch(() => { if (alive) setStore({ v: 2, studios: [] }) })\n    return () => { alive = false }\n  }, [])\n\n  // Read-modify-write: the drive file is the truth, a concurrent tab never loses a message.\n  // FR : lecture-modification-ecriture, un autre onglet ne fait jamais perdre un message.\n  async function persist(nextStudios) {\n    setStore({ v: 2, studios: nextStudios })\n    setSaving('…')\n    const r = await saveJsonWithRetry(STORE_PATH, () => ({ v: 2, studios: nextStudios }), { sha })\n    if (r.ok) { setSha(r.sha); setSaving('enregistré') } else { setSaving('erreur'); notify('Enregistrement impossible', String(r.error || '')) }\n  }\n\n  const studios = store ? store.studios : []\n  const open = studios.find((s) => s.id === openId) || null\n  const shown = useMemo(() => {\n    const list = searchStudios(studios, query)\n    return filter === 'all' ? list : list.filter((s) => s.status === filter)\n  }, [studios, query, filter])\n  const c = counts(studios)\n  const events = useMemo(() => timeline(studios, 24), [studios])\n\n  const addStudio = () => {\n    const s = normalizeStudio({ ...form, createdAt: isoDay(), status: 'to_contact' })\n    if (!s) return\n    setForm({ name: '', role: '', link: '' })\n    persist([s, ...studios])\n  }\n  const updateStudio = (next) => persist(studios.map((s) => (s.id === next.id ? next : s)))\n  const removeStudio = (id) => { if (!window.confirm('Supprimer ce studio et son historique ?')) return; setOpenId(null); persist(studios.filter((s) => s.id !== id)) }\n\n  return (\n    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '6px 2px 60px', color: t.textPrimary }}>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, flexWrap: 'wrap', marginBottom: 6 }}>\n        <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 30, letterSpacing: '-0.02em', margin: 0 }}>ZenRay <span style={{ fontStyle: 'italic' }}>Freelance</span></h1>\n        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>\n          {c.toContact} à contacter · {c.contacted} contactés · {c.answered} réponses · {c.messages} messages\n        </span>\n        <span style={{ marginLeft: 'auto', fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{saving}</span>\n      </div>\n\n      {store === null && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>chargement…</div>}\n\n      {store !== null && open && (\n        <StudioDetail t={t} studio={open} onBack={() => setOpenId(null)} onChange={updateStudio} onDelete={() => removeStudio(open.id)} />\n      )}\n\n      {store !== null && !open && (\n        <>\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', margin: '16px 0 14px' }}>\n            <Field t={t} value={form.name} onChange={(v) => setForm({ ...form, name: v })} placeholder=\"Studio\" onKeyDown={(e) => { if (e.key === 'Enter') addStudio() }} />\n            <Field t={t} value={form.role} onChange={(v) => setForm({ ...form, role: v })} placeholder=\"Poste visé\" width={150} />\n            <Field t={t} value={form.link} onChange={(v) => setForm({ ...form, link: v })} placeholder=\"Site ou offre\" width={200} />\n            <Button t={t} primary onClick={addStudio}>+ studio</Button>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 22 }}>\n            <span onClick={() => setFilter('all')} style={{ ...glassStyle(t), cursor: 'pointer', opacity: filter === 'all' ? 1 : 0.55, fontWeight: filter === 'all' ? 600 : 400 }}>Tous {studios.length}</span>\n            {groupByStatus(studios).map((g) => (\n              <GlassPill key={g.key} t={t} statusKey={g.key} active={filter === g.key} onClick={() => setFilter(filter === g.key ? 'all' : g.key)}>\n                {g.label} {g.items.length}\n              </GlassPill>\n            ))}\n            <span style={{ flex: 1, minWidth: 140 }}>\n              <Field t={t} value={query} onChange={setQuery} placeholder=\"Chercher un studio, un message…\" width={200} />\n            </span>\n          </div>\n\n          {groupByStatus(shown).map((g) => (\n            <div key={g.key} style={{ marginBottom: 26 }}>\n              <SectionTitle t={t} title={g.label} count={g.items.length} />\n              <div style={{ display: 'grid', gridTemplateColumns: P.studioGrid, gap: P.gap }}>\n                {g.items.map((s) => <StudioCard key={s.id} t={t} studio={s} onOpen={() => setOpenId(s.id)} />)}\n              </div>\n            </div>\n          ))}\n\n          {!studios.length && (\n            <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, lineHeight: 1.6 }}>\n              Aucun studio pour l'instant. Ajoute le premier ci-dessus, puis colle le message que tu lui envoies :\n              la date, le texte et chaque changement d'état resteront gardés.\n            </div>\n          )}\n\n          {events.length > 0 && (\n            <div style={{ marginTop: 34 }}>\n              <SectionTitle t={t} title=\"Progression\" count={events.length} />\n              <div style={{ display: 'grid', gap: 6 }}>\n                {events.map((e, i) => (\n                  <div key={i} onClick={() => setOpenId(e.id)} style={{ display: 'flex', gap: 10, alignItems: 'baseline', cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n                    <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n                    <span style={{ color: t.textPrimary }}>{e.studio}</span>\n                    <span>{e.label}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </>\n      )}\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6017,"cache_read_input_tokens":647481,"output_tokens":8530,"output_tokens_details":{"thinking_tokens":504},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6017,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":8530,"cache_read_input_tokens":647481,"cache_creation_input_tokens":6017,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6017},"type":"message"}],"speed":"standard"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_015NWB73BoTABGGeUeYBpvYW":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/components/FreelanceView.jsx","content":"// ZENRAY FREELANCE v2 (2026-09-12).\n//\n// A dashboard of studios: the ones still to contact, the ones already contacted with the exact\n// message that was sent, and a dated trail of every change, so the progress survives the months.\n// The look follows ZenRay Assets: one column, serif titles, cards, and a liquid glass pill for the\n// state. Storage is the drive file `freelance/applications.json`, written through the\n// read-modify-write helper so two tabs never lose a message.\n//\n// FR : le tableau de bord des studios, ceux a contacter et ceux deja contactes, avec le message\n// exact envoye et la trace datee de chaque changement. Meme esthetique que ZenRay Assets, meme\n// fichier de stockage qu'avant, ecrit sans jamais ecraser une modification concurrente.\nimport React, { useEffect, useMemo, useState } from 'react'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { DOT } from '../config/colors.js'\nimport { notify } from './Notifications.jsx'\nimport {\n  STATUSES, normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage,\n  groupByStatus, counts, timeline, searchStudios, readableDate, statusLabel, statusColor, isoDay,\n} from '../lib/freelanceStudios.js'\n\nconst STORE_PATH = 'freelance/applications.json'\n\n// The parameter interface of the page: every value judged by eye lives here and nowhere else.\n// FR : l'interface de parametres de la page, toute valeur jugee a l'oeil vit ici.\nconst P = {\n  serif: 'var(--zr-police-serif)',\n  sans: 'var(--zr-police-sans)',\n  mono: 'var(--zr-police-mono)',\n  serifWeight: 350,\n  numberWeight: 400,\n  column: 1240,\n  studioGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',\n  radius: 8,\n  cardPadding: '16px 18px',\n  gap: 14,\n  messageLines: 3,\n}\n\nconst glassStyle = (t, color) => ({\n  display: 'inline-flex', alignItems: 'center', gap: DOT.gap,\n  padding: '4px 11px', borderRadius: 999,\n  background: (t.glass && t.glass.bg) || t.surface,\n  backdropFilter: (t.glass && t.glass.filter) || 'none',\n  WebkitBackdropFilter: (t.glass && t.glass.filter) || 'none',\n  boxShadow: (t.glass && t.glass.edge) || 'none',\n  border: `1px solid ${t.border}`,\n  color: t.textPrimary, fontFamily: P.sans, fontSize: 12.5, whiteSpace: 'nowrap',\n  ...(color ? { borderColor: color + '55' } : null),\n})\n\nfunction Dot({ color }) {\n  return <span aria-hidden=\"true\" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />\n}\n\n/** The liquid glass pill: the state of one studio, readable in one glance. */\nfunction GlassPill({ t, statusKey, children, onClick, active }) {\n  const color = statusColor(statusKey)\n  return (\n    <span onClick={onClick} style={{ ...glassStyle(t, color), cursor: onClick ? 'pointer' : 'default', opacity: active === false ? 0.55 : 1, fontWeight: active ? 600 : 400 }}>\n      <Dot color={color} />{children || statusLabel(statusKey)}\n    </span>\n  )\n}\n\nfunction Field({ t, value, onChange, placeholder, width = 180, onKeyDown }) {\n  return (\n    <input value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} onKeyDown={onKeyDown}\n      style={{ flex: `1 1 ${width}px`, minWidth: 120, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 12px', fontFamily: P.sans, fontSize: 13.5, outline: 'none' }} />\n  )\n}\n\nfunction Button({ t, onClick, children, primary }) {\n  return (\n    <button onClick={onClick} style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 15px', cursor: 'pointer', fontFamily: P.sans, fontSize: 13.5 }}>{children}</button>\n  )\n}\n\nfunction SectionTitle({ t, title, count }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>\n      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{count}</span>\n      <span style={{ flex: 1, height: 1, background: t.border }} />\n    </div>\n  )\n}\n\n/** One studio card: name, role, state pill, and the beginning of the last message sent. */\nfunction StudioCard({ t, studio, onOpen }) {\n  const msg = lastMessage(studio)\n  return (\n    <button type=\"button\" onClick={onOpen} title={studio.name}\n      style={{ display: 'flex', flexDirection: 'column', gap: 8, textAlign: 'left', padding: P.cardPadding, border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, color: 'inherit', cursor: 'pointer', minWidth: 0 }}>\n      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>\n        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>\n        <span style={{ marginLeft: 'auto' }}><GlassPill t={t} statusKey={studio.status} /></span>\n      </span>\n      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ') || 'poste à préciser'}\n      </span>\n      <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary }}>\n        {studio.contactedAt ? `contacté le ${readableDate(studio.contactedAt)}` : 'jamais contacté'}\n        {studio.messages.length ? ` · ${studio.messages.length} message${studio.messages.length > 1 ? 's' : ''}` : ''}\n      </span>\n      {msg && (\n        <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary, display: '-webkit-box', WebkitLineClamp: P.messageLines, WebkitBoxOrient: 'vertical', overflow: 'hidden', lineHeight: 1.45 }}>{msg.text}</span>\n      )}\n    </button>\n  )\n}\n\n/** One studio, opened in place: its messages, its dated history, its notes. */\nfunction StudioDetail({ t, studio, onBack, onChange, onDelete }) {\n  const [draft, setDraft] = useState('')\n  const [channel, setChannel] = useState('mail')\n  const [notes, setNotes] = useState(studio.notes)\n  useEffect(() => { setNotes(studio.notes) }, [studio.id])\n\n  const send = () => {\n    if (!draft.trim()) return\n    onChange(addMessage(studio, { text: draft, channel }))\n    setDraft('')\n    notify('Message enregistré', 'Le texte exact est gardé avec sa date.')\n  }\n  const copy = (text) => { try { navigator.clipboard.writeText(text) } catch {} notify('Message copié', 'Collé tel quel, prêt à envoyer.') }\n\n  const events = timeline([studio], 40)\n  return (\n    <>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 18, flexWrap: 'wrap' }}>\n        <button type=\"button\" onClick={onBack} style={{ background: 'none', border: 'none', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les studios</button>\n        <span style={{ flex: 1 }} />\n        {studio.link && <a href={studio.link} target=\"_blank\" rel=\"noreferrer\" style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>site ou offre ↗</a>}\n        <button type=\"button\" onClick={onDelete} style={{ background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>supprimer</button>\n      </div>\n\n      <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: '0 0 6px' }}>{studio.name}</h2>\n      <div style={{ fontFamily: P.sans, fontSize: 13.5, color: t.textSecondary, marginBottom: 16 }}>\n        {[studio.role, studio.city].filter(Boolean).join(' · ')}\n        {studio.contactedAt ? `${studio.role || studio.city ? ' · ' : ''}premier contact le ${readableDate(studio.contactedAt)}` : ''}\n      </div>\n\n      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 22 }}>\n        {STATUSES.map((s) => (\n          <GlassPill key={s.key} t={t} statusKey={s.key} active={studio.status === s.key}\n            onClick={() => onChange(setStatus(studio, s.key))} />\n        ))}\n      </div>\n\n      <SectionTitle t={t} title=\"Messages envoyés\" count={studio.messages.length} />\n      <div style={{ display: 'grid', gap: 10, marginBottom: 18 }}>\n        {studio.messages.slice().reverse().map((m, i) => (\n          <div key={`${m.at}-${i}`} style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding }}>\n            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, marginBottom: 6 }}>\n              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{readableDate(m.at)}</span>\n              <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{m.channel}</span>\n              <button type=\"button\" onClick={() => copy(m.text)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12 }}>copier</button>\n            </div>\n            <div style={{ fontFamily: P.sans, fontSize: 13, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{m.text}</div>\n          </div>\n        ))}\n        {!studio.messages.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Aucun message pour l'instant. Colle ci-dessous celui que tu envoies, il sera gardé avec sa date.</div>}\n      </div>\n\n      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} placeholder=\"Le message envoyé, collé tel quel…\"\n        style={{ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, minHeight: 120, resize: 'vertical', outline: 'none', boxSizing: 'border-box' }} />\n      <div style={{ display: 'flex', gap: 8, alignItems: 'center', margin: '10px 0 24px', flexWrap: 'wrap' }}>\n        {['mail', 'linkedin', 'instagram', 'discord', 'en personne'].map((c) => (\n          <span key={c} onClick={() => setChannel(c)} style={{ ...glassStyle(t), cursor: 'pointer', opacity: channel === c ? 1 : 0.55, fontWeight: channel === c ? 600 : 400 }}>{c}</span>\n        ))}\n        <span style={{ flex: 1 }} />\n        <Button t={t} primary onClick={send}>Enregistrer le message</Button>\n      </div>\n\n      <SectionTitle t={t} title=\"Historique\" count={events.length} />\n      <div style={{ display: 'grid', gap: 6, marginBottom: 24 }}>\n        {events.map((e, i) => (\n          <div key={i} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>\n            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, minWidth: 128 }}>{readableDate(e.at)}</span>\n            <span>{e.label}</span>\n          </div>\n        ))}\n        {!events.length && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Rien encore.</div>}\n      </div>\n\n      <SectionTitle t={t} title=\"Notes\" count=\"\" />\n      <textarea value={notes} onChange={(e) => setNotes(e.target.value)} onBlur={() => { if (notes !== studio.notes) onChange({ ...studio, notes }) }}\n        placeholder=\"Contact, salaire, retour reçu…\"\n        style={{ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, minHeight: 90, resize: 'vertical', outline: 'none', boxSizing: 'border-box' }} />\n    </>\n  )\n}\n\nexport default function FreelanceView({ t }) {\n  const [store, setStore] = useState(null)\n  const [sha, setSha] = useState(null)\n  const [openId, setOpenId] = useState(null)\n  const [query, setQuery] = useState('')\n  const [filter, setFilter] = useState('all')\n  const [form, setForm] = useState({ name: '', role: '', link: '' })\n  const [saving, setSaving] = useState('')\n\n  useEffect(() => { let alive = true\n    readJson(STORE_PATH).then((r) => { if (!alive) return; setSha(r.sha); setStore(normalizeStore(r.data)) }).catch(() => { if (alive) setStore({ v: 2, studios: [] }) })\n    return () => { alive = false }\n  }, [])\n\n  // Read-modify-write: the drive file is the truth, a concurrent tab never loses a message.\n  // FR : lecture-modification-ecriture, un autre onglet ne fait jamais perdre un message.\n  async function persist(nextStudios) {\n    setStore({ v: 2, studios: nextStudios })\n    setSaving('…')\n    const r = await saveJsonWithRetry(STORE_PATH, () => ({ v: 2, studios: nextStudios }), { sha })\n    if (r.ok) { setSha(r.sha); setSaving('enregistré') } else { setSaving('erreur'); notify('Enregistrement impossible', String(r.error || '')) }\n  }\n\n  const studios = store ? store.studios : []\n  const open = studios.find((s) => s.id === openId) || null\n  const shown = useMemo(() => {\n    const list = searchStudios(studios, query)\n    return filter === 'all' ? list : list.filter((s) => s.status === filter)\n  }, [studios, query, filter])\n  const c = counts(studios)\n  const events = useMemo(() => timeline(studios, 24), [studios])\n\n  const addStudio = () => {\n    const s = normalizeStudio({ ...form, createdAt: isoDay(), status: 'to_contact' })\n    if (!s) return\n    setForm({ name: '', role: '', link: '' })\n    persist([s, ...studios])\n  }\n  const updateStudio = (next) => persist(studios.map((s) => (s.id === next.id ? next : s)))\n  const removeStudio = (id) => { if (!window.confirm('Supprimer ce studio et son historique ?')) return; setOpenId(null); persist(studios.filter((s) => s.id !== id)) }\n\n  return (\n    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '6px 2px 60px', color: t.textPrimary }}>\n      <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, flexWrap: 'wrap', marginBottom: 6 }}>\n        <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 30, letterSpacing: '-0.02em', margin: 0 }}>ZenRay <span style={{ fontStyle: 'italic' }}>Freelance</span></h1>\n        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>\n          {c.toContact} à contacter · {c.contacted} contactés · {c.answered} réponses · {c.messages} messages\n        </span>\n        <span style={{ marginLeft: 'auto', fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{saving}</span>\n      </div>\n\n      {store === null && <div style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>chargement…</div>}\n\n      {store !== null && open && (\n        <StudioDetail t={t} studio={open} onBack={() => setOpenId(null)} onChange={updateStudio} onDelete={() => removeStudio(open.id)} />\n      )}\n\n      {store !== null && !open && (\n        <>\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', margin: '16px 0 14px' }}>\n            <Field t={t} value={form.name} onChange={(v) => setForm({ ...form, name: v })} placeholder=\"Studio\" onKeyDown={(e) => { if (e.key === 'Enter') addStudio() }} />\n            <Field t={t} value={form.role} onChange={(v) => setForm({ ...form, role: v })} placeholder=\"Poste visé\" width={150} />\n            <Field t={t} value={form.link} onChange={(v) => setForm({ ...form, link: v })} placeholder=\"Site ou offre\" width={200} />\n            <Button t={t} primary onClick={addStudio}>+ studio</Button>\n          </div>\n\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 22 }}>\n            <span onClick={() => setFilter('all')} style={{ ...glassStyle(t), cursor: 'pointer', opacity: filter === 'all' ? 1 : 0.55, fontWeight: filter === 'all' ? 600 : 400 }}>Tous {studios.length}</span>\n            {groupByStatus(studios).map((g) => (\n              <GlassPill key={g.key} t={t} statusKey={g.key} active={filter === g.key} onClick={() => setFilter(filter === g.key ? 'all' : g.key)}>\n                {g.label} {g.items.length}\n              </GlassPill>\n            ))}\n            <span style={{ flex: 1, minWidth: 140 }}>\n              <Field t={t} value={query} onChange={setQuery} placeholder=\"Chercher un studio, un message…\"