turn json.loads(path.read_text())\n47\t    except Exception:\n48\t        return {'project': d.name.replace('-captures', ''), 'captures': []}\n49\t\n50\t\n51\tdef write_index(d, index):\n52\t    (d / INDEX_NAME).write_text(json.dumps(index, indent=1, ensure_ascii=False))\n53\t\n54\t\n55\tdef digest(path):\n56\t    h = hashlib.sha256()\n57\t    with Path(path).open('rb') as f:\n58\t        for chunk in iter(lambda: f.read(1 << 20), b''):\n59\t            h.update(chunk)\n60\t    return h.hexdigest()\n61\t\n62\t\n63\tdef to_jpeg(src, dst):\n64\t    \"\"\"Convert with Pillow when available, fall back to macOS sips, never silently skip.\"\"\"\n65\t    try:\n66\t        from PIL import Image\n67\t        im = Image.open(src)\n68\t        im = im.convert('RGB') if im.mode not in ('RGB', 'L') else im\n69\t        w, h = im.size\n70\t        if max(w, h) > MAX_SIDE:\n71\t            scale = MAX_SIDE / float(max(w, h))\n72\t            im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))))\n73\t        im.save(dst, 'JPEG', quality=QUALITY, optimize=True)\n74\t        return im.size\n75\t    except ImportError:\n76\t        subprocess.run(['sips', '-s', 'format', 'jpeg', '-Z', str(MAX_SIDE), str(src), '--out', str(dst)],\n77\t                       check=True, capture_output=True)\n78\t        out = subprocess.run(['sips', '-g', 'pixelWidth', '-g', 'pixelHeight', str(dst)],\n79\t                             check=True, capture_output=True, text=True).stdout\n80\t        nums = [int(x.split(':')[1]) for x in out.strip().splitlines() if ':' in x and x.split(':')[1].strip().isdigit()]\n81\t        return tuple(nums[:2]) if len(nums) >= 2 else (0, 0)\n82\t\n83\t\n84\tdef add(project, label, images, note=''):\n85\t    d = project_dir(project)\n86\t    index = read_index(d)\n87\t    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')\n88\t    added = []\n89\t    for i, src in enumerate(images, 1):\n90\t        src = Path(src).expanduser()\n91\t        if not src.exists():\n92\t            raise SystemExit(f'capture introuvable : {src}')\n93\t        name = f'{stamp}-{i:02d}-{slug(label)}.jpg'\n94\t        dst = d / name\n95\t        size = to_jpeg(src, dst)\n96\t        entry = {'file': name, 'at': datetime.now().isoformat(timespec='seconds'), 'label': label,\n97\t                 'source': str(src), 'width': size[0], 'height': size[1],\n98\t                 'bytes': dst.stat().st_size, 'sha256': digest(dst)[:16], 'note': note}\n99\t        index['captures'].append(entry)\n100\t        added.append(entry)\n101\t    write_index(d, index)\n102\t    print(json.dumps({'dir': str(d), 'added': added, 'total': len(index['captures'])}, indent=1, ensure_ascii=False))\n103\t\n104\t\n105\tdef show(project):\n106\t    d = project_dir(project)\n107\t    index = read_index(d)\n108\t    for c in index['captures']:\n109\t        print(f\"{c['at']}  {c['width']}x{c['height']:<6} {c['file']:<44} {c['label']}\")\n110\t    print(f\"{len(index['captures'])} capture(s) dans {d}\")\n111\t\n112\t\n113\tdef main():\n114\t    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n115\t    sub = p.add_subparsers(dest='mode', required=True)\n116\t    a = sub.add_parser('add'); a.add_argument('project'); a.add_argument('label'); a.add_argument('images', nargs='+'); a.add_argument('--note', default='')\n117\t    l = sub.add_parser('list'); l.add_argument('project')\n118\t    args = p.parse_args()\n119\t    if args.mode == 'add':\n120\t        add(args.project, args.label, args.images, args.note)\n121\t    else:\n122\t        show(args.project)\n123\t\n124\t\n125\tif __name__ == '__main__':\n126\t    main()"},"type":"attachment","uuid":"b2df573f-3021-48d9-9b8e-f868eba8b7d1","timestamp":"2026-09-12T13:01:17.159Z","rendered":[{"content":"<system-reminder>\nNote: /Users/zenray/.claude/skills/zenray-houdini/scripts/capture_archive.py changed on disk since you last read it. That's usually deliberate, so take it as the curr