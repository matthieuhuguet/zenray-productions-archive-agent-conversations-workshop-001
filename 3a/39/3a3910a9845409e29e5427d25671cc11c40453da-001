rt|contrat|contract|\\bCV\\b|casanova|scam|facture|imp[oô]t|carte.?vitale|relev[eé]', e['name'], re.I)),\n    ('deja dans ZenRay Assets', 'purge proposee apres verification du drive',\n     lambda e: e['archived'] and not e['changed_after_upload']),\n    ('deja dans ZenRay Assets, modifie depuis', 'renvoyer la difference, puis purge',\n     lambda e: e['archived'] and e['changed_after_upload']),\n    ('logiciel', 'reste en local, intouche',\n     lambda e: re.search(r'\\.(dmg|pkg|rar|torrent|exe)$|fitgirl|repack|monter group|nmac|\\brune\\b|patcher|gstreamer', e['name'], re.I)),\n    ('film ou serie', 'reste en local, intouche',\n     lambda e: re.search(r'S\\d\\dE\\d\\d|\\b(1080p|2160p|720p|bluray|web-?dl|webrip|x26[45]|hevc|av1)\\b|\\(\\d{4}\\)', e['name'], re.I)\n     or (e['ext'] in VIDEO and e['bytes'] >= BIG_VIDEO) or e['name'] in ('subs', 'House of the Dragon')\n     or re.search(r'\\.(srt|ass)$', e['name'], re.I)),\n    ('musique du commerce', 'reste en local, intouche',\n     lambda e: re.search(r'soundtrack|\\bost\\b|\\[mp3\\]|24-48|apple system sounds', e['name'], re.I)),\n    ('doublon d une archive extraite', 'garder le dossier, le zip est a valider',\n     lambda e: e['name'].lower().endswith('.zip') and e['zip_has_folder']),\n    ('livre', 'reste en local',\n     lambda e: re.search(r'\\.(pdf|epub)$', e['name'], re.I) and ' - ' in e['name']),\n    ('chantier en cours', 'deplacer dans ~/.claude/tmp',\n     lambda e: e['is_chantier'] and e['age_days'] <= ACTIVE_DAYS),\n    ('chantier fini', 'envoyer dans ZenRay Assets, projet date',\n     lambda e: e['is_chantier']),\n    ('code ou skill telecharge', 'reste en local, a valider',\n     lambda e: re.search(r'-main(\\.zip)?$|\\.skill$|^SKILL|skills|^claude(\\.html|_files)$|^Inter_Tight', e['name'], re.I)),\n    ('photo ou video perso', 'envoyer dans ZenRay Assets, classee par date',\n     lambda e: e['kind'] == 'file' and (e['ext'] in IMAGE or (e['ext'] in VIDEO and e['bytes'] < BIG_VIDEO))),\n    ('audio perso', 'envoyer dans ZenRay Assets, classe par date',\n     lambda e: e['kind'] == 'file' and e['ext'] in {'.wav', '.m4a', '.mp3', '.aiff'}),\n    ('document', 'Memory1 ou ZenRay Assets selon le sujet, a valider',\n     lambda e: e['kind'] == 'file' and e['ext'] in {'.md', '.html', '.pdf', '.txt', '.obj'}),\n]\nCHANTIER_RE = re.compile(r'^(tmp|temp)[-_ ]|^temp ?post|^post-|-post\\d|^zenray-post|^clip-cowork|^subtitle_compare|^greg-guillotin|^Temp(Items|Japonais)|^meiji-jingu|^streets-jogasaki', re.I)\n\n\ndef french(ts):\n    t = time.localtime(ts)\n    return f'{t.tm_mday} {MONTHS[t.tm_mon - 1]} {t.tm_year}'\n\n\ndef plan_sources():\n    out = []\n    for f in PLANS_DIR.glob('*.json'):\n        plan = json.loads(f.read_text())\n        for s in plan.get('sources', []):\n            paths = s.get('files') or [s['localPath']]\n            for p in paths:\n                out.append((os.path.realpath(p), plan['id'], f.stat().st_mtime))\n    return out\n\n\ndef measure(path):\n    if not os.path.isdir(path) or os.path.islink(path):\n        st = os.lstat(path)\n        return st.st_size, 1, st.st_mtime\n    size = count = 0\n    newest = os.lstat(path).st_mtime\n    for dirpath, dirs, files in os.walk(path):\n        for n in files:\n            try:\n                st = os.lstat(os.path.join(dirpath, n))\n            except OSError:\n                continue\n            size += st.st_size\n            count += 1\n            newest = max(newest, st.st_mtime)\n    return size, count, newest\n\n\ndef describe(entry, sources, names, now):\n    path = entry.path\n    size, count, newest = measure(path)\n    real = os.path.realpath(path)\n    hit = [s for s in sources if s[0] == real or s[0].startswith(real + os.sep)]\n    name = entry.name\n    return {\n        'name': name, 'path': path, 'kind': 'dir' if entry.is_dir(follow_symlinks=False) else 'file',\n        'ext': os.path.splitext(name)[1].lower(), 'bytes': size, 'files': count,\n        'newest': newest, 'newest_fr': french(newest), 'age_days': round((now - newest) / 86400, 1),\n        'archived': [h[1] for h in hit][:1], 'changed_after_upload': bool(hit) and newest > max(h[2] for h in hit),\n        'is_chantier': bool(CHANTIER_RE.search(name)),\n        'zip_has_folder': name.lower().endswith('.zip') and name[:-4] in names,\n    }\n\n\ndef classify(e):\n    for category, action, test in RULES:\n        try:\n            if test(e):\n                return category, action\n        except Exception:\n            continue\n    return 'a inspecter', 'regarder le contenu avant toute decision'\n\n\ndef human(n):\n    for unit, div in (('Go', 1024 ** 3), ('Mo', 1024 ** 2), ('Ko', 1024)):\n        if n >= div:\n            return f'{n / div:.1f} {unit}'.replace('.', ',')\n    return f'{n} o'\n\n\ndef main():\n    root, out_dir = Path(sys.argv[1]).expanduser(), Path(sys.argv[2]).expanduser()\n    out_dir.mkdir(parents=True, exist_ok=True)\n    entries = [e for e in os.scandir(root) if not e.name.startswith('.')]\n    names = {e.name for e in entries}\n    sources, now = plan_sources(), time.time()\n    with ThreadPoolExecutor(max_workers=16) as pool:\n        rows = list(pool.map(lambda e: describe(e, sources, names, now), entries))\n    for r in rows:\n        r['category'], r['action'] = classify(r)\n    rows.sort(key=lambda r: (r['category'], -r['bytes']))\n    (out_dir / 'scan.json').write_text(json.dumps(rows, indent=1, ensure_ascii=False))\n\n    totals = {}\n    for r in rows:\n        t = totals.setdefault(r['category'], {'entries': 0, 'bytes': 0, 'action': r['action']})\n        t['entries'] += 1\n        t['bytes'] += r['bytes']\n    lines = [f'# Table zenray-collect de {root}', '', f'Scan du {french(now)}, {len(rows)} entrées, {human(sum(r[\"bytes\"] for r in rows))}. Lecture seule.', '',\n             '## Par catégorie', '', '| Catégorie | Entrées | Poids | Action proposée |', '|---|---|---|---|']\n    for c, t in sorted(totals.items(), key=lambda kv: -kv[1]['bytes']):\n        lines.append(f'| {c} | {t[\"entries\"]} | {human(t[\"bytes\"])} | {t[\"action\"]} |')\n    current = None\n    for r in rows:\n        if r['category'] != current:\n            current = r['category']\n            lines += ['', f'## {current}', '', '| Entrée | Poids | Fichiers | Dernière modification |', '|---|---|---|---|']\n        lines.append(f'| `{r[\"name\"]}` | {human(r[\"bytes\"])} | {r[\"files\"]} | {r[\"newest_fr\"]} |')\n    (out_dir / 'table.md').write_text('\\n'.join(lines) + '\\n')\n    print(json.dumps({c: {'entries': t['entries'], 'size': human(t['bytes'])} for c, t in sorted(totals.items(), key=lambda kv: -kv[1]['bytes'])}, indent=1, ensure_ascii=False))\n\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"490eeca0-7c73-43f1-87f7-5027f958fdc9","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/.claude/Memory1","sessionId":"60d4fc84-ff82-40eb-a470-9dd232cfd5ff","version":"2.1.266","gitBranch":"main","slug":"swift-kindling-moth"}
