{"parentUuid":"358ac492-0603-4ffe-a47e-fac493152790","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011Cf3DGMDrzjwCwMYzP5iX1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q5UmF8vwJHkY5Bn2BjhpWh","name":"Write","input":{"file_path":"/Users/zenray/.claude/skills/zenray-collect/scripts/build_move_plan.py","content":"#!/usr/bin/env python3\n\"\"\"zenray-collect step 5 for local moves: turn a classified folder into a gear plan, never touching the disk.\n\n2026-09-14. Every visible entry of the source folder gets one destination, read from DESTINATIONS by its\ncategory, or from OVERRIDES by its name. Containers listed in SPLIT are opened one level and their children\nare routed one by one. Entries in HOLD, entries with an open file inside, and entries whose destination is\nalready taken are kept in place and listed, never forced.\nFR : chaque entrée reçoit une destination, par sa catégorie ou par une exception nommée. Ce qui est tenu,\nouvert par un programme ou en collision reste en place et part dans la liste d'attente.\n\nUsage: python3 build_move_plan.py <routing.json> <out_dir>\n\"\"\"\nimport importlib.util, json, os, re, subprocess, sys, time\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nspec = importlib.util.spec_from_file_location('scan_classify', HERE / 'scan_classify.py')\nsc = importlib.util.module_from_spec(spec); spec.loader.exec_module(sc)\n\n\ndef expand(p):\n    return os.path.expanduser(p)\n\n\ndef open_paths():\n    out = subprocess.run(['lsof', '-nP', '-Fn'], capture_output=True, text=True).stdout\n    return [l[1:] for l in out.splitlines() if l.startswith('n/')]\n\n\ndef route(entry_row, cfg):\n    \"\"\"Destination directory for one classified entry, or None when nothing explains it.\"\"\"\n    for rule in cfg['overrides']:\n        if re.search(rule['match'], entry_row['name'], re.I) and (rule.get('min_bytes', 0) <= entry_row['bytes']):\n            return rule['dest'], 'exception : ' + rule['match']\n    dest = cfg['destinations'].get(entry_row['category'])\n    return (dest, 'catégorie : ' + entry_row['category']) if dest else (None, 'aucune destination')\n\n\ndef main():\n    cfg = json.load(open(sys.argv[1]))\n    out_dir = Path(expand(sys.argv[2])); out_dir.mkdir(parents=True, exist_ok=True)\n    root = expand(cfg['root'])\n    sources, now = sc.plan_sources(), time.time()\n    opened = open_paths()\n    hold = set(cfg['hold'])\n\n    def children(folder):\n        ents = [e for e in os.scandir(folder) if not e.name.startswith('.')]\n        names = {e.name for e in ents}\n        rows = [sc.describe(e, sources, names, now) for e in ents]\n        for r in rows:\n            r['category'], _ = sc.classify(r)\n        return rows\n\n    todo, waiting, containers = [], [], []\n    stack = [(root, children(root))]\n    while stack:\n        folder, rows = stack.pop()\n        for r in rows:\n            rel = os.path.relpath(r['path'], root)\n            if rel in cfg['split']:\n                containers.append(r['path'])\n                stack.append((r['path'], children(r['path'])))\n                continue\n            if rel in hold or r['name'] in hold:\n                waiting.append((rel, 'tenu : ' + cfg['hold'].get(rel, cfg['hold'].get(r['name'], ''))))\n                continue\n            busy = [p for p in opened if p == r['path'] or p.startswith(r['path'] + '/')]\n            if busy:\n                waiting.append((rel, 'ouvert par un programme : ' + busy[0][len(root) + 1:]))\n                continue\n            dest, why = route(r, cfg)\n            if not dest:\n                waiting.append((rel, why))\n                continue\n            todo.append({'src': r['path'], 'dest_dir': expand(dest), 'why': why, 'bytes': r['bytes'], 'files': r['files'], 'rel': rel})\n\n    # Destinations: never overwrite, never let two sources claim one name.\n    # FR : jamais d'écrasement, jamais deux sources sur un même nom.\n    claimed, ops = set(), []\n    for t in sorted(todo, key=lambda t: t['rel']):\n        name = os.path.basename(t['src'])\n        dst = os.path.join(t['dest_dir'], name)\n        if dst.lower() in claimed or os.path.lexists(dst):\n            parent = os.path.basename(os.path.dirname(t['src']))\n            stem, ext = os.path.splitext(name) if os.path.isfile(t['src']) else (name, '')\n            dst = os.path.join(t['dest_dir'], f'{stem} (depuis {parent}){ext}')\n            if dst.lower() in claimed or os.path.lexists(dst):\n                waiting.append((t['rel'], 'collision de nom à la destination'))\n                continue\n        claimed.add(dst.lower())\n        ops.append({'op': 'move', 'src': t['src'], 'dst': dst, 'why': t['why'], 'bytes': t['bytes'], 'files': t['files']})\n\n    plan = {'mode': 'zenray-collect-move', 'root': root, 'ops': ops}\n    (out_dir / 'move-plan.json').write_text(json.dumps(plan, indent=1, ensure_ascii=False))\n    (out_dir / 'waiting.json').write_text(json.dumps(waiting, indent=1, ensure_ascii=False))\n    (out_dir / 'containers.json').write_text(json.dumps(containers, indent=1, ensure_ascii=False))\n    by_dest = {}\n    for o in ops:\n        d = by_dest.setdefault(os.path.dirname(o['dst']), [0, 0, 0]); d[0] += 1; d[1] += o['files']; d[2] += o['bytes']\n    print(json.dumps({'operations': len(ops), 'files': sum(o['files'] for o in ops), 'bytes': sum(o['bytes'] for o in ops),\n                      'by_destination': {k.replace(os.path.expanduser('~'), '~'): {'entries': v[0], 'files': v[1], 'size': sc.human(v[2])} for k, v in sorted(by_dest.items())},\n                      'waiting': waiting}, indent=1, ensure_ascii=False))\n\n\nif __name__ == '__main__':\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2061,"cache_read_input_tokens":387034,"output_tokens":10665,"output_tokens_details":{"thi