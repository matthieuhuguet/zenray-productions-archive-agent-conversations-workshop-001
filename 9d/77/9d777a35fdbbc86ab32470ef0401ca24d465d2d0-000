teurs_total\": len(acteurs),\n        \"par_classe\": dict(sorted(par_classe.items(), key=lambda kv: -kv[1])),\n    }\n\n    t = time.time()\n    cible = os.path.join(sortie, \"capture.png\")\n    try:\n        unreal.AutomationLibrary.take_high_res_screenshot(\n            PARAMS[\"capture_largeur\"], PARAMS[\"capture_hauteur\"], cible\n        )\n        rapport[\"capture\"] = {\"demandee\": True, \"chemin\": cible}\n    except Exception as erreur:\n        rapport[\"capture\"] = {\"demandee\": False, \"erreur\": str(erreur)}\n    rapport[\"etapes\"][\"capture_s\"] = round(time.time() - t, 2)\n\n    rapport[\"total_script_s\"] = round(time.time() - debut, 2)\n\n    chemin_rapport = os.path.join(sortie, PARAMS[\"nom_rapport\"])\n    with open(chemin_rapport, \"w\") as f:\n        json.dump(rapport, f, indent=2, ensure_ascii=False)\n\n    unreal.log(\"PROBE_JSON_DEBUT\")\n    unreal.log(json.dumps(rapport, ensure_ascii=False))\n    unreal.log(\"PROBE_JSON_FIN\")\n\n\nmain()\n","userModified":false},"sourceToolAssistantUUID":"ddb98e4f-8489-4306-b021-8f7b34d21da8","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"dbce3bc3-3df4-4de3-afd5-4a37d6421f19","version":"2.1.229","gitBranch":"main"}
