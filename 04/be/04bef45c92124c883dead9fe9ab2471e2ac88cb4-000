e microphone. Requires macOS microphone permission for the terminal.\"\"\"\n137\t    subprocess.run(\n138\t        [\"ffmpeg\", \"-nostdin\", \"-loglevel\", \"error\", \"-y\",\n139\t         \"-f\", \"avfoundation\", \"-i\", PARAMS[\"mic_device\"],\n140\t         \"-t\", str(seconds), \"-ar\", str(PARAMS[\"sample_rate\"]), \"-ac\", \"1\", str(dst)],\n141\t        check=True,\n142\t    )\n143\t    return dst\n144\t\n145\t\n146\t# ---- Commands ----\n147\t\n148\tdef cmd_check(_args) -> int:\n149\t    \"\"\"Verify the chain BOTH ways: a right answer must pass, a wrong one must fail.\n150\t    FR : verifie la chaine dans les deux sens, un vrai doit passer, un faux doit echouer.\"\"\"\n151\t    print(\"1. voix + transcription\")\n152\t    with tempfile.TemporaryDirectory() as tmp:\n153\t        aiff, wav = Path(tmp) / \"p.aiff\", Path(tmp) / \"p.wav\"\n154\t        target = \"日本語が少し話せます\"\n155\t        speak(target, out=aiff)\n156\t        heard = transcribe(to_wav(aiff, wav))\n157\t    print(f\"   dit    : {target}\\n   entendu: {heard}\")\n158\t\n159\t    print(\"2. le vrai doit passer\")\n160\t    good = score(target, heard)\n161\t    print(f\"   {good['ratio']} {good['verdict']}\")\n162\t\n163\t    print(\"3. le faux doit echouer\")\n164\t    bad = score(target, \"ビールを三つください\")\n165\t    print(f\"   {bad['ratio']} {bad['verdict']}\")\n166\t\n167\t    print(\"4. graphies differentes, meme son\")\n168\t    same = score(\"今日はいい天気ですね\", \"きょうはいい天気ですね\")\n169\t    print(f\"   {same['ratio']} {same['verdict']}\")\n170\t\n171\t    ok = good[\"verdict\"] == \"OK\" and bad[\"verdict\"] == \"RATE\" and same[\"verdict\"] == \"OK\"\n172\t    print(\"\\nVERIFICATEUR VALIDE\" if ok else \"\\nVERIFICATEUR INVALIDE\")\n173\t    return 0 if ok else 1\n174\t\n175\t\n176\tdef cmd_say(args) -> int:\n177\t    speak(args.text, voice=args.voice, rate=args.rate)\n178\t    return 0\n179\t\n180\t\n181\tdef cmd_score(args) -> int:\n182\t    print(json.dumps(score(args.target, args.heard), ensu