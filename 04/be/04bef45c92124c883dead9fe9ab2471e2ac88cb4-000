{"parentUuid":"49f36ead-37cb-41d6-9227-047d39162f80","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Memory/Japanese/skills/lesson-card-html/generate_lesson_card.py","snippet":"1\t#!/usr/bin/env python3\n2\t\"\"\"Génère une fiche de leçon HTML auto-suffisante, mobile-first (portrait-safe).\n3\t\n4\tProblème résolu : les grands tableaux markdown (16-64 mots) débordent en\n5\tportrait sur mobile — lisibles seulement en paysage. Cette fiche remplace le\n6\ttableau large par des LIGNES qui s'enroulent (flex-wrap), regroupées en\n7\tsections repliables natives (<details>, sans JS), imprimables en PDF\n8\t(Fichier > Partager > Imprimer sur iPhone/Safari).\n9\t\n10\tUsage:\n11\t    python3 generate_lesson_card.py spec.json\n12\t\n13\tVoir SKILL.md pour le format du spec JSON. Aucune dépendance externe\n14\t(stdlib only), même esprit que kanji-stroke-order-html/generate_kanji_card.py.\n15\t\"\"\"\n16\timport json, os, sys, re, math, urllib.request\n17\t\n18\t_HERE = os.path.dirname(os.path.abspath(__file__))\n19\t_DEFAULT_OUTDIR = os.path.normpath(os.path.join(_HERE, \"..\", \"..\", \"LessonCards\"))\n20\t\n21\t# --- Fusion avec kanji-stroke-order-html : tracés KanjiVG inlinés dans la fiche\n22\t# de leçon elle-même (jamais de fichier .md, jamais de lien externe). Logique\n23\t# dupliquée (pas importée) pour que chaque skill reste auto-suffisant.\n24\tKANJIVG_URL = \"https://raw.githubusercontent.com/KanjiVG/kanjivg/master/kanji/{cp}.svg\"\n25\t\n26\t\n27\tdef _codepoint(char):\n28\t    return format(ord(char), \"05x\")\n29\t\n30\t\n31\tdef _parse_paths(svg):\n32\t    return re.findall(r'<path[^>]*\\bd=\"([^\"]+)\"', svg)\n33\t\n34\t\n35\tdef _parse_numbers(svg):\n36\t    out = []\n37\t    for m in re.finditer(r'<text[^>]*transform=\"matrix\\(1 0 0 1 ([\\d.]+) ([\\d.]+)\\)\"', svg):\n38\t        out.append((float(m.group(1)), float(m.group(2))))\n39\t    return out\n40\t\n41\t\n42\tdef _path_endpoints(d):\n43\t    tokens = 