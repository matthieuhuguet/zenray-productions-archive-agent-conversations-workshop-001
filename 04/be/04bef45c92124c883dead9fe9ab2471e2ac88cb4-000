"sample_rate\": 16000,\n41\t    \"mic_device\": \":0\",  # [0] MacBook Pro Microphone; [1] AirPods Pro (ffmpeg -f avfoundation -list_devices true -i \"\")\n42\t    \"record_seconds\": 6,\n43\t    \"score_pass\": 0.92,\n44\t    \"score_partial\": 0.75,\n45\t}\n46\t\n47\tSCRIPT_DIR = Path(__file__).resolve().parent\n48\tSTRIP_RE = re.compile(r\"[、。！？…・「」『』\\s,.!?~〜ー－\\-]\")\n49\t\n50\t\n51\tdef venv_python() -> str:\n52\t    \"\"\"Python interpreter of the ASR venv, required for fugashi and parakeet.\"\"\"\n53\t    return str(PARAMS[\"venv\"] / \"bin\" / \"python3\")\n54\t\n55\t\n56\tdef in_asr_venv() -> bool:\n57\t    return Path(sys.prefix).resolve() == PARAMS[\"venv\"].resolve()\n58\t\n59\t\n60\tdef reexec_in_venv() -> None:\n61\t    \"\"\"Re-run this script inside the ASR venv when launched from system python.\n62\t    FR : relance le script dans le venv ASR quand il est lance depuis le python systeme.\"\"\"\n63\t    if in_asr_venv():\n64\t        return\n65\t    py = venv_python()\n66\t    if not Path(py).exists():\n67\t        sys.exit(f\"ASR venv missing: {PARAMS['venv']}\")\n68\t    os.execv(py, [py, str(Path(__file__).resolve()), *sys.argv[1:]])\n69\t\n70\t\n71\t# ---- Phonetic normalisation ----\n72\t\n73\tdef to_kana(text: str) -> str:\n74\t    \"\"\"Reduce any Japanese string to its bare hiragana reading, punctuation removed.\"\"\"\n75\t    from fugashi import Tagger\n76\t    import jaconv\n77\t\n78\t    tagger = to_kana._tagger  # type: ignore[attr-defined]\n79\t    if tagger is None:\n80\t        tagger = Tagger()\n81\t        to_kana._tagger = tagger  # type: ignore[attr-defined]\n82\t    reading = \"\".join((w.feature.kana or w.surface) for w in tagger(text))\n83\t    return STRIP_RE.sub(\"\", jaconv.kata2hira(reading))\n84\t\n85\t\n86\tto_kana._tagger = None  # type: ignore[attr-defined]\n87\t\n88\t\n89\tdef score(target: str, heard: str) -> dict:\n90\t    \"\"\"Phonetic similarity between what was asked and what was actually said.\"\"\"\n91\t    t, h