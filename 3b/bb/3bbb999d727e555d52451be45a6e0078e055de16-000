lines):\n        if ln.startswith(\"Format:\") and \"Fontname\" in ln:\n            fmt = [c.strip() for c in ln[len(\"Format:\"):].split(\",\")]\n        elif ln.startswith(\"Style:\") and fmt:\n            f = [c.strip() for c in ln[len(\"Style:\"):].split(\",\")]\n            if len(f) != len(fmt):\n                continue\n            d = dict(zip(fmt, f))\n            if is_sign_style(d[\"Name\"]) or int(float(d.get(\"Alignment\", \"2\"))) not in (1, 2, 3):\n                continue\n            d[\"Fontname\"] = font_name\n            d[\"Fontsize\"] = f\"{fontsize_1080 * scale:g}\"\n            d[\"Bold\"] = \"0\"\n            d[\"Italic\"] = d.get(\"Italic\", \"0\")\n            d[\"Outline\"] = f\"{outline * scale:g}\"\n            d[\"Shadow\"] = \"0\"\n            d[\"MarginV\"] = f\"{margin_v_1080 * scale:g}\"\n            lines[i] = \"Style: \" + \",\".join(d[c] for c in fmt)\n            changed.append(d[\"Name\"])\n    return \"\\n\".join(lines), changed\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"input\")\n    ap.add_argument(\"--output\", required=True)\n    ap.add_argument(\"--fontsize\", type=float, default=28, help=\"in 1080p pixels\")\n    ap.add_argument(\"--margin-v\", type=float, default=40)\n    ap.add_argument(\"--outline\", type=float, default=1.4)\n    ap.add_argument(\"--font-name\", default=\"Inter Variable\")\n    ap.add_argument(\"--keep-workdir\", action=\"store_true\")\n    a = ap.parse_args()\n    src = os.path.abspath(a.input)\n    out = os.path.abspath(a.output)\n    ff = find_ffmpeg()\n    fp = os.path.join(os.path.dirname(ff), \"ffprobe\")\n    info = ffprobe_json(fp, src)\n    video, audio, a_idx, sub, s_idx = pick_streams(info)\n    work = tempfile.mkdtemp(prefix=\"softsub_\")\n    try:\n        print(f\"[1/4] extract FR track #{sub['index']} + fonts\")\n        extract_subs_and_fonts(ff, src, s_idx, work)\n        raw = open(os.path.join(work, \"sub.ass\"), encoding=\"utf-8-sig\").read()\n   