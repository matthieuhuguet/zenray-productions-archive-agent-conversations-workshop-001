n\n\ndef parse_series(name):\n    \"\"\"Rend (titre, saison, episode) ou None. Le titre est ce qui precede le\n    marqueur de saison : c'est la seule heuristique qui tienne sur tous les\n    formats de release rencontres.\"\"\"\n    n = _SEP_RE.sub(\" \", nfc(os.path.splitext(name)[0]))\n    for rx in _SE_RES:\n        m = rx.search(n)\n        if not m:\n            continue\n        title = n[:m.start()].strip(\" -_\")\n        s = int(m.group(\"s\"))\n        e = m.groupdict().get(\"e\")\n        if e is None:\n            m2 = _EP_ONLY_RE.search(n[m.end():])\n            e = m2.group(\"e\") if m2 else None\n        if e is None:\n            continue\n        return (title, s, int(e))\n    return None\n\n\n# ===========================================================================\n#  Plan — la table de correspondance, ecrite AVANT que le disque bouge\n# ===========================================================================\nclass Plan(object):\n    def __init__(self, root, mode, policy=None):\n        self.root = root\n        self.mode = mode\n        self.ops = []\n        self.policy = policy or {}\n        self.claimed = set()   # destinations deja prises par ce plan lui-meme\n\n    def add(self, op, src=None, dst=None, why=\"\", bytes_=0, extra=None):\n        d = {\"op\": op, \"why\": why}\n        if src:\n            d[\"src\"] = src\n        if dst:\n            d[\"dst\"] = dst\n        if bytes_:\n            d[\"bytes\"] = bytes_\n        if extra:\n            d.update(extra)\n        self.ops.append(d)\n        if dst:\n            self.claimed.add(nfc(dst).lower())\n        return d\n\n    def taken(self, dst):\n        \"\"\"Une destination est prise si elle existe sur le disque OU si une\n        operation anterieure du meme plan la revendique deja. Oublier le second\n        cas est la maniere classique de perdre un fichier : deux sources\n        differentes qui arrivent sur le meme nom, la seconde ecrase la premiere.\"\"\"\n        return nfc(dst).lower() in self.claimed or os.path.lexists(dst)\n\n    def to_json(self):\n        return {\n            \"gear_version\": GEAR_VERSION, \"created\": NOW, \"root\": self.root,\n            \"mode\": self.mode, \"policy\": self.policy, \"ops\": self.ops,\n        }\n\n\ndef resolve_collision(plan, dst, src=None):\n    \"\"\"Applique la politique de collision. Rend (chemin, note) ou (None, raison).\"\"\"\n    if not plan.taken(dst):\n        return dst, \"\"\n    pol = plan.policy.get(\"collision\", CONFIG[\"collision\"])\n    if pol == \"fail\":\n        raise Refus(\"collision : %s existe deja\" % dst)\n    if pol == \"skip\":\n        return None, \"destination occupee, source laissee en place\"\n    if pol == \"dedupe\" and src and os.path.isfile(dst) and os.path.isfile(src):\n        try:\n            if os.path.getsize(src) == os.path.getsize(dst) and hash_file(src) == hash_file(dst):\n                return None, \"contenu identique a la destination, doublon\"\n        except OSError:\n            pass\n    stem, ext = os.path.splitext(dst)\n    n = 2\n    while True:\n        cand = CONFIG[\"collision_fmt\"].format(stem=stem, n=n, ext=ext)\n        if not plan.taken(cand):\n            return cand, \"renomme en (%d) pour ne rien ecraser\" % n\n        n += 1\n        if n > 9999:\n            raise Refus(\"plus de 9999 collisions sur %s\" % dst)\n\n\n# --- Constructeurs de plan -------------------------------------------------\ndef build_clean(root, a):\n    plan = Plan(root, \"clean\", {\"collision\": a.collision, \"title\": not a.no_title})\n    for e in sorted(walk(root, maxdepth=a.depth, files_only=not a.dirs, skip_noise=True),\n                    key=lambda x: x.path):\n        if is_partial(e.name):\n            plan.add(\"skip\", src=e.path, why=\"telechargement inacheve\")\n            continue\n        new = clean_name(e.name, keep_tags=a.keep_tags, do_title=not a.no_title)\n        if nfc(new) == nfc(e.name):\n            continue\n  