f (!j) return []\n  return ((j.items) || []).filter((i) => i.link).map((i) => ({ title: i.title || q, year: '', image: i.link, source: 'google' }))\n}\nasync function ddgImages(q) {\n  try {\n    const page = await fetch(`https://duckduckgo.com/?q=${encodeURIComponent(q)}&iax=images&ia=images`, { headers: { 'User-Agent': DDG_UA } }).then((r) => r.text())\n    const m = page.match(/vqd=[\"']?([\\d-]+)[\"']?/)\n    if (!m) return []\n    const j = await fetch(`https://duckduckgo.com/i.js?l=us-en&o=json&q=${encodeURIComponent(q)}&vqd=${m[1]}&f=,,,&p=1`, { headers: { 'User-Agent': DDG_UA, Referer: 'https://duckduckgo.com/' } }).then((r) => r.json()).catch(() => null)\n    return ((j && j.results) || []).filter((r) => r.image).map((r) => ({ title: r.title || q, year: '', image: r.image, source: 'web' }))\n  } catch { return [] }\n}\nasync function webImages(q) {\n  const g = await googleImages(q)\n  if (g !== null) return g // Google configuré -> source de vérité en prod (même si 0 résultat)\n  return ddgImages(q) // sinon fallback keyless (local)\n}\n\n// — RAWG (jeux) : background_image = art paysage du jeu.\nasync function rawg(q) {\n  if (!RAWG_KEY) return []\n  const j = await jget(`https://api.rawg.io/api/games?key=${RAWG_KEY}&search=${encodeURIComponent(q)}&page_size=8`)\n  return ((j && j.results) || []).filter((g) => g.background_image).map((g) => ({ title: g.name, year: (g.released || '').slice(0, 4), image: g.background_image, source: 'rawg' }))\n}\n\n// — TMDB (films / séries / docs / anime) : poster_path -> CDN image.tmdb.org (w500).\nasync function tmdb(q) {\n  if (!TMDB_KEY) return []\n  const j = await jget(`https://api.themoviedb.org/3/search/multi?api_key=${TMDB_KEY}&query=${encodeURIComponent(q)}&include_adult=false`)\n  return ((j && j.results) || []).filter((m) => m.poster_path).map((m) => ({\n    title: m.title || m.name || q,\n    year: ((m.release_date || m.first_air_date || '')).slice(0, 4),\n    image: `https://image.tmdb.org/t/p/w500${m.poster_