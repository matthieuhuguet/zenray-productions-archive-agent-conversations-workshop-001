rflow:hidden;\n         flex:none; transform-origin:top left; background:#111; }\n\n/* calque 1 : le fond, c'est le media lui-meme floute */\n.fond { position:absolute; inset:0; background:url(__FOND__) center/cover no-repeat;\n        filter: blur(calc(var(--fond-flou) - __FOND_FLOU__px)) brightness(var(--fond-lum));\n        opacity: var(--fond-op); }\n\n/* calque 2 : le media source, jamais recadre, jamais agrandi */\n.media { position:absolute; left:50%; top:var(--media-y); transform:translate(-50%,-50%);\n         width:var(--media-w); border-radius:var(--media-r); overflow:hidden;\n         box-shadow: 0 30px 80px rgba(0,0,0,var(--media-ombre)); line-height:0; }\n.media img { width:100%; height:auto; display:block; }\n\n.play { position:absolute; inset:0; display:grid; place-items:center; pointer-events:none; }\n.play span { width:104px; height:104px; border-radius:50%; background:rgba(255,255,255,.94);\n             display:grid; place-items:center; box-shadow:0 10px 34px rgba(0,0,0,.28); }\n.play span::after { content:''; width:0; height:0; border-top:20px solid transparent;\n             border-bottom:20px solid transparent; border-left:32px solid #17171a; margin-left:9px; }\n.duree { position:absolute; right:18px; bottom:16px; padding:5px 11px; border-radius:8px;\n         background:rgba(12,12,14,.62); color:#fff; font-family:'Inter', sans-serif;\n         font-size:24px; font-weight:500; }\n\n/* calque 3 : le titre. Position Y INDEPENDANTE, comme les autres calques. */\n.titre { position:absolute; left:60px; right:60px; top:var(--titre-y); transform:translateY(-50%);\n         text-align:center; color:#fff;\n         font-family:var(--titre-famille); font-size:var(--titre-taille);\n         font-weight:var(--titre-graisse); letter-spacing:var(--titre-interlettre);\n         line-height:1.08; text-wrap:balance;\n         text-shadow: 0 2px calc(var(--titre-ombre-flou) * .5) rgba(0,0,0,calc(var(--titre-ombre) * .9)),\n                      0 14px var(--titre-ombre-flou) rgba(0,0,0,var(--titre-ombre)); }\n\n/* calque 4 : le sous-titre. Position Y INDEPENDANTE elle aussi. */\n.soustitre { position:absolute; left:70px; right:70px; top:var(--st-y); transform:translateY(-50%);\n             text-align:center; color:#fff;\n             font-family:var(--st-famille); font-size:var(--st-taille);\n             font-weight:var(--st-graisse); line-height:1.3; opacity:var(--st-op);\n             text-wrap:balance;\n             text-shadow: 0 2px 10px rgba(0,0,0,.5), 0 10px 26px rgba(0,0,0,.4); }\n\n/* ── PANNEAU DESIGNER — NE PART JAMAIS DANS L'ASSET FINAL ─────────────\n   Il est retire par le rendu PNG (classe .rendu sur <body>), et il n'existe\n   de toute facon pas dans le PNG, qui est le seul livrable.               */\n.panneau { position:sticky; top:28px; width:308px; flex:none; color:#fff;\n           background:#1b1b1f; border:1px solid #2b2b31; border-radius:12px; padding:16px;\n           font:500 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;\n           max-height:calc(100vh - 56px); overflow-y:auto; }\n.panneau h4 { margin:0 0 6px; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#8d939b; }\n.panneau .grp { margin:14px 0 0; padding-top:10px; border-top:1px solid #2b2b31; }\n.panneau label { display:block; margin-bottom:11px; }\n.panneau .row { display:flex; justify-content:space-between; margin-bottom:4px; color:#c9ced5; }\n.panneau .row b { color:#fff; font-weight:600; }\n.panneau input[type=range] { width:100%; accent-color:#F38A5C; margin:0; }\n.panneau input[type=text], .panneau select { width:100%; background:#111114; border:1px solid #2b2b31;\n           color:#fff; border-radius:6px; padding:7px 9px; font:500 12px ui-monospace, monospace; }\n.panneau button { width:100%; margin-top:12px; padding:9px; border:none; border-radius:7px;\n           background:#F38A5C; color:#161616; font:600 12px ui-monospace, monospace; cursor:pointer; }\n.panneau .out { margin-top:8px; color:#8d