/*\"))\n    CHROME = hits[0] if hits else None\nif not CHROME:\n    sys.exit(\"Aucun Chromium headless trouve. npx playwright install chromium\")\n\nTOK = P[\"tokens\"]\n\ndef color(name):\n    return TOK[\"colors\"][name]\n\ndef render(html_path, png_path, w, h):\n    subprocess.run([\n        CHROME, \"--headless=new\", \"--disable-gpu\", \"--hide-scrollbars\",\n        f\"--force-device-scale-factor={SCALE}\",\n        \"--default-background-color=00000000\",\n        f\"--window-size={w},{h}\", f\"--screenshot={png_path}\",\n        f\"file://{html_path}\",\n    ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n\ndef runs_html(runs, emph_color, normal_color):\n    out = []\n    for r in runs:\n        emph = r[\"emph\"]\n        if emph == \"mixed\":\n            cls = \"run emph\"\n        elif emph:\n            cls = \"run emph\"\n        else:\n            cls = \"run\"\n        out.append(f'<span class=\"{cls}\">{r[\"text\"]}</span>')\n    return \" \".join(out)\n\ndef write_box_asset(name, box, bg_color_name, body_html, extra_css=\"\", radius=18):\n    w, h = box[\"w\"] * SCALE // SCALE, box[\"h\"]  # keep logical units, scale applied by chrome flag\n    html = f\"\"\"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<style>\n  @font-face {{ font-family:'{TOK[\"fontFamily\"]}'; src:url('file://{TOK[\"fontFile\"]}') format('truetype'); font-weight:900; }}\n  * {{ margin:0; padding:0; box-sizing:border-box; }}\n  html, body {{ background: transparent; }}\n  .box {{\n    width:{box[\"w\"]}px; height:{box[\"h\"]}px;\n    background:{color(bg_color_name)};\n    border-radius:{radius}px;\n    display:flex; align-items:center; justify-content:center;\n    padding: 0 34px;\n  }}\n  .run {{ font-family:'{TOK[\"fontFamily\"]}', sans-serif; font-weight:900; color:{color(\"black\")}; font-size:34px; }}\n  .run.emph {{ color:{color(\"white\")}; font-size:40px; }}\n  {extra_css}\n</style></head>\n<body><div class=\"box\">{body_html}</div></body></html>\n\"\"\"\n    html_path = os.path.join(ROOT, f\"{name}.html\")\n    png_path = os.path.join(ROOT, f\"{name}.png\")\n    open(html_path, \"w\").write(html)\n    render(f\"{ROOT}/{name}.html\", png_path, box[\"w\"], box[\"h\"])\n    return png_path\n\ndef build_title():\n    t = P[\"title\"]\n    body = f'<span class=\"run emph\" style=\"font-size:64px; letter-spacing:0.01em;\">{t[\"text\"]}</span>'\n    write_box_asset(\"1-title\", t[\"box\"], t[\"bg\"], body, radius=0)\n\ndef build_subtitle():\n    s = P[\"subtitle\"]\n    body = f'<div class=\"wrap\">{runs_html(s[\"runs\"], \"white\", \"black\")}</div>'\n    extra = \".wrap{display:flex;flex-wrap:wrap;gap:0 12px;justify-content:center;text-align:center;line-height:1.15;}\"\n    write_box_asset(\"2-subtitle\", s[\"box\"], s[\"bg\"], body, extra_css=extra, radius=0)\n\ndef build_arrow():\n    a = P[\"arrow\"]\n    box = a[\"box\"]\n    html = f\"\"\"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<style>* {{margin:0;padding:0;}} html,body{{background:transparent;}}</style></head>\n<body>\n<svg width=\"{box['w']}\" height=\"{box['h']}\" viewBox=\"0 0 {box['w']} {box['h']}\" style=\"transform:rotate({a['rotationDeg']}deg)\">\n  <path d=\"M 10 {box['h']//2} L {box['w']-40} {box['h']//2} M {box['w']-70} {box['h']//2-30} L {box['w']-10} {box['h']//2} L {box['w']-70} {box['h']//2+30}\"\n        stroke=\"{color(a['color'])}\" stroke-width=\"14\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>\n</body></html>\"\"\"\n    html_path = os.path.join(ROOT, \"3-arrow.html\")\n    open(html_path, \"w\").write(html)\n    render(html_path, os.path.join(ROOT, \"3-arrow.png\"), box[\"w\"], box[\"h\"])\n\ndef build_criteria():\n    for i, c in enumerate(P[\"criteria\"], start=1):\n        body = f'<div class=\"wrap\">{runs_html(c[\"runs\"], \"white\", \"black\")}</div>'\n        extra = \".wrap{display:flex;flex-wrap:wrap;gap:0 12px;justify-content:center;text-align:center;line-height:1.1;}\"\n        write_box_asset(f\"{4+i}-critere-{i}\", c[\"box\"], c[\"bg\"], body, extra_css=extra, radius=14)\n\ndef build_tag():\n    t = P[\"tag\"]\n    lines = t[\"text\"].split(\"\\n\")\n    body = \"\".join(f'<div class=\"run\" style=\"color:{color(t[\"textColor\"])};font-size:24px;line-height:1.25;\">{l}</div>' for l in lines)\n    write_box_asset(\"10-tag\", t[\"box\"], t[\"bg\"], f'<div class=\"wrap\">{body}</div>',\n                     extra_css=\".wrap{text-align:center;}\", radius=10)\n\ndef build_photo_placeholder():\n    ph = P[\"photo\"]\n    if ph[\"src\"]:\n        return\n    box = ph[\"box\"]\n    html = f\"\"\"<!doctype html><html><head><style>*{{margin:0;padding:0;}}html,body{{background:transparent;}}\n    .slot{{width:{box['w']}px;height:{box['h']}px;background:transparent;border:3px dashed rgba(0,0,0,0.15);\n           display:flex;align-items:center;justify-content:center;font-family:sans-serif;color:rgba(0,0,0,0.25);font-size:22px;text-align:center;}}\n    </style></head><body><div class=\"slot\">asset photo absent<br>slot declare</div></body></html>\"\"\"\n    html_path = os.path.join(ROOT, \"9-photo-slot.html\")\n    open(html_path, \"w\").write(html)\n    render(html_path, os.path.join(ROOT, \"9-photo-slot.png\"), box[\"w\"], box[\"h\"])\n\ndef build_composite():\n    canvas = P[\"canvas\"]\n    def pos(box):\n        return f'position:absolute; left:{box[\"x\"]}px; top:{box[\"y\"]}px; width:{box[\"w\"]}px; height:{box[\"h\"]}px;'\n    imgs = []\n    imgs.append(f'<img src=\"1-title.png\" style=\"{pos(P[\"title\"][\"box\"])}\">')\n    imgs.append(f'<img src=\"2-subtitle.png\" style=\"{pos(P[\"subtitle\"][\"box\"])}\">')\n    imgs.append(f'<img src=\"3-arrow.png\" style=\"{pos(P[\"arrow\"][\"box\"])}\">')\n    for i, c in enumerate(P[\"criteria\"], start=1):\n        imgs.append(f'<img src=\"{4+i}-critere-{i}.png\" style=\"{pos(c[\"box\"])}\">')\n    imgs.append(f'<img src=\"9-photo-slot.png\" style=\"{pos(P[\"photo\"][\"box\"])}\">')\n    imgs.append(f'<img src=\"10-tag.png\" style=\"{pos(P[\"tag\"][\"box\"])}\">')\n    html = f\"\"\"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<style>\n  * {{ margin:0; padding:0; box-sizing:border-box; }}\n  .canvas {{ position:relative; width:{canvas['width']}px; height:{canvas['height']}px; background:{color(canvas['bg'])}; overflow:hidden; }}\n  .canvas img {{ display:block; }}\n</style></head>\n<body><div class=\"canvas\">{''.join(imgs)}</div></body></html>\n\"\"\"\n    open(os.path.join(ROOT, \"slide-1.html\"), \"w\").write(html)\n\nif __name__ == \"__main__\":\n    build_title()\n    build_subtitle()\n    build_arrow()\n    build_criteria()\n    build_photo_placeholder()\n    build_tag()\n    build_composite()\n    print(\"assets + slide-1.html ecrits\")\n","structuredPatch":[{"oldStart":112,"oldLines":7,"newStart":112,"newLines":7,"lines":[" def build_tag():","     t = P[\"tag\"]","     lines = t[\"text\"].split(\"\\n\")","-    body = \"\".join(f'<div class=\"run\" style=\"color:{color(t[\"textColor\"])};font-size:24px;line-height:1.25;\">{l}</div>' for l in lines)","+    body = \"\".join(f'<div class=\"run\" style=\"color:{color(t[\"textColor\"])};font-size:{t[\"fontSize\"]}px;line-height:1.3;\">{l}</div>' for l in lines)","     write_box_asset(\"10-tag\", t[\"box\"], t[\"bg\"], f'<div class=\"wrap\">{body}</div>',","                      extra_css=\".wrap{text-align:center;}\", radius=10)"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"65ba4c37-e9d1-4671-b203-af832cee149b","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"545b1129-5138-4cfb-81ca-0414eb8bfd2d","version":"2.1.229","gitBranch":"main","slug":"tender-exploring-kazoo"}
