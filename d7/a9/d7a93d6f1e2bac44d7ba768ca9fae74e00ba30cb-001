\"),\n    (\"Abril.ttf\", \"Serif alternative\",\n     \"Tried for SWITZERLAND, superseded by Didonesque Stencil.\"),\n]\nbrand_names = {b[0] for b in BRAND}\n\ndef family_id(fname):\n    return \"f_\" + re.sub(r\"[^A-Za-z0-9]\", \"_\", fname)\n\ndef fmt(p):\n    return \"opentype\" if p.suffix.lower() == \".otf\" else \"truetype\"\n\nfaces = []\nfor p in files:\n    faces.append(\n        f\"@font-face {{ font-family:'{family_id(p.name)}'; \"\n        f\"src:url('file://{p}') format('{fmt(p)}'); }}\"\n    )\n\ndef card(p, role=None, note=None):\n    fid = family_id(p.name)\n    return f\"\"\"\n  <div class=\"card{' brand' if role else ''}\">\n    <div class=\"meta\">\n      <div class=\"name\">{html.escape(p.stem)}</div>\n      {f'<div class=\"role\">{html.escape(role)}</div>' if role else ''}\n      {f'<div class=\"note\">{html.escape(note)}</div>' if note else ''}\n    </div>\n    <div class=\"sample\" style=\"font-family:'{fid}'\">ZenRay Dictate</div>\n    <div class=\"sample small\" style=\"font-family:'{fid}'\">\n      ABCDEFGHIJKLM abcdefghijklm 0123456789 &amp; ? !\n    </div>\n    <code class=\"path\">file://{html.escape(str(p))}</code>\n  </div>\"\"\"\n\nbrand_cards = []\nfor fname, role, note in BRAND:\n    p = font_dir / fname\n    if p.exists():\n        brand_cards.append(card(p, role, note))\n\n# Group the rest by family prefix so 20 weights of one face don't drown the list.\nrest = [p for p in files if p.name not in brand_names]\ngroups = {}\nfor p in rest:\n    key = re.split(r\"[-_]\", p.stem)[0]\n    groups.setdefault(key, []).append(p)\n\nrest_html = []\nfor key in sorted(groups, key=str.lower):\n    members = groups[key]\n    rest_html.append(f'<h3 class=\"group\">{html.escape(key)} '\n                     f'<span class=\"count\">{len(members)}</span></h3>')\n    rest_html.extend(card(p) for p in members)\n\ndoc = f\"\"\"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<title>ZenRay HTML Photoshop — Font Book</title>\n<style>\n  {chr(10).join('  ' + f for f in faces)}\n\n  * {{ box-sizing: border-box; }}\n  body {{\n    margin: 0; padding: 48px 40px 96px;\n    background: #fafafa; color: #2b2b2b;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }}\n  h1 {{ font-size: 34px; margin: 0 0 6px; }}\n  .sub {{ color: #6b6b6b; font-size: 15px; margin-bottom: 40px; }}\n  h2 {{\n    font-size: 13px; letter-spacing: .14em; text-transform: uppercase;\n    color: #8a8a8a; margin: 48px 0 16px;\n    border-bottom: 1px solid #e6e6e6; padding-bottom: 10px;\n  }}\n  h3.group {{\n    font-size: 15px; margin: 34px 0 12px; color: #6b6b6b; font-weight: 600;\n  }}\n  h3 .count {{\n    font-size: 12px; color: #a5a5a5; font-weight: 500;\n    background: #efefef; border-radius: 20px; padding: 2px 9px; margin-left: 6px;\n  }}\n  .card {{\n    background: #fff; border: 1px solid #e8e8e8; border-radius: 14px;\n    padding: 20px 24px; margin-bottom: 12px;\n  }}\n  .card.brand {{ border-color: #d8c9a4; background: #fffdf6; }}\n  .meta {{ display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }}\n  .name {{ font-size: 15px; font-weight: 600; }}\n  .role {{\n    font-size: 11px; letter-spacing: .1em; text-transform: uppercase;\n    color: #b3862c; background: #fdf6e3; border-radius: 20px; padding: 3px 10px;\n  }}\n  .note {{ font-size: 13px; color: #8a8a8a; flex-basis: 100%; margin-top: 2px; }}\n  .sample {{ font-size: 46px; line-height: 1.25; margin: 14px 0 4px; }}\n  .sample.small {{ font-size: 19px; color: #6b6b6b; margin-bottom: 12px; }}\n  code.path {{\n    display: block; font-size: 12px; color: #7a7a7a;\n    background: #f4f4f4; border-radius: 8px; padding: 8px 12px;\n    user-select: all; word-break: break-all;\n  }}\n</style></head>\n<body>\n  <h1>Font Book</h1>\n  <div class=\"sub\">\n    {len(files)} fonts installed in ~/Library/Fonts. Click a path to select it,\n    then paste it into a <code>@font-face</code> src. Regenerate with\n    <code>scripts/build-fontbook.sh</code>.\n 