t\n45\t    \"$CHROME\" --headless=new --disable-gpu --hide-scrollbars \\\n46\t        --force-device-scale-factor=2 \\\n47\t        --window-size=$W,$H --screenshot=\"out/$base@2x.png\" \\\n48\t        \"file://$(pwd)/$html\" >/dev/null 2>&1\n49\t\n50\t    # Assert the format really is 4:5. A silent wrong-size export is worse than\n51\t    # a loud failure: Instagram would crop it and nobody would know why.\n52\t    python3 - \"$base\" $W $H <<'PY'\n53\timport sys\n54\tfrom PIL import Image\n55\tbase, w, h = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])\n56\tok = True\n57\tfor path, ew, eh in ((f\"out/{base}.png\", w, h), (f\"out/{base}@2x.png\", w*2, h*2)):\n58\t    got = Image.open(path).size\n59\t    flag = \"ok\" if got == (ew, eh) else f\"WRONG, expected {ew}x{eh}\"\n60\t    if got != (ew, eh): ok = False\n61\t    print(f\"  {path:28s} {got[0]}x{got[1]}  {flag}\")\n62\tsys.exit(0 if ok else 1)\n63\tPY\n64\tdone\n65\t\n66\techo\n67\techo \"Done. Files in out/ — 1x = ${W}x${H}, 2x = $((W*2))x$((H*2)), both 4:5.\""},"type":"attachment","uuid":"5cb25551-4854-4bdc-83d8-05c306f078d0","timestamp":"2026-08-11T14:42:16.984Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"545b1129-5138-4cfb-81ca-0414eb8bfd2d","version":"2.1.222","gitBranch":"main"}
