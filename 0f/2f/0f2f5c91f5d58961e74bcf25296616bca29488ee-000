{"parentUuid":"65458608-9a87-48bf-88c9-6b2a47ed52c3","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/nodes.test.js","snippet":"1\t// Carte L9 — la porte des sous-composants.\n2\t//\n3\t// « Le plus important c'est que tous les composants soient sous-divisés en des sous-composants qui\n4\t// sont eux-mêmes éditables, et avoir une hiérarchie propre. » Ces tests vérifient les trois choses\n5\t// dont ça dépend : que l'arbre soit juste, que le chemin d'un élément soit calculé de la même façon\n6\t// des deux côtés du pont, et qu'un réglage écrive dans la page sans détruire ce qui l'entoure.\n7\t\n8\timport { describe, it, expect } from 'vitest'\n9\timport { parseTree, findNode, applyOverrides, pathOfElement, countNodes, NODE_STYLES } from './nodes.js'\n10\t\n11\tconst PAGE = `<!doctype html><html><body>\n12\t<section data-zrm-instance=\"cmp-1\">\n13\t  <style>.x{color:red}</style>\n14\t  <header class=\"zrm-masthead\">\n15\t    <h1 class=\"zrm-logo\">Le Journal</h1>\n16\t    <time>4 août</time>\n17\t  </header>\n18\t  <nav class=\"zrm-nav\"><a href=\"#\">Monde</a><a href=\"#\">Économie</a></nav>\n19\t</section>\n20\t<figure data-zrm-instance=\"cmp-2\"><img src=\"x.png\"><figcaption>Légende</figcaption></figure>\n21\t</body></html>`\n22\t\n23\tdescribe('L9 — l’arbre des sous-composants', () => {\n24\t  it('découpe chaque pièce en un arbre, une entrée par instance', () => {\n25\t    const arbre = parseTree(PAGE)\n26\t    expect(Object.keys(arbre).sort()).toEqual(['cmp-1', 'cmp-2'])\n27\t    expect(arbre['cmp-1']).toHaveLength(2)      // <style> est écarté, header et nav restent\n28\t  })\n29\t\n30\t  it('écarte les balises sans surface, qui ne sont pas des sous-composants', () => {\n31\t    const arbre = parseTree(PAGE)\n32\t    expect(arbre['cmp-1'].map((n) => n.tag)).toEqual(['header', 'nav'])\n33\t  })\n34\t\n35\t  it('nomme un nœud par ce que l’AUTEUR a écrit avant de le deviner', () => {\n36\t    const arbre = parseTree(PAGE)\n37\t    const entete = arbre['cmp-1'][0]\n38\t    expect(entete.name).toBe('masthead')                 // la classe zrm-* gagne\n39\t    expect(entete.children[0].name).toBe('logo')\n40\t    expect(entete.children[1].name).toBe('Date')         // pas de classe : la balise <time> parle\n41\t    expect(arbre['cmp-2'][1].name).toBe('figcaption')\n42\t  })\n43\t\n44\t  it('ne retient que le texte PROPRE d’un nœud, jamais celui de ses enfants', () => {\n45\t    const arbre = parseTree(PAGE)\n46\t    const entete = arbre['cmp-1'][0]\n47\t    expect(entete.text).toBe('')                         // le conteneur ne porte rien lui-même\n48\t    expect(entete.editable).toBe(false)\n49\t    expect(entete.children[0].text).toBe('Le Journal')\n50\t    expect(entete.children[0].editable).toBe(true)\n51\t  })\n52\t\n53\t  it('retrouve un nœud par son chemin d’indices', () => {\n54\t    const arbre = parseTree(PAGE)\n55\t    expect(findNode(arbre, 'cmp-1', '0.0').text).toBe('Le Journal')\n56\t    expect(findNode(arbre, 'cmp-1', '1.1').text).toBe('Économie')\n57\t    expect(findNode(arbre, 'cmp-1', '9.9')).toBe(null)\n58\t    expect(findNode(arbre, 'inconnu', '0')).toBe(null)\n59\t  })\n60\t\n61\t  // LE POINT QUI DÉCIDE DU CLIC DANS L'APERÇU : le pont compte les indices dans le document, ce\n62\t  // module les compte dans son arbre. Un écart d'un cran désignerait deux éléments différents.\n63\t  it('le chemin d’un élément réel est CELUI de l’arbre, sans décalage', () => {\n64\t    const doc = new DOMParser().parseFromString(PAGE, 'text/html')\n65\t    const hote = doc.querySelector('[data-zrm-instance=\"cmp-1\"]')\n66\t    const logo = doc.querySelector('.zrm-logo')\n67\t    const chemin = pathOfElement(logo, hote)\n68\t    expect(chemin).toBe('0.0')\n69\t    expect(findNode(parseTree(PAGE), 'cmp-1', chemin).text).toBe('Le Journal')\n70\t  })\n71\t\n72\t  it('compte les sous-composants d’une pièce, descendance comprise', () => {\n73\t    expect(countNodes(parseTree(PAGE)['cmp-1'])).toBe(6)   // header, h1, time, nav, a, a\n74\t  })\n75\t})\n76\t\n77\tdescribe('L9 — l’application des réglages', () => {\n78\t  it('remplace le texte d’un nœud SANS détruire ses voisins', () => {\n79\t    const html = applyOverrides(PAGE, { 'cmp-1': { '0.0': { text: 'La Gazette' } } })\n80\t    expect(html).toContain('La Gazette')\n81\t    expect(html).not.toContain('Le Journal')\n82\t    expect(html).toContain('4 août')       // le voisin est intact\n83\t    expect(html).toContain('Économie')\n84\t  })\n85\t\n86\t  it('n’efface JAMAIS la descendance en écrivant sur un conteneur', () => {\n87\t    const html = applyOverrides(PAGE, { 'cmp-1': { '0': { text: 'Rien' } } })\n88\t    // Le conteneur n'a pas de texte propre : le réglage se pose sans emporter ses enfants.\n89\t    expect(html).toContain('Le Journal')\n90\t    expect(html).toContain('4 août')\n91\t  })\n92\t\n93\t  it('écrit le style en ligne, en tiret et non en camel', () => {\n94\t    const html = applyOverrides(PAGE, { 'cmp-1': { '0.0': { style: { fontSize: '42px', color: '#ff0000' } } } })\n95\t    expect(html).toContain('font-size:42px')\n96\t    expect(html).toContain('color:#ff0000')\n97\t  })\n98\t\n99\t  it('refuse une propriété hors de la liste fermée, et neutralise une valeur qui sort du style', () => {\n100\t    const html = applyOverrides(PAGE, { 'cmp-1': { '0.0': { style: { position: 'fixed', color: 'red;}</style><script>x' } } } })\n101\t    expect(html).not.toContain('position:fixed')\n102\t    expect(html).not.toContain('<script>x')\n103\t  })\n104\t\n105\t  it('ignore sans bruit un chemin devenu introuvable', () => {\n106\t    const html = applyOverrides(PAGE, { 'cmp-1': { '7.7.7': { text: 'ORPHELIN' } }, 'inconnu': { '0': { text: 'FANTOME' } } })\n107\t    expect(html).toContain('Le Journal')\n108\t    expect(html).not.toContain('ORPHELIN')\n109\t    expect(html).not.toContain('FANTOME')\n110\t  })\n111\t\n112\t  it('rend la page inchangée quand il n’y a rien à appliquer', () => {\n113\t    expect(applyOverrides(PAGE, {})).toBe(PAGE)\n114\t    expect(applyOverrides(PAGE, { 'cmp-1': {} })).toBe(PAGE)\n115\t  })\n116\t\n117\t  it('la liste des réglages reste courte et fermée : douze propriétés, pas une de plus', () => {\n118\t    expect(NODE_STYLES).toHaveLength(12)\n119\t    expect(NODE_STYLES.every((c) => c.key && c.label && c.type)).toBe(true)\n120\t  })\n121\t})","displayPath":"../Productions/GithubProductions/ZenRayProgress/src/zenraymedia/nodes.test.js"},"type":"attachment","uuid":"2893ae83-a49e-4e23-9a4a-8bc131a71bd0","timestamp":"2026-08-04T08:20:50.077Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"dd3dbff7-8101-4996-9a8f-e69e4841d77c","version":"2.1.221","gitBranch":"main"}
