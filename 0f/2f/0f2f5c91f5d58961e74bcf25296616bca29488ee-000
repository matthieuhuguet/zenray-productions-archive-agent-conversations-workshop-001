ous l'onglet « Contenu ». Le montage de\n35\t  // test ouvre donc successivement les deux onglets dont les tests ont besoin, au lieu de supposer\n36\t  // que tout est visible d'emblée. C'est une correction du HARNAIS, pas un contournement : le\n37\t  // produit affiche bien ces champs, à un clic d'onglet près.\n38\t  // Les thèmes vivent dans la PALETTE depuis le 2026-08-04 ; on y passe pour attendre le signal de\n39\t  // chargement, puis on revient aux composants, puis on ouvre le contenu de l'article.\n40\t  fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))\n41\t  await waitFor(() => expect(screen.getByRole('button', { name: /Lecture pure/ })).toBeTruthy())\n42\t  fireEvent.click(screen.getByRole('button', { name: 'Comp.' }))\n43\t  fireEvent.click(screen.getByRole('button', { name: 'Contenu' }))\n44\t  await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n45\t  return utils\n46\t}\n47\t\n48\t// Rouvre l'onglet dont un test a besoin, sans supposer lequel est ouvert.\n49\tfunction onglet(nom) { fireEvent.click(screen.getByRole('button', { name: nom })) }\n50\t\n51\tdescribe('ZenRayMedia — interface', () => {\n52\t  it('s’ouvre sur le brief de démonstration, jamais sur un écran vide', async () => {\n53\t    await mount()\n54\t    expect(screen.getByLabelText('Titre de travail').value).toBe('Un brief, mille formes')\n55\t    expect(screen.getByLabelText('Message').value).toMatch(/goulot/)\n56\t    // L'article est monté automatiquement : ses blocs sont directement modifiables.\n57\t    await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n58\t  })\n59\t\n60\t  it('affiche le catalogue de thèmes avec sa famille et le contrat de dépôt', async () => {\n61\t    await mount()\n62\t    fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))\n63\t    expect(screen.getByText('Presse & éditorial')).toBeTruthy()\n64\t    expect(screen.getByText(/T-01-3-2/)).toBeTruthy()\n65\t    // Le mode d'em