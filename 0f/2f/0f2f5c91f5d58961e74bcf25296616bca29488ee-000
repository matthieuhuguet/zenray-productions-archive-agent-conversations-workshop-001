{"parentUuid":"f866f362-b3e8-4b7d-8c71-a7b4aaf7c4e6","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CdhMU3J5KUzKiiqpknkgx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W8ykCc35a8d32ZYncxoQdm","name":"Write","input":{"file_path":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/layers.js","content":"// ZenRayMedia — LE MODÈLE DE CALQUES (carte L1, 2026-08-04).\n//\n// « Pense éditeur d'UI comme React mais en GUI + layer HTML comme Photoshop = layer de PNG ou\n// effets. » Cette phrase de Matthieu tranche une contradiction qui a coûté cinq jours : l'INTERFACE\n// est celle d'Unreal, le MODÈLE est celui de Photoshop.\n//\n// Photoshop n'imbrique pas, il EMPILE. Une pile ordonnée de calques sur un canevas de taille fixe,\n// chacun portant sa position, sa taille, son rang, son opacité, son mode de fusion et ses effets.\n// C'est ce qui rend la composition rapide, et c'est aussi ce qui rend ce fichier court : un arbre\n// avec emplacements demanderait des semaines pour un gain nul sur « craft rapidement ».\n//\n// LE CONTRAT DE `composition.js` N'EST PAS ROUVERT, et c'est le cadeau de la carte C1 du\n// 2026-08-01 : depuis cette date `normalizeComposition` conserve les clefs qu'elle ne connaît pas.\n// Un tableau `layers` posé à côté de `rows` survit donc à tous les gestes sans qu'une seule ligne de\n// son contrat change, et les documents déjà enregistrés restent lisibles puisqu'un document sans\n// calques rend simplement un tableau vide.\n\nimport { makeId } from './contracts.js'\n\nexport const LAYER_KINDS = ['text', 'image', 'shape', 'component']\n\n// Les modes de fusion sont ceux que CSS sait appliquer NATIVEMENT via `mix-blend-mode`. On ne\n// propose que ce que le navigateur exécute réellement : un mode qu'il faudrait émuler en toile\n// coûterait un rendu hors iframe et casserait l'export en page autonome.\nexport const BLEND_MODES = [\n  'normal', 'multiply', 'screen', 'overlay', 'darken', 'lighten',\n  'color-dodge', 'color-burn', 'hard-light', 'soft-light', 'difference', 'exclusion',\n]\n\n// Les effets sont des FILTRES CSS, pour la même raison. Chacun se réduit à une fonction de\n// `filter` ou à `box-shadow`, donc à une chaîne que l'export emporte sans dépendance.\nexport const EFFECT_KEYS = ['blur', 'brightness', 'contrast', 'saturate', 'shadow']\n\nexport function emptyEffects() {\n  return { blur: 0, brightness: 1, contrast: 1, saturate: 1, shadow: '' }\n}\n\n// Le gabarit d'un calque neuf. Une taille par défaut qui NE SOIT PAS nulle : un calque de zéro\n// pixel se pose sans qu'on le voie, et l'utilisateur conclut que le dépôt a échoué.\nexport function makeLayer(composition, kind, patch = {}) {\n  if (!LAYER_KINDS.includes(kind)) throw new Error(`kind de calque inconnu : ${kind}`)\n  const serial = (composition?.serial || 0) + 1\n  return {\n    id: makeId('lay', `${composition?.themeId || 'sans-theme'}:${kind}`, serial),\n    serial,\n    kind,\n    name: patch.name || defaultName(kind),\n    x: 0, y: 0, w: 320, h: kind === 'text' ? 64 : 180,\n    z: nextZ(composition),\n    opacity: 1,\n    blend: 'normal',\n    hidden: false,\n    locked: false,\n    source: '',          // texte du calque, adresse de l'image, ou identifiant du composant\n    effects: emptyEffects(),\n    ...patch,\n  }\n}\n\nfunction defaultName(kind) {\n  return { text: 'Texte', image: 'Image', shape: 'Forme', component: 'Composant' }[kind]\n}\n\n// LE RANG LE PLUS ÉLEVÉ EST DEVANT, comme dans Photoshop où le calque du haut de la pile masque\n// ceux du dessous. Un calque neuf se pose donc AU-DESSUS de tout, ce qui est le seul comportement\n// qui ne surprenne personne : on veut voir ce qu'on vient de poser.\nfunction nextZ(composition) {\n  const layers = readLayers(composition)\n  return layers.length ? Math.max(...layers.map((l) => l.z)) + 1 : 0\n}\n\n// LECTURE TOLÉRANTE, ÉCRITURE STRICTE. Un document venu du disque peut n'avoir aucun tableau de\n// calques, en avoir un corrompu, ou porter des calques auxquels il manque des champs ajoutés après\n// coup. La lecture répare sans jamais jeter ; l'écriture, elle, ne produit que des calques complets.\nexport function readLayers(composition) {\n  const brut = composition?.layers\n  if (!Array.isArray(brut)) return []\n  return brut\n    .filter((l) => l && typeof l === 'object' && LAYER_KINDS.includes(l.kind))\n    .map((l, i) => ({\n      ...l,\n      id: l.id || makeId('lay', 'repare', i),\n      name: typeof l.name === 'string' && l.name ? l.name : defaultName(l.kind),\n      x: nombre(l.x, 0), y: nombre(l.y, 0),\n      w: Math.max(1, nombre(l.w, 320)), h: Math.max(1, nombre(l.h, 180)),\n      z: nombre(l.z, i),\n      opacity: Math.min(1, Math.max(0, nombre(l.opacity, 1))),\n      blend: BLEND_MODES.includes(l.blend) ? l.blend : 'normal',\n      hidden: !!l.hidden, locked: !!l.locked,\n      source: typeof l.source === 'string' ? l.source : '',\n      effects: { ...emptyEffects(), ...(l.effects && typeof l.effects === 'object' ? l.effects : {}) },\n    }))\n}\n\nfunction nombre(valeur, repli) {\n  return Number.isFinite(valeur) ? valeur : repli\n}\n\n// L'ORDRE DE PEINTURE, du fond vers le premier plan. C'est cette liste que la compilation écrit\n// dans le DOM, et c'est aussi celle que la hiérarchie affiche À L'ENVERS, puisqu'une pile de calques\n// se lit du haut, c'est-à-dire du plus proche de l'œil.\nexport function paintOrder(composition) {\n  return readLayers(composition).sort((a, b) => a.z - b.z || a.serial - b.serial)\n}\n\nexport function stackOrder(composition) {\n  return paintOrder(composition).reverse()\n}\n\nfunction ecrire(composition, layers) {\n  const serials = layers.map((l) => l.serial || 0)\n  return {\n    ...composition,\n    serial: Math.max(composition?.serial || 0, ...(serials.length ? serials : [0])),\n    layers,\n  }\n}\n\nexport function addLayer(composition, kind, patch = {}) {\n  const layer = makeLayer(composition, kind, patch)\n  return ecrire(composition, [...readLayers(composition), layer])\n}\n\nexport function patchLayer(composition, layerId, patch) {\n  return ecrire(composition, readLayers(composition).map((l) => {\n    if (l.id !== layerId) return l\n    // Les effets se fusionnent CHAMP PAR CHAMP : régler le flou ne doit pas effacer la saturation,\n    // erreur exacte que la carte C1 avait déjà payée sur `item.props` le 2026-08-01.\n    const effects = patch.effects ? { ...l.effects, ...patch.effects } : l.effects\n    return { ...l, ...patch, effects }\n  }))\n}\n\nexport function removeLayer(composition, layerId) {\n  return ecrire(composition, readLayers(composition).filter((l) => l.id !== layerId))\n}\n\nexport function duplicateLayer(composition, layerId) {\n  const source = readLayers(composition).find((l) => l.id === layerId)\n  if (!source) return composition\n  // Le doublon se décale de dix pixels, sans quoi il se pose exactement sur son modèle et l'on\n  // croit que rien ne s'est produit.\n  const copie = makeLayer(composition, source.kind, {\n    ...source, id: undefined, serial: undefined, z: undefined,\n    name: `${source.name} copie`, x: source.x + 10, y: source.y + 10,\n    effects: { ...source.effects },\n  })\n  const neuf = makeLayer(composition, source.kind)\n  return ecrire(composition, [...readLayers(composition), { ...copie, id: neuf.id, serial: neuf.serial, z: neuf.z }])\n}\n\n// MONTER OU DESCENDRE DANS LA PILE. On renumérote la pile entière plutôt que d'échanger deux rangs,\n// parce qu'un document réparé peut porter des rangs égaux et qu'un échange y serait sans effet.\nexport function reorderLayer(composition, layerId, direction) {\n  const ordre = paintOrder(composition)\n  const index = ordre.findIndex((l) => l.id === layerId)\n  if (index < 0) return composition\n  const cible = direction === 'up' ? index + 1 : index - 1\n  if (cible < 0 || cible >= ordre.length) return composition\n  const permute = [...ordre]\n  permute[index] = ordre[cibl