nst echelle = fitScale || 1\n    const dx = (event.clientX - geste.sx) / echelle\n    const dy = (event.clientY - geste.sy) / echelle\n    const suivant = { x: geste.x, y: geste.y, w: geste.w, h: geste.h }\n    if (geste.mode === 'move') { suivant.x = geste.x + dx; suivant.y = geste.y + dy }\n    else {\n      // Le mode porte les côtés tirés : « nw » tire le coin haut-gauche, donc déplace l'origine ET\n      // réduit la taille d'autant. Un plancher d'un pixel évite le calque replié sur lui-même.\n      if (geste.mode.includes('e')) suivant.w = Math.max(1, geste.w + dx)\n      if (geste.mode.includes('s')) suivant.h = Math.max(1, geste.h + dy)\n      if (geste.mode.includes('w')) { suivant.w = Math.max(1, geste.w - dx); suivant.x = geste.x + (geste.w - suivant.w) }\n      if (geste.mode.includes('n')) { suivant.h = Math.max(1, geste.h - dy); suivant.y = geste.y + (geste.h - suivant.h) }\n    }\n    patchComposition((c) => patchLayer(c, geste.id, {\n      x: Math.round(suivant.x), y: Math.round(suivant.y),\n      w: Math.round(suivant.w), h: Math.round(suivant.h),\n    }))\n  }\n\n  const onPoigneeUp = () => { if (gesteRef.current) { gesteRef.current = null; setActionCount((n) => n + 1) } }\n\n'''\ns=s.replace(anc, meca+anc, 1)\n\n# ── LA COUCHE DE MANIPULATION dans le canevas, juste avant le calque de zones de securite\nanc2 = \"              {showSafe && format.safe && (\"\nassert anc2 in s\ncouche = '''              {/* La couche de manipulation. Elle ne capte le pointeur que sur les boîtes, si bien\n                  que le reste de l'aperçu reste cliquable par le pont de sélection. */}\n              {countLayers(composition) > 0 && (\n                <div className=\"zrm-lay-layer\" onPointerMove={onPoigneeMove} onPointerUp={onPoigneeUp} onPointerCancel={onPoigneeUp}>\n                  {stackOrder(composition).filter((l) => !l.hidden).map((layer) => (\n                    <div key={layer.id} className=\"zrm-lay-box\" data-on={selectedComponent === layer.id} d