{"parentUuid":"a3ed625e-9d2b-43b1-893e-b0bc8b688197","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/layers.js","snippet":"1\t// ZenRayMedia — LE MODÈLE DE CALQUES (carte L1, 2026-08-04).\n2\t//\n3\t// « Pense éditeur d'UI comme React mais en GUI + layer HTML comme Photoshop = layer de PNG ou\n4\t// effets. » Cette phrase de Matthieu tranche une contradiction qui a coûté cinq jours : l'INTERFACE\n5\t// est celle d'Unreal, le MODÈLE est celui de Photoshop.\n6\t//\n7\t// Photoshop n'imbrique pas, il EMPILE. Une pile ordonnée de calques sur un canevas de taille fixe,\n8\t// chacun portant sa position, sa taille, son rang, son opacité, son mode de fusion et ses effets.\n9\t// C'est ce qui rend la composition rapide, et c'est aussi ce qui rend ce fichier court : un arbre\n10\t// avec emplacements demanderait des semaines pour un gain nul sur « craft rapidement ».\n11\t//\n12\t// LE CONTRAT DE `composition.js` N'EST PAS ROUVERT, et c'est le cadeau de la carte C1 du\n13\t// 2026-08-01 : depuis cette date `normalizeComposition` conserve les clefs qu'elle ne connaît pas.\n14\t// Un tableau `layers` posé à côté de `rows` survit donc à tous les gestes sans qu'une seule ligne de\n15\t// son contrat change, et les documents déjà enregistrés restent lisibles puisqu'un document sans\n16\t// calques rend simplement un tableau vide.\n17\t\n18\timport { makeId } from './contracts.js'\n19\t\n20\texport const LAYER_KINDS = ['text', 'image', 'shape', 'component']\n21\t\n22\t// Les modes de fusion sont ceux que CSS sait appliquer NATIVEMENT via `mix-blend-mode`. On ne\n23\t// propose que ce que le navigateur exécute réellement : un mode qu'il faudrait émuler en toile\n24\t// coûterait un rendu hors iframe et casserait l'export en page autonome.\n25\texport const BLEND_MODES = [\n26\t  'normal', 'multiply', 'screen', 'overlay', 'darken', 'lighten',\n27\t  'color-dodge', 'color-burn', 'hard-light', 'soft-light', 'difference', 'exclusion',\n28\t]\n29\t\n30\t// Les effets sont des FILTRES CSS, pour la même raison. Chacun se réduit à une fonction de\n31\t// `filter` ou à `box-shadow`, donc à une chaîne que l'export emporte sans dépendance.\n32\texport const EFFECT_KEYS = ['blur', 'brightness', 'contrast', 'saturate', 'shadow']\n33\t\n34\texport function emptyEffects() {\n35\t  return { blur: 0, brightness: 1, contrast: 1, saturate: 1, shadow: '' }\n36\t}\n37\t\n38\t// Le gabarit d'un calque neuf. Une taille par défaut qui NE SOIT PAS nulle : un calque de zéro\n39\t// pixel se pose sans qu'on le voie, et l'utilisateur conclut que le dépôt a échoué.\n40\texport function makeLayer(composition, kind, patch = {}) {\n41\t  if (!LAYER_KINDS.includes(kind)) throw new Error(`kind de calque inconnu : ${kind}`)\n42\t  const serial = (composition?.serial || 0) + 1\n43\t  return {\n44\t    id: makeId('lay', `${composition?.themeId || 'sans-theme'}:${kind}`, serial),\n45\t    serial,\n46\t    kind,\n47\t    name: patch.name || defaultName(kind),\n48\t    x: 0, y: 0, w: 320, h: kind === 'text' ? 64 : 180,\n49\t    z: nextZ(composition),\n50\t    opacity: 1,\n51\t    blend: 'normal',\n52\t    hidden: false,\n53\t    locked: false,\n54\t    source: '',          // texte du calque, adresse de l'image, ou identifiant du composant\n55\t    effects: emptyEffects(),\n56\t    ...patch,\n57\t  }\n58\t}\n59\t\n60\tfunction defaultName(kind) {\n61\t  return { text: 'Texte', image: 'Image', shape: 'Forme', component: 'Composant' }[kind]\n62\t}\n63\t\n64\t// LE RANG LE PLUS ÉLEVÉ EST DEVANT, comme dans Photoshop où le calque du haut de la pile masque\n65\t// ceux du dessous. Un calque neuf se pose donc AU-DESSUS de tout, ce qui est le seul comportement\n66\t// qui ne surprenne personne : on veut voir ce qu'on vient de poser.\n67\tfunction nextZ(composition) {\n68\t  const layers = readLayers(composition)\n69\t  return layers.length ? Math.max(...layers.map((l) => l.z)) + 1 : 0\n70\t}\n71\t\n72\t// LECTURE TOLÉRANTE, ÉCRITURE STRICTE. Un document venu du disque peut n'avoir aucun tableau de\n73\t// calques, en avoir un corrompu, ou porter des calques auxquels il manque des champs ajoutés après\n74\t// coup. La lecture répare sans jamais jeter ; l'écriture, elle, ne produit que des calques complets.\n75\texport function readLayers(composition) {\n76\t  const brut = composition?.layers\n77\t  if (!Array.isArray(brut)) return []\n78\t  return brut\n79\t    .filter((l) => l && typeof l === 'object' && LAYER_KINDS.includes(l.kind))\n80\t    .map((l, i) => ({\n81\t      ...l,\n82\t      id: l.id || makeId('lay', 'repare', i),\n83\t      name: typeof l.name === 'string' && l.name ? l.name : defaultName(l.kind),\n84\t      x: nombre(l.x, 0), y: nombre(l.y, 0),\n85\t      w: Math.max(1, nombre(l.w, 320)), h: Math.max(1, nombre(l.h, 180)),\n86\t      z: nombre(l.z, i),\n87\t      opacity: Math.min(1, Math.max(0, nombre(l.opacity, 1))),\n88\t      blend: BLEND_MODES.includes(l.blend) ? l.blend : 'normal',\n89\t      hidden: !!l.hidden, locked: !!l.locked,\n90\t      source: typeof l.source === 'string' ? l.source : '',\n91\t      effects: { ...emptyEffects(), ...(l.effects && typeof l.effects === 'object' ? l.effects : {}) },\n92\t    }))\n93\t}\n94\t\n95\tfunction nombre(valeur, repli) {\n96\t  return Number.isFinite(valeur) ? valeur : repli\n97\t}\n98\t\n99\t// L'ORDRE DE PEINTURE, du fond vers le premier plan. C'est cette liste que la compilation écrit\n100\t// dans le DOM, et c'est aussi celle que la hiérarchie affiche À L'ENVERS, puisqu'une pile de calques\n101\t// se lit du haut, c'est-à-dire du plus proche de l'œil.\n102\texport function paintOrder(composition) {\n103\t  return readLayers(composition).sort((a, b) => a.z - b.z || a.serial - b.serial)\n104\t}\n105\t\n106\texport function stackOrder(composition) {\n107\t  return paintOrder(composition).reverse()\n108\t}\n109\t\n110\tfunction ecrire(composition, layers) {\n111\t  const seri