 () => notify(await copyText(plan.command) ? 'Commande copiée.' : 'Copie refusée.', 'ok')}>Copier la commande</button>\n                  <button className=\"zrm-btn zrm-btn-sm\" onClick={async () => notify(await copyText(plan.script) ? 'Script de rendu copié.' : 'Copie refusée.', 'ok')}>Copier le script</button>\n                </div>\n                <span className=\"zrm-label\">Sonde de vérification</span>\n                <pre className=\"zrm-pre\">{plan.probe}</pre>\n                <span className=\"zrm-label\" style={{ marginTop: 10 }}>Marche à suivre</span>\n                <ol className=\"zrm-note\" style={{ paddingLeft: 16, margin: '4px 0 0' }}>\n                  {plan.steps.map((s, i) => <li key={i} style={{ marginBottom: 3 }}>{s}</li>)}\n                </ol>\n              </>\n            ) : (\n              <p className=\"zrm-note\">\n                La Forge s’active sur un format temporel (Vidéo 16:9 ou Habillage alpha). Le rendu vidéo ne tourne pas dans le navigateur :\n                une image RGBA 4K pèse 33,18 Mo et la réponse serverless du projet plafonne à ~4,5 Mo. La Forge produit ici le pipeline local exact, reproductible.\n              </p>\n            )\n          )}\n\n          {deckTab === 'log' && (\n            <>\n              {log.length === 0 && <p className=\"zrm-note\">Aucun livrable produit pour l’instant. Chaque export écrit sa ligne ici : thème, format, poids, empreinte.</p>}\n              {log.map((entry, i) => (\n                <div key={i} className=\"zrm-issue\" data-sev=\"info\" style={{ display: 'block' }}>\n                  <div style={{ fontSize: 11.5 }}>{entry.title} — {entry.kind.toUpperCase()}</div>\n                  <div className=\"zrm-mono\" style={{ marginTop: 2 }}>{entry.theme} · {entry.format} · {formatBytes(entry.bytes)} · {entry.checksum}</div>\n                </div>\n              ))}\n              {log.length > 0 && <button className=\"zrm-btn zrm-btn-sm\" onClick={() => setLog(clearLog())}>Vider le journal</button>}\n            </>\n          )}\n        </div>\n      </section>\n\n      {/* ---- BIBLIOTHÈQUE : famille → thème actif → groupes → composants ---- */}\n      <section className=\"zrm-panel zrm-library zrm-zone-palette\">\n        <header className=\"zrm-library-head\">\n          <div className=\"zrm-library-tabs\">\n            {[\n              ['components', 'Composants'],\n              ['images', 'Images'],\n              ['icons', 'Icônes'],\n            ].map(([key, label]) => (\n              <button key={key} className=\"zrm-btn zrm-btn-sm\" data-on={libraryTab === key} onClick={() => setLibraryTab(key)}>{label}</button>\n            ))}\n          </div>\n          <div className=\"zrm-library-search\">\n            <Icon name=\"magnifyingglass\" size={13} />\n            <input aria-label=\"Rechercher dans la bibliothèque\" value={libraryQuery}\n              placeholder={libraryTab === 'images' ? 'Rechercher une image indexée…' : 'Rechercher un composant…'}\n              onChange={(e) => setLibraryQuery(e.target.value)} />\n          </div>\n          <span className=\"zrm-mono\">{FAMILIES[theme?.family] || theme?.familyLabel || 'Famille'} · {theme?.name}</span>\n        </header>\n\n        <div className=\"zrm-library-body\">\n          {libraryTab === 'images' ? (\n            <>\n              {!imageIndexReady && <span className=\"zrm-library-note\">Chargement de l’index d’images…</span>}\n              {imageIndexReady && imageResults.length === 0 && <span className=\"zrm-library-note\">Aucune image trouvée.</span>}\n              <div className=\"zrm-library-images\">\n                {imageResults.map((image) => (\n                  <button key={image.path} className=\"zrm-library-image\" title={image.path}\n                    draggable\n                    onDragStart={(e) => e.dataTransfer.setData('application/x-zenray-image', image.path)}\n                    onClick={() => addLibraryImage(image)}>\n                    <img src={image.url} alt=\"\" />\n                    <span>{image.name}</span>\n                  </button>\n                ))}\n              </div>\n            </>\n          ) : (\n            Object.entries(componentGroups).map(([group, entries]) => {\n              const open = openComponentGroups[group] !== false\n              return (\n                <div key={group} className=\"zrm-library-group\" data-open={open}>\n                  <button className=\"zrm-library-group-head\" onClick={() => setOpenComponentGroups((state) => ({ ...state, [group]: !open }))}>\n                    <Icon name=\"chevron.right\" size={10} />{group}<span>{entries.length}</span>\n                  </button>\n                  {open && <div className=\"zrm-library-cards\">\n                    {entries.map((entry) => (\n                      <button key={entry.id} className=\"zrm-library-card\" draggable\n                        title={`Ajouter ${entry.name}`}\n                        onDragStart={(e) => {\n                          e.dataTransfer.effectAllowed = 'copy'\n                          e.dataTransfer.setData('application/x-zenray-component', entry.id)\n                        }}\n                        onClick={() => addLibraryComponent(entry)}>\n                        <span className=\"zrm-library-card-icon\">{libraryTab === 'icons' ? '◇' : '+'}</span>\n                        <span><b>{entry.name}</b><small>{entry.id}</small></span>\n                      </button>\n                    ))}\n                  </div>}\n                </div>\n              )\n            })\n          )}\n        </div>\n\n        <footer className=\"zrm-render\">\n          <div className=\"zrm-chips\">\n            {FORMATS.map((f) => (\n              <button key={f.id} className=\"zrm-chip\" data-on={f.id === formatId} onClick={() => { setFormatId(f.id); setActionCount((n) => n + 1) }} title={f.label}>\n                {f.short}\n              </button>\n            ))}\n          </div>\n          <span className=\"zrm-head-spacer\" />\n          {busy && <div className=\"zrm-progress\"><i style={{ width: '65%' }} /></div>}\n          <button className=\"zrm-btn\" onClick={() => runExport('text')} disabled={!compiled || !!busy}>Copier le texte</button>\n          {format.kind === 'print' && <button className=\"zrm-btn\" onClick={() => runExport('pdf')} disabled={!compiled || !!busy}>PDF</button>}\n          {['still', 'video', 'overlay'].includes(format.kind) && <button className=\"zrm-btn\" onClick={() => runExport('png')} disabled={!compiled || !!busy}>Image PNG</button>}\n          <button className=\"zrm-btn\" onClick={() => runExport('html')} disabled={!compiled || !!busy}>Fichier HTML</button>\n          <button className=\"zrm-btn zrm-btn-primary\" onClick={publishNow} disabled={!compiled || !!busy} title=\"Écrit une page dans Create, l’indexe et copie son adresse\">\n            {busy === 'publish' ? 'Publication…' : 'Publier'}\n          </button>\n          <span className=\"zrm-mono\" title=\"Règle des trois actions : note → thème → rendre\">{actionCount} action{actionCount > 1 ? 's' : ''}</span>\n        </footer>\n      </section>\n\n      {toast && <div className=\"zrm-toast\" data-kind={toast.kind}>{toast.message}</div>}\n      {/* ZONE 8 · BARRE DU BAS. Elle dit l'état, elle ne commande rien : le document, sa\n          sauvegarde, le thème et le format. C'est la ligne qu'on lit sans la chercher. */}\n      <div className=\"zrm-panel zrm-zone-status\">\n        <span>{docPath || 'document non enregistré'}</span>\n        <span style={{ opacity: .5 }}>· {theme?.name || '—'}</span>\n        <span style={{ opacity: .5 }}>· {format.label}</span>\n        <span style={{ marginLeft: 'auto', opacity: .5 }}>{issues.length ? `${issues.length} remarque(s)` : 'aucune remarque'}</span>\n      </div>\n    </div>\n  )\n}","numLines":290,"startLine":989,"totalLines":1279}},"sourceToolAssistantUUID":"a0122e28-4f16-48d0-8a7d-ea2b5998