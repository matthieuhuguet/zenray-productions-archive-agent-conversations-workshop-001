.length > 6)\n  if (classe) return classe.replace(/^zrm-/, '').replace(/-/g, ' ')\n  const tag = el.tagName.toLowerCase()\n  const titres = { h1: 'Titre 1', h2: 'Titre 2', h3: 'Titre 3', h4: 'Titre 4', p: 'Paragraphe', a: 'Lien', img: 'Image', ul: 'Liste', li: 'Élément', button: 'Bouton', nav: 'Navigation', header: 'En-tête', footer: 'Pied', section: 'Section', figure: 'Figure', time: 'Date', span: 'Texte', svg: 'Icône', use: 'Icône' }\n  return titres[tag] || tag\n}\n\n// Le texte propre d'un nœud, c'est-à-dire celui qu'il porte LUI-MÊME et non celui de ses enfants.\n// La distinction est ce qui rend l'édition sûre : modifier le texte d'un conteneur effacerait\n// toute sa descendance, ce que personne n'attend en tapant dans un champ.\nfunction texteDirect(el) {\n  let out = ''\n  for (const enfant of el.childNodes) {\n    if (enfant.nodeType === 3) out += enfant.nodeValue\n  }\n  return out.trim()\n}\n\nfunction noeudsEnfants(el) {\n  return [...el.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n}\n\nfunction construire(el, chemin, profondeur) {\n  // Une profondeur maximale, parce qu'un tableau SVG imbriqué produirait des centaines de nœuds\n  // pour une seule icône, et qu'un arbre qu'on ne peut pas parcourir ne vaut pas mieux qu'aucun.\n  const enfants = profondeur >= 6 ? [] : noeudsEnfants(el).map((c, i) => construire(c, chemin ? `${chemin}.${i}` : String(i), profondeur + 1))\n  return {\n    path: chemin,\n    tag: el.tagName.toLowerCase(),\n    name: nommer(el),\n    text: texteDirect(el),\n    editable: texteDirect(el).length > 0,\n    children: enfants,\n  }\n}\n\n/**\n * L'arbre des sous-composants d'une page compilée, indexé par identifiant d'instance.\n * @returns {Record<string, {path:string,tag:string,name:string,text:string,children:any[]}[]>}\n */\nexport function parseTree(html) {\n  if (!disponible() || typeof html !== 'string' || !html) return {}\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  const out = {}\n