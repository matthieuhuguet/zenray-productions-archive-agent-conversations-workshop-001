,text:string,children:any[]}[]>}\n100\t */\n101\texport function parseTree(html) {\n102\t  if (!disponible() || typeof html !== 'string' || !html) return {}\n103\t  const doc = new DOMParser().parseFromString(html, 'text/html')\n104\t  const out = {}\n105\t  for (const hote of doc.querySelectorAll('[data-zrm-instance]')) {\n106\t    const id = hote.getAttribute('data-zrm-instance')\n107\t    out[id] = noeudsEnfants(hote).map((c, i) => construire(c, String(i), 0))\n108\t  }\n109\t  return out\n110\t}\n111\t\n112\t/** Le nœud désigné par son chemin, ou null. */\n113\texport function findNode(arbre, instanceId, path) {\n114\t  let liste = arbre?.[instanceId]\n115\t  if (!Array.isArray(liste) || !path) return null\n116\t  const indices = String(path).split('.').map(Number)\n117\t  let noeud = null\n118\t  for (const i of indices) {\n119\t    noeud = liste?.[i]\n120\t    if (!noeud) return null\n121\t    liste = noeud.children\n122\t  }\n123\t  return noeud\n124\t}\n125\t\n126\t/** Le chemin d'un élément DANS son hôte, calculé exactement comme `construire` le numérote. */\n127\texport function pathOfElement(el, hote) {\n128\t  const indices = []\n129\t  let courant = el\n130\t  while (courant && courant !== hote) {\n131\t    const parent = courant.parentElement\n132\t    if (!parent) return null\n133\t    const fratrie = [...parent.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n134\t    const i = fratrie.indexOf(courant)\n135\t    if (i < 0) return null\n136\t    indices.unshift(i)\n137\t    courant = parent\n138\t  }\n139\t  return courant === hote ? indices.join('.') : null\n140\t}\n141\t\n142\tfunction styleEnLigne(reglages) {\n143\t  return Object.entries(reglages || {})\n144\t    .filter(([clef, valeur]) => CLEFS_STYLE.has(clef) && typeof valeur === 'string' && valeur.trim())\n145\t    // camelCase vers tiret : `fontSize` devient `font-size`.\n146\t    .map(([clef, valeur]) => `${clef.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${valeur.replace(/[;<>\"']/g, '')}`)\n147\t    .join(';')\n148\t}\n149\t\n150\t/**\n151\t * Applique les réglages de sous-composants à une page compilée.\n152\t *\n153\t * Les réglages arrivent sous la forme `{ [instanceId]: { [path]: { text, style } } }`, exactement\n154\t * la forme sous laquelle ils sont enregistrés dans `item.props.__nodes`. Un chemin devenu\n155\t * introuvable, parce que le composant a changé, est IGNORÉ sans bruit : un réglage orphelin ne doit\n156\t * jamais empêcher une page de se rendre.\n157\t */\n158\texport function applyOverrides(html, reglagesParInstance) {\n159\t  if (!disponible() || !reglagesParInstance || !Object.keys(reglagesParInstance).length) return html\n\n... [81 lines truncated] ...","displayPath":"../Productions/GithubProductions/ZenRayProgress/src/zenraymedia/nodes.js"},"type":"attachment","uuid":"cf379350-0626-493a-9ccb-42e5ad97bf58","timestamp":"2026-08-04T08:38:17.951Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"dd3dbff7-8101-4996-9a8f-e69e4841d77c","version":"2.1.221","gitBranch":"main"}
