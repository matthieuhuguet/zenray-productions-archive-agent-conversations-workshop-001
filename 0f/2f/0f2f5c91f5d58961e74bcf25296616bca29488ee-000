{"parentUuid":"f16ee20e-572d-4496-86ce-10dfa4efdfff","isSidechain":false,"promptId":"62bc6338-3371-4bd1-8d69-bb3ae74939dc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EQR1a1w11XwAA82sikHkxE","type":"tool_result","content":"690\t\n691\t  if (!project) return <div style={{ padding: 24 }}>Aucun brief.</div>\n692\t\n693\t  const rt = cut ? readingTimeOf(cut) : { words: 0, minutes: 0 }\n694\t  const briefErrors = validate('brief', project.brief)\n695\t  const errorFor = (field) => briefErrors.find((e) => e.field === field)?.message\n696\t\n697\t\n698\t\n699\t  return (\n700\t    <div className=\"zrm-shell\" data-panes={panes} style={{ '--zrm-accent': UI.blue }}>\n701\t      {/* ---- Barre de commande : SEUL point d'entrée des actions rares ---- */}\n702\t      <div className=\"zrm-panel zrm-bar zrm-zone-menu\" style={{ flexDirection: 'row' }}>\n703\t        <Icon name=\"magnifyingglass\" size={15} />\n704\t        <input\n705\t          ref={queryRef}\n706\t          value={query}\n707\t          placeholder=\"Rechercher une action, un thème, un format…\"\n708\t          onChange={(e) => { setQuery(e.target.value); setPaletteOpen(true) }}\n709\t          onFocus={() => setPaletteOpen(true)}\n710\t          onKeyDown={(e) => {\n711\t            if (e.key === 'ArrowDown') { e.preventDefault(); setPaletteIndex((i) => Math.min(i + 1, filteredCommands.length - 1)) }\n712\t            else if (e.key === 'ArrowUp') { e.preventDefault(); setPaletteIndex((i) => Math.max(i - 1, 0)) }\n713\t            else if (e.key === 'Enter' && filteredCommands[paletteIndex]) { e.preventDefault(); runCommand(filteredCommands[paletteIndex]) }\n714\t          }}\n715\t        />\n716\t        <span className=\"zrm-kbd\">⌘K</span>\n717\t        <select className=\"zrm-select\" aria-label=\"Brief courant\" style={{ width: 200, flex: '0 0 auto' }} value={currentId} onChange={(e) => setCurrentId(e.target.value)}>\n718\t          {projects.map((p) => <option key={p.id} value={p.id}>{p.brief.title || 'Sans titre'}</option>)}\n719\t        </select>\n720\t        <button className=\"zrm-btn zrm-btn-icon\" title=\"Ouvrir un document depuis Create\" onClick={() => setBrowser('open')}><Icon name=\"folder\" size={14} /></button>\n721\t        <button className=\"zrm-btn zrm-btn-icon\" title={docPath ? `Enregistrer (${docPath})` : 'Enregistrer dans Create…'} onClick={() => { if (docPath) persist(docPath); else setBrowser('save') }} disabled={busy === 'save'}><Icon name=\"arrow.down.right\" size={14} /></button>\n722\t        {/* REPLI DES PANNEAUX (zone 2, Outils rapides). Trois etats et non deux : trois colonnes pour\n723\t            travailler, deux pour gagner la largeur des Details quand on cadre, une pour ne garder que\n724\t            l'apercu quand on juge le rendu. Le libelle affiche le nombre COURANT, pas le suivant, sans\n725\t            quoi personne ne sait ou il en est. */}\n726\t        <button className=\"zrm-btn zrm-btn-icon\" title={`Panneaux : ${panes === 'three' ? 'trois' : panes === 'two' ? 'deux' : 'un'} — cliquer pour replier`}\n727\t          onClick={() => setPanes((p) => (p === 'three' ? 'two' : p === 'two' ? 'one' : 'three'))}><Icon name=\"sidebar.left\" size={14} /></button>\n728\t        <button className=\"zrm-btn zrm-btn-icon\" title=\"Nouveau brief\" onClick={newProject}><Icon name=\"plus\" size={14} /></button>\n729\t        <button className=\"zrm-btn zrm-btn-icon\" title=\"Dupliquer\" onClick={duplicateProject}><Icon name=\"doc.text\" size={14} /></button>\n730\t        <button className=\"zrm-btn zrm-btn-icon\" title=\"Supprimer\" onClick={deleteProject}><Icon name=\"trash\" size={14} /></button>\n731\t\n732\t        {paletteOpen && filteredCommands.length > 0 && (\n733\t          <div className=\"zrm-palette\" onMouseLeave={() => setPaletteOpen(false)}>\n734\t            {filteredCommands.map((c, i) => (\n735\t              <button key={c.id} className=\"zrm-palette-item\" data-active={i === paletteIndex} onMouseEnter={() => setPaletteIndex(i)} onClick={() => runCommand(c)}>\n736\t                <span>{c.label}</span>\n737\t                <span className=\"zrm-palette-hint\">{c.hint}</span>\n738\t              </button>\n739\t            ))}\n740\t          </div>\n741\t        )}\n742\t      </div>\n743\t\n744\t      {/* ---- ARTICLE : le brief ET le texte éditable, dans une seule colonne ----\n745\t           Retrait 2026-07-25 (retour Matthieu) : « registre » et « intention » n'apportaient rien\n746\t           à l'écran ni sur la page partagée -- ils restent dans le modèle de données (le Critique\n747\t           s'en sert pour l'appel à l'action) mais ne prennent plus de place. À leur place, ce qui\n748\t           compte vraiment : l'ARTICLE, directement modifiable à côté de son aperçu. L'onglet\n749\t           « Partition » a disparu du centre : un onglet de moins à traverser pour éditer un mot. */}\n750\t      {/* ZONE 2 · OUTILS RAPIDES. Bande fine sous le menu, à la place qu'occupe la barre Compile\n751\t          d'Unreal. Elle ne DUPLIQUE pas le sélecteur de format, qui vit déjà à trois endroits :\n752\t          elle porte le repli des panneaux, l'échelle et le verdict, c'est-à-dire ce qui pilote la\n753\t          VUE et non le document. */}\n754\t      <div className=\"zrm-panel zrm-zone-tools\">\n755\t        <button className=\"zrm-btn zrm-btn-sm\" title={`Panneaux : ${panes === 'three' ? 'trois' : panes === 'two' ? 'deux' : 'un'}`}\n756\t          onClick={() => setPanes((p) => (p === 'three' ? 'two' : p === 'two' ? 'one' : 'three'))}>\n757\t          <Icon name=\"sidebar.left\" size={13} />\n758\t        </button>\n759\t        <span style={{ opacity: .5 }}>{format.label}</span>\n760\t        <span style={{ opacity: .5 }}>· {Math.round((contentScale || 1) * 100)} %</span>\n761\t        <span style={{ marginLeft: 'auto', opacity: .6 }}>\n762\t          {compiled?.error ? 'erreur de compilation' : `${countItems(composition)} pièce(s) posée(s)`}\n763\t        </span>\n764\t      </div>\n765\t\n766\t      {/* ZONE 7 · ANIMATIONS. La timeline est HORS V1 par décision écrite du plan : elle\n767\t          réinventerait `cut.js`, qui est déjà la partition temporelle du produit, et son champ\n768\t          serait détruit à chaque geste tant que le contrat n'a pas été ouvert pour elle. La zone\n769\t          existe donc, vide et nommée, plutôt qu'absente : une zone manquante se redécouvre, une\n770\t          zone vide s'explique. */}\n771\t      <section className=\"zrm-panel zrm-zone-anim\">\n772\t        <header className=\"zrm-head\"><span className=\"zrm-head-title\">Animations</span></header>\n773\t        <div className=\"zrm-body\" style={{ display: 'grid', placeItems: 'center', opacity: .45, fontSize: 12 }}>\n774\t          Aucune animation · la timeline arrive en V2\n775\t        </div>\n776\t      </section>\n777\t\n778\t      <section className=\"zrm-panel zrm-pane-structure zrm-zone-hier\">\n779\t        <header className=\"zrm-head\">\n780\t          <span className=\"zrm-head-title\">Structure</span>\n781\t          <span className=\"zrm-head-spacer\" />\n782\t          {docPath\n783\t            ? <span className=\"zrm-saved\" title={docPath}><Icon name=\"checkmark\" size={11} />{docPath.replace(/^pages\\//, '').replace(/\\.zmedia\\.json$/, '')}</span>\n784\t            : <span className=\"zrm-saved\">non enregistré</span>}\n785\t          <span className=\"zrm-mono\">{rt.words} mots · {rt.minutes} min</span>\n786\t        </header>\n787\t        <div className=\"zrm-body\">\n788\t          <div className=\"zrm-structure-head\">\n789\t            <span className=\"zrm-label\">Lego · {countItems(composition)} élément{countItems(composition) > 1 ? 's' : ''}</span>\n790\t            <span>Glisse sur un bord pour poser au-dessus, dessous, à gauche ou à droite.</span>\n791\t          </div>\n792\t          <div className=\"zrm-structure\"\n793\t            onDragOver={(e) => { if (!composition.rows.length) e.preventDefault() }}\n794\t            onDrop={onEmptyStructureDrop}\n795\t            onDragLeave={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) setDropTarget(null) }}>\n796\t            {composition.rows.length === 0 && (\n797\t              <button className=\"zrm-structure-empty\" onClick={() => setLibraryTab('components')}>\n798\t                Le template actuel reste intact. Choisis un composant dans la bibliothèque du bas pour commencer.\n799\t              </button>\n800\t            )}\n801\t            {composition.rows.map((row) => (\n802\t              <div key={row.id} className=\"zrm-structure-row\">\n803\t                {row.items.map((item) => (\n804\t                  <div key={item.id} className=\"zrm-structure-item\"\n805\t                    draggable={!item.locked}\n806\t                    data-on={selectedComponent === item.id}\n807\t                    data-hidden={item.hidden}\n808\t                    data-drop={dropTarget?.id === item.id ? dropTarget.placement : undefined}\n809\t                    onClick={() => setSelectedComponent(item.id)}\n810\t                    onDragStart={(e) => {\n811\t                      e.dataTransfer.effectAllowed = 'move'\n812\t                      e.dataTransfer.setData('application/x-zenray-instance', item.id)\n813\t                    }}\n814\t                    onDragOver={(e) => onStructureDragOver(e, item.id)}\n815\t                    onDrop={(e) => onStructureDrop(e, item.id)}>\n816\t                    <span className=\"zrm-structure-grip\">⠿</span>\n817\t                    <span className=\"zrm-structure-name\">{item.name}</span>\n818\t                    <span className=\"zrm-structure-kind\">{item.kind === 'image' ? 'Image' : item.group}</span>\n819\t                    <span className=\"zrm-structure-actions\">\n820\t                      <button title={item.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { hidden: !item.hidden })) }}><Icon name=\"eye\" size={11} /></button>\n821\t                      <button title={item.locked ? 'Déverrouiller' : 'Verrouiller'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { locked: !item.locked })) }}><Icon name=\"lock\" size={11} /></button>\n822\t                      <button title=\"Dupliquer\" onClick={(e) => { e.stopPropagation(); patchComposition((current) => duplicateItem(current, item.id)) }}><Icon name=\"doc.text\" size={11} /></button>\n823\t                      <button title=\"Retirer le composant\" onClick={(e) => { e.stopPropagation(); patchComposition((current) => removeItem(current, item.id)); if (selectedComponent === item.id) setSelectedComponent(null) }}><Icon name=\"trash\" size={11} /></button>\n824\t                    </span>\n825\t                  </div>\n826\t                ))}\n827\t              </div>\n828\t            ))}\n829\t          </div>\n830\t\n831\t          <div className=\"zrm-brief-divider\"><span>Contenu de l’article</span></div>\n832\t          <label className=\"zrm-field\">\n833\t            <span className=\"zrm-label\">Titre</span>\n834\t            <input className=\"zrm-input\" aria-label=\"Titre de travail\" value={project.brief.title} onChange={(e) => patchBrief({ title: e.target.value })} />\n835\t            {errorFor('title') && <span className=\"zrm-error\">{errorFor('title')}</span>}\n836\t          </label>\n837\t\n838\t          <label className=\"zrm-field\">\n839\t            <span className=\"zrm-label\">Message — une seule phrase</span>\n840\t            <textarea className=\"zrm-textarea\" aria-label=\"Message\" style={{ minHeight: 58 }} value={project.brief.message} onChange={(e) => patchBrief({ message: e.target.value })} />\n841\t            {errorFor('message') && <span className=\"zrm-error\">{errorFor('message')}</span>}\n842\t          </label>\n843\t\n844\t          <label className=\"zrm-field\">\n845\t            <span className=\"zrm-label\">Public</span>\n846\t            <input className=\"zrm-input\" aria-label=\"Public\" value={project.brief.audience} onChange={(e) => patchBrief({ audience: e.target.value })} />\n847\t            {errorFor('audience') && <span className=\"zrm-error\">{errorFor('audience')}</span>}\n848\t          </label>\n849\t\n850\t          {/* Les blocs de l'article, modifiables ici même. */}\n851\t          <div style={{ display: 'flex', alignItems: 'center', gap: 8, margin: '16px 0 8px' }}>\n852\t            <span className=\"zrm-label\" style={{ margin: 0 }}>Blocs{cut ? ` · ${cut.beats.length}` : ''}</span>\n853\t            <span className=\"zrm-head-spacer\" />\n854\t            {cut && <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => refitCut(c, theme))} disabled={cut.locked} title=\"Réajuster le nombre de blocs au thème\">Réajuster</button>}\n855\t            {cut && <button className=\"zrm-btn zrm-btn-sm\" data-on={cut.locked} onClick={() => withCut((c) => ({ ...c, locked: !c.locked }))} title=\"Un article verrouillé ne bouge plus quand on essaie d’autres thèmes\">{cut.locked ? 'Verrouillé' : 'Verrouiller'}</button>}\n856\t          </div>\n857\t\n858\t          {!cut ? (\n859\t            <p className=\"zrm-note\">Aucun bloc. Colle tes notes plus bas puis « Monter l’article ».</p>\n860\t          ) : cut.beats.map((beat, i) => (\n861\t            <div key={beat.id} className=\"zrm-beat\" data-on={i === selectedBeat} onFocusCapture={() => setSelectedBeat(i)}\n862\t              onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); e.currentTarget.dataset.drop = 'true' } }}\n863\t              onDragLeave={(e) => { delete e.currentTarget.dataset.drop }}\n864\t              onDrop={(e) => { if (e.dataTransfer.files?.length) { e.preventDefault(); delete e.currentTarget.dataset.drop; attachImages(i, e.dataTransfer.files) } }}>\n865\t              <div className=\"zrm-beat-top\">\n866\t                <select className=\"zrm-beat-role\" aria-label={`Rôle du bloc ${i + 1}`} value={beat.role} onChange={(e) => withCut((c) => updateBeat(c, i, { role: e.target.value }))}>\n867\t                  {BEAT_ROLES.map((r) => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}\n868\t                </select>\n869\t                <span className=\"zrm-beat-meta\">\n870\t                  {i + 1}/{cut.beats.length}\n871\t                  {isTemporal(format) ? ` · ${beatDuration(beat)}s` : ''}\n872\t                </span>\n873\t              </div>\n874\t              <textarea className=\"zrm-beat-text\" aria-label={`Texte du bloc ${i + 1}`} value={beat.text} onChange={(e) => withCut((c) => updateBeat(c, i, { text: e.target.value }))} />\n875\t              {(beat.slots || []).length > 0 && (\n876\t                <div className=\"zrm-slots-strip\">\n877\t                  {beat.slots.map((slot, si) => (\n878\t                    <div key={si} className=\"zrm-slot-thumb\" title={slot.label || 'image'}>\n879\t                      {slot.dataUrl ? <img src={slot.dataUrl} alt={slot.label || ''} /> : <span>{slot.kind}</span>}\n880\t                      <button className=\"zrm-slot-remove\" title=\"Retirer l’image\" onClick={() => withCut((c) => removeSlot(c, i, si))}>×</button>\n881\t                    </div>\n882\t                  ))}\n883\t                </div>\n884\t              )}\n885\t              <div className=\"zrm-beat-actions\">\n886\t                <label className=\"zrm-btn zrm-btn-sm\" title={`Ajouter une image (${(beat.slots || []).length}/${MAX_SLOTS})`} style={{ cursor: (beat.slots || []).length >= MAX_SLOTS ? 'not-allowed' : 'pointer' }}>\n887\t                  <Icon name=\"photo\" size={12} />\n888\t                  <input type=\"file\" accept=\"image/*\" multiple aria-label={`Images du bloc ${i + 1}`} style={{ display: 'none' }}\n889\t                    disabled={(beat.slots || []).length >= MAX_SLOTS || busy === 'image'}\n890\t                    onChange={(e) => { attachImages(i, e.target.files); e.target.value = '' }} />\n891\t                </label>\n892\t                <button className=\"zrm-btn zrm-btn-sm\" title=\"Monter\" onClick={() => withCut((c) => moveBeat(c, i, Math.max(0, i - 1)))} disabled={i === 0}>↑</button>\n893\t                <button className=\"zrm-btn zrm-btn-sm\" title=\"Descendre\" onClick={() => withCut((c) => moveBeat(c, i, Math.min(cut.beats.length - 1, i + 1)))} disabled={i === cut.beats.length - 1}>↓</button>\n894\t                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => mergeBeats(c, i))} disabled={i >= cut.beats.length - 1}>Fusionner</button>\n895\t                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => splitBeat(c, i))}>Scinder</button>\n896\t                <button className=\"zrm-btn zrm-btn-sm\" title=\"Insérer un bloc après\" onClick={() => withCut((c) => addBeat(c, i))}>+</button>\n897\t                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => removeBeat(c, i))} disabled={cut.beats.length <= 1}>Retirer</button>\n898\t              </div>\n899\t            </div>\n900\t          ))}\n901\t\n902\t          <details style={{ marginTop: 14 }}>\n903\t            <summary className=\"zrm-label\" style={{ cursor: 'pointer', marginBottom: 8 }}>Notes source</summary>\n904\t            <textarea className=\"zrm-textarea\" aria-label=\"Notes\" style={{ minHeight: 130 }} value={project.notes} onChange={(e) => patchProject({ notes: e.target.value })} />\n905\t            <div className=\"zrm-row\" style={{ marginTop: 8 }}>\n906\t              <button className=\"zrm-btn zrm-btn-sm\" onClick={buildCutNow} disabled={!theme}>Monter l’article</button>\n907\t              <button className=\"zrm-btn zrm-btn-sm\" onClick={() => patchProject({ notes: SEED_NOTES })}>Notes d’exemple</button>\n908\t            </div>\n909\t            <p className=\"zrm-note\" style={{ marginTop: 6 }}>Une ligne vide sépare deux blocs. Remonter l’article écrase les blocs modifiés à la main.</p>\n910\t          </details>\n911\t        </div>\n912\t      </section>\n913\t\n914\t      {/* ---- STAGE ---- */}\n915\t      <section className=\"zrm-panel zrm-zone-viewport\">\n916\t        <header className=\"zrm-head\">\n917\t          <span className=\"zrm-head-title\">Aperçu</span>\n918\t          <span className=\"zrm-head-spacer\" />\n919\t          <span className=\"zrm-mono\">\n920\t            {format.canvas.w}{format.canvas.h ? `×${format.canvas.h}` : ' · libre'}\n921\t            {isTemporal(format) && cut ? ` · ${durationOf(cut, format)}s` : ''}\n922\t            {compiled?.meta?.scale && compiled.meta.scale !== 1 ? ` · échelle ${compiled.meta.scale}` : ''}\n923\t            {compiled?.meta?.omitted > 0 ? ` · ${compiled.meta.shown}/${compiled.meta.shown + compiled.meta.omitted} blocs` : ''}\n924\t          </span>\n925\t          <button className=\"zrm-btn zrm-btn-icon\" title={renderDark ? 'Rendu en clair' : 'Rendu en sombre'} data-on={renderDark} onClick={() => setRenderDark((v) => !v)}>\n926\t            <Icon name={renderDark ? 'sun.max' : 'moon'} size={14} />\n927\t          </button>\n928\t          {format.safe && (\n929\t            <button className=\"zrm-btn zrm-btn-icon\" title=\"Zones de sécurité\" data-on={showSafe} onClick={() => setShowSafe((v) => !v)}>\n930\t              <Icon name=\"rectangle.dashed\" size={14} />\n931\t            </button>\n932\t          )}\n933\t        </header>\n934\t\n935\t        <div className=\"zrm-stage-body\" ref={stageRef}>\n936\t          {themeError ? (\n937\t            <p className=\"zrm-stage-empty\">{themeError}</p>\n938\t          ) : !compiled ? (\n939\t            <p className=\"zrm-stage-empty\">Complète le titre, le message d’une phrase et le public. L’aperçu est la page réelle, pas une approximation.</p>\n940\t          ) : compiled.error ? (\n941\t            <p className=\"zrm-stage-empty\">{compiled.error}</p>\n942\t          ) : (\n943\t            <div className=\"zrm-canvas\" style={{ width: format.canvas.w * fitScale, height: stageHeight * fitScale }}>\n944\t              <iframe\n945\t                ref={frameRef}\n946\t                title=\"Aperçu ZenRayMedia\"\n947\t                onLoad={onFrameLoad}\n948\t                srcDoc={debouncedHtml}\n949\t                sandbox=\"allow-same-origin\"\n950\t                style={{ width: format.canvas.w, height: stageHeight, transform: `scale(${fitScale})`, transformOrigin: '0 0' }}\n951\t              />\n952\t              {showSafe && format.safe && (\n953\t                <div className=\"zrm-safe-overlay\">\n954\t                  <i style={{ left: 0, right: 0, top: 0, height: format.safe.top * fitScale }} />\n955\t                  <i style={{ left: 0, right: 0, bottom: 0, height: format.safe.bottom * fitScale }} />\n956\t                  <i style={{ top: 0, bottom: 0, left: 0, width: format.safe.sides * fitScale }} />\n957\t                  <i style={{ top: 0, bottom: 0, right: 0, width: format.safe.sides * fitScale }} />\n958\t                </div>\n959\t              )}\n960\t            </div>\n961\t          )}\n962\t        </div>\n963\t      </section>\n964\t\n965\t      {/* ---- DECK ---- */}\n966\t      <section className=\"zrm-panel zrm-pane-details zrm-zone-details\">\n967\t        <header className=\"zrm-head\" style={{ gap: 4 }}>\n968\t          {DECK_TABS.map((tab) => (\n969\t            <button key={tab.key} className=\"zrm-btn zrm-btn-sm\" data-on={deckTab === tab.key} onClick={() => setDeckTab(tab.key)}>\n970\t              {tab.label}{tab.key === 'critic' && issues.length ? ` · ${issues.length}` : ''}\n971\t            </button>\n972\t          ))}\n973\t        </header>\n974\t        <div className=\"zrm-body\">\n975\t          {/* DÉTAILS DE LA PIÈCE SÉLECTIONNÉE. Vider un champ le fait REVENIR au brief au lieu de\n976\t              l'effacer : `resolveItemData` ne retient que les chaînes non vides, et c'est ce qui\n977\t              distingue « jamais renseigné » de « renseigné puis vidé » dans une interface où le\n978\t              modèle, lui, ne les distingue pas. */}\n979\t          {pieceSelectionnee && champsDeclares.length > 0 && (\n980\t            <div className=\"zrm-field-group\" style={{ marginBottom: 12 }}>\n981\t              <div className=\"zrm-head-title\" style={{ marginBottom: 6 }}>Détails · {pieceSelectionnee.componentId}</div>\n982\t              {champsDeclares.map((champ) => (\n983\t                <label key={champ.key} className=\"zrm-field\" style={{ display: 'block', marginBottom: 6 }}>\n984\t                  <span style={{ display: 'block', opacity: .7, marginBottom: 2 }}>{champ.key}</span>\n985\t                  <input\n986\t                    className=\"zrm-input\"\n987\t                    type={champ.type === 'color' ? 'color' : champ.type === 'number' ? 'number' : 'text'}\n988\t                    value={pieceSelectionnee.props?.[champ.key] ?? ''}\n989\t                    placeholder=\"valeur du brief\""}]},"uuid":"6f5ad29f-4881-4f02-924b-cd273e5f344c","timestamp":"2026-08-04T06:18:50.805Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/MediaApp.jsx","content":"\n  if (!project) return <div style={{ padding: 24 }}>Aucun brief.</div>\n\n  const rt = cut ? readingTimeOf(cut) : { words: 0, minutes: 0 }\n  const briefErrors = validate('brief', project.brief)\n  const errorFor = (field) => briefErrors.find((e) => e.field === field)?.message\n\n\n\n  return (\n    <div className=\"zrm-shell\" data-panes={panes} style={{ '--zrm-accent': UI.blue }}>\n      {/* ---- Barre de commande : SEUL point d'entrée des actions rares ---- */}\n      <div className=\"zrm-panel zrm-bar zrm-zone-menu\" style={{ flexDirection: 'row' }}>\n        <Icon name=\"magnifyingglass\" size={15} />\n        <input\n          ref={queryRef}\n          value={query}\n          placeholder=\"Rechercher une action, un thème, un format…\"\n          onChange={(e) => { setQuery(e.target.value); setPaletteOpen(true) }}\n          onFocus={() => setPaletteOpen(true)}\n          onKeyDown={(e) => {\n            if (e.key === 'ArrowDown') { e.preventDefault(); setPaletteIndex((i) => Math.min(i + 1, filteredCommands.length - 1)) }\n            else if (e.key === 'ArrowUp') { e.preventDefault(); setPaletteIndex((i) => Math.max(i - 1, 0)) }\n            else if (e.key === 'Enter' && filteredCommands[paletteIndex]) { e.preventDefault(); runCommand(filteredCommands[paletteIndex]) }\n          }}\n        />\n        <span className=\"zrm-kbd\">⌘K</span>\n        <select className=\"zrm-select\" aria-label=\"Brief courant\" style={{ width: 200, flex: '0 0 auto' }} value={currentId} onChange={(e) => setCurrentId(e.target.value)}>\n          {projects.map((p) => <option key={p.id} value={p.id}>{p.brief.title || 'Sans titre'}</option>)}\n        </select>\n        <button className=\"zrm-btn zrm-btn-icon\" title=\"Ouvrir un document depuis Create\" onClick={() => setBrowser('open')}><Icon name=\"folder\" size={14} /></button>\n        <button className=\"zrm-btn zrm-btn-icon\" title={docPath ? `Enregistrer (${docPath})` : 'Enregistrer dans Create…'} onClick={() => { if (docPath) persist(docPath); else setBrowser('save') }} disabled={busy === 'save'}><Icon name=\"arrow.down.right\" size={14} /></button>\n        {/* REPLI DES PANNEAUX (zone 2, Outils rapides). Trois etats et non deux : trois colonnes pour\n            travailler, deux pour gagner la largeur des Details quand on cadre, une pour ne garder que\n            l'apercu quand on juge le rendu. Le libelle affiche le nombre COURANT, pas le suivant, sans\n            quoi personne ne sait ou il en est. */}\n        <button className=\"zrm-btn zrm-btn-icon\" title={`Panneaux : ${panes === 'three' ? 'trois' : panes === 'two' ? 'deux' : 'un'} — cliquer pour replier`}\n          onClick={() => setPanes((p) => (p === 'three' ? 'two' : p === 'two' ? 'one' : 'three'))}><Icon name=\"sidebar.left\" size={14} /></button>\n        <button className=\"zrm-btn zrm-btn-icon\" title=\"Nouveau brief\" onClick={newProject}><Icon name=\"plus\" size={14} /></button>\n        <button className=\"zrm-btn zrm-btn-icon\" title=\"Dupliquer\" onClick={duplicateProject}><Icon name=\"doc.text\" size={14} /></button>\n        <button className=\"zrm-btn zrm-btn-icon\" title=\"Supprimer\" onClick={deleteProject}><Icon name=\"trash\" size={14} /></button>\n\n        {paletteOpen && filteredCommands.length > 0 && (\n          <div className=\"zrm-palette\" onMouseLeave={() => setPaletteOpen(false)}>\n            {filteredCommands.map((c, i) => (\n              <button key={c.id} className=\"zrm-palette-item\" data-active={i === paletteIndex} onMouseEnter={() => setPaletteIndex(i)} onClick={() => runCommand(c)}>\n                <span>{c.label}</span>\n                <span className=\"zrm-palette-hint\">{c.hint}</span>\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* ---- ARTICLE : le brief ET le texte éditable, dans une seule colonne ----\n           Retrait 2026-07-25 (retour Matthieu) : « registre » et « intention » n'apportaient rien\n           à l'écran ni sur la page partagée -- ils restent dans le modèle de données (le Critique\n           s'en sert pour l'appel à l'action) mais ne prennent plus de place. À leur place, ce qui\n           compte vraiment : l'ARTICLE, directement modifiable à côté de son aperçu. L'onglet\n           « Partition » a disparu du centre : un onglet de moins à traverser pour éditer un mot. */}\n      {/* ZONE 2 · OUTILS RAPIDES. Bande fine sous le menu, à la place qu'occupe la barre Compile\n          d'Unreal. Elle ne DUPLIQUE pas le sélecteur de format, qui vit déjà à trois endroits :\n          elle porte le repli des panneaux, l'échelle et le verdict, c'est-à-dire ce qui pilote la\n          VUE et non le document. */}\n      <div className=\"zrm-panel zrm-zone-tools\">\n        <button className=\"zrm-btn zrm-btn-sm\" title={`Panneaux : ${panes === 'three' ? 'trois' : panes === 'two' ? 'deux' : 'un'}`}\n          onClick={() => setPanes((p) => (p === 'three' ? 'two' : p === 'two' ? 'one' : 'three'))}>\n          <Icon name=\"sidebar.left\" size={13} />\n        </button>\n        <span style={{ opacity: .5 }}>{format.label}</span>\n        <span style={{ opacity: .5 }}>· {Math.round((contentScale || 1) * 100)} %</span>\n        <span style={{ marginLeft: 'auto', opacity: .6 }}>\n          {compiled?.error ? 'erreur de compilation' : `${countItems(composition)} pièce(s) posée(s)`}\n        </span>\n      </div>\n\n      {/* ZONE 7 · ANIMATIONS. La timeline est HORS V1 par décision écrite du plan : elle\n          réinventerait `cut.js`, qui est déjà la partition temporelle du produit, et son champ\n          serait détruit à chaque geste tant que le contrat n'a pas été ouvert pour elle. La zone\n          existe donc, vide et nommée, plutôt qu'absente : une zone manquante se redécouvre, une\n          zone vide s'explique. */}\n      <section className=\"zrm-panel zrm-zone-anim\">\n        <header className=\"zrm-head\"><span className=\"zrm-head-title\">Animations</span></header>\n        <div className=\"zrm-body\" style={{ display: 'grid', placeItems: 'center', opacity: .45, fontSize: 12 }}>\n          Aucune animation · la timeline arrive en V2\n        </div>\n      </section>\n\n      <section className=\"zrm-panel zrm-pane-structure zrm-zone-hier\">\n        <header className=\"zrm-head\">\n          <span className=\"zrm-head-title\">Structure</span>\n          <span className=\"zrm-head-spacer\" />\n          {docPath\n            ? <span className=\"zrm-saved\" title={docPath}><Icon name=\"checkmark\" size={11} />{docPath.replace(/^pages\\//, '').replace(/\\.zmedia\\.json$/, '')}</span>\n            : <span className=\"zrm-saved\">non enregistré</span>}\n          <span className=\"zrm-mono\">{rt.words} mots · {rt.minutes} min</span>\n        </header>\n        <div className=\"zrm-body\">\n          <div className=\"zrm-structure-head\">\n            <span className=\"zrm-label\">Lego · {countItems(composition)} élément{countItems(composition) > 1 ? 's' : ''}</span>\n            <span>Glisse sur un bord pour poser au-dessus, dessous, à gauche ou à droite.</span>\n          </div>\n          <div className=\"zrm-structure\"\n            onDragOver={(e) => { if (!composition.rows.length) e.preventDefault() }}\n            onDrop={onEmptyStructureDrop}\n            onDragLeave={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) setDropTarget(null) }}>\n            {composition.rows.length === 0 && (\n              <button className=\"zrm-structure-empty\" onClick={() => setLibraryTab('components')}>\n                Le template actuel reste intact. Choisis un composant dans la bibliothèque du bas pour commencer.\n              </button>\n            )}\n            {composition.rows.map((row) => (\n              <div key={row.id} className=\"zrm-structure-row\">\n                {row.items.map((item) => (\n                  <div key={item.id} className=\"zrm-structure-item\"\n                    draggable={!item.locked}\n                    data-on={selectedComponent === item.id}\n                    data-hidden={item.hidden}\n                    data-drop={dropTarget?.id === item.id ? dropTarget.placement : undefined}\n                    onClick={() => setSelectedComponent(item.id)}\n                    onDragStart={(e) => {\n                      e.dataTransfer.effectAllowed = 'move'\n                      e.dataTransfer.setData('application/x-zenray-instance', item.id)\n                    }}\n                    onDragOver={(e) => onStructureDragOver(e, item.id)}\n                    onDrop={(e) => onStructureDrop(e, item.id)}>\n                    <span className=\"zrm-structure-grip\">⠿</span>\n                    <span className=\"zrm-structure-name\">{item.name}</span>\n                    <span className=\"zrm-structure-kind\">{item.kind === 'image' ? 'Image' : item.group}</span>\n                    <span className=\"zrm-structure-actions\">\n                      <button title={item.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { hidden: !item.hidden })) }}><Icon name=\"eye\" size={11} /></button>\n                      <button title={item.locked ? 'Déverrouiller' : 'Verrouiller'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { locked: !item.locked })) }}><Icon name=\"lock\" size={11} /></button>\n                      <button title=\"Dupliquer\" onClick={(e) => { e.stopPropagation(); patchComposition((current) => duplicateItem(current, item.id)) }}><Icon name=\"doc.text\" size={11} /></button>\n                      <button title=\"Retirer le composant\" onClick={(e) => { e.stopPropagation(); patchComposition((current) => removeItem(current, item.id)); if (selectedComponent === item.id) setSelectedComponent(null) }}><Icon name=\"trash\" size={11} /></button>\n                    </span>\n                  </div>\n                ))}\n              </div>\n            ))}\n          </div>\n\n          <div className=\"zrm-brief-divider\"><span>Contenu de l’article</span></div>\n          <label className=\"zrm-field\">\n            <span className=\"zrm-label\">Titre</span>\n            <input className=\"zrm-input\" aria-label=\"Titre de travail\" value={project.brief.title} onChange={(e) => patchBrief({ title: e.target.value })} />\n            {errorFor('title') && <span className=\"zrm-error\">{errorFor('title')}</span>}\n          </label>\n\n          <label className=\"zrm-field\">\n            <span className=\"zrm-label\">Message — une seule phrase</span>\n            <textarea className=\"zrm-textarea\" aria-label=\"Message\" style={{ minHeight: 58 }} value={project.brief.message} onChange={(e) => patchBrief({ message: e.target.value })} />\n            {errorFor('message') && <span className=\"zrm-error\">{errorFor('message')}</span>}\n          </label>\n\n          <label className=\"zrm-field\">\n            <span className=\"zrm-label\">Public</span>\n            <input className=\"zrm-input\" aria-label=\"Public\" value={project.brief.audience} onChange={(e) => patchBrief({ audience: e.target.value })} />\n            {errorFor('audience') && <span className=\"zrm-error\">{errorFor('audience')}</span>}\n          </label>\n\n          {/* Les blocs de l'article, modifiables ici même. */}\n          <div style={{ display: 'flex', alignItems: 'center', gap: 8, margin: '16px 0 8px' }}>\n            <span className=\"zrm-label\" style={{ margin: 0 }}>Blocs{cut ? ` · ${cut.beats.length}` : ''}</span>\n            <span className=\"zrm-head-spacer\" />\n            {cut && <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => refitCut(c, theme))} disabled={cut.locked} title=\"Réajuster le nombre de blocs au thème\">Réajuster</button>}\n            {cut && <button className=\"zrm-btn zrm-btn-sm\" data-on={cut.locked} onClick={() => withCut((c) => ({ ...c, locked: !c.locked }))} title=\"Un article verrouillé ne bouge plus quand on essaie d’autres thèmes\">{cut.locked ? 'Verrouillé' : 'Verrouiller'}</button>}\n          </div>\n\n          {!cut ? (\n            <p className=\"zrm-note\">Aucun bloc. Colle tes notes plus bas puis « Monter l’article ».</p>\n          ) : cut.beats.map((beat, i) => (\n            <div key={beat.id} className=\"zrm-beat\" data-on={i === selectedBeat} onFocusCapture={() => setSelectedBeat(i)}\n              onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); e.currentTarget.dataset.drop = 'true' } }}\n              onDragLeave={(e) => { delete e.currentTarget.dataset.drop }}\n              onDrop={(e) => { if (e.dataTransfer.files?.length) { e.preventDefault(); delete e.currentTarget.dataset.drop; attachImages(i, e.dataTransfer.files) } }}>\n              <div className=\"zrm-beat-top\">\n                <select className=\"zrm-beat-role\" aria-label={`Rôle du bloc ${i + 1}`} value={beat.role} onChange={(e) => withCut((c) => updateBeat(c, i, { role: e.target.value }))}>\n                  {BEAT_ROLES.map((r) => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}\n                </select>\n                <span className=\"zrm-beat-meta\">\n                  {i + 1}/{cut.beats.length}\n                  {isTemporal(format) ? ` · ${beatDuration(beat)}s` : ''}\n                </span>\n              </div>\n              <textarea className=\"zrm-beat-text\" aria-label={`Texte du bloc ${i + 1}`} value={beat.text} onChange={(e) => withCut((c) => updateBeat(c, i, { text: e.target.value }))} />\n              {(beat.slots || []).length > 0 && (\n                <div className=\"zrm-slots-strip\">\n                  {beat.slots.map((slot, si) => (\n                    <div key={si} className=\"zrm-slot-thumb\" title={slot.label || 'image'}>\n                      {slot.dataUrl ? <img src={slot.dataUrl} alt={slot.label || ''} /> : <span>{slot.kind}</span>}\n                      <button className=\"zrm-slot-remove\" title=\"Retirer l’image\" onClick={() => withCut((c) => removeSlot(c, i, si))}>×</button>\n                    </div>\n                  ))}\n                </div>\n              )}\n              <div className=\"zrm-beat-actions\">\n                <label className=\"zrm-btn zrm-btn-sm\" title={`Ajouter une image (${(beat.slots || []).length}/${MAX_SLOTS})`} style={{ cursor: (beat.slots || []).length >= MAX_SLOTS ? 'not-allowed' : 'pointer' }}>\n                  <Icon name=\"photo\" size={12} />\n                  <input type=\"file\" accept=\"image/*\" multiple aria-label={`Images du bloc ${i + 1}`} style={{ display: 'none' }}\n                    disabled={(beat.slots || []).length >= MAX_SLOTS || busy === 'image'}\n                    onChange={(e) => { attachImages(i, e.target.files); e.target.value = '' }} />\n                </label>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Monter\" onClick={() => withCut((c) => moveBeat(c, i, Math.max(0, i - 1)))} disabled={i === 0}>↑</button>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Descendre\" onClick={() => withCut((c) => moveBeat(c, i, Math.min(cut.beats.length - 1, i + 1)))} disabled={i === cut.beats.length - 1}>↓</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => mergeBeats(c, i))} disabled={i >= cut.beats.length - 1}>Fusionner</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => splitBeat(c, i))}>Scinder</button>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Insérer un bloc après\" onClick={() => withCut((c) => addBeat(c, i))}>+</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => removeBeat(c, i))} disabled={cut.beats.length <= 1}>Retirer</button>\n              </div>\n            </div>\n          ))}\n\n          <details style={{ marginTop: 14 }}>\n            <summary className=\"zrm-label\" style={{ cursor: 'pointer', marginBottom: 8 }}>Notes source</summary>\n            <textarea className=\"zrm-textarea\" aria-label=\"Notes\" style={{ minHeight: 130 }} value={project.notes} onChange={(e) => patchProject({ notes: e.target.value })} />\n            <div className=\"zrm-row\" style={{ marginTop: 8 }}>\n              <button className=\"zrm-btn zrm-btn-sm\" onClick={buildCutNow} disabled={!theme}>Monter l’article</button>\n              <button className=\"zrm-btn zrm-btn-sm\" onClick={() => patchProject({ notes: SEED_NOTES })}>Notes d’exemple</button>\n            </div>\n            <p className=\"zrm-note\" style={{ marginTop: 6 }}>Une ligne vide sépare deux blocs. Remonter l’article écrase les blocs modifiés à la main.</p>\n          </details>\n        </div>\n      </section>\n\n      {/* ---- STAGE ---- */}\n      <section className=\"zrm-panel zrm-zone-viewport\">\n        <header className=\"zrm-head\">\n          <span className=\"zrm-head-title\">Aperçu</span>\n          <span className=\"zrm-head-spacer\" />\n          <span className=\"zrm-mono\">\n            {format.canvas.w}{format.canvas.h ? `×${format.canvas.h}` : ' · libre'}\n            {isTemporal(format) && cut ? ` · ${durationOf(cut, format)}s` : ''}\n            {compiled?.meta?.scale && compiled.meta.scale !== 1 ? ` · échelle ${compiled.meta.scale}` : ''}\n            {compiled?.meta?.omitted > 0 ? ` · ${compiled.meta.shown}/${compiled.meta.shown + compiled.meta.omitted} blocs` : ''}\n          </span>\n          <button className=\"zrm-btn zrm-btn-icon\" title={renderDark ? 'Rendu en clair' : 'Rendu en sombre'} data-on={renderDark} onClick={() => setRenderDark((v) => !v)}>\n            <Icon name={renderDark ? 'sun.max' : 'moon'} size={14} />\n          </button>\n          {format.safe && (\n            <button className=\"zrm-btn zrm-btn-icon\" title=\"Zones de sécurité\" data-on={showSafe} onClick={() => setShowSafe((v) => !v)}>\n              <Icon name=\"rectangle.dashed\" size={14} />\n            </button>\n          )}\n        </header>\n\n        <div className=\"zrm-stage-body\" ref={stageRef}>\n          {themeError ? (\n            <p className=\"zrm-stage-empty\">{themeError}</p>\n          ) : !compiled ? (\n            <p className=\"zrm-stage-empty\">Complète le titre, le message d’une phrase et le public. L’aperçu est la page réelle, pas une approximation.</p>\n          ) : compiled.error ? (\n            <p className=\"zrm-stage-empty\">{compiled.error}</p>\n          ) : (\n            <div className=\"zrm-canvas\" style={{ width: format.canvas.w * fitScale, height: stageHeight * fitScale }}>\n              <iframe\n                ref={frameRef}\n                title=\"Aperçu ZenRayMedia\"\n                onLoad={onFrameLoad}\n                srcDoc={debouncedHtml}\n                sandbox=\"allow-same-origin\"\n                style={{ width: format.canvas.w, height: stageHeight, transform: `scale(${fitScale})`, transformOrigin: '0 0' }}\n              />\n              {showSafe && format.safe && (\n                <div className=\"zrm-safe-overlay\">\n                  <i style={{ left: 0, right: 0, top: 0, height: format.safe.top * fitScale }} />\n                  <i style={{ left: 0, right: 0, bottom: 0, height: format.safe.bottom * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, left: 0, width: format.safe.sides * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, right: 0, width: format.safe.sides * fitScale }} />\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      </section>\n\n      {/* ---- DECK ---- */}\n      <section className=\"zrm-panel zrm-pane-details zrm-zone-details\">\n        <header className=\"zrm-head\" style={{ gap: 4 }}>\n          {DECK_TABS.map((tab) => (\n            <button key={tab.key} className=\"zrm-btn zrm-btn-sm\" data-on={deckTab === tab.key} onClick={() => setDeckTab(tab.key)}>\n              {tab.label}{tab.key === 'critic' && issues.length ? ` · ${issues.length}` : ''}\n            </button>\n          ))}\n        </header>\n        <div className=\"zrm-body\">\n          {/* DÉTAILS DE LA PIÈCE SÉLECTIONNÉE. Vider un champ le fait REVENIR au brief au lieu de\n              l'effacer : `resolveItemData` ne retient que les chaînes non vides, et c'est ce qui\n              distingue « jamais renseigné » de « renseigné puis vidé » dans une interface où le\n              modèle, lui, ne les distingue pas. */}\n          {pieceSelectionnee && champsDeclares.length > 0 && (\n            <div className=\"zrm-