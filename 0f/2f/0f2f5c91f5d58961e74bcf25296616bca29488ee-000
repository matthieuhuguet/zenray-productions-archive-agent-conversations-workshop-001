                    <button key={b.formatId} className=\"zrm-theme\" data-on={b.formatId === formatId}\n                        onClick={() => { setFormatId(b.formatId); setActionCount((n) => n + 1) }}\n                        title={b.declared ? b.label : `${b.label} — non déclaré par ce thème`}>\n                        <span className=\"zrm-theme-chip\" style={{ color: b.ready ? '#30d158' : '#ff453a' }}>{b.short}</span>\n                        <span style={{ minWidth: 0 }}>\n                          <span className=\"zrm-theme-name\">{b.label}{b.declared ? '' : ' ·'}</span>\n                          <span className=\"zrm-theme-sub\">\n                            {b.shown}/{b.total} blocs\n                            {b.duration ? ` · ${b.duration}s` : ''}\n                            {b.blocking ? ` · ${b.blocking} bloquant` : (b.warnings ? ` · ${b.warnings} avert.` : ' · prêt')}\n                            {advice ? ` · ${advice.words} mots hors cadre` : ''}\n                          </span>\n                        </span>\n                      </button>\n                    )\n                  })}\n                </div>\n              ))}\n              {treeSummary.undeclared.length > 0 && (\n                <p className=\"zrm-note\" style={{ marginTop: 8 }}>\n                  Les sorties marquées « · » ne sont pas déclarées par « {theme?.name} » : elles rendront, mais approximativement.\n                </p>\n              )}\n            </>\n          )}\n\n          {deckTab === 'themes' && (\n            <>\n              <p className=\"zrm-note\" style={{ marginBottom: 10 }}>\n                {themes.length} thème{themes.length > 1 ? 's' : ''} construit{themes.length > 1 ? 's' : ''} sur les 1024 du catalogue.\n                Dépose un fichier <span className=\"zrm-mono\">T-FF-S-V--slug.html</span> dans <span className=\"zrm-mono\">src/zenraymedia/themes/</span> : il apparaît ici.\n              </p>\n              {Object.entries(grouped).map(