port function applyOverrides(html, reglagesParInstance) {\n  if (!disponible() || !reglagesParInstance || !Object.keys(reglagesParInstance).length) return html\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  let touche = false\n\n  for (const [instanceId, reglages] of Object.entries(reglagesParInstance)) {\n    const hote = doc.querySelector(`[data-zrm-instance=\"${CSS.escape ? CSS.escape(instanceId) : instanceId}\"]`)\n    if (!hote) continue\n    for (const [path, reglage] of Object.entries(reglages || {})) {\n      const el = elementAuChemin(hote, path)\n      if (!el) continue\n      if (typeof reglage.text === 'string' && reglage.text !== '') {\n        // On ne remplace QUE les nœuds de texte directs, jamais les enfants : sans cela, régler le\n        // texte d'un conteneur effacerait toute sa descendance en un caractère.\n        let pose = false\n        for (const enfant of [...el.childNodes]) {\n          if (enfant.nodeType !== 3) continue\n          if (pose) { enfant.nodeValue = '' } else { enfant.nodeValue = reglage.text; pose = true }\n        }\n        if (!pose) el.textContent = reglage.text\n        touche = true\n      }\n      const style = styleEnLigne(reglage.style)\n      if (style) {\n        el.setAttribute('style', `${el.getAttribute('style') || ''};${style}`)\n        touche = true\n      }\n    }\n  }\n  if (!touche) return html\n  return `<!doctype html>${doc.documentElement.outerHTML}`\n}\n\nfunction elementAuChemin(hote, path) {\n  let courant = hote\n  for (const i of String(path).split('.').map(Number)) {\n    const enfants = noeudsEnfants(courant)\n    courant = enfants[i]\n    if (!courant) return null\n  }\n  return courant\n}\n\n/** Le nombre de sous-composants d'une instance, replié pour l'affichage. */\nexport function countNodes(liste) {\n  if (!Array.isArray(liste)) return 0\n  return liste.reduce((n, noeud) => n + 1 + countNodes(noeud.children), 0)\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"too