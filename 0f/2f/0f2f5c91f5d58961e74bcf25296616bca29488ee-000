{"parentUuid":"ef60a1b1-5325-4c76-80ca-32bf3ac77182","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/layers.test.js","snippet":"1\t// Carte L1 — la porte du modèle de calques.\n2\t//\n3\t// Ce fichier EST le critère de fini de la carte : tant qu'il ne rend pas vert, la carte n'est pas\n4\t// finie, et tant que Matthieu ne l'a pas vue à l'écran, elle n'est pas validée. C'est la règle qui\n5\t// manquait pendant cinq jours, où aucune carte n'était jamais déclarée close.\n6\t\n7\timport { describe, it, expect } from 'vitest'\n8\timport { emptyComposition, normalizeComposition, addComponent, patchItem } from './composition.js'\n9\timport {\n10\t  addLayer, patchLayer, removeLayer, duplicateLayer, reorderLayer, moveLayerTo, resizeLayerTo,\n11\t  readLayers, paintOrder, stackOrder, countLayers, findLayer, filterOf, makeLayer,\n12\t  LAYER_KINDS, BLEND_MODES,\n13\t} from './layers.js'\n14\t\n15\tconst THEME = 'T-01-3-2'\n16\tconst vide = () => emptyComposition(THEME)\n17\t\n18\tdescribe('L1 — le modèle de calques', () => {\n19\t  it('un document sans calques rend une pile vide, jamais une erreur', () => {\n20\t    expect(readLayers(vide())).toEqual([])\n21\t    expect(readLayers(null)).toEqual([])\n22\t    expect(readLayers({ layers: 'pas un tableau' })).toEqual([])\n23\t    expect(countLayers(vide())).toBe(0)\n24\t  })\n25\t\n26\t  it('pose les quatre types de calques et leur donne un identifiant distinct', () => {\n27\t    let c = vide()\n28\t    for (const kind of LAYER_KINDS) c = addLayer(c, kind)\n29\t    const ids = readLayers(c).map((l) => l.id)\n30\t    expect(ids).toHaveLength(4)\n31\t    expect(new Set(ids).size).toBe(4)\n32\t    expect(readLayers(c).map((l) => l.kind)).toEqual(LAYER_KINDS)\n33\t  })\n34\t\n35\t  it('refuse un type de calque inconnu au lieu d’en fabriquer un bancal', () => {\n36\t    expect(() => makeLayer(vide(), 'nuage')).toThrow(/inconnu/)\n37\t  })\n38\t\n39\t  it('un calque neuf se pose DEVANT, comme dans Photoshop', () => {\n40\t    let c = addLayer(vide(), 'text', { name: 'Fond' })\n41\t    c = addLayer(c, 'text', { name: 'Milieu' })\n42\t    c = addLayer(c, 'text', { name: 'Devant' })\n43\t    // L'ordre de peinture va du fond vers l'œil, la pile affichée est son inverse.\n44\t    expect(paintOrder(c).map((l) => l.name)).toEqual(['Fond', 'Milieu', 'Devant'])\n45\t    expect(stackOrder(c).map((l) => l.name)).toEqual(['Devant', 'Milieu', 'Fond'])\n46\t  })\n47\t\n48\t  it('un calque neuf a une taille NON NULLE, sans quoi on le croit perdu', () => {\n49\t    const c = addLayer(vide(), 'image')\n50\t    const [l] = readLayers(c)\n51\t    expect(l.w).toBeGreaterThan(0)\n52\t    expect(l.h).toBeGreaterThan(0)\n53\t  })\n54\t\n55\t  it('déplace et redimensionne en pixels du canevas, arrondis', () => {\n56\t    let c = addLayer(vide(), 'shape')\n57\t    const id = readLayers(c)[0].id\n58\t    c = moveLayerTo(c, id, 120.4, 55.6)\n59\t    c = resizeLayerTo(c, id, 300.2, 0)\n60\t    const l = findLayer(c, id)\n61\t    expect(l.x).toBe(120)\n62\t    expect(l.y).toBe(56)\n63\t    expect(l.w).toBe(300)\n64\t    expect(l.h).toBe(1)   // jamais zéro : un calque de hauteur nulle est un calque invisible\n65\t  })\n66\t\n67\t  it('RÉGLER UN EFFET N’EFFACE PAS LES AUTRES — la faute exacte payée sur item.props', () => {\n68\t    let c = addLayer(vide(), 'image')\n69\t    const id = readLayers(c)[0].id\n70\t    c = patchLayer(c, id, { effects: { blur: 4 } })\n71\t    c = patchLayer(c, id, { effects: { saturate: 1.5 } })\n72\t    const l = findLayer(c, id)\n73\t    expect(l.effects.blur).toBe(4)\n74\t    expect(l.effects.saturate).toBe(1.5)\n75\t    expect(l.effects.brightness).toBe(1)\n76\t  })\n77\t\n78\t  it('la chaîne filter est vide quand rien n’est réglé, et cumulative sinon', () => {\n79\t    let c = addLayer(vide(), 'image')\n80\t    const id = readLayers(c)[0].id\n81\t    expect(filterOf(findLayer(c, id