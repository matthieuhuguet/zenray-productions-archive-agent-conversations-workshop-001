{"parentUuid":"917be71d-5ad0-4c12-b250-3a6fc0f11121","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/zenraymedia/MediaApp.test.jsx","snippet":"1\t// ZenRayMedia — vérification de l'interface réelle (L9).\n2\t// Les tests de `zenraymedia.test.js` gardent la logique ; ceux-ci gardent les BOUTONS : un\n3\t// produit vendable n'a aucun contrôle mort. Chaque interaction testée ici est une action que\n4\t// Matthieu peut faire devant un client.\n5\t\n6\timport React from 'react'\n7\timport { describe, it, expect, beforeEach, afterEach, beforeAll, vi } from 'vitest'\n8\timport { render, screen, fireEvent, waitFor, cleanup } from '@testing-library/react'\n9\timport MediaApp from './MediaApp.jsx'\n10\t\n11\tbeforeAll(() => {\n12\t  // jsdom n'implémente ni ResizeObserver (mise à l'échelle du Stage) ni matchMedia.\n13\t  if (!global.ResizeObserver) {\n14\t    global.ResizeObserver = class { observe() {} unobserve() {} disconnect() {} }\n15\t  }\n16\t})\n17\t\n18\tbeforeEach(() => {\n19\t  localStorage.clear()\n20\t  vi.restoreAllMocks()\n21\t})\n22\t\n23\t// Sans nettoyage explicite, les rendus s'empilent dans le document et toute requête devient\n24\t// ambiguë. Le projet n'a pas de cleanup global : on le pose ici.\n25\tafterEach(() => cleanup())\n26\t\n27\tasync function mount() {\n28\t  const utils = render(<MediaApp />)\n29\t  // Deux attentes, pas une : le thème se charge de façon asynchrone (un gabarit HTML est un\n30\t  // fichier à part), PUIS la partition se monte. Tant que la partition n'existe pas, rien n'est\n31\t  // compilé et les boutons de rendu sont désactivés -- c'est le comportement voulu du produit,\n32\t  // donc le test doit attendre le vrai signal « prêt » au lieu de cliquer dans le vide.\n33\t  // REFONTE DU 2026-08-04 : le panneau de droite s'ouvre désormais sur « Détails », comme dans un\n34\t  // éditeur de widgets, et le formulaire de l'article vit sous l'onglet « Contenu ». Le montage de\n35\t  // test ouvre donc successivement les deux onglets dont les tests ont besoin, au lieu de supposer\n36\t  // que tout est visible d'emblée. C'est une correction du HARNAIS, pas un contournement : le\n37\t  // produit affiche bien ces champs, à un clic d'onglet près.\n38\t  fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))\n39\t  await waitFor(() => expect(screen.getByRole('button', { name: /Lecture pure/ })).toBeTruthy())\n40\t  fireEvent.click(screen.getByRole('button', { name: 'Contenu' }))\n41\t  await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n42\t  return utils\n43\t}\n44\t\n45\t// Rouvre l'onglet dont un test a besoin, sans supposer lequel est ouvert.\n46\tfunction onglet(nom) { fireEvent.click(screen.getByRole('button', { name: nom })) }\n47\t\n48\tdescribe('ZenRayMedia — interface', () => {\n49\t  it('s’ouvre sur le brief de démonstration, jamais sur un écran vide', async () => {\n50\t    await mount()\n51\t    expect(screen.getByLabelText('Titre de travail').value).toBe('Un brief, mille formes')\n52\t    expect(screen.getByLabelText('Message').value).toMatch(/goulot/)\n53\t    // L'article est monté automatiquement : ses blocs sont directement modifiables.\n54\t    await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n55\t  })\n56\t\n57\t  it('affiche le catalogue de thèmes avec sa famille et le contrat de dépôt', async () => {\n58\t    await mount()\n59\t    onglet('Thèmes')\n60\t    expect(screen.getByText('Presse & éditorial')).toBeTruthy()\n61\t    expect(screen.getByText(/T-01-3-2/)).toBeTruthy()\n62\t    // Le mode d'emploi d'ajout des futurs gabarits est visible dans le produit, pas seulement en doc.\n63\t    expect(screen.getByText(/T-FF-S-V--slug\\.html/)).toBeTruthy()\n64\t  })\n65\t\n66\t  it('refuse un message à deux phrases et le dit à l’endroit du champ', async () => {\n67\t    await mount()\n68\t    const message = screen.getByLabelText('Message')\n69\t    fireEvent.change(message, { target: { value: 'Première phrase. Seconde phrase.' } })\n70\t    await waitFor(() => expect(screen.getByText(/Le message doit tenir en UNE phrase/)).toBeTruthy())\n71\t  })\n72\t\n73\t  it('change de format en un clic et le Stage suit', async () => {\n74\t    await mount()\n75\t    const listeFormat = screen.getByLabelText('Format de sortie')\n76\t    fireEvent.change(listeFormat, { target: { value: 'F-social-9x16' } })\n77\t    await waitFor(() => expect(screen.getByText(/1080 × 1920/)).toBeTruthy())\n78\t    fireEvent.change(listeFormat, { target: { value: 'F-web-article' } })\n79\t    await waitFor(() => expect(screen.getByText(/820 × libre/)).toBeTruthy())\n80\t  })\n81\t\n82\t  it('le Critique rend un verdict et il est atteignable en un clic', async () => {\n83\t    await mount()\n84\t    fireEvent.click(screen.getByRole('button', { name: /^Critique/ }))\n85\t    await waitFor(() => expect(screen.getByText(/Publiable\\./)).toBeTruthy())\n86\t  })\n87\t\n88\t  it('l’article est modifiable en place : ajoute et retire un bloc sans changer d’onglet', async () => {\n89\t    await mount()\n90\t    const before = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n91\t    expect(before).toBeGreaterThan(0)\n92\t\n93\t    fireEvent.click(screen.getAllByRole('button', { name: '+' })[0])\n94\t    await waitFor(() => {\n95\t      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n96\t      expect(after).toBe(before + 1)\n97\t    })\n98\t\n99\t    fireEvent.click(screen.getAllByRole('button', { name: 'Retirer' })[0])\n100\t    await waitFor(() => {\n101\t      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n102\t      expect(after).toBe(before)\n103\t    })\n104\t  })\n105\t\n106\t  it('la Forge ne s’active que sur un format temporel, et donne la co