    todo = reste()                      # relu du disque à chaque tour\n        if not todo:\n            print(\"\\nVERT — plus rien hors de /Game/ZenRayShards\")\n            sys.exit(0)\n        src, dst, n = todo[0]\n        if not editeur_pret() and not garantir():\n            print(\"ROUGE — éditeur indisponible, arrêt propre\")\n            sys.exit(1)\n        print(f\"→ {src}  ({n} assets)\", flush=True)\n        try:\n            ok, sortie = appel(\"move\", {\"path\": src, \"new_path\": dst})\n        except subprocess.TimeoutExpired:\n            ok, sortie = False, \"expiration\"\n        time.sleep(2)\n        if compter(CONTENT / src.replace(\"/Game/\", \"\").split(\"/\")[0]) == 0 or \"true\" in sortie.lower():\n            print(f\"   déplacé\", flush=True)\n            echecs = 0\n            continue\n        if not editeur_pret():\n            print(\"   l'éditeur est tombé pendant ce déplacement, relance\", flush=True)\n            garantir()\n            echecs += 1\n        else:\n            echecs += 1\n            print(f\"   échec · {sortie}\", flush=True)\n        if echecs >= 3:\n            print(f\"ROUGE — trois échecs de suite sur {src}, arrêt pour inspection\")\n            sys.exit(1)\nPYEOF\ncd /Users/zenray/Create/Build/Productions/ZenRayShards/ZenRayShards && python3 Scripts/migrate_assets.py plan","description":"Write the resumable migration script and show the plan","timeout":180000},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":476,"cache_read_input_tokens":793783,"output_tokens":2559,"output_tokens_details":{"thinking_tokens":221},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":476,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2559,"cache_read_input_tokens":793783,"cach