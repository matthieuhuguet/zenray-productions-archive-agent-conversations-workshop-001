n/json, text/event-stream\"}\n    if session:\n        entetes[\"Mcp-Session-Id\"] = session\n    req = urllib.request.Request(URL, data=json.dumps(charge).encode(), headers=entetes, method=\"POST\")\n    with urllib.request.urlopen(req, timeout=120) as r:\n        brut = r.read().decode()\n        sid = r.headers.get(\"Mcp-Session-Id\")\n    # Le serveur peut répondre en SSE : on ne garde alors que la charge utile des lignes `data:`.\n    if brut.lstrip().startswith(\"event:\") or brut.lstrip().startswith(\"data:\"):\n        brut = \"\\n\".join(l[5:].strip() for l in brut.splitlines() if l.startswith(\"data:\"))\n    return (json.loads(brut) if brut.strip() else None), sid\n\ndef connexion():\n    \"\"\"Poignée de main complète. Rend l'identifiant de session à passer aux appels suivants.\"\"\"\n    _, sid = _post({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\n        \"protocolVersion\": \"2025-06-18\", \"capabilities\": {},\n        \"clientInfo\": {\"name\": \"zenrayshards-cli\", \"version\": \"1.0\"}}})\n    if not sid:\n        raise SystemExit(\"ÉCHEC — pas d'identifiant de session. L'éditeur Unreal est-il ouvert ?\")\n    _post({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"}, sid)\n    return sid\n\ndef appeler(methode, params=None, sid=None):\n    sid = sid or connexion()\n    rep, _ = _post({\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": methode, \"params\": params or {}}, sid)\n    if rep and \"error\" in rep:\n        raise SystemExit(f\"ÉCHEC — {rep['error'].get('message', rep['error'])}\")\n    return (rep or {}).get(\"result\", {})\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 2:\n        raise SystemExit(__doc__)\n    cmd = sys.argv[1]\n    try:\n        if cmd == \"ping\":\n            connexion(); print(\"VERT — l'éditeur Unreal répond sur\", URL); sys.exit(0)\n        if cmd == \"list\":\n            outils = appeler(\"tools/list\").get(\"tools\", [])\n            print(f\"{len(outils)} outils exposés\\n\")\n            for o in outils:\n                print(f\"  {o['name']:<38} {(o.get('description') or '').splitlines()[0][:96]}\")\n            sys.exit(0)\n        if cmd == \"schema\":\n            for o in appeler(\"tools/list\").get(\"tools\", []):\n                if o[\"name\"] == sys.argv[2]:\n                    print(json.dumps(o, indent=2, ensure_ascii=False)); sys.exit(0)\n            raise SystemExit(f\"ÉCHEC — outil inconnu : {sys.argv[2]}\")\n        if cmd == \"call\":\n            args = json.loads(sys.argv[3]) if len(sys.argv) > 3 else {}\n            r = appeler(\"tools/call\", {\"name\": sys.argv[2], \"arguments\": args})\n            for bloc in r.get(\"content\", []):\n                print(bloc.get(\"text\", json.dumps(bloc, ensure_ascii=False)))\n            sys.exit(1 if r.get(\"isError\") else 0)\n        raise SystemExit(f\"ÉCHEC — commande inconnue : {cmd}\")\n    except urllib.error.URLError as e:\n        raise SystemExit(f\"ÉCHEC — serveur MCP injoignable sur {URL} ({e.reason}). Éditeur fermé ?\")\nPYEOF\ncd /Users/zenray/Create/Build/Productions/ZenRayShards/ZenRayShards && python3 Scripts/mcp.py ping && echo && python3 Scripts/mcp.py list","description":"Write a reusable MCP CLI client and list Unreal tools"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1072,"cache_read_input_tokens":606698,"output_tokens":2549,"output_tokens_details":{"thinking_tokens":296},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1072,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2549,"cache_read_input_tokens":606698,"cache_creation_input_tokens":1072,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1072},"type":"message"}],"speed":"standard"},"diagnostics":null