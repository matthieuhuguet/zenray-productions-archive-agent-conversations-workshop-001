log\"\n\n\ndef _note(msg):\n    JOURNAL.parent.mkdir(parents=True, exist_ok=True)\n    ligne = f\"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}\"\n    with open(JOURNAL, \"a\", encoding=\"utf-8\") as f:\n        f.write(ligne + \"\\n\")\n    print(ligne)\n\n\ndef vivant():\n    return subprocess.run([\"pgrep\", \"-f\", MOTIF_PROC], capture_output=True).returncode == 0\n\n\ndef repond():\n    \"\"\"Le MCP répond-il ? C'est le seul test qui prouve que l'éditeur est UTILISABLE.\"\"\"\n    try:\n        req = urllib.request.Request(MCP, method=\"POST\",\n            data=json.dumps({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\n                \"protocolVersion\": \"2025-06-18\", \"capabilities\": {},\n                \"clientInfo\": {\"name\": \"guard\", \"version\": \"1\"}}}).encode(),\n            headers={\"Content-Type\": \"application/json\",\n                     \"Accept\": \"application/json, text/event-stream\"})\n        with urllib.request.urlopen(req, timeout=6) as r:\n            return bool(r.headers.get(\"Mcp-Session-Id\"))\n    except Exception:\n        return False\n\n\ndef tuer_rapporteur():\n    \"\"\"La fenêtre de rapport de plantage bloque et n'apporte rien ici. On la ferme.\"\"\"\n    r = subprocess.run([\"pkill\", \"-f\", \"CrashReportClient\"], capture_output=True)\n    if r.returncode == 0:\n        _note(\"fenêtre CrashReportClient fermée\")\n        return True\n    return False\n\n\ndef plantages_recents(n=5):\n    if not CRASHES.exists():\n        return []\n    dossiers = sorted((d for d in CRASHES.iterdir() if d.is_dir()),\n                      key=lambda d: d.stat().st_mtime, reverse=True)[:n]\n    out = []\n    for d in dossiers:\n        msg, genre = \"\", \"?\"\n        ctx = d / \"CrashContext.runtime-xml\"\n        if ctx.exists():\n            import re\n            t = ctx.read_text(encoding=\"utf-8\", errors=\"replace\")\n            m = re.search(r\"<ErrorMessage>(.*?)</ErrorMessage>\", t, re.S)\n            if m:\n                msg = \" \".join(m.group(1).split())[:180]\n            g = re.search(r\"<CrashType>(.*?)</CrashType>\", t)\n            if g:\n                genre = g.group(1)\n        out.append({\"dossier\": d.name, \"quand\": time.strftime(\"%Y-%m-%d %H:%M\", time.localtime(d.stat().st_mtime)),\n                    \"genre\": genre, \"message\": msg})\n    return out\n\n\ndef relancer():\n    _note(\"relancement de l'éditeur\")\n    subprocess.run([\"open\", \"-a\", EDITEUR, \"--args\", str(UPROJECT)], check=False)\n\n\ndef garantir(delai=420):\n    \"\"\"Rend un éditeur PRÊT, quoi qu'il arrive. Code 0 si prêt, 1 sinon.\"\"\"\n    tuer_rapporteur()\n    if not vivant():\n        p = plantages_recents(1)\n        if p and p[0][\"genre\"] not in (\"Ensure\", \"\"):\n            _note(f\"PLANTAGE détecté · {p[0]['genre']} · {p[0]['message'][:120]}\")\n        else:\n            _note(\"éditeur absent\")\n        relancer()\n    debut = time.time()\n    while time.time() - debut < delai:\n        if repond():\n            _note(f\"VERT — éditeur prêt en {int(time.time() - debut)}s\")\n            return 0\n        if not vivant():          # mort pendant le démarrage : on retente une fois\n            tuer_rapporteur()\n            _note(\"mort pendant le démarrage, nouvelle tentative\")\n            relancer()\n        time.sleep(8)\n    _note(f\"ROUGE — toujours pas prêt après {delai}s\")\n    return 1\n\n\nif __name__ == \"__main__\":\n    cmd = sys.argv[1] if len(sys.argv) > 1 else \"status\"\n    if cmd == \"status\":\n        v, r = vivant(), repond()\n        print(f\"processus : {'vivant' if v else 'MORT'}\")\n        print(f\"MCP       : {'répond' if r else 'muet'}\")\n        sys.exit(0 if (v and r) else 1)\n    if cmd == \"ensure\":\n        sys.exit(garantir(int(sys.argv[2]) if len(sys.argv) > 2 else 420))\n    if cmd == \"crashes\":\n        for p in plantages_recents(8):\n            print(f\"  {p['quand']}  [{p['genre']}]  {p['messa