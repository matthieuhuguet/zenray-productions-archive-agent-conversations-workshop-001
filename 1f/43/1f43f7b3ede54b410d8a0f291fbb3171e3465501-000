{"parentUuid":"97eb2690-854b-4174-a5f9-e53a7e4d8c75","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CeHtd24eVwSwW5GqPUDgZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Fc79a9F8uDsGu5veAKJ5xu","name":"Bash","input":{"command":"cd /Users/zenray/Create/Build/Productions/GithubProductions/ZenRayWebsite && python3 - <<'PY'\nimport json, io\n\ndef p(*runs):\n    return {\"type\":\"paragraph\",\"props\":{},\"content\":[{\"type\":\"text\",\"text\":t,\"styles\":s} for t,s in runs]}\ndef T(t): return (t,{})\ndef B(t): return (t,{\"bold\":True})\ndef C(t): return (t,{\"code\":True})\ndef h(txt, lvl=2):\n    return {\"type\":\"heading\",\"props\":{\"level\":lvl},\"content\":[{\"type\":\"text\",\"text\":txt,\"styles\":{}}]}\ndef code(txt):\n    return {\"type\":\"codeBlock\",\"props\":{},\"content\":[{\"type\":\"text\",\"text\":txt,\"styles\":{}}]}\ndef li(*runs):\n    return {\"type\":\"bulletListItem\",\"props\":{},\"content\":[{\"type\":\"text\",\"text\":t,\"styles\":s} for t,s in runs]}\ndef quote(txt):\n    return {\"type\":\"quote\",\"props\":{},\"content\":[{\"type\":\"text\",\"text\":txt,\"styles\":{}}]}\n\nblocks = [\n p(B(\"Short answer: it works.\"),\" Epic's markerless body capture runs on an Apple Silicon Mac, and the reason almost everyone believes otherwise is a stale build identifier, not a platform restriction. I tested the whole chain end to end on 22 August 2026 and got an animation out.\"),\n\n quote(\"The plugin belongs to Epic Games. It ships with Unreal Engine and none of its code is mine. My contribution is narrow and I want it stated plainly: I compiled it on macOS and ran it end to end on a real clip until an animation came out. It works.\"),\n\n p(T(\"Setup: macOS on Apple Silicon, Unreal Engine 5.8.1 as an \"),C(\"Installed Build\"),T(\" from the Launcher, Xcode 26.6. Input was four seconds of gameplay footage at 3840x2160 and 60 frames per second. Output was 239 tracked frames after five processing stages, in about thirty minutes.\")),\n\n h(\"Why everyone thinks it is Windows only\"),\n p(T(\"Enable the plugin and the editor greets you with this:\")),\n code(\"The following modules are missing or built with a different engine version:\\n  MetaHumanBodyTracker\\n  BodyTracker\\n  Segmentation\\n  MetaHumanBodyOptimizer\\n\\nEngine modules cannot be compiled at runtime. Please build through your IDE.\"),\n p(T(\"It reads like a platform wall. It is not one. Three facts, each checkable in a minute:\")),\n li(T(\"The \"),C(\".uplugin\"),T(\" declares no \"),C(\"PlatformAllowList\"),T(\" at all.\")),\n li(T(\"No \"),C(\"Build.cs\"),T(\" restricts the platform.\")),\n li(T(\"The \"),C(\"Binaries/Mac\"),T(\" folder already contains universal arm64 and x86_64 dylibs.\")),\n p(T(\"The real cause is one number. The plugin's module manifest announced build \"),C(\"54595663\"),T(\" while the engine expected \"),C(\"55116800\"),T(\". It was compiled against an earlier 5.8, and the editor rejects any module whose build identifier does not match. Nothing about macOS is involved.\")),\n\n h(\"The fix, and the one sentence that carries it\"),\n p(B(\"An engine plugin cannot be recompiled inside an Installed Build. A project plugin can.\"),\" That asymmetry is the entire solution. Move the plugin out of the engine and into the project, drop its stale binaries, and build the project target.\"),\n code('mv \"$UE/Engine/Plugins/Marketplace/MetaHumanBodyTracker_5.8\" \\\\\\n   \"$PROJECT/Plugins/MetaHumanBodyTracker\"\\nrm -rf \"$PROJECT/Plugins/MetaHumanBodyTracker/Binaries\" \\\\\\n       \"$PROJECT/Plugins/MetaHumanBodyTracker/Intermediate\"\\n\\n\"$UE/Engine/Build/BatchFiles/Mac/Build.sh\" MyProjectEditor Mac Development \\\\\\n  -project=\"$PROJECT/MyProject.uproject\" -waitmutex'),\n p(T(\"Result: \"),C(\"Succeeded\"),T(\" in 63 seconds, 103 compile units. The plugin's build identifier now matches the engine and all four modules load. This is the supported path for an Installed Build, not a workaround.\")),\n\n h(\"Three more walls, none of them obvious\"),\n p(B(\"The companion plugins are off.\"), T(\" MetaHumanBodyTracker alone gets you nowhere, because the menus every tutorial describes do not exist until you enable \"),C(\"MetaHuman\"),T(\" for the Performance asset type, \"),C(\"MetaHumanCoreTech\"),T(\" as a declared dependency, \"),C(\"LiveLinkHub\"),T(\" for the Capture Manager window, \"),C(\"CaptureManagerEditor\"),T(\" for mono video ingestion, and \"),C(\"IKRig\"),T(\" for retargeting. Five plugins, not one.\")),\n p(B(\"The ingest refuses ordinary MP4.\"), T(\" It answers \")),\n code(\"Failed to convert: Video file format is unsupported.\\nConsider enabling Third Party Encoder in Capture Manager settings.\"),\n p(T(\"The engine's media readers do not cover every encoding. Capture Manager can delegate, and ffmpeg is almost certainly already on your machine:\")),\n code('[/Script/CaptureManagerEditorSettings.CaptureManagerEditorSettings]\\nbEnableThirdPartyEncoder=True\\nThirdPartyEncoder=(FilePath=\"/opt/homebrew/bin/ffmpeg\")'),\n p(B(\"Everything looks mouse driven.\"), T(\" It is not. Ingestion and processing are fully scriptable, which is what makes the pipeline repeatable instead of a ritual.\")),\n\n h(\"The script that actually produced the animation\"),\n p(T(\"Three gestures, no clicking: create the Performance asset, wire the footage, save it.\")),\n code('import unreal\\n\\nFOOTAGE = \"/Game/CaptureManager/Imports/Take001_1/CD_Take001_1\"\\nFOLDER  = \"/Game/MoCap\"\\nNAME    = \"MHP_Take001\"\\nPATH    = f\"{FOLDER}/{NAME}\"\\n\\nfootage = unreal.load_asset(FOOTAGE)\\n\\nperf = unreal.load_asset(PATH)\\nif perf is None:\\n    tools = unreal.AssetToolsHelpers.get_asset_tools()\\n    perf = tools.create_asset(NAME, FOLDER, unreal.MetaHumanPerformance,\\n                              unreal.MetaHumanPerformanceFactoryNew())\\n\\nperf.set_editor_property(\"footage_capture_data\", footage)\\nperf.set_editor_property(\"body_tracking\", True)\\nperf.set_editor_property(\"face_tracking\", False)\\n\\n# Mandatory. create_asset persists nothing: without this line the asset\\n# exists only in memory and the next process finds None.\\nunreal.EditorAssetLibrary.save_asset(PATH)\\n\\nperf.set_blocking_processing(True)\\nperf.start_pipeline()'),\n p(T(\"Ingestion itself is one call, through a Blueprint function library that Python reaches directly:\")),\n code('lib = unreal.CaptureManagerIngestBlueprintLibrary\\ndata, err = lib.ingest_mono_video_sync(\\n    mp4_path, \"\", \"Take001\", 1,\\n    unreal.CaptureManagerConversionParams())'),\n\n h(\"The still skeleton is not a bug\"),\n p(T(\"During processing the preview skeleton does not move, and that is alarming until you know why. The five stages map onto the plugin's own nodes: body detection, pose estimation, camera calibration, finalisation, then a merge. Camera calibration needs every frame before it can solve anything, so \")),\n p(C(\"AnimationData\"),T(\" is only populated when the pipeline completes. A frozen skeleton at stage two of five is the expected behaviour, not a symptom.\")),\n\n h(\"The step the tutorials skip\"),\n p(T(\"Body tracking does not output onto an Unreal skeleton. It produces animation on an \"),B(\"SMPL\"),T(\" skeleton, which has to be converted twice before it reaches your character:\")),\n code(\"tracking  ->  SMPL  --RTG_SMPL_MH-->  MetaHuman  --RTG_MH_IKRig-->  target skeleton\"),\n p(C(\"SKM_SMPL\"),T(\", \"),C(\"SKEL_SMPL\"),T(\", \"),C(\"IK_SMPL\"),T(\", \"),C(\"IK_Metahuman\"),T(\", \"),C(\"RTG_SMPL_MH\"),T(\" and \"),C(\"RTG_MH_IKRig\"),T(\" all ship inside the plugin's own Content folder. Any guide that ends on \\\"Export Skeleton, pick Existing Skeleton\\\" has skipped this, and that is where it breaks.\")),\n\n h(\"Six traps, each worth a session\"),\n li(B(\"create_asset persists nothing.\"),T(\" The next process finds \"),C(\"None\"),T(\". Call \"),C(\"save_asset\"),T(\" before the script returns.\")),\n li(C(\"can_process\"),T(\" is a \"),B(\"method\"),T(\", not a property. \"),C(\"get_editor_property\"),T(\" raises \\\"Failed to find property\\\".\")),\n li(T(\"Headless processing needs \"),C(\"set_blocking_processing(True)\"),T(\". Without an editor loop, an async job never advances.\")),\n li(C(\"can_process()\"),T(\" can return \"),C(\"False\"),T(\" headlessly while the job runs perfectly with the editor open. A false negative, not a blocker.\")),\n li(T(\"Writing \"),C(\"visualizationObject\"),T(\" from script kills the editor with \"),C(\"Assertion failed: false\"),T(\". The property expects a SkeletalMesh, not a Blueprint class, and the open asset window is what asserts. Use the dropdown.\")),\n li(T(\"Relaunching too fast after a crash leaves the MCP port held, and the server fails to bind \")),\n li(B(\"silently.\"),T(\" One log line admits it. Check the port is free before relaunching.\")),\n\n h(\"Is the computation lost if the editor closes?\"),\n p(T(\"No, provided you saved. The result lives inside the Performance \"),C(\".uasset\"),T(\", which grows from a few kilobytes to roughly ten megabytes once the animation data is written. I verified this the hard way: the editor crashed after processing and the file came back byte for byte identical. The only real risk is leaving it unsaved.\")),\n\n h(\"What I have not proven\"),\n p(T(\"Retargeting and export had not run end to end when I wrote this. They are documented from the plugin sources, not from a success. I would rather say so than let you find out at the worst moment.\")),\n p(T(\"One practical note for volume: 60 frames per second doubles the compute for little gain on body capture, since a human body does not change direction in sixteen milliseconds. Keep 60 for fast weapon work and drop to 30 for the rest.\")),\n\n h(\"Everything, in one repository\"),\n p(T(\"Scripts, configuration snippet, and the full protocol: \")),\n p(C(\"github.com/matthieuhuguet/MetaHuman-Animator-Markerless-Motion-Capture-Plugin-macOS\")),\n p(T(\"It includes a small MCP client for driving the editor from any shell, and a guard that detects an Unreal crash, closes the reporter, checks the port and relaunches. A long asset migration or a thirty minute solve will eventually meet an engine assert, and without a guard the task simply stops there.\")),\n]\n\nart = {\"schema\":\"article.public.v1\",\n       \"slug\":\"metahuman-markerless-macos\",\n       \"title\":\"MetaHuman Animator Markerless Motion Capture Plugin on macOS\",\n       \"subtitle\":\"Everyone says the body capture is Windows only. It is not. The blocker is one stale number, and here is the whole chain from a YouTube clip to an animation.\",\n       \"blocks\":blocks}\nio.open('public/articles/metahuman-markerless-macos.json','w',encoding='utf-8').write(json.dumps(art, ensure_ascii=False, indent=1))\nprint('  blocs :',len(blocks))\nprint('  tirets cadratins :', json.dumps(art,ensure_ascii=False).count(\"—\"))\nPY","description":"Write the article JSON applying the methodology","timeout":240000},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1631,"cache_read_input_tokens":984506,"output_tokens":5348,"output_tokens_details":{"thinking_tokens":331},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1631,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5348,"cache_read_input_tokens":984506,"cache_creation_input_tokens":1631,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1631},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeHtcw8z2A89JZbQddqTh","attributionSkill":"zenray-website","type":"assistant","uuid":"5513b9d6-27d4-489c-bfc5-d17ccff86bcf","timestamp":"2026-08-22T13:48:31.272Z","effort":"m