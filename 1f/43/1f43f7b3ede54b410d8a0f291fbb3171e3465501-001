fmpeg,\n# qui n'a pas la session du client yt-dlp, et YouTube repond 403. Verifie a nouveau le 22 aout 2026,\n# sur quatre clients : seul android_vr passe sans PO token, et ses URL refusent tout acces externe.\n#\n# Ce meme client plafonne a environ 20 Mo par URL. La parade n'est pas une option, c'est de\n# relancer : chaque passe re-extrait une URL fraiche et --continue reprend a l'octet atteint.\nif [ ! -f \"$SOURCE\" ]; then\n  echo \"telechargement de la source, format $FORMAT\"\n  for i in $(seq 1 80); do\n    yt-dlp -f \"$FORMAT\" --continue --no-warnings -o \"$SOURCE\" \"$URL\" >/dev/null 2>&1 || true\n    [ -f \"$SOURCE\" ] && { echo \"  source complete en $i passes\"; break; }\n  done\n  [ -f \"$SOURCE\" ] || { echo \"source non telechargee apres 80 passes\" >&2; exit 3; }\nfi\n\n# ETAPE 2, decouper et convertir.\n# -ss avant -i cherche vite, -t donne la duree. La cadence descend a $FPS, la resolution ne\n# change pas : un downscale ici fausserait la comparaison entre les deux assets.\nffmpeg -y -ss \"$DEBUT\" -i \"$SOURCE\" -to \"$FIN\" -copyts -start_at_zero \\\n  -r \"$FPS\" -c:v libx264 -crf \"$CRF\" -preset slow -pix_fmt yuv420p -an \"$CIBLE\" 2>/dev/null\n\n# ETAPE 3, verifier plutot que supposer.\nTAILLE=$(stat -f%z \"$CIBLE\")\nMO=$(echo \"scale=2; $TAILLE/1048576\" | bc)\nLU=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height,r_frame_rate,nb_frames \\\n     -of csv=p=0 \"$CIBLE\")\necho \"  $CIBLE\"\necho \"  $LU  ·  $MO Mo\"\nDEPASSE=$(echo \"$MO > $PLAFOND_MO\" | bc)\nif [ \"$DEPASSE\" = \"1\" ]; then\n  echo \"  ROUGE : $MO Mo depasse le plafond de $PLAFOND_MO Mo, remonter le CRF\" >&2\n  exit 4\nfi\necho \"  VERT : sous le plafond de $PLAFOND_MO Mo, aucun remux ni bornage de debit necessaire\"\nSH\nchmod +x /Users/zenray/Create/Build/Productions/ZenRayShards/ZenRayShards/Scripts/mocap_take.sh\necho \"  Scripts/mocap_take.sh ecrit\"","description":"Write the reusable take script","timeout":240000},"caller":{"type":"direct"}}