.00, 0.0), (0.015, 0.85), (0.06, 0.65), (0.16, 0.25), (0.30, 0.0)],\n    'flash_radius_ratio': 0.85,        # fraction of the half-diagonal the gradient reaches\n    # A pure white frame at the very start: the hit-stop pop before the red settles in.\n    'white_keys': [(0.00, 0.0), (0.012, 0.95), (0.035, 0.0)],\n    # Radial speed lines bursting from center, the classic parry-effect streaks.\n    'streak_count': 28,\n    'streak_keys': [(0.02, 0.0, 0.0), (0.05, 1.0, 0.9), (0.15, 1.6, 0.0)],\n    'streak_color': (255, 235, 235, 255),\n    'streak_width': 5,\n}\n\n\ndef envelope(keys, t):\n    if t <= keys[0][0]:\n        return keys[0][1:]\n    if t >= keys[-1][0]:\n        return keys[-1][1:]\n    for a, b in zip(keys, keys[1:]):\n        if a[0] <= t <= b[0]:\n            f = (t - a[0]) / (b[0] - a[0])\n            return tuple(x + (y - x) * f for x, y in zip(a[1:], b[1:]))\n    return keys[-1][1:]\n\n\ndef build_text_sprite():\n    font = ImageFont.truetype(P['text_font'], P['text_size'])\n    text = P['text']\n    box = font.getbbox(text, stroke_width=P['text_outline_width'])\n    pad = 8\n    w, h = box[2] - box[0] + pad * 2, box[3] - box[1] + pad * 2\n    sprite = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(sprite)\n    draw.text((pad - box[0], pad - box[1]), text, font=font, fill=P['text_color'],\n              stroke_width=P['text_outline_width'], stroke_fill=P['text_outline_color'])\n    return sprite\n\n\ndef build_flash_gradient():\n    \"\"\"A radial gradient, full color at center fading to transparent, built once and reused at\n    every frame simply by remapping its alpha with the envelope value.\"\"\"\n    w, h = P['width'], P['height']\n    cx, cy = w / 2, h / 2\n    max_r = math.hypot(cx, cy) * P['flash_radius_ratio']\n    grad = Image.new('L', (w, h), 0)\n    px = grad.load()\n    step = 2  # compute every 2 pixels, then upscale: a radial gradient does not need per-pixel cost\n    small = Image.new('L', (w // step + 1, h // step + 1), 0)\n    sp = small.load()\n    for y in range(small.height):\n        for x in range(small.width):\n            dist = math.hypot(x * step - cx, y * step - cy)\n            sp[x, y] = max(0, int(255 * (1 - min(1.0, dist / max_r)) ** 1.6))\n    grad = small.resize((w, h), Image.BILINEAR)\n    return grad\n\n\ndef build_streak_layer(progress, opacity):\n    if opacity <= 0.0:\n        return None\n    w, h = P['width'], P['height']\n    cx, cy = w / 2, h / 2\n    layer = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(layer)\n    inner = 60 + 260 * progress\n    outer = inner + 520 * progress\n    color = tuple(list(P['streak_color'][:3]) + [int(P['streak_color'][3] * opacity)])\n    for i in range(P['streak_count']):\n        angle = (2 * math.pi / P['streak_count']) * i\n        x0 = cx + math.cos(angle) * inner\n        y0 = cy + math.sin(angle) * inner\n        x1 = cx + math.cos(angle) * outer\n        y1 = cy + math.sin(angle) * outer\n        draw.line([(x0, y0), (x1, y1)], fill=color, width=P['streak_width'])\n    return layer.filter(ImageFilter.GaussianBlur(1.2))\n\n\ndef main():\n    text_sprite = build_text_sprite()\n    flash_gradient = build_flash_gradient()\n    total_frames = int(round(P['duration'] * P['fps']))\n    out = sys.stdout.buffer\n\n    for frame_index in range(total_frames):\n        t = frame_index / P['fps']\n        canvas = Image.new('RGBA', (P['width'], P['height']), (0, 0, 0, 0))\n\n        # 1. Red radial flash: colorize the precomputed gradient, scale its alpha by the envelope.\n        (flash_alpha,) = envelope(P['flash_keys'], t)\n        if flash_alpha > 0.0:\n            colored = Image.new('RGBA', (P['width'], P['height']), P['flash_color'] + (0,))\n            alpha = flash_gradient.point(lambda a: int(a * flash_alpha))\n            colored.putalpha(alpha)\n            canvas.alpha_composite(colored)\n\n        # 2. Radial speed lines, bursting outward and fading.\n        streak_progress, streak_opa