_timeout'])\n    for line in reversed((completed.stdout or '').splitlines()):\n        line = line.strip()\n        if line.startswith('{') or line.startswith('['):\n            try:\n                return json.loads(line)\n            except ValueError:\n                continue\n    # When no JSON comes out, the cause is almost always named in plain text on stderr by the script\n    # being called. Surfacing it beats a \"no JSON\" message that teaches nothing.\n    explicit = next((l for l in reversed((completed.stderr or '').splitlines())\n                     if l.strip().startswith('ERROR')), '')\n    return {'ok': False, 'error': explicit or 'hython returned no JSON',\n            'stdout': (completed.stdout or '')[-1200:], 'stderr': (completed.stderr or '')[-1200:]}\n\n\ndef _bridge(request):\n    \"\"\"Talk to the open Houdini session. A refused connection is NOT the absence of Houdini: it is\n    almost always the bridge that was never started inside the session.\"\"\"\n    try:\n        with socket.create_connection((P['bridge_host'], P['bridge_port']),\n                                      timeout=P['bridge_timeout']) as sock:\n            sock.sendall((json.dumps(request, ensure_ascii=False) + '\\n').encode('utf-8'))\n            raw = b''\n            while not raw.endswith(b'\\n'):\n                chunk = sock.recv(1 << 20)\n                if not chunk:\n                    break\n                raw += chunk\n        return json.loads(raw.decode('utf-8'))\n    except (ConnectionRefusedError, OSError) as exc:\n        return {'ok': False,\n                'error': f'bridge unreachable on {P[\"bridge_host\"]}:{P[\"bridge_port\"]} ({exc}). '\n                         f'In the Houdini Python shell: exec(open(\"{P[\"bridge_script\"]}\").read())'}\n\n\ndef tool_search(query='', family='', kind='nodes', limit=P['default_limit']):\n    \"\"\"Search the harvested vocabulary. Houdini does not need to be open.\"\"\"\n    limit = max(1, min(int(limit), P['max_limit']))\n    source = _read_json(P['nodes_file'] if kind == 'nodes' else P['vex_file'])\n    needle = (query or '').strip().lower()\n    found = []\n    for row in source:\n        if family and family not in (row.get('f') or []):\n            continue\n        if needle and needle not in row['n'].lower() and needle not in (row.get('s') or '').lower():\n            continue\n        found.append(row)\n    return {'ok': True, 'kind': kind, 'total': len(found), 'returned': min(len(found), limit),\n            'results': [\n                {'name': (f\"{row['c']}/{row['n']}\" if row.get('c') else row['n']),\n                 'summary': row.get('s') or '',\n                 'families': row.get('f') or [],\n                 **({'signatures': row['u'][:2]} if row.get('u') else {}),\n                 **({'deprecated': True} if row.get('d') else {})}\n                for row in found[:limit]]}\n\n\ndef tool_recipes():\n    \"\"\"List the already verified graphs, with their tunable parameters.\"\"\"\n    result = _hython([str(P['recipe_script']), '--list', '--json'])\n    return {'ok': True, 'recipes': result} if isinstance(result, list) else result\n\n\ndef tool_build(recipe, params=None, hip=''):\n    \"\"\"Build a graph, cook it, and return the verdict of every check.\"\"\"\n    args = [str(P['recipe_script']), '--build', recipe, '--json']\n    for key, value in (params or {}).items():\n        args += ['--p', f'{key}={value}']\n    if hip:\n        args += ['--hip', hip]\n    result = _hython(args)\n    if hip and result.get('ok'):\n        result['hip'] = hip\n    return result\n\n\ndef tool_scene(path='/obj', depth=2):\n    \"\"\"Return the OPEN scene as compact JSON: paths, types, errors, geometry counts.\"\"\"\n    return _bridge({'op': 'scene', 'path': path, 'depth': int(depth)})\n\n\ndef tool_hom(code, target='live'):\n    \"\"\"Escape hatch. Put the value to return in a variable named `result`.\"\"\"\n    if target == 'live':\n        return _bridge({'op': 'hom', 'code': code})\n    wrapper = (\n        'import hou, json\\n'\n        'scope = {\"hou\": hou, \"result\": None}\\n'\n        f'exec(compile({code!r}, \"<zrhoudini>\", \"exec\"), scope)\\n'\n        'value = scope.get(\"result\")\\n'\n        'try: json.dumps(value)\\n'\n        'except TypeError: value = repr(value)\\n'\n        'print(json.dumps({\"ok\": True, \"result\": value}, ensure_ascii=False))\\n'\n    )\n    return _hython(['-c', wrapper])\n\n\n# == THE MCP CATALOGUE, deliberately short =======================================================\n\nTOOLS = [\n    {'name': 'houdini_search',\n     'description': \"Search a node or a VEX function in the complete Houdini 22 vocabulary \"\n                    \"(5564 nodes, 1132 functions). Houdini does not need to be open.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'query': {'type': 'string', 'description': 'term searched in the name or the summary'},\n         'family': {'type': 'string', 'description': 'scattering, instancing, uv, materials, textures, '\n                    'simulation, destruction, terrain, curves, crowd, rendering, export, vex, attributes, modeling'},\n         'kind': {'type': 'string', 'enum': ['nodes', 'vex'], 'description': 'defaults to nodes'},\n         'limit': {'type': 'integer'}}},\n     'fn': lambda a: tool_search(a.get('query', ''), a.get('family', ''), a.get('kind', 'nodes'),\n                                 a.get('limit', P['default_limit']))},\n    {'name': 'houdini_recipes',\n     'description': \"List the Houdini graphs already built AND verified, with their parameters.\",\n     'inputSchema': {'type': 'object', 'properties': {}},\n     'fn': lambda a: tool_recipes()},\n    {'name': 'houdini_build',\n     'description': \"Build a recipe headless, cook it, check the geometry is not empty and return \"\n                    \"every check. Writes a .hip file when a path is given.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'recipe': {'type': 'string'},\n         'params': {'type': 'object', 'description': 'overrides, for example {\"point_count\": 1200}'},\n         'hip': {'type': 'string', 'description': 'path of the .hip file to write, optional'}},\n         'required': ['recipe']},\n     'fn': lambda a: tool_build(a['recipe'], a.get('params'), a.get('hip', ''))},\n    {'name': 'houdini_scene',\n     'description': \"Return the OPEN Houdini scene as compact JSON: paths, types, errors, point and \"\n                    \"primitive counts. Requires zrbridge.py running inside Houdini.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'path': {'type': 'string', 'description': 'defaults to /obj'},\n         'depth': {'type': 'integer', 'description': 'defaults to 2'}}},\n     'fn': lambda a: tool_scene(a.get('path', '/obj'), a.get('depth', 2))},\n    {'name': 'houdini_hom',\n     'description': \"Escape hatch: run HOM code. target=live talks to the open session, \"\n                    \"target=headless runs hython. Put the value to return in `result`.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'code': {'type': 'string'},\n         'target': {'type': 'string', 'enum': ['live', 'headless']}},\n         'required': ['code']},\n     'fn': lambda a: tool_hom(a['code'], a.get('target', 'live'))},\n]\n\n\ndef _serve_mcp():\n    \"\"\"JSON-RPC delimited by newlines, over stdin and stdout. Nothing else.\"\"\"\n    def reply(message):\n        sys.stdout.write(json.dumps(message, ensure_ascii=False) + '\\n')\n        sys.stdout.flush()\n\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            request = json.loads(line)\n        except ValueError:\n            continue\n        method, request_id, params = request.get('method'), request.get('id'), request.get('params') or {}\n        # A notification carries no id: answering one breaks some clients.\n        if request_id is None:\n            continue\n        if method == 'initialize':\n            reply({'jsonrpc': '2.0', 'id': request_id, 'result': {\n                'protocolVersion': P['mcp_protocol'],\n                'capabilities': {'tools': {}},\n                'serverInfo': {'name': P['server_name'], 'version': P['server_version']}}})\n        elif method == 'tools/list':\n            reply({'jsonrpc': '2.0', 'id': request_id, 'result': {\n                'tools': [{k: t[k] for k in ('name', 'description', 'inputSchema')} for t in TOOLS]}})\n        elif method == 'tools/call':\n            name = params.get('name')\n            tool = next((t for t in TOOLS if t['name'] == name), None)\n            if tool is None:\n                reply({'jsonrpc': '2.0', 'id': request_id,\n                       'error': {'code': -32602, 'message': f'unknown tool: {name}'}})\n                continue\n            try:\n                result = tool['fn'](params.get('arguments') or {})\n                failed = not result.get('ok', True)\n            except Exception as exc:\n                result, failed = {'ok': False, 'error': f'{type(exc).__name__}: {exc}'}, True\n            reply({'jsonrpc': '2.0', 'id': request_id, 'result': {\n                'content': [{'type': 'text', 'text': json.dumps(result, ensure_ascii=False, indent=1)}],\n                'isError': failed}})\n        elif method in ('ping', 'shutdown'):\n            reply({'jsonrpc': '2.0', 'id': request_id, 'result': {}})\n        else:\n            reply({'jsonrpc': '2.0', 'id': request_id,\n                   'error': {'code': -32601, 'message': f'unhandled method: {method}'}})\n\n\ndef _cli(argv):\n    if not argv or argv[0] in ('-h', '--help', 'help'):\n        print(__doc__)\n        print('Commands: status | search <term> [family] [nodes|vex] | recipes | '\n              'build <recipe> [key=value ...] | scene [path] [depth] | hom <code> [live|headless]')\n        return 0\n    command, rest = argv[0], argv[1:]\n    if command == 'status':\n        bridge = _bridge({'op': 'ping'})\n        index = _read_json(P['index_file']) if Path(P['index_file']).exists() else {}\n        result = {'ok': True,\n                  'hython': {'path': P['hython'], 'present': Path(P['hython']).exists()},\n                  'vocabulary': {'houdini_version': index.get('houdini_version'),\n                                 'nodes': index.get('total_nodes'), 'vex': index.get('total_vex')},\n                  'recipes': Path(P['recipe_script']).exists(),\n                  'bridge': bridge}\n    elif command == 'search':\n        result = tool_search(rest[0] if rest else '',\n                             rest[1] if len(rest) > 1 else '',\n                             rest[2] if len(rest) > 2 else 'nodes')\n    elif command == 'recipes':\n        result = tool_recipes()\n    elif command == 'build':\n        if not rest:\n            raise SystemExit('ERROR: name the recipe')\n        params = {}\n        for argument in rest[1:]:\n            key, _, value = argument.partition('=')\n            try:\n                params[key] = int(value)\n            except ValueError:\n                try:\n                    params[key] = float(value)\n                except ValueError:\n                    params[key] = value\n        result = tool_build(rest[0], params)\n    elif command == 'scene':\n        result = tool_scene(rest[0] if rest else '/obj', int(rest[1]) if len(rest) > 1 else 2)\n    elif command == 'hom':\n        if not rest:\n            raise SystemExit('ERROR: give the code')\n        result = tool_hom(rest[0], rest[1] if len(rest) > 1 else 'live')\n    else:\n        raise SystemExit(f'ERROR: unknown command \"{command}\"')\n    print(json.dumps(result, ensure_ascii=False, indent=1))\n    return 0 if result.get('ok', True) else 1\n\n\nif __name__ == '__main__':\n    if '--mcp' in sys.argv:\n        _serve_mcp()\n    else:\n        sys.exit(_cli(sys.argv[1:]))\nPYEOF\nchmod +x Houdini/MCP/zrhoudini.