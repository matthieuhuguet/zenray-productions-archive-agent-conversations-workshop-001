 glassy teal-to-blue background with visible veins/drips sliding down. Streamed\nas opaque RGBA frames to ffmpeg's stdin.\n\nV4, corrected 2026-09-12. Matthieu: the flow was invisible and the colors read too raw/saturated,\nlike plain blue and turquoise rather than the frosted dark glass used on the ZenRayProgress\nsidebar. Two changes: (1) the noise is now RIDGED and ANISOTROPIC, elongated vertically, so it\nreads as veins or drops sliding down rather than a soft cloud ; (2) the palette is pre-darkened and\ndesaturated here, at generation time, matching a \"glass panel\" feel, so the ffmpeg compositing only\nneeds to blur it softly instead of fighting the raw hue.\n\nFR : bruit \"ridged\" et anisotrope, etire verticalement, pour lire comme des veines ou des gouttes\nqui glissent. Palette assombrie et desaturee des la generation, pour un rendu vitre sombre.\n\"\"\"\nimport sys\nimport numpy as np\nfrom PIL import Image, ImageFilter\n\n# -- PARAMETERS (HDA law: everything tunable lives here) -----------------------------------------\nP = {\n    'width': 1080,\n    'height': 1920,\n    'fps': 30,\n    'duration': 30.0,\n    # Turquoise stays at the TOP, deep blue at the BOTTOM, so the yellow subtitles (bottom third)\n    # sit on the darker color. Pre-darkened here (not the raw saturated hex from v2/v3).\n    # FR : turquoise en haut, bleu profond en bas ; assombri directement ici.\n    'color_top': (0x0E, 0x7A, 0x5E),\n    'color_bottom': (0x0A, 0x35, 0x6B),\n    'darken_mix': 0.30,                # 0 = raw color_top/bottom, 1 = fully mixed toward glass_base\n    'glass_base': (0x10, 0x18, 0x22),  # near-black blue-gray, the \"frosted glass\" undertone\n    'noise_octaves': 4,\n    'noise_low_res_divisor_x': 9,      # finer horizontally = thinner veins\n    'noise_low_res_divisor_y': 34,     # coarser vertically = elongated drips\n    'noise_blur_radius': 10,\n    'ridge_sharpness': 1.6,            # >1 thins and sharpens the vein ridges\n    'vein_strength': 0.55,             # how much the veins modulate brightness, 0..1\n    'noise_amplitude': 0.34,           # how far the noise pushes the base vertical blend\n    'scroll_speed_px_s': 46.0,         # faster, visible drift, like drops sliding down\n    'seed': 11,\n}\n\n\ndef fbm_field(width, height, octaves, low_res_divisor_x, low_res_divisor_y, blur_radius, seed):\n    \"\"\"Sum of blurred random layers, anisotropic cells (narrower than tall) so the upscaled result\n    reads as vertical veins rather than round blobs, at halving frequency, normalized to 0..1.\"\"\"\n    rng = np.random.default_rng(seed)\n    acc = np.zeros((height, width), dtype=np.float32)\n    amplitude = 1.0\n    total = 0.0\n    div_x, div_y = low_res_divisor_x, low_res_divisor_y\n    for octave in range(octaves):\n        low_w = max(2, width // div_x)\n        low_h = max(2, height // div_y)\n        cell = rng.random((low_h, low_w), dtype=np.float32)\n        layer = Image.fromarray((cell * 255).astype(np.uint8)).convert('L')\n        layer = layer.resize((width, height), Image.BICUBIC)\n        layer = layer.filter(ImageFilter.GaussianBlur(blur_radius / (octave + 1) ** 0.5))\n        acc += amplitude * (np.asarray(layer, dtype=np.float32) / 255.0)\n        total += amplitude\n        amplitude *= 0.55\n        div_x = max(2, div_x - 2)\n        div_y = max(3, int(div_y * 0.65))\n    acc /= total\n    acc -= acc.min()\n    acc /= max(1e-6, acc.max())\n    return acc  # (height, width) float32 0..1\n\n\ndef main():\n    width, height, fps, duration = P['width'], P['height'], P['fps'], P['duration']\n    scroll_range = int(P['scroll_speed_px_s'] * duration) + height\n    tall = fbm_field(width, scroll_range, P['noise_octaves'],\n                      P['noise_low_res_divisor_x'], P['noise_low_res_divisor_y'],\n                      P['noise_blur_radius'], P['seed'])\n\n    # Ridged transform: 1 - |2x - 1| turns smooth fBm into thin bright ridges (classic vein/marble\n    # noise), sharpened by a power curve so the veins stay thin and smooth-edged rather than blobby.\n    ridged = 1.0 - np.abs(2.0 * tall - 1.0)\n    ridged = np.clip(ridged, 0.0, 1.0) ** P['ridge_sharpness']\n\n    grad = np.linspace(0.0, 1.0, height, dtype=np.float32)[:, None]\n    grad = np.repeat(grad, width, axis=1)\n\n    top = np.array(P['color_top'], dtype=np.float32)\n    bottom = np.array(P['color_bottom'], dtype=np.float32)\n    glass = np.array(P['glass_base'], dtype=np.float32)\n    top = top * (1.0 - P['darken_mix']) + glass * P['darken_mix']\n    bottom = bottom * (1.0 - P['darken_mix']) + glass * P['darken_mix']\n\n    total_frames = int(round(duration * fps))\n    out = sys.stdout.buffer\n    for frame_index in range(total_frames):\n        t = frame_index / fps\n        offset = int(t * P['scroll_speed_px_s']) % (scroll_range - height + 1)\n        noise_slice = tall[offset:offset + height, :]\n        ridge_slice = ridged[offset:offset + height, :]\n\n        value = grad + P['noise_amplitude'] * (noise_slice - 0.5)\n        value = np.clip(value, 0.0, 1.0)[:, :, None]\n        rgb = top[None, None, :] * (1.0 - value) + bottom[None, None, :] * value\n\n        vein_mod = 1.0 - P['vein_strength'] * 0.5 + P['vein_strength'] * ridge_slice\n        rgb = rgb * vein_mod[:, :, None]\n\n        rgba = np.empty((height, width, 4), dtype=np.uint8)\n        rgba[:, :, :3] = np.clip(rgb, 0, 255).astype(np.uint8)\n        rgba[:, :, 3] = 255\n\n        out.write(rgba.tobytes())\n    out.flush()\n\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[{"oldStart":28,"oldLines":14,"newStart":28,"newLines":14,"lines":["     'color_bottom': (0x0A, 0x35, 0x6B),","     'darken_mix': 0.30,                # 0 = raw color_top/bottom, 1 = fully mixed toward glass_base","     'glass_base': (0x10, 0x18, 0x22),  # near-black blue-gray, the \"frosted glass\" undertone","-    'noise_octaves': 4,","-    'noise_low_res_divisor_x': 9,      # finer horizontally = thinner veins","-    'noise_low_res_div