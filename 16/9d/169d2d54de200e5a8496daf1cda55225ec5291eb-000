{"parentUuid":"645d5b7c-c2fc-481c-a89d-d7a687bfeb4e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/private/tmp/claude-501/-Users-zenray-Create-Build-Memory/5f649d7d-3f0b-4e40-9aeb-39c6fa2e2eab/scratchpad/render_short.py","snippet":"1\t\"\"\"Render the animated subtitle and title overlay for a 30 second short, piped straight into ffmpeg.\n2\t\n3\tWHY A PIPE. 900 RGBA frames at 1080x1920 would mean writing and re-reading ~7 GB of PNGs. Streaming\n4\traw frames to ffmpeg's stdin, as a second input, skips that entirely: no intermediate files, no\n5\tcompression overhead, one process reads what the other writes.\n6\t\n7\tFR : le pipe evite d ecrire puis relire des gigaoctets de PNG intermediaires.\n8\t\"\"\"\n9\timport sys\n10\tfrom PIL import Image, ImageDraw, ImageFont\n11\t\n12\t# -- PARAMETERS (HDA law: everything tunable lives here) -----------------------------------------\n13\tP = {\n14\t    'width': 1080,\n15\t    'height': 1920,\n16\t    'fps': 30,\n17\t    'duration': 30.0,\n18\t    # Corrected 2026-09-12: the title font is AnthropicSerif SemiBoldItalic, not AnthropicSans.\n19\t    # FR : la police du titre est AnthropicSerif SemiBoldItalic, pas AnthropicSans.\n20\t    # Corrected 2026-09-12: NON ITALIC. Matthieu: \"Houdini doit etre non italic\".\n21\t    # FR : le titre n est pas en italique, jamais.\n22\t    'title_font': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf',\n23\t    'title_text': 'HOUDINI LOUISIANA BAYOU',\n24\t    'title_size_start': 130,           # the title is sized to the MAXIMUM px that still fits, never cropped\n25\t    'title_max_pill_width_ratio': 0.92,\n26\t    'title_pill_bg': (255, 255, 255, 255),\n27\t    'title_text_color': (0, 0, 0, 255),\n28\t    'title_radius_ratio': 0.30,\n29\t    'title_pad_x_ratio': 0.55,\n30\t    'title_pad_y_ratio': 0.42,\n31\t    'title_y_center': 260,\n32\t    'subtitle_font': '/Users/zenray/Library/Fonts/InterVariable.ttf',\n33\t    # Corrected 2026-09-12: the bottom subtitles are Inter ExtraBold (800), not SemiBold (600).\n34\t    # FR : les sous-titres du bas sont en Inter ExtraBold, pas SemiBold.\n35\t    # Corrected 2026-09-12: Inter Black (900), not ExtraBold, and yellow #f8f671, not #edc853.\n36\t    # FR : Inter Black, pas ExtraBold ; jaune #f8f671, pas l ancien.\n37\t    'subtitle_weight': 900,\n38\t    'subtitle_color': (0xF8, 0xF6, 0x71, 255),\n39\t    'subtitle_size_start': 62,\n40\t    'subtitle_max_width_ratio': 0.86,\n41\t    'line1_y': 1520,\n42\t    'line2_y': 1610,\n43\t    'cue_seconds': 3.0,\n44\t    'pop_line1_offset': 0.0,\n45\t    'pop_line2_offset': 0.4,\n46\t    # (time, scale, opacity) keyframes of the pop-in envelope, held at the last value after.\n47\t    'pop_keys': [(0.0, 0.5, 0.0), (0.05, 0.5, 1.0), (0.15, 1.18, 1.0), (0.30, 0.96, 1.0), (0.45, 1.0, 1.0)],\n48\t}\n49\t\n50\tCUES = [\n51\t    (\"Today I continued developing\", \"my procedural Louisiana bayou church in Houdini.\"),\n52\t    (\"I added a new asymmetrical vestibule\", \"on the porch stairs.\"),\n53\t    (\"It sits off-center\", \"as part of the porch entrance.\"),\n54\t    (\"I also started a Copernicus workflow\", \"for procedural materials like Substance Designer.\"),\n55\t    (\"Its advantage is staying\", \"inside the same software.\"),\n56\t    (\"I will see how far Copernicus can go\", \"compared with Substance Designer.\"),\n57\t    (\"Across my existing components,\", \"I identified the material tags.\"),\n58\t    (\"Those tags assign materials\", \"directly to the geometry.\"),\n59\t    (\"I chose four materials from\", \"my concept art and reference images.\"),\n60\t    (\"Next is the Karma XPU lookdev render.\", \"The complete graph is already set up.\"),\n61\t]\n62\t\n63\t\n64\tWEIGHT_NAMES = {400: b'Regular', 500: b'Medium', 600: b'SemiBold', 700: b'Bold',\n65\t                800: b'ExtraBold', 900: b'Black'}\n66\t\n67\t\n68\tdef load_variable_font(path, size, weight):\n69\t    # InterVariable carries TWO axes, optical size