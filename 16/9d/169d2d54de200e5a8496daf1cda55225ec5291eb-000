 grid.parm('cols').set(40)\n\n    scatter = geo.createNode('scatter', 'semis')\n    scatter.setFirstInput(grid)\n    scatter.parm('npts').set(params['nombre_points'])\n    scatter.parm('seed').set(params['graine'])\n\n    # 2. Le nom sur les POINTS cibles, plus l'échelle et l'orientation aléatoires.\n    pts = geo.createNode('attribwrangle', 'nom_et_variation_points')\n    pts.setFirstInput(scatter)\n    pts.parm('class').set(2)  # Points\n    pts.parm('snippet').set(\n        'int nb = chi(\"nb_variantes\");\\n'\n        's@name = sprintf(\"A%d\", int(rand(@ptnum * 13.37 + chi(\"graine\")) * nb) + 1);\\n'\n        '@pscale = fit01(rand(@ptnum + 91), chf(\"echelle_min\"), chf(\"echelle_max\"));\\n'\n        'float yaw = rand(@ptnum + 3) * 2 * $PI;\\n'\n        '@orient = quaternion(yaw, {0,1,0});\\n'\n    )\n    for nom, clef, valeur in [\n        ('nb_variantes', 'nb_variantes', params['nombre_variantes']),\n        ('graine', 'graine', params['graine']),\n        ('echelle_min', 'echelle_min', params['echelle_min']),\n        ('echelle_max', 'echelle_max', params['echelle_max']),\n    ]:\n        pass\n    _ajouter_sliders(hou, pts, {\n        'nb_variantes': ('int', params['nombre_variantes']),\n        'graine': ('int', params['graine']),\n        'echelle_min': ('float', params['echelle_min']),\n        'echelle_max': ('float', params['echelle_max']),\n    })\n\n    # 3. Les gabarits : N boîtes de tailles différentes, empaquetées, chacune nommée A1..AN.\n    boite = geo.createNode('box', 'gabarits')\n    boite.parm('scale').set(0.5)\n    copie = geo.createNode('duplicate', 'variantes')\n    copie.setFirstInput(boite)\n    copie.parm('ncy').set(params['nombre_variantes'] - 1)\n    copie.parm('tx').set(3)\n    copie.parm('scale').set(0.85)\n\n    pack = geo.createNode('pack', 'pack_gabarits')\n    pack.setFirstInput(copie)\n    pack.parm('packbyname').set(0)\n\n    nom_gab = geo.createNode('attribwrangle', 'nom_gabarits')\n    nom_gab.setFirstInput(pack)\n    nom_gab.parm('class').set(1)  # Primitives : le nom se pose APRÈS le pack (Leçon 3)\n    nom_gab.parm('snippet').set('s@name = sprintf(\"A%d\", @primnum + 1);')\n\n    # 4. Le name matching, le coeur de la recette.\n    copy = geo.createNode('copytopoints::2.0', 'instancier')\n    copy.setFirstInput(nom_gab)\n    copy.setSecondInput(pts)\n    copy.parm('useidattrib').set(1)\n    copy.parm('idattrib').set('name')\n\n    # 5. Les attributs que Houdini Engine lit à l'import Unreal.\n    unreal = geo.createNode('attribwrangle', 'attributs_unreal')\n    unreal.setFirstInput(copy)\n    unreal.parm('class').set(0)  # Detail\n    unreal.parm('snippet').set(\n        's@unreal_material = chs(\"materiau\");\\n'\n        's@unreal_output_name = chs(\"nom_sortie\");\\n'\n        'i@unreal_nanite_enabled = chi(\"nanite\");\\n'\n        'i@unreal_collision_geo = chi(\"collision\");\\n'\n    )\n    _ajouter_sliders(hou, unreal, {\n        'materiau': ('string', params['materiau_unreal']),\n        'nom_sortie': ('string', params['nom_sortie_unreal']),\n        'nanite': ('int', params['nanite']),\n        'collision': ('int', params['collision']),\n    })\n\n    sortie = geo.createNode('null', 'SORTIE')\n    sortie.setFirstInput(unreal)\n    sortie.setDisplayFlag(True)\n    sortie.setRenderFlag(True)\n    geo.layoutChildren()\n    return sortie\n\n\ndef verifier(hou, sortie, params):\n    geo = sortie.geometry()\n    prims = len(geo.prims())\n    noms = set()\n    for p in geo.prims():\n        try:\n            noms.add(p.stringAttribValue('name'))\n        except Exception:\n            pass\n    detail = {a.name() for a in geo.globalAttribs()}\n    return [\n        (\"la geometrie n'est pas vide\", prims > 0, f'{prims} primitives'),\n        ('toutes les variantes sont distribuees', len(noms) == params['nombre_variantes'],\n         f\"{len(noms)} noms distincts sur {params['nombre_variantes']} attendus : {sorted(noms)}\"),\n        ('un point instancie par point seme', prims == params['nombre_points'],\n         f\"{prims} contre {params['nombre_points']}\"),\n        ('les attributs Unreal sont poses', {'unreal_material', 'unreal_output_name',\n                                             'unreal_nanite_enabled'} <= detail,\n         f'detail : {sorted(detail)}'),\n    ]\n\n\ndef _ajouter_sliders(hou, noeud, definitions):\n    \"\"\"Expose les valeurs en paramètres de l'interface plutôt qu'en dur dans le VEX (loi HDA).\"\"\"\n    groupe = noeud.parmTemplateGroup()\n    for nom, (genre, valeur) in definitions.items():\n        if groupe.find(nom):\n            continue\n        if genre == 'int':\n            groupe.append(hou.IntParmTemplate(nom, nom, 1, default_value=(int(valeur),)))\n        elif genre == 'float':\n            groupe.append(hou.FloatParmTemplate(nom, nom, 1, default_value=(float(valeur),)))\n        else:\n            groupe.append(hou.StringParmTemplate(nom, nom, 1, default_value=(str(valeur),)))\n    noeud.setParmTemplateGroup(groupe)\n    for nom, (_, valeur) in definitions.items():\n        noeud.parm(nom).set(valeur)\nPYEOF\necho \"recette 1 écrite\"","description":"Write recipe 1: scatter to Unreal"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":825,"cache_read_input_tokens":233917,"output_tokens":3150,"output_tokens_details":{"thinking_tokens":55},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":825,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3150,"cache_read_input_tokens":233917,"cache_creation_input_tokens":825,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":825},"type":"message"}],"speed":"standard"},"diagnostics":null},"apiBlockIndex":1,"requestId":"req_011CeonWcDgwtePmFReomCam","type":"assistant","uuid":"c49aefc6-bcc4-476f-