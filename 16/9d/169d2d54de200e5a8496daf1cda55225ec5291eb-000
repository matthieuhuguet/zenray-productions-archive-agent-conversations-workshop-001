quest(URL, data=json.dumps(charge).encode(), headers=entetes, method=\"POST\")\n    with urllib.request.urlopen(req, timeout=120) as r:\n        brut = r.read().decode()\n        sid = r.headers.get(\"Mcp-Session-Id\")\n    # Le serveur peut répondre en SSE : on ne garde alors que la charge utile des lignes `data:`.\n    if brut.lstrip().startswith(\"event:\") or brut.lstrip().startswith(\"data:\"):\n        brut = \"\\n\".join(l[5:].strip() for l in brut.splitlines() if l.startswith(\"data:\"))\n    return (json.loads(brut) if brut.strip() else None), sid\n\ndef connexion():\n    \"\"\"Poignée de main complète. Rend l'identifiant de session à passer aux appels suivants.\"\"\"\n    _, sid = _post({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\n        \"protocolVersion\": \"2025-06-18\", \"capabilities\": {},\n        \"clientInfo\": {\"name\": \"zenrayshards-cli\", \"version\": \"1.0\"}}})\n    if not sid:\n        raise SystemExit(\"ÉCHEC — pas d'identifiant de session. L'éditeur Unreal est-il ouvert ?\")\n    _post({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"}, sid)\n    return sid\n\ndef appeler(methode, params=None, sid=None):\n    sid = sid or connexion()\n    rep, _ = _post({\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": methode, \"params\": params or {}}, sid)\n    if rep and \"error\" in rep:\n        raise SystemExit(f\"ÉCHEC — {rep['error'].get('message', rep['error'])}\")\n    return (rep or {}).get(\"result\", {})\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 2:\n        raise SystemExit(__doc__)","is_error":false}]},"uuid":"78298c0b-fad0-471d-93f8-14f94fcd8b49","timestamp":"2026-09-07T09:21:20.697Z","toolUseResult":{"stdout":"     121 /Users/zenray/Create/Build/Productions/ZenRayShards/ZenRayShards/Scripts/mcp.py\n#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nCLIENT MCP UNREAL EN LIGNE DE COMMANDE — parler à l'éditeur depuis N'IMPORTE QUELLE session.\n\nPOURQUOI CE FICHIER EXISTE (2026