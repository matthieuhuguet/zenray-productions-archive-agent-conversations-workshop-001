lly mixed toward glass_base\n    'glass_base': (0x10, 0x18, 0x22),  # near-black blue-gray, the \"frosted glass\" undertone\n    'noise_octaves': 4,\n    'noise_low_res_divisor_x': 9,      # finer horizontally = thinner veins\n    'noise_low_res_divisor_y': 34,     # coarser vertically = elongated drips\n    'noise_blur_radius': 10,\n    'ridge_sharpness': 1.6,            # >1 thins and sharpens the vein ridges\n    'vein_strength': 0.55,             # how much the veins modulate brightness, 0..1\n    'noise_amplitude': 0.34,           # how far the noise pushes the base vertical blend\n    'scroll_speed_px_s': 46.0,         # faster, visible drift, like drops sliding down\n    'seed': 11,\n}\n\n\ndef fbm_field(width, height, octaves, low_res_divisor_x, low_res_divisor_y, blur_radius, seed):\n    \"\"\"Sum of blurred random layers, anisotropic cells (narrower than tall) so the upscaled result\n    reads as vertical veins rather than round blobs, at halving frequency, normalized to 0..1.\"\"\"\n    rng = np.random.default_rng(seed)\n    acc = np.zeros((height, width), dtype=np.float32)\n    amplitude = 1.0\n    total = 0.0\n    div_x, div_y = low_res_divisor_x, low_res_divisor_y\n    for octave in range(octaves):\n        low_w = max(2, width // div_x)\n        low_h = max(2, height // div_y)\n        cell = rng.random((low_h, low_w), dtype=np.float32)\n        layer = Image.fromarray((cell * 255).astype(np.uint8)).convert('L')\n        layer = layer.resize((width, height), Image.BICUBIC)\n        layer = layer.filter(ImageFilter.GaussianBlur(blur_radius / (octave + 1) ** 0.5))\n        acc += amplitude * (np.asarray(layer, dtype=np.float32) / 255.0)\n        total += amplitude\n        amplitude *= 0.55\n        div_x = max(2, div_x - 2)\n        div_y = max(3, int(div_y * 0.65))\n    acc /= total\n    acc -= acc.min()\n    acc /= max(1e-6, acc.max())\n    return acc  # (height, width) float32 0..1\n\n\ndef main():\n    width, height, fps, duration = P['width'], P['