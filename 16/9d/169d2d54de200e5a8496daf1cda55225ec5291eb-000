  'hote': '127.0.0.1',      # jamais 0.0.0.0 : ce pont ouvre une session Houdini, il reste local\n    'port': 18812,            # 18811 est pris par hrpyc, on ne marche pas dessus\n    'tampon': 1 << 20,        # 1 Mio par message, largement au-dessus d un resume de scene\n    'attente': 0.0,           # socket non bloquant : la boucle d evenements donne le rythme\n    'profondeur_max': 6,\n    'noeuds_max': 400,        # au-dela, un resume de scene ne se lit plus, il se compte\n}\n\n_etat = {'socket': None, 'actif': False}\n\n\ndef _resumer_noeud(hou, noeud, profondeur, restant):\n    \"\"\"Rend un noeud en JSON compact. Compact veut dire : ce qui sert a decider, rien d autre.\"\"\"\n    if restant[0] <= 0:\n        return None\n    restant[0] -= 1\n    d = {\n        'chemin': noeud.path(),\n        'type': noeud.type().name(),\n        'categorie': noeud.type().category().name(),\n    }\n    try:\n        if noeud.isDisplayFlagSet():\n            d['affiche'] = True\n    except Exception:\n        pass\n    erreurs = []\n    try:\n        erreurs = list(noeud.errors())\n    except Exception:\n        pass\n    if erreurs:\n        d['erreurs'] = [e[:200] for e in erreurs[:3]]\n    # La geometrie compte plus que la structure : un graphe correct qui rend zero primitive est le\n    # mode d echec le plus frequent, et le plus silencieux.\n    try:\n        if hasattr(noeud, 'geometry') and noeud.isDisplayFlagSet():\n            g = noeud.geometry()\n            if g is not None:\n                d['geo'] = {\n                    'points': len(g.points()),\n                    'prims': len(g.prims()),\n                    'attribs_points': [a.name() for a in g.pointAttribs()][:12],\n                    'attribs_detail': [a.name() for a in g.globalAttribs()][:12],\n                }\n    except Exception:\n        pass\n    if profondeur > 0:\n        enfants = [_resumer_noeud(hou, e, profondeur - 1, restant) for e in noeud.children()]\n        enfants = [e for e in enfants if e]\n        if enfants:\n            d['enfants'] = enfants\n    return d\n\n\ndef _traiter(requete):\n    import hou\n    op = requete.get('op')\n    if op == 'ping':\n        return {'ok': True, 'version': hou.applicationVersionString(),\n                'hip': hou.hipFile.path(), 'image': hou.frame()}\n    if op == 'scene':\n        chemin = requete.get('chemin') or '/obj'\n        noeud = hou.node(chemin)\n        if noeud is None:\n            return {'ok': False, 'erreur': f'noeud introuvable : {chemin}'}\n        profondeur = min(int(requete.get('profondeur', 2)), P['profondeur_max'])\n        restant = [P['noeuds_max']]\n        arbre = _resumer_noeud(hou, noeud, profondeur, restant)\n        return {'ok': True, 'racine': chemin, 'tronque': restant[0] <= 0, 'arbre': arbre}\n    if op == 'hom':\n        code = requete.get('code') or ''\n        espace = {'hou': hou, 'resultat': None}\n        exec(compile(code, '<zrbridge>', 'exec'), espace)\n        r = espace.get('resultat')\n        try:\n            json.dumps(r)\n        except TypeError:\n            r = repr(r)\n        return {'ok': True, 'resultat': r}\n    return {'ok': False, 'erreur': f'operation inconnue : {op}'}\n\n\ndef _tour():\n    \"\"\"Un tour de boucle. Ne bloque jamais : sinon l interface de Houdini se fige.\"\"\"\n    srv = _etat['socket']\n    if srv is None:\n        return\n    try:\n        conn, _ = srv.accept()\n    except (BlockingIOError, OSError):\n        return\n    try:\n        conn.settimeout(5)\n        brut = b''\n        while not brut.endswith(b'\\n'):\n            morceau = conn.recv(P['tampon'])\n            if not morceau:\n                break\n            brut += morceau\n        requete = json.loads(brut.decode('utf-8') or '{}')\n        try:\n            reponse = _traiter(requete)\n        except Exception:\n            reponse = {'ok': False, 'erreur': traceback.format_exc(limit=4)}\n        conn.sendall((json.dumps(reponse, ensure_ascii=False) + '\\n').encode('utf-8'))\n    except Exception:\n        pass\n    finally:\n        try:\n            conn.close()\n        except Exception:\n            pass\n\n\ndef zr_pont_demarrer():\n    import hou\n    if _etat['actif']:\n        print(f\"pont ZenRay deja actif sur {P['hote']}:{P['port']}\")\n        return\n    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    srv.bind((P['hote'], P['port']))\n    srv.listen(4)\n    srv.setblocking(False)\n    _etat['socket'] = srv\n    _etat['actif'] = True\n    hou.ui.addEventLoopCallback(_tour)\n    print(f\"pont ZenRay ouvert sur {P['hote']}:{P['port']} — Houdini {hou.applicationVersionString()}\")\n\n\ndef zr_pont_arreter():\n    import hou\n    if not _etat['actif']:\n        print('pont ZenRay deja arrete')\n        return\n    try:\n        hou.ui.removeEventLoopCallback(_tour)\n    except Exception:\n        pass\n    try:\n        _etat['socket'].close()\n    except Exception:\n        pass\n    _etat['socket'] = None\n    _etat['actif'] = False\n    print('pont ZenRay ferme')\n\n\nzr_pont_demarrer()\nPYEOF\npython3 -m py_compile Houdini/MCP/zrbridge.py && echo \"zrbridge.py compile\"","description":"Write the in-Houdini TCP bridge"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1083,"cache_read_input_tokens":316080,"output_tokens":3711,"output_tokens_details":{"thinking_tokens":696},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1083,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3711,"cache_read_input_tokens":316080,"cache_creation_input_tokens":1083,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1083},"type":"message"}],"speed":"standard"},"diagnostics":null