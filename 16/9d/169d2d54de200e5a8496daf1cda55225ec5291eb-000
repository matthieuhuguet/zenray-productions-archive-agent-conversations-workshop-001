for (t0, s0, o0), (t1, s1, o1) in zip(keys, keys[1:]):\n165\t        if t0 <= local_t <= t1:\n166\t            f = (local_t - t0) / (t1 - t0)\n167\t            return s0 + (s1 - s0) * f, o0 + (o1 - o0) * f\n168\t    return keys[-1][1], keys[-1][2]\n169\t\n170\t\n171\tdef paste_scaled(base, sprite, center_x, center_y, scale, opacity):\n172\t    if opacity <= 0.0 or scale <= 0.0:\n173\t        return\n174\t    w, h = sprite.size\n175\t    new_w, new_h = max(1, int(w * scale)), max(1, int(h * scale))\n176\t    resized = sprite.resize((new_w, new_h), Image.LANCZOS)\n177\t    if opacity < 1.0:\n178\t        alpha = resized.getchannel('A').point(lambda a: int(a * opacity))\n179\t        resized.putalpha(alpha)\n180\t    base.alpha_composite(resized, (int(center_x - new_w / 2), int(center_y - new_h / 2)))\n181\t\n182\t\n183\tdef main():\n184\t    max_width = int(P['width'] * P['subtitle_max_width_ratio'])\n185\t    sprites = []\n186\t    for line1, line2 in CUES:\n187\t        font1, _ = fit_font(line1, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n188\t        font2, _ = fit_font(line2, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n189\t        sprites.append((make_text_sprite(line1, font1, P['subtitle_color']),\n190\t                        make_text_sprite(line2, font2, P['subtitle_color'])))\n191\t\n192\t    title_layer = build_title_layer()\n193\t\n194\t    total_frames = int(round(P['duration'] * P['fps']))\n195\t    out = sys.stdout.buffer\n196\t    for frame_index in range(total_frames):\n197\t        t = frame_index / P['fps']\n198\t        cue_index = min(int(t // P['cue_seconds']), len(CUES) - 1)\n199\t        local_t = t - cue_index * P['cue_seconds']\n200\t        sprite1, sprite2 = sprites[cue_index]\n201\t\n202\t        frame = title_layer.copy()\n203\t        scale1, opacity1 = envelope(max(0.0, local_t - P['pop_line1_offset']))\n204\t        scale2, opacity2 = envelope(max(0.0, local_t - P['pop_line2_offset']))\n205\t        if local_t < P['pop_line2_offset']:\n206\t            opacity2 = 0.0\n207\t        paste_scaled(frame, sprite1, P['width'] / 2, P['line1_y'], scale1, opacity1)\n208\t        paste_scaled(frame, sprite2, P['width'] / 2, P['line2_y'], scale2, opacity2)\n209\t\n210\t        out.write(frame.tobytes())\n211\t    out.flush()\n212\t\n213\t\n214\tif __name__ == '__main__':\n215\t    main()\n216\t\n</system-reminder>"}],"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"5f649d7d-3f0b-4e40-9aeb-39c6fa2e2eab","version":"2.1.266","gitBranch":"main","slug":"swirling-zooming-hartmanis"}
{"parentUuid":"e0372e2b-4768-4a24-bfc1-900c041887cc","isSidechain":false,"attachment":{"type":"invoked_skills","skills":[{"name":"ctrl-s","path":"userSettings:ctrl-s","content":"Base directory for this skill: /Users/zenray/.claude/skills/ctrl-s\n\n# Ctrl-S\n\nLe geste répond à une seule question :\n\n> Où faut-il écrire ce que nous venons d'apprendre pour que cela serve encore dans six mois ?\n\nLa réponse comporte parfois deux écritures, dont les rôles ne se doublonnent jamais :\n\n- le fichier `*1.md` garde la connaissance durable du projet ;\n- `/Users/zenray/.claude/PROGRESS.md` garde la trace datée de l'action et pointe vers cette source.\n\n## Architecture canonique\n\n| Question | Source unique |\n|---|---|\n| Quand, quoi, quel agent, quelle preuve, quelle suite ? | `~/.claude/PROGRESS.md` via le skill `progress` |\n| Que sait durablement un projet ou un domaine ? | `Memory/<domaine>/<Nom>1.md` |\n| Comment retrouver une section dans un gros fichier ? | skill routeur de contexte |\n| Quelle méthode réutiliser ? | `~/.claude/skills/<méthode>/` |\n| Quelle loi vaut encore demain ? | `CLAUDE.md` global ou du projet |\n| Pourquoi cette ligne de code surprenante existe-t-elle ? | commentaire au point exact |\n| Quel plan ou état de chantier détaillé reprendre ? | fichier dédié dans le projet |\n| Où vit un secret ? | section autorisée de `Identity/Matthieu1.md`, jamais ailleurs |\n\nUne information, un seul endroit. Le journal cite la source durable ; il n'en recopie pas le contenu.\n\n## Arbre de décision\n\n1. **Secret** : utiliser seulement la valeur nécessaire depuis `Identity/Matthieu1.md`. Ne jamais l'afficher,\n   la journaliser ni la mettre dans un commit.\n2. **Connaissance durable d'un projet ou de Matthieu** : trouver son `*1.md` avec le routeur correspondant,\n   puis ajouter une section datée sans effacer l'historique.\n3. **Méthode réutilisable** : créer ou corriger le skill source dans `~/.claude/skills/`, puis le synchroniser.\n4. **Loi transversale** : modifier `~/.claude/CLAUDE.md`. Une loi propre à un dépôt va dans son `CLAUDE.md`.\n5. **Cause locale d'un code surprenant** : commenter au point exact, avec symptôme, cause, fausse piste et risque.\n6. **Plan ou chantier long** : utiliser `KANBAN.md`, `PROTOCOLE.md`, `docs/<sujet>-design.md` ou le fichier déjà\n   en vigueur dans le projet.\n7. **Chronologie** : appeler le skill `progress` dans tous les cas notables, avec un pointeur vers la source\n   durable quand les étapes précédentes ont écrit ailleurs.\n\n## Bases Memory\n\nLes gros fichiers restent entiers. Un skill court sert d'index dynamique et ne charge que la section utile.\n\n- `matthieu-context` route vers `/Users/zenray/Create/Build/Memory/Identity/Matthieu1.md` ;\n- `japanese-context` route vers `/Users/zenray/Create/Build/Memory/Japanese/Japanese1.md` ;\n- `zenrayshards-context` route vers `/Users/zenray/Create/Build/Memory/ZenRayShards/ZenRayShards1.md` ;\n- les autres domaines suivent le même contrat, par exemple `Design/Design1.md`, `Houdini/Houdini1.md`,\n  `UnrealEngine/UnrealEngine1.md`, `AudioProductions/Audio1.md`.\n\nAvant d'écrire, chercher les titres avec `rg -n '^#{1,4} '` et la notion avec `rg -n -i '<termes>'`. Ajouter\ndans la section concernée avec la date. Une correction nouvelle annule explicitement l'ancienne sans l'effacer.\n\nUn fait ne va dans un `*1.md` que s'il change ce que le projet saura encore dans six mois. Une simple commande\nexécutée, un build vert ou une étape intermédiaire restent dans le journal global.\n\n## Journal global\n\nNe jamais créer ni compléter un `PROGRESS.md` dans le projet courant. Appeler :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs append \\\n  --project \"Nom du projet\" \\\n  --fait \"Résultat factuel\" \\\n  --verifie \"Preuve réelle\" \\\n  --source-durable \"/chemin/vers/Projet1.md\" \\\n  --prochain \"Action suivante\"\n```\n\nChamps disponibles : `Mesuré`, `Décision`, `Échoué`, `Écarté`, `Apprentissage`, `Vérifié`, `Source durable`,\n`Prochain`, `Blocage`. `Fait` est obligatoire. Un chiffre porte son unité, sa méthode et sa date.\n\nLe script `progress` est obligatoire parce que deux instances, Claude Code et Codex, peuvent écrire au même\ninstant. Il verrouille l'append, relève l'agent et le modèle depuis l'hôte et masque les secrets. Ne jamais\npré-rédiger un résultat avant la commande qui le prouve.\n\n## Agent et modèle\n\nL'infrastructure se déduit de l'hôte, jamais d'une introspection du modèle :\n\n- session avec métadonnées Codex : `Codex Desktop`, modèle et effort lus dans le dernier `turn_context` ;\n- session Claude Code : `Claude Code Desktop`, modèle lu dans les métadonnées ou le transcript seulement s'il\n  y apparaît ;\n- donnée absente : écrire `non exposé par l'hôte`.\n\nLes noms configurés ou attendus ne deviennent pas automatiquement le modèle de la session, car une sélection\ndans l'interface ou une option de lancement peut les surcharger.\n\n## Reprise\n\nAu début d'une session, lire trois entrées, éventuellement filtrées par projet :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --count 3\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --project \"ZenRayShards\" --count 3\n```\n\nRésumer ces trois entrées en trois lignes maximum et annoncer la dernière action `Prochain`. Ne jamais charger\nle journal entier pour une reprise ordinaire ; le détail vient ensuite du skill routeur et du `*1.md` concerné.\n\n## Journaux legacy\n\nLes sept anciens `PROGRESS.md` sont retirés le 2026-08-22 après audit complet et validation explicite. Ne jamais\nles recréer. Si un autre journal legacy est découvert, le skill `progress` l’importe de façon idempotente dans\nle global, masque les secrets dans la copie et conserve son chemin et sa ligne avant toute suppression autorisée.\n\n## Déclencheurs\n\nSauvegarder automatiquement lorsqu'une tâche significative finit, qu'une décision se tranche, qu'une mesure\nproduit un chiffre, qu'une piste échoue ou s'écarte, qu'un blocage apparaît ou se lève, qu'un fichier important\nchange de rôle, qu'un agent rend un résultat, que le contexte va se compacter, ou que Matthieu marque une pause.\n\nNe rien sauvegarder quand l'état se reconstruit en trois secondes, qu'aucune décision n'en dépend et qu'aucune\nsession future n'en bénéficiera. Écrire trop enterre autant qu'écrire au mauvais endroit.\n\n## Le cas japonais — ce qu'un Ctrl-S doit produire pour que la leçon apparaisse sur le site\n\nDepuis le 2026-08-27, une leçon japonaise n'est plus seulement archivée : elle est **affichée**, par la vue\nZenRayJapanese de ZenRayProgress (zone Learn, nav Japanese). Cette vue ne lit rien d'autre que ce que le Ctrl-S\nécrit, si bien qu'une leçon mal rangée ne disparaît pas, elle devient invisible, ce qui est pire.\n\nLa règle d'or reste la même : **une information, un seul endroit**. `Memory/Japanese/Japanese1.md` demeure la\nsource unique et append-only ; `Memory/Japanese/Site/japanese.json` n'en est que l'index dérivé, produit par un\nscript, jamais écrit à la main. Modifier l'index sans modifier le corpus fabrique une seconde vérité qui sera\nécrasée à la première régénération.\n\n### Le routage, section par section\n\nLa vue possède quatre sections, et chacune se remplit par une FORME d'écriture précise dans le corpus. Écrire\nla bonne chose sous la mauvaise forme la range dans le carnet papier plutôt que sur le site.\n\n| Ce qu'on vient d'enseigner | La forme à écrire dans `Japanese1.md` | Où cela apparaît |\n|---|---|---|\n| Une leçon entière | un titre `## L<n> — <AAAA-MM-JJ> — <titre>` | onglet **Leçons**, une carte |\n| Un point de grammaire | un titre `### Grammaire — ~point` **ou** une ligne de tableau `\\| Point \\| Sens \\|` | onglet **Grammaire** |\n| Du vocabulaire | un tableau à deux colonnes `\\| Mot \\| Sens \\|` | onglet **Vocabulaire** |\n| Un kanji | une fiche `Lessons/KanjiCards/<plage>/NNN 漢 Kun On.html` | onglet **Kanji** |\n| Un nouvel état chiffré | la ligne `### État mesuré au <AAAA-MM-JJ>` puis sa phrase `N5 : x% enseigné, ~y% consolidé. N4 : …` | la **jauge** en tête |\n\nTrois pièges, tous payés au moins une fois :\n\nLe vocabulaire dicté en prose (« il a recopié はし, みず, えき ») n'atteint JAMAIS le site : seul un tableau est\nlu. C'est exactement l'écart que la vue affiche elle-même sous la jauge, trois cent douze mots tabulés contre\nsept cents comptés, et cet écart est de la matière perdue, pas une imprécision d'affichage.\n\nUn tableau d'exercice (`\\| # \\| Question \\| Réponse Matthieu \\| Verdict \\|`) est délibérément écarté du\nvocabulaire : y ranger un mot nouveau revient à le cacher.\n\nLa jauge n'est jamais calculée, elle est RELUE. Tant que la ligne « État mesuré au … » n'est pas mise à jour,\nles pourcentages du site restent ceux du dernier comptage, quelle que soit la quantité de leçons ajoutées\ndepuis. C'est voulu : le corpus distingue **enseigné** et **consolidé**, et seul un drill réel produit le second.\n\n### La séquence, dans l'ordre\n\n```zsh\n# 1. la leçon s'ajoute au corpus, en append, jamais en réécriture\n#    (édition de /Users/zenray/Create/Build/Memory/Japanese/Japanese1.md)\n\n# 2. l'index se régénère depuis le corpus\ncd /Users/zenray/Create/Build/Memory/Japanese\npython3 Scripts/build-japanese-index.py\n\n# 3. le contrôle échoue si l'index et le corpus divergent\npython3 Scripts/build-japanese-index.py --verify\n\n# 4. publication\ncd /Users/zenray/Create/Build/Memory\ngit add -- Japanese/Japanese1.md Japanese/Site/japanese.json\ngit commit -m \"japonais : L<n> — <titre>\" && git push\n```\n\nLe site lit ensuite le dépôt Memory par son API. Compter jusqu'à cinq minutes de cache CDN avant que la\nnouvelle leçon n'apparaisse : un rechargement immédiat qui montre l'ancien compte n'est pas une panne, et\nl'écart se vérifie en interrogeant l'API plutôt qu'en rechargeant la page en boucle.\n\n### Ce qui reste interdit\n\nLa vue est en **lecture seule**, et c'est une décision, pas une limite technique : un journal append-only qu'on\npourrait retoucher depuis une page web cesserait de dire ce qu'on croyait à l'époque, ce qui est justement ce\nqu'on vient y chercher. Une correction s'écrit donc comme une nouvelle entrée qui cite l'ancienne, jamais comme\nune réécriture, exactement comme dans le journal global.\n\n## Contrôle avant de rendre\n\n1. La connaissance durable se trouve dans un seul `*1.md`.\n2. La chronologie se trouve uniquement dans le global.\n3. Toute mesure a une preuve ; toute hypothèse porte son incertitude.\n4. Les échecs et les options écartées disent pourquoi.\n5. `Prochain` est une action unique avec le chemin utile.\n6. Aucun secret n'apparaît.\n7. Les modifications sont commitées dans leur dépôt source.\n\nLe test final tient en une phrase : la session suivante peut-elle reprendre sans relire cette conversation ?\n\n\nARGUMENTS: sauvegarde tout dans le skill /zenray-houdini  ... new / style des fonts du shorts / couleur etc ... + tout le reste."},{"name":"wait-validation","path":"userSettings:wait-validation","content":"Base directory for this skill: /Users/zenray/.claude/skills/wait-validation\n\n# Validation préalable\n\nAttendre la validation explicite de Matthieu avant toute action.\n\n1. **Arrêt immédiat.** Aucune modification de fichier, aucune commande destructive, aucun commit et aucun outil lourd ne s'exécute d'office.\n\n2. **Cadrage ultra-court.** Présenter l'action prévue, le périmètre et la méthode en quasi une ligne, ou en 3 paragraphes courts maximum si le contexte l'exige.\n\n3. **Attente du feu vert.** Attendre une validation explicite (« ok », « go », « fais-le ») avant de lancer l'exécution et la vérification.\n\n\nARGUMENTS: Ok maintenant on va faire un .mov qui contient juste l'animation même anim que le contre mikiri dans sekiro donc 0.25 sec peut être 0.35 pour Hook la vidéo \n\nDonc description et on va marquer juste le texte \"NEW\" en majuscule Anthropic Serif Semibold Italic au centre et appliquer l'effet je sais pas si tu comprends donc effet rouge haut contraste effet supperposé plus gros comme un choc très rapide"},{"name":"zenray-houdini","path":"userSettings:zenray-houdini","content":"Base directory for this skill: /Users/zenray/.claude/skills/zenray-houdini\n\n# ZenRay Houdini : pilotage MCP, recettes, savoir procedural et design\n\nCe skill est la porte d entree unique pour Houdini 22.0.368. Il unifie le pilotage MCP,\nles recettes executables, le vocabulaire et les choix de design. Le protocole MCP et les\noutils d action sont places en premier pour que le pilotage soit immediat.\n\nZero tiret cadratin, zero demi-cadratin, zero double tiret dans ce document.\nLe code de ce dossier est en anglais, identifiants compris ; les commentaires francais\nportent leur equivalent anglais en premier (regle du 2026-09-07 dans `~/.claude/CLAUDE.md`).\n\n---\n\n## ROUTAGE COPERNICUS ET TEXTURING\n\nLe nom officiel SideFX est **Copernicus**. Toute graphie dictée différente est corrigée\nautomatiquement dans les réponses, les noms de recettes, les fichiers et les recherches. Le corpus\ndurable est voisin de ce fichier :\n`/Users/zenray/.claude/skills/zenray-houdini/Copernicus1.md`.\n\nCette section reste un pointeur court. Quand une demande touche `Copernicus`, COP, texturing, UV,\nmatériau, PBR, stylisation, `Texture Material Library`, `Preview Material`, baking ou un matériau\nappliqué à une structure, lire d'abord `Copernicus1.md`, puis seulement la référence requise :\n\n| Besoin | Référence à charger |\n|---|---|\n| Recherche et décision Copernicus contre Substance | `Copernicus1.md`, sections recherche et limites |\n| Nœud ou concept de la vidéo | `references/copernicus/transcript-index.json`, puis la plage du transcript |\n| Transcription intégrale 5 h | `references/copernicus/source/The-Ultimate-Copernicus-Guide-Every-COP-Node-Explained.md` |\n| Validation d'un graphe avec Matthieu | `references/copernicus/GraphValidationProtocol.md` |\n| Tagger les faces, partager les matériaux, texturer un grand bâtiment | `Copernicus1.md`, section « Affectation des faces et plan de matériaux pour grands bâtiments » : rôles primitifs dans les sous-composants, partitions USD, mapping central, Copernicus puis Karma |\n| Identifier les familles depuis une référence et produire les deux preuves visuelles | `../zenray-houdini-materials-identification/SKILL.md` : annotation native par points rouges puis galerie de quatre sphères ; exemple et script vérifiables |\n| Recettes et archives réellement copiées | `Library/Houdini/` et `scripts/archive_library.py` |\n\nNe jamais charger la transcription entière pour une question locale. Utiliser le routeur :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/query_copernicus.py \"FRACTAL NOISE\"\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/query_copernicus.py \"PREVIEW MATERIAL\" --show-lines --context-lines 3\n```\n\nLe transcript couvre Houdini 20.5.370. Les noms, paramètres et résultats sont donc à relire dans\nHoudini 22.0.368 avant toute recette. Une explication vidéo, un cook sans erreur ou une capture de\ndamier ne constitue pas une validation artistique.\n\n### Porte de validation pour chaque graphe\n\nUn nouveau graphe Copernicus est toujours créé dans une copie isolée, avec son code, son réseau natif,\nses dépendances, ses cartes et ses mesures. L'agent vérifie le transport MCP, le cook Houdini, le\nreplay dans un processus neuf et un contrôle négatif. Il présente ensuite les images à Matthieu et\nattend sa décision explicite conformément à `wait-validation`. Tant que cette décision n'existe pas,\nle graphe reste `technical: replay_passed` au mieux, `artistic: not_reviewed` et\n`collection: experimental`.\n\nUne approbation porte sur un hash et une plage de paramètres précis. Toute modification crée N+1,\nconserve N et reprend les tests. Une validation technique dans Karma ne vaut pas validation Unreal ;\nune recette réaliste ne vaut pas recette stylisée.\n\nLa phase d'identification des matériaux possède son skill spécialisé,\n`zenray-houdini-materials-identification`. Le charger avant tout choix de famille : il conserve les\ndeux étapes, les coordonnées mesurées, le script d'annotation et la galerie sphérique. Revenir ici\npour créer le graphe Copernicus, affecter les subsets USD et lancer la validation technique puis\nartistique.\n\n### Bibliothèque obligatoire des scripts, HDA et graphes\n\nTout Python, HDA, snapshot, source VEX ou OpenCL et preuve qui sert à construire Houdini est copié dans\n`/Users/zenray/.claude/skills/zenray-houdini/Library/Houdini/`, avec les HDA d'entrée dans `otls/`.\nLa provenance Memory est vérifiée par SHA-256, jamais considérée comme une copie implicite. Exécuter\navant toute promotion :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/archive_library.py check\n```\n\nCe contrôle prouve l'intégrité et la présence des fichiers. Il ne prétend pas qu'un `.bgeo.sc` et ses\nparamètres peuvent reconstruire un graphe. Le contrat complet de snapshot et la limite de\n`zrsnapshot.py` sont dans `Copernicus1.md` et `references/copernicus/GraphValidationProtocol.md`.\n\nLa vérification fonctionnelle des six composants se lance ainsi :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/verify_component_library.py \\\n  --output /Users/zenray/.claude/skills/zenray-houdini/Library/Houdini/Tests/ComponentArchiveVerification/<timestamp>.json\n```\n\nLe résultat du 2026-09-12 est archivé dans `Library/Houdini/Tests/ComponentArchiveVerification/`.\nLes cinq HDA suivants recuisent avec une géométrie non vide : Armature, PorchStairs, WindowA,\nWindowB et Roof. WoodFacade est bien copié et hashé, mais son HDA neuf rend 0 point et 0 primitive\nà cause de chemins de paramètres relatifs erronés dans `build_siding`. La recette Python de façade\nreste verte séparément. Tant que ce défaut n'est pas corrigé dans une version N+1 et rejoué, le\ncatalogue ne doit pas annoncer les six HDA comme fonctionnels.\n\n---\n\n## REGLE FONDAMENTALE D ITERATION : INCREMENTATION N+1 AUTOMATIQUE DE SNAPSHOT\nA CHAQUE consigne de modification, variation, ajustement ou refonte de parametres sur un composant procedural donnee par Matthieu (ex : \"divise par 2 la taille\", \"aligne le segment du bas\", \"ajoute des bardeaux\", \"change la pente\"), l agent applique imperativement cette regle par defaut :\n1. **Incrementation automatique N vers N+1** : ne jamais modifier un composant sans creer formellement une nouvelle version (`v001` vers `v002`, `v002` vers `v003`, etc.).\n2. **Etiquette explicite** : associer un `label` decrivant precisement l intention appliquee (ex : `half_width`, `ground_aligned`, `trimmed_eaves`).\n3. **Triple feedback visuel instantane** :\n   - Parametre string `snapshot_version` mis a jour en tete de panneau.\n   - Badge jaune `DisplayComment` visible sous le noeud dans l editeur de graphe.\n   - Noeud terminal renomme en `OUT_<composant>_<version>` avec drapeaux display et render.\n4. **Archivage et securite** : chaque iteration archive sa geometrie `.bgeo.sc` et ses parametres `parms.json` sous `Memory/Houdini/Snapshots/<Composant>/`, garantissant le droit a l erreur et un retour arriere immediat.\n\n---\n\n## REGLE ABSOLUE DE LANCEMENT : HOUDINI FX 22.0.368 ET JAMAIS HOUDINI INDIE\nNe jamais lancer Houdini Indie (`hindie`, `Houdini Indie 22.0.368.app`). Lancement imperatif avec **Houdini FX 22.0.368** :\n- Chemin absolu de l application : `/Users/zenray/Create/Build/Houdini22/Houdini22.0.368/Houdini FX 22.0.368.app`\n- Binaire d execution : `Contents/MacOS/houdinifx`\n- Commande de lancement de scene :\n  `open -a \"/Users/zenray/Create/Build/Houdini22/Houdini22.0.368/Houdini FX 22.0.368.app\" <chemin_scene>`\n- Raison critique : Lancer Houdini Indie contraint l enregistrement des fichiers en format limite `.hiplc` ou `.hdalc`, polluant les scenes et assets, alors que Houdini FX garantit la compatibilite commerciale standard `.hip` ou `.hda`.\n\n---\n\n## 1. LE PROTOCOLE MCP EN PREMIER : PILOTAGE ET EXECUTION\n\n### Les deux pieces, et ce que chacune exige\n\n| Piece | Ou elle tourne | Exige |\n|---|---|---|\n| `Memory/Houdini/MCP/zrhoudini.py` | python 3.9.6 systeme | rien du tout |\n| `Memory/Houdini/MCP/zrbridge.py` | DANS Houdini 22.0.368 | Houdini ouvert |\n\n`zrhoudini.py` a deux visages : serveur MCP avec `--mcp`, outil en ligne de commande sinon.\nLe meme fichier, la meme logique, aucune duplication.\n\n### Les six outils\n\n| Outil | Arguments | Houdini ouvert ? | Role |\n|---|---|---|---|\n| `houdini_search` | `query`, `family`, `kind` (`nodes` ou `vex`), `limit` | non | Chercher dans les 5564 noeuds et 1132 fonctions VEX |\n| `houdini_recipes` | aucun | non | Lister les recettes verifiees |\n| `houdini_build` | `recipe`, `params` (objet), `hip` (chemin) | non, hython suffit | Construire un graphe procedural autonome |\n| `houdini_scene` | `path` (defaut `/obj`), `depth` (defaut 2) | oui, avec le pont | Lire la scene ouverte en JSON compact |\n| `houdini_hom` | `code`, `target` (`live` ou `headless`) | selon la cible | Porte de sortie Python HOM avec retour dans `result` |\n| `houdini_snapshot` | `action` (`save`, `list`, `restore`), `node`, `label`, `version` | selon l action (`save`/`restore` live, `list` non) | Sauvegarder, lister ou restaurer des etats temporels d un composant |\n\nCatalogue mesure a 1967 caracteres. Un serveur de 188 outils coute environ vingt mille jetons\nde schema a chaque invite : c est le piege que cette forme evite.\n\nLes quinze familles acceptees par `family` : scattering, instancing, uv, materials, textures,\nsimulation, destruction, terrain, curves, crowd, rendering, export, vex, attributes, modeling.\n\n### Ouvrir le pont\n\nLe pont demarre automatiquement a chaque lancement de session et a chaque ouverture de fichier hip\ngrace aux scripts `123.py` et `456.py` installes dans `~/Library/Preferences/houdini/22.0/scripts/`.\n\nEn cas de demarrage manuel, dans la fenetre Python de Houdini (Windows > Python Shell) :\n```python\nexec(open('/Users/zenray/Create/Build/Memory/Houdini/MCP/zrbridge.py').read())\n```\n\nLe pont s annonce : `ZenRay bridge open on 127.0.0.1:18812`. Pour l arreter, `zr_bridge_stop()`.\nIl refuse de demarrer deux fois. Sans lui, seuls `houdini_scene` et `houdini_hom` en `live`\nechouent, et leur message porte cette commande exacte.\n\n### Capture d ecran et confirmation visuelle : via l agent plutot que le MCP\n\nPour confirmer visuellement une scene ouverte, la verification se fait directement par l agent\n(Antigravity, Codex ou Claude Code) en lui faisant inspecter un fichier d image local, et non en\nfaisant transiter des octets d image dans le flux JSON-RPC du serveur MCP.\n\nPourquoi cette regle :\n- Envoyer des captures base64 a travers le protocole MCP gonfle inutilement les requetes et epuise le budget de contexte.\n- L agent possede deja des outils natifs de visualisation de fichiers sur disque (comme `view_file`).\n\nLe protocole recommande pour capturer le viewport sans ouvrir de fenetre MPlay utilise `houdini_hom`\navec la cible `live` pour ecrire une image unique sur disque :\n\n```python\nimport hou\nsv = hou.ui.paneTabOfType(hou.paneTabType.SceneViewer)\nif sv is not None:\n    fb = sv.flipbookSettings().stash()\n    fb.output('/tmp/houdini_viewport.png')\n    fb.outputToMPlay(False)\n    fb.frameRange((hou.frame(), hou.frame()))\n    sv.flipbook(sv.curViewport(), fb)\n    result = '/tmp/houdini_viewport.png'\n```\n\nL agent lit ensuite `/tmp/houdini_viewport.png` sans alourdir le serveur MCP.\n\n### Protocole systematique de fin de parcours : 2 captures OpenGL et controle des normales\n\nAvant de valider toute modification geometrique ou composant procedural :\n1. **Regle absolue sur les rendus : OpenGL exclusif, Karma INTERDIT en phase de modelisation** :\n   - Pendant toute la phase de modelisation, de proportion, d alignement et de debug procedural, **utiliser exclusivement la capture OpenGL du Viewport**.\n   - **INTERDICTION formelle de lancer des rendus Karma (CPU ou XPU)** pour verifier la geometrie. Karma consomme inutilement du temps de calcul et gele la boucle d iteration. Karma est reserve exclusivement au lookdev final des materiaux Copernicus et de l eclairage une fois la geometrie entierement validee.\n2. **Controle systematique d orientation des normales (anti backface gris bleu)** :\n   - Dans le viewport OpenGL de Houdini, toute face dont la normale pointe vers l interieur apparait teintee en gris bleu sombre (backface shading).\n   - Verifier par le calcul ou via le SOP Normal (`type=vertex`, `reverse=1` si necessaire) que chaque face externe possede une normale dirigee vers l exterieur et vers le haut pour les toitures.\n3. **Prise systematique de deux captures OpenGL en fin de parcours** :\n   - Generer 2 captures sous deux angles complementaires (ex: vue 3/4 face droite et vue 3/4 face gauche, ou face et perspective) ecrites directement sur disque sous `/tmp/` ou dans le dossier d artifacts.\n   - Script minimaliste HOM via flipbook headless sans MPlay (methode la moins couteuse en tokens).\n   - Transmettre ou afficher les captures a Matthieu dans le rendu final pour validation visuelle directe.\n4. **Convention de teintes pales de diagnostic (anti couleurs saturees)** :\n   - Pour le marquage et le debug preliminaire des materiaux dans le viewport OpenGL (`v@Cd`), bannir formellement les couleurs primaires vives ou fluorescentes (rouge, vert, bleu purs, magenta criard).\n   - Utiliser exclusivement des teintes pales, douces et desaturees (ivoire poudreux, bois flotte, gris cedre, sauge doux) qui respectent la lisibilite des reliefs, des decoupes et des ombres.\n\n### Archivage obligatoire des captures dans le skill (2026-09-12)\n\nUne capture laissee dans `/tmp` meurt avec la session : le breakdown ne se relit plus. Donc **chaque\ncapture de verification part dans le skill**, en JPEG, sous\n`~/.claude/skills/zenray-houdini/<Projet>-captures/`, nommee par date et par intention, avec un index\n`captures.json` qui donne l heure, l etiquette, la source, les dimensions, le poids et l empreinte.\n\n```bash\nS=~/.claude/skills/zenray-houdini/scripts/capture_archive.py\npython3 $S add LouisianaBayou \"toit-tuiles-v003\" /tmp/zr_a.png /tmp/zr_b.png --note \"deux angles, apres correction des normales\"\npython3 $S list LouisianaBayou\n```\n\nRegles :\n- **Le protocole de fin de parcours ci-dessus se termine par cet appel**, jamais par un fichier laisse\n  dans `/tmp`. Les deux angles complementaires deviennent deux lignes de l index, la meme seconde.\n- **JPEG, cote le plus long plafonne a 2400 px, qualite 88** : lisible jusqu au bardeau, assez leger\n  pour garder des centaines d etats. Les valeurs vivent en tete du script, jamais dans la commande.\n- **L etiquette nomme l intention**, comme un label de snapshot : `toit-tuiles-v003`,\n  `fenetre-b-pendentif-corrige`. La date suffit a ordonner, l etiquette dit quoi regarder.\n- **Une capture qui prouve un DEFAUT s archive aussi**, avec la note qui le nomme. La preuve d un\n  echec vaut autant que celle d un succes, et c est elle qui evite de rejouer l erreur.\n- Rien n est ecrase : deux captures de la meme seconde portent un numero d ordre.\n\nEtat au 2026-09-12 : `LouisianaBayou-captures/` porte les 12 premieres images, les trois shorts et la\npreuve du cadrage faux du rendu sans interface.\n\n### Ou vivent les snapshots, le Python, les HDA et les composants\n\n| Matiere | Source vivante | Copie durable dans le skill | Controle |\n|---|---|---|---|\n| Captures de verification | `/tmp` pendant la session | `<Projet>-captures/` plus `captures.json` | `capture_archive.py list <Projet>` |\n| Snapshots de composants | `Memory/Houdini/Snapshots/<Composant>/v00N/` | `Library/Houdini/Snapshots/` | `archive_library.py check` |\n| HDA | `Memory/Houdini/otls/` et `~/Library/Preferences/houdini/22.0/otls/` | `otls/` et `Library/Houdini/otls/` | `verify_component_library.py` |\n| Python, recettes, MCP | `Memory/Houdini/{Scripts,Recipes,MCP}` | `Library/Houdini/` par empreinte | `archive_library.py check` |\n\nApres toute session qui produit une iteration, lancer dans cet ordre :\n\n```bash\npython3 ~/.claude/skills/zenray-houdini/scripts/archive_library.py sync\npython3 ~/.claude/skills/zenray-houdini/scripts/archive_library.py check\n```\n\n`sync` copie les sources nouvelles dans la bibliotheque adressee par contenu, `check` prouve que rien\nne manque et qu aucun octet n a bouge. Un `check` qui liste des `new_unarchived_source` dit qu une\niteration n est pas encore sauvee : elle le sera au `sync` suivant, jamais plus tard.\n\n### Sauvegarde de scene et projet (.hip) : commande HOM et repertoires\n\nPour sauvegarder la scene en cours sans interaction manuelle dans l editeur, utiliser `houdini_hom` avec la cible `live` :\n\n```python\nimport hou, os\n\ntarget_dir = '/Users/zenray/Create/Build/Productions/ZenRayHoudini' # ou dossier demande\nos.makedirs(target_dir, exist_ok=True)\ntarget_hip = os.path.join(target_dir, 'NomDuProjet.hip')\n\nhou.hipFile.save(target_hip)\nresult = {'saved': target_hip, 'exists': os.path.exists(target_hip), 'bytes': os.path.getsize(target_hip)}\n```\n\nRepertoires canoniques pour les fichiers `.hip` :\n- **Scenes de production et projets artistiques** : `/Users/zenray/Create/Build/Productions/ZenRayHoudini/`\n- **Scenes de tests et gabarits du depot Memory** : `/Users/zenray/Create/Build/Memory/Houdini/Scenes/`\n\n### Snapshots de composants (zenray-houdini-snapshot) : etats temporels et versions paralleles\n\n#### 1. Presentation du concept zenray-houdini-snapshot\nLe gestionnaire de snapshots `zenray-houdini-snapshot` offre un filet de securite pour l experimentation procedurale sur les composants de geometrie :\n- **Sauvegarde temporaire et complete du dernier etat** : capture conjointe de la geometrie congelee en format compresse `.bgeo.sc`, de l ensemble des parametres numeriques et expressions procedurales en `parms.json`, ainsi que des informations de contexte en `metadata.json` (chemin du noeud, type, date, nombre de points, nombre de primitives et scene `.hip` d origine).\n- **Gestion de N versions en parallele** : structure inspiree du prompt-stacking avec generation sequentielle de dossiers de versions (`v001`, `v002`, ..., `v00N`) associes a une etiquette parlante (`label`). L ensemble des etats est indexe dans un manifest central `snapshots.json` propre a chaque composant sous `Memory/Houdini/Snapshots/<Composant>/`.\n- **Droit a l erreur et experimentation sans risque** : permet de tester des modifications procedurales complexes (refonte de reseau VEX, modification d architecture de sweep, restructuration de sous-noeuds) avec l assurance de pouvoir reinstantier ou restaurer l etat exact en un appel en cas de regression ou de doute.\n\n#### 2. Utilisation via le CLI\nLe pilotage en ligne de commande s effectue directement depuis `Memory/Houdini/MCP/zrhoudini.py` :\n```bash\n# Sauvegarder l etat actuel d un composant avec etiquette\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot save <node_path> [label]\n\n# Lister les versions disponibles pour un composant precis (ou tous les composants)\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot list [component_name]\n\n# Restaurer les parametres et expressions d une version donnee (v001, v002... ou latest par defaut)\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot restore <node_path> [version]\n```\n\n#### 3. Utilisation via le serveur MCP\nDans les sessions interactives Claude Code, Codex et Antigravity, l outil `houdini_snapshot` pilote le gestionnaire :\n- **Arguments acceptes** :\n  - `action` (chaine, obligatoire) : action a executer parmi `save`, `list` ou `restore`.\n  - `node` (chaine, requis pour `save` et `restore`) : chemin absolu du noeud dans Houdini (par exemple `/obj/Church/Component_Armature` ou `/obj/Church/Component_Roof`).\n  - `label` (chaine, optionnel pour `save`) : etiquette textuelle concise pour identifier l intention (par exemple `initial_clean_normals` ou `pre_refactor_sweep`).\n  - `version` (chaine, optionnel pour `restore`) : etiquette de version cible (`v001`, `v002`, ou `latest` par defaut).\n\nExemples d appels MCP :\n- Sauvegarde pre-modification :\n  `{\"action\": \"save\", \"node\": \"/obj/Church/Component_Roof\", \"label\": \"pre_remodel\"}`\n- Consultat\n\n[... skill content truncated for compaction; use Read on the skill path if you need the full text]"},{"name":"zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel","path":"userSettings:zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel","content":"Base directory for this skill: /Users/zenray/.claude/skills/zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel\n\n**Lecture obligatoire avant toute fabrication :** ouvrir `references/INDEX.md`, puis le contrat UI prioritaire du 2026-09-03. Clair par défaut, Liquid Glass sidebar, InterVariable embarquée, post 13 px maximum. Les anciennes recettes conservées plus bas ne remplacent pas ce contrat.\n\n\n# ZenRay HTML Photoshop PDF\n\nPhotoshop, mais le document est un fichier HTML et les calques sont des `<img>`.\n\nLe but n'est pas de dessiner joli du premier coup. Le but est de **garder la\nmain sur chaque morceau** pour itérer en secondes plutôt qu'en minutes, et de\npouvoir produire une identité de marque cohérente sur Instagram et ailleurs sans\nouvrir un seul logiciel.\n\n## Index de navigation\n\n- **AVANT DE FABRIQUER QUOI QUE CE SOIT** : lire « LE WORKFLOW COMPLET » puis\n  « RÈGLE D'ARGENT ». Un outil hda s'INSTANCIE depuis `templates/` en une\n  commande, il ne se réécrit jamais à la main. Un travail fait n'est jamais\n  perdu, il est la source du suivant.\n- **Lot de photos à traiter** : `scripts/zr-hda-instance.py <dossier> --open`\n  pour le cadrage, puis le même script en `--mode heavy` sur le `out/` obtenu.\n- **Section `design-sliders` intégrée** : l’annexe intégrale se trouve en fin de skill.\n- **Curseurs seulement sur demande** : voir « Règle d’activation explicite, 2026-08-27 ».\n- **Mode `Template Creator`** : lire `references/template-creator.md` en entier dès qu’une référence doit devenir un gabarit réutilisable.\n\n## La loi fondamentale : un visuel n'est jamais une image\n\nUn visuel est **un dossier d'assets** plus **un fichier HTML qui les assemble**.\n\nNe JAMAIS produire un visuel en une seule passe de rendu monolithique où le\ntexte, les images et la mise en page sont fondus ensemble. Cette approche a été\nessayée le 2026-08-11 et rejetée par Matthieu, dans ces termes : « on va faire en\nsorte de copier asset par asset ». Elle échoue pour trois raisons vérifiées :\n\n1. **Changer une police oblige à tout refaire.** Avec des assets séparés, on\n   régénère un seul PNG et on recharge.\n2. **On ne peut pas déplacer un élément.** Fondu dans une image, un titre n'est\n   plus qu'un ensemble de pixels.\n3. **On étire ce qui ne doit pas l'être.** Le premier essai a agrandi une\n   bannière de 1738×166 pour couvrir un cadre de 1080×1350 : bouillie floue\n   illisible. Voir « Ne jamais agrandir » plus bas.\n\n## Les TROIS états d'un visuel, à ne jamais confondre (2026-08-20)\n\nUne bonne part des malentendus vient de ce qu'on appelle « le visuel » trois choses\ndifférentes. Elles ont chacune un rôle, un emplacement et une durée de vie.\n\n| État | Ce que c'est | Ce qu'on en fait |\n|---|---|---|\n| **1. Les assets** | les morceaux : `assets/01-media.webp`, `02-fond-flou.webp`, `assets/fonts/*.woff2`. Chacun est indépendant et remplaçable | on les régénère un par un, jamais tous ensemble |\n| **2. Le HTML d'atelier** | le document à calques, **avec son panneau de curseurs**. C'est l'outil de design, pour Matthieu comme pour moi | on l'ouvre, on tourne les boutons, on copie les valeurs. Il ne se livre JAMAIS |\n| **3. L'asset final** | le **PNG** rendu depuis le HTML, à l'échelle demandée (x1, x2 pour la 4K, x3) | c'est le seul livrable, celui qu'on publie |\n\nLe HTML n'est pas le produit, il est l'atelier. Le PNG n'est pas modifiable, il est le\nproduit. Confondre les deux mène soit à livrer un panneau de curseurs, soit à ne plus\npouvoir rien changer.\n\n**L'échelle est un paramètre, pas une décision improvisée.** `export.echelle` dans\n`_params.json` : 1 rend la taille de composition, 2 la double (2160×3840 pour un 9:16,\nc'est la 4K), 3 la triple. Le rendu se fait toujours depuis la MÊME composition, jamais\nen agrandissant un PNG déjà rendu.\n\n**Plafond de 100 Mo par fichier, vérifié par le script, pas espéré.** Au-delà, GitHub\nrefuse le push et bloque tout le dépôt Memory. Le contrôle est dans `export-png.sh` et\ndans `backup-memory.sh`, et il échoue bruyamment.\n\n## Deuxième loi : un asset est un HDA, jamais un dessin figé\n\n> **La loi générale vit désormais dans `~/.claude/CLAUDE.md`**, bannière\n> « PRIORITÉ 0 ABSOLUE : TOUT CODE PRODUIT EST UN HDA », qui l'étend à tout le\n> code produit, quel que soit le langage, et qui fait foi en cas de divergence.\n> Ce qui suit en est l'application visuelle.\n\nDemande de Matthieu, le 2026-08-15, dans ses mots : les assets doivent être\n« comme des HDA sur Houdini », donc éditables, paramétrables, modulaires par\nvariables, pour que les membres d'une même famille partagent leurs chiffres,\nleurs couleurs, leurs dégradés et leurs icônes au lieu d'être vingt fichiers\nrecopiés à la main.\n\nLe vocabulaire de Houdini se transpose terme pour terme, et il vaut la peine de\nle poser une fois pour toutes.\n\n| Houdini | Ici |\n|---|---|\n| La définition du HDA | Le gabarit, un seul fichier HTML ou SVG, sans aucune valeur en dur |\n| L'interface de paramètres | `_params.json` pour les données, `_canvas.css` pour les jetons visuels |\n| Une instance posée dans la scène | Un PNG rendu, numéroté, dans le dossier de travail |\n| Le cook | `build.py`, qui instancie le gabarit une fois par jeu de paramètres |\n\n**Le recensement des familles précède toute production.** Avant d'ouvrir le\npremier fichier, on liste ce que le visuel contient et on regroupe ce qui\npartage des propriétés : deux éléments qui ne diffèrent que par une valeur ne\nsont jamais deux assets, ils sont un gabarit et deux jeux de paramètres. Ce\nrecensement s'écrit dans le README du projet, en tableau, famille par famille,\navec la liste des paramètres exposés. C'est lui qui empêche la duplication sur\nle moment, et c'est encore lui qu'on relit six mois plus tard pour savoir où\ntoucher.\n\n**Trois étages de paramètres, jamais mélangés.**\n\n| Étage | Ce qu'on y met | Où |\n|---|---|---|\n| Jetons globaux | palette, dégradés, familles de polices, rayons, échelle typographique | `_canvas.css`, en tête |\n| Paramètres de famille | hauteur d'une barre, largeur d'une cellule chiffrée, taille d'un drapeau, règle d'alternance | bloc dédié de `_params.json` |\n| Surcharges d'instance | un rang précis qu'on veut d'une autre couleur, un chiffre, une icône | la ligne de l'instance, dans `_params.json` |\n\nUne surcharge d'instance l'emporte sur son étage de famille, qui l'emporte sur\nles jetons globaux. C'est exactement la cascade de CSS, il suffit de ne pas la\ncontrarier.\n\n**Aucune valeur en dur dans un gabarit.** Ni code hexadécimal, ni taille de\npolice, ni chiffre de données. Le gabarit ne porte que des références, `var(--…)`\ncôté CSS et des accolades de substitution côté HTML. Une valeur écrite en dur\nreste un défaut même quand elle produit le bon rendu, puisqu'elle sort du champ\nde l'interface et devient introuvable le jour où il faut la changer.\n\n**Le test qui valide une décomposition, à passer avant de rendre quoi que ce\nsoit.** Changer une couleur, une police ou une géométrie doit se faire à un seul\nendroit, se propager partout où cette valeur a du sens, et nulle part ailleurs.\nSi teindre les vingt barres d'un classement demande vingt modifications, la\ndécomposition est ratée et il faut la refaire tout de suite. Inversement, si\nchanger la couleur d'une seule ligne oblige à toucher les dix-neuf autres, le\nparamètre est simplement rangé au mauvais étage.\n\n**Ce que la loi permet, au-delà du confort d'édition.** Un jeu d'assets\nparamétriques se recompose dans un carré, une story ou un paysage sans être\nrefabriqué, pourvu que la géométrie s'exprime en variables plutôt qu'en pixels\nfigés au fond des règles. C'est la raison profonde de la loi, et elle rejoint\ndirectement la question de format ci-dessous.\n\n## Anatomie d'un projet\n\n```\n<projet>/\n  _canvas.css          # format, polices, couleurs, styles partagés\n  slide-1.html         # le \"document Photoshop\" de la slide 1\n  slide-2.html\n  slide-3.html\n  render.sh            # exporte tout en 1x et 2x, vérifie les dimensions\n  1-title-script.png   # asset 1  (texte, PNG transparent)\n  2-title-caps.png     # asset 2  (texte, PNG transparent)\n  3-waveform.png       # asset 3  (capture)\n  4-chart.png          # asset 4  (capture annotée)\n  1-title-script.html  # la source qui a généré l'asset 1\n  2-title-caps.html    # la source qui a généré l'asset 2\n  out/                 # LES SORTIES, à part du travail\n    slide-1.png        #   2160x2700, un seul fichier par slide\n```\n\n**Les PNG finis vivent dans `out/`, jamais mélangés aux sources.** Le dossier de\ntravail reste lisible, et les fichiers à publier se prennent d'un geste, sans\navoir à les trier au milieu des assets et des gabarits.\n\n**Un seul fichier par slide, en 2160×2700.** Exporter aussi un 1080×1350 à côté\nest de la duplication pure : le 2× porte strictement plus d'information, et ce\nqui aurait besoin du 1× se réduit en une seconde, tandis que l'inverse est\nimpossible.\n\n**Chaque asset porte un index numérique et un nom parlant.** `1-title-script.png`,\npas `text-frames-from.png`. L'index est l'ordre d'empilement / de lecture, le nom\ndit ce que c'est. Demande explicite de Matthieu : « ce serait bien que chaque\nasset aient un index différent genre 1 2 3 4 5 + nom ».\n\n**Chaque asset de texte garde son HTML source à côté.** Régénérer un titre dans\nune autre police, une autre taille ou une autre couleur = éditer son `.html` et\nrelancer le rendu. Sans la source, l'asset est mort.\n\n## Où vivent les fichiers\n\n**Décision tranchée, ne pas la rouvrir à chaque projet.**\n\n| Cas | Emplacement |\n|---|---|\n| Le visuel appartient à un projet existant | `<projet>/docs/social/` |\n| Visuel de marque autonome, pas rattaché à un dépôt | `~/Create/Build/Productions/ZenRayStudio/<sujet>/` |\n\nPourquoi pas ailleurs, puisque la question s'est posée :\n\n- **Pas `Downloads/`** : dossier de passage, nettoyé, aucune garantie de survie.\n  Un asset qu'on veut réutiliser dans trois mois n'y a rien à faire.\n- **Pas `Memory/`** : c'est le dépôt de connaissance, synchronisé vers GitHub,\n  et il a déjà payé des incidents de taille (`GH001`, fichiers > 100 Mo). Y\n  déverser des PNG de production est une mauvaise idée structurelle.\n- **`Productions/`** est déjà le foyer de ce qui est fabriqué. Les visuels y\n  sont, et quand ils servent un dépôt précis ils voyagent avec lui, versionnés\n  au même endroit que le code qu'ils annoncent.\n\n## Le format se demande, il ne se présume jamais\n\nRègle posée par Matthieu le 2026-08-15 : le skill disait 4:5, il faut désormais\n**toujours poser la question du format avant de fabriquer quoi que ce soit**, en\nmême temps que celle de la résolution de sortie. Le 4:5 reste le défaut proposé,\nparce qu'il occupe le plus de surface dans le fil Instagram, mais ce n'est qu'un\ndéfaut, jamais une règle.\n\n**L'ordre de décision, tel que Matthieu l'a fixé le 2026-08-15.** D'abord, si le\nprompt précise un format, ce format s'applique, sans question. Ensuite, si aucun\nformat n'est précisé mais qu'une image de référence est fournie, **le format est\ncelui de la source**, mesuré sur elle et non deviné. Enfin, dans tous les autres\ncas, la question se pose avant de fabriquer quoi que ce soit. Pour une suite de\nvisuels, la même chaîne se rejoue à chaque fois : le prompt d'abord, la source\nensuite, la question en dernier recours.\n\n**La résolution de sortie, elle, ne se demande presque jamais.** La règle est un\nagrandissement à facteur entier, deux, trois ou quatre selon le rapport, choisi\ncomme le plus petit entier qui atteint ou dépasse 3840 pixels sur le grand côté.\nUn 4:5 part donc en fois trois, soit 3240 × 4050, un carré en fois quatre, une\nstory ou un paysage en fois deux. Aucune sortie ne descend en dessous de cette\nbarre sans une raison explicite.\n\n| Format | Canevas | Facteur | Sortie livrée |\n|---|---|---|---|\n| 4:5 portrait, défaut Instagram | 1080 × 1350 | ×3 | 3240 × 4050 |\n| 1:1 carré | 1080 × 1080 | ×4 | 4320 × 4320 |\n| 9:16 story et reel | 1080 × 1920 | ×2 | 2160 × 3840 |\n| 16:9 paysage, YouTube | 1920 × 1080 | ×2 | 3840 × 2160 |\n| 1:2 bandeau vertical | 1080 × 2160 | ×2 | 2160 × 4320 |\n| 3:4 | 1080 × 1440 | ×3 | 3240 × 4320 |\n| 2:3 affiche | 1080 × 1620 | ×3 | 3240 × 4860 |\n| 4:3 | 1440 × 1080 | ×3 | 4320 × 3240 |\n\nLe facteur se calcule, il ne se retient pas : `ceil(3840 / grand_côté_du_canevas)`,\nborné à quatre. `render.sh` le fait seul et vérifie la dimension obtenue.\n\n**Le canevas garde une hauteur fixe, quel que soit le format.** C'est une planche\nà dessin, pas une page web, et du contenu qui déborde reste un défaut de mise en\npage. `render.sh` refuse de livrer quand les dimensions ne tombent pas juste,\nparce qu'un mauvais format qui passe en silence finit recadré par Instagram sans\nque personne comprenne pourquoi.\n\n**Le 2x et le 4K se rendent, ils ne s'agrandissent pas.** Le facteur d'échelle\nrefait le rendu à la résolution demandée. Agrandir un PNG déjà rendu produirait\nexactement le flou que tout ce skill cherche à éviter.\n\n**Un seul fichier par slide et par format demandé.** Exporter en plus un 1x à\ncôté du 4K est de la duplication pure, puisque la grande résolution porte\nstrictement plus d'information et se réduit en une seconde.\n\n\n**Le canevas a une hauteur FIXE.** Il ne grandit pas avec son contenu. C'est une\nplanche à dessin, pas une page web. Du contenu qui déborde est un bug de mise en\npage à corriger, jamais une raison d'allonger le cadre. `render.sh` refuse de\nlivrer si les dimensions ne tombent pas juste, parce qu'un export à la mauvaise\ntaille se fait recadrer par Instagram sans prévenir personne.\n\n**Le 2x se rend, il ne s'agrandit pas.** `--force-device-scale-factor=2` refait\nle rendu à double résolution. Agrandir le PNG 1x produirait exactement le flou\nqu'on cherche à éviter.\n\n## Les polices\n\nToutes les polices installées vivent dans `~/Library/Fonts/`. On les charge par\n`@font-face` avec une URL `file://` absolue, ce qui marche en rendu Chromium\nheadless sans installation ni réseau.\n\n```css\n@font-face {\n  font-family: 'DidonesqueStencil';\n  src: url('file:///Users/zenray/Library/Fonts/Didonesque-Stencil-Bold.otf') format('opentype');\n}\n```\n\n**Le catalogue visuel est dans `fontbook.html`, à côté de ce fichier.** L'ouvrir\ndans un navigateur pour voir chaque police rendue, avec son chemin exact prêt à\ncopier. Le régénérer après toute installation de police :\n\n```bash\n~/.claude/skills/zenray-html-photoshop-pdf/scripts/build-fontbook.sh\n```\n\nLe trio de marque établi jusqu'ici, à réutiliser par défaut pour rester cohérent :\n\n| Rôle | Police | Fichier |\n|---|---|---|\n| Titre display | Didonesque Stencil Bold | `Didonesque-Stencil-Bold.otf` |\n| Signature manuscrite | Golden Hopes | `GoldenHopes_PERSONAL_USE_ONLY.otf` |\n| Texte courant | Anthropic Sans (Medium / SemiBold) | `AnthropicSans-*.ttf` |\n\nGolden Hopes est sous licence **usage personnel uniquement**. Le signaler avant\ntout usage commercial ; ne pas l'employer en silence sur un visuel qui vend.\n\n## Fabriquer un asset de texte\n\nUn fichier HTML minuscule, une seule ligne de texte, fond transparent.\n\n```html\n<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<style>\n  @font-face { font-family:'X'; src:url('file:///Users/zenray/Library/Fonts/X.otf') format('opentype'); }\n  html, body { margin:0; padding:0; background: transparent; }\n  .wrap { width:1900px; height:400px; display:flex; align-items:center; justify-content:center; }\n  .txt  { font-family:'X'; font-size:200px; color:#2b2b2b; }\n</style></head>\n<body><div class=\"wrap\"><div class=\"txt\">ZenRay Dictate</div></div></body></html>\n```\n\nRendu, **transparence obligatoire** :\n\n```bash\nchrome --headless=new --disable-gpu --hide-scrollbars \\\n  --default-background-color=00000000 \\\n  --window-size=1900,400 --screenshot=\"2-title-caps.png\" \"file://$PWD/2-title-caps.html\"\n```\n\nSans `--default-background-color=00000000`, le PNG sort avec un fond blanc opaque\nqui écrasera tout ce qu'il recouvre dans la composition. Vérifier après coup que\nle mode est bien `RGBA` :\n\n```bash\npython3 -c \"from PIL import Image; im=Image.open('2-title-caps.png'); print(im.mode, im.size)\"\n```\n\nPrévoir un cadre nettement plus large que le texte attendu : un glyphe coupé au\nbord est irrécupérable, alors que du vide transparent ne coûte rien.\n\n## Découper une image de référence en assets\n\nQuand Matthieu fournit un visuel à reproduire, **mesurer, ne pas estimer à\nl'œil**. Les frontières entre panneaux se trouvent en cherchant les ruptures de\ncouleur ligne par ligne.\n\n```python\nfrom PIL import Image\nim = Image.open(src).convert(\"RGB\"); w,h = im.size; px = im.load()\nprev = None\nfor y in range(h):\n    row = [px[x,y] for x in range(0, w, 10)]\n    avg = tuple(sum(c[i] for c in row)/len(row) for i in range(3))\n    if prev and sum(abs(avg[i]-prev[i]) for i in range(3)) > 25:\n        print(\"rupture à y =\", y)\n    prev = avg\n```\n\nPour retrouver la position d'un texte dans une référence, scanner sa couleur\nd'encre et relever la boîte englobante. Ça a donné, sur le gabarit Switzerland,\ndes panneaux de 588 px séparés par un cadre de 3 px et une position de titre au\npixel près, là où l'estimation visuelle se serait trompée de plusieurs dizaines\nde pixels.\n\n## Mode `Template Creator` : une référence devient une machine\n\nDès que Matthieu demande d’identifier une mise en page, de reproduire une référence avec\nune autre image, ou de fabriquer un template à partir d’une ou plusieurs captures, lire\n`references/template-creator.md` en entier puis suivre son contrat. Ce mode produit une\nspécification JSON exécutable et, pour chaque template, un dossier contenant un PNG guide 4K\net son Markdown jumeau. Un guide ne montre jamais plus d’un template.\n\nSur un raster, le mode décrit uniquement le type (`serif`, `sans`, `mono`, `other`), la largeur\n(`condensed`, `normal`, `expanded`) et l’interlettrage. Il ne nomme jamais une famille de fonte\net ne lance aucun font matching. La fonte de rendu est un choix séparé, documenté comme tel.\n\nDans le mode Template Creator, dès que le document contient une image, les réglages photo complets\ndeviennent automatiques. Les fichiers canoniques sont\n`assets/photo-controls/zr-photo-adjustments.js` et\n`assets/photo-controls/zr-photo-adjustments.css`. Ils s’emploient tels quels, sans recopier\nleurs constantes dans chaque projet.\n\n## Annoter une capture (surlignage, flèches, cadres)\n\nComposer par-dessus l'original avec un calque translucide, jamais en repeignant\nles pixels d'origine.\n\n```python\nfrom PIL import Image, ImageDraw\nsrc = Image.open(path).convert(\"RGBA\")\noverlay = Image.new(\"RGBA\", src.size, (0,0,0,0))\nImageDraw.Draw(overlay).rectangle([x0, 0, x1, src.height], fill=(255,214,0,128))  # 128 = 50%\nImage.alpha_composite(src, overlay).convert(\"RGB\").save(out)\n```\n\nLocaliser la cible par mesure, comme ci-dessus : pour surligner une barre précise\nd'un graphique, scanner la ligne à mi-hauteur pour trouver ses bornes exactes en\nx, puis élargir de quelques pixels pour que la bande se lise comme « cette\ncolonne » et pas comme « ce rectangle ».\n\n## Composer\n\nLe fichier `slide-N.html` est le document. Les assets y entrent en `<img>`, et\ntous les réglages remontent en variables CSS **en haut du fichier**, pour qu'un\najustement soit une ligne à changer et non une chasse dans le corps du style.\n\n```html\n<link rel=\"stylesheet\" href=\"_canvas.css\">\n<style>\n  .lockup img.script { width: 380px; }\n  .lockup img.caps   { width: 936px; }\n</style>\n...\n<div class=\"canvas\">\n  <div class=\"question\">…</div>\n  <div class=\"spacer\"></div>\n  <div class=\"lockup\">\n    <img class=\"script\" src=\"1-title-script.png\">\n    <img class=\"caps\"   src=\"2-title-caps.png\">\n  </div>\n  <div class=\"spacer\"></div>\n  <div class=\"waveform\"><img src=\"3-waveform.png\"></div>\n</div>\n```\n\n`.spacer` répartit l'espace restant dans un cadre à hauteur fixe, au lieu de tout\nempiler en haut.\n\n## Un asset qu'on n'a pas ne s'invente pas, il reste un trou déclaré\n\nRègle de Matthieu, le 2026-08-15 : « si tu n'as pas l'asset tu n'inventes rien tu\nlaisses en transparent, ou blanc. » Ell\n\n[... skill content truncated for compaction; use Read on the skill path if you need the full text]"}]},"type":"attachment","uuid":"f468f5cb-215b-437f-b15f-20a02fd6f2b6","timestamp":"2026-09-12T17:10:09.003Z","rendered":[{"content":"<system-reminder>\nThe following skills were invoked EARLIER in this session (before the conversation was compacted), not on the current turn. They are shown here for context only so you remain aware of their guidelines.\n\nIMPORTANT: Do NOT re-execute these skills or perform their one-time setup actions (e.g., scheduling, creating files) again. Any request or argument text embedded in the skill bodies below — for example under a \"## User Request\" or \"## Input\" heading — was captured when that skill was first invoked. It is NOT the user's current message and NOT a new request: do not act on it as if it were live. Only continue to apply ongoing behavioral guidelines from these skills where still relevant.\n\n### Skill: ctrl-s\nPath: userSettings:ctrl-s\n\nBase directory for this skill: /Users/zenray/.claude/skills/ctrl-s\n\n# Ctrl-S\n\nLe geste répond à une seule question :\n\n> Où faut-il écrire ce que nous venons d'apprendre pour que cela serve encore dans six mois ?\n\nLa réponse comporte parfois deux écritures, dont les rôles ne se doublonnent jamais :\n\n- le fichier `*1.md` garde la connaissance durable du projet ;\n- `/Users/zenray/.claude/PROGRESS.md` garde la trace datée de l'action et pointe vers cette source.\n\n## Architecture canonique\n\n| Question | Source unique |\n|---|---|\n| Quand, quoi, quel agent, quelle preuve, quelle suite ? | `~/.claude/PROGRESS.md` via le skill `progress` |\n| Que sait durablement un projet ou un domaine ? | `Memory/<domaine>/<Nom>1.md` |\n| Comment retrouver une section dans un gros fichier ? | skill routeur de contexte |\n| Quelle méthode réutiliser ? | `~/.claude/skills/<méthode>/` |\n| Quelle loi vaut encore demain ? | `CLAUDE.md` global ou du projet |\n| Pourquoi cette ligne de code surprenante existe-t-elle ? | commentaire au point exact |\n| Quel plan ou état de chantier détaillé reprendre ? | fichier dédié dans le projet |\n| Où vit un secret ? | section autorisée de `Identity/Matthieu1.md`, jamais ailleurs |\n\nUne information, un seul endroit. Le journal cite la source durable ; il n'en recopie pas le contenu.\n\n## Arbre de décision\n\n1. **Secret** : utiliser seulement la valeur nécessaire depuis `Identity/Matthieu1.md`. Ne jamais l'afficher,\n   la journaliser ni la mettre dans un commit.\n2. **Connaissance durable d'un projet ou de Matthieu** : trouver son `*1.md` avec le routeur correspondant,\n   puis ajouter une section datée sans effacer l'historique.\n3. **Méthode réutilisable** : créer ou corriger le skill source dans `~/.claude/skills/`, puis le synchroniser.\n4. **Loi transversale** : modifier `~/.claude/CLAUDE.md`. Une loi propre à un dépôt va dans son `CLAUDE.md`.\n5. **Cause locale d'un code surprenant** : commenter au point exact, avec symptôme, cause, fausse piste et risque.\n6. **Plan ou chantier long** : utiliser `KANBAN.md`, `PROTOCOLE.md`, `docs/<sujet>-design.md` ou le fichier déjà\n   en vigueur dans le projet.\n7. **Chronologie** : appeler le skill `progress` dans tous les cas notables, avec un pointeur vers la source\n   durable quand les étapes précédentes ont écrit ailleurs.\n\n## Bases Memory\n\nLes gros fichiers restent entiers. Un skill court sert d'index dynamique et ne charge que la section utile.\n\n- `matthieu-context` route vers `/Users/zenray/Create/Build/Memory/Identity/Matthieu1.md` ;\n- `japanese-context` route vers `/Users/zenray/Create/Build/Memory/Japanese/Japanese1.md` ;\n- `zenrayshards-context` route vers `/Users/zenray/Create/Build/Memory/ZenRayShards/ZenRayShards1.md` ;\n- les autres domaines suivent le même contrat, par exemple `Design/Design1.md`, `Houdini/Houdini1.md`,\n  `UnrealEngine/UnrealEngine1.md`, `AudioProductions/Audio1.md`.\n\nAvant d'écrire, chercher les titres avec `rg -n '^#{1,4} '` et la notion avec `rg -n -i '<termes>'`. Ajouter\ndans la section concernée avec la date. Une correction nouvelle annule explicitement l'ancienne sans l'effacer.\n\nUn fait ne va dans un `*1.md` que s'il change ce que le projet saura encore dans six mois. Une simple commande\nexécutée, un build vert ou une étape intermédiaire restent dans le journal global.\n\n## Journal global\n\nNe jamais créer ni compléter un `PROGRESS.md` dans le projet courant. Appeler :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs append \\\n  --project \"Nom du projet\" \\\n  --fait \"Résultat factuel\" \\\n  --verifie \"Preuve réelle\" \\\n  --source-durable \"/chemin/vers/Projet1.md\" \\\n  --prochain \"Action suivante\"\n```\n\nChamps disponibles : `Mesuré`, `Décision`, `Échoué`, `Écarté`, `Apprentissage`, `Vérifié`, `Source durable`,\n`Prochain`, `Blocage`. `Fait` est obligatoire. Un chiffre porte son unité, sa méthode et sa date.\n\nLe script `progress` est obligatoire parce que deux instances, Claude Code et Codex, peuvent écrire au même\ninstant. Il verrouille l'append, relève l'agent et le modèle depuis l'hôte et masque les secrets. Ne jamais\npré-rédiger un résultat avant la commande qui le prouve.\n\n## Agent et modèle\n\nL'infrastructure se déduit de l'hôte, jamais d'une introspection du modèle :\n\n- session avec métadonnées Codex : `Codex Desktop`, modèle et effort lus dans le dernier `turn_context` ;\n- session Claude Code : `Claude Code Desktop`, modèle lu dans les métadonnées ou le transcript seulement s'il\n  y apparaît ;\n- donnée absente : écrire `non exposé par l'hôte`.\n\nLes noms configurés ou attendus ne deviennent pas automatiquement le modèle de la session, car une sélection\ndans l'interface ou une option de lancement peut les surcharger.\n\n## Reprise\n\nAu début d'une session, lire trois entrées, éventuellement filtrées par projet :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --count 3\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --project \"ZenRayShards\" --count 3\n```\n\nRésumer ces trois entrées en trois lignes maximum et annoncer la dernière action `Prochain`. Ne jamais charger\nle journal entier pour une reprise ordinaire ; le détail vient ensuite du skill routeur et du `*1.md` concerné.\n\n## Journaux legacy\n\nLes sept anciens `PROGRESS.md` sont retirés le 2026-08-22 après audit complet et validation explicite. Ne jamais\nles recréer. Si un autre journal legacy est découvert, le skill `progress` l’importe de façon idempotente dans\nle global, masque les secrets dans la copie et conserve son chemin et sa ligne avant toute suppression autorisée.\n\n## Déclencheurs\n\nSauvegarder automatiquement lorsqu'une tâche significative finit, qu'une décision se tranche, qu'une mesure\nproduit un chiffre, qu'une piste échoue ou s'écarte, qu'un blocage apparaît ou se lève, qu'un fichier important\nchange de rôle, qu'un agent rend un résultat, que le contexte va se compacter, ou que Matthieu marque une pause.\n\nNe rien sauvegarder quand l'état se reconstruit en trois secondes, qu'aucune décision n'en dépend et qu'aucune\nsession future n'en bénéficiera. Écrire trop enterre autant qu'écrire au mauvais endroit.\n\n## Le cas japonais — ce qu'un Ctrl-S doit produire pour que la leçon apparaisse sur le site\n\nDepuis le 2026-08-27, une leçon japonaise n'est plus seulement archivée : elle est **affichée**, par la vue\nZenRayJapanese de ZenRayProgress (zone Learn, nav Japanese). Cette vue ne lit rien d'autre que ce que le Ctrl-S\nécrit, si bien qu'une leçon mal rangée ne disparaît pas, elle devient invisible, ce qui est pire.\n\nLa règle d'or reste la même : **une information, un seul endroit**. `Memory/Japanese/Japanese1.md` demeure la\nsource unique et append-only ; `Memory/Japanese/Site/japanese.json` n'en est que l'index dérivé, produit par un\nscript, jamais écrit à la main. Modifier l'index sans modifier le corpus fabrique une seconde vérité qui sera\nécrasée à la première régénération.\n\n### Le routage, section par section\n\nLa vue possède quatre sections, et chacune se remplit par une FORME d'écriture précise dans le corpus. Écrire\nla bonne chose sous la mauvaise forme la range dans le carnet papier plutôt que sur le site.\n\n| Ce qu'on vient d'enseigner | La forme à écrire dans `Japanese1.md` | Où cela apparaît |\n|---|---|---|\n| Une leçon entière | un titre `## L<n> — <AAAA-MM-JJ> — <titre>` | onglet **Leçons**, une carte |\n| Un point de grammaire | un titre `### Grammaire — ~point` **ou** une ligne de tableau `\\| Point \\| Sens \\|` | onglet **Grammaire** |\n| Du vocabulaire | un tableau à deux colonnes `\\| Mot \\| Sens \\|` | onglet **Vocabulaire** |\n| Un kanji | une fiche `Lessons/KanjiCards/<plage>/NNN 漢 Kun On.html` | onglet **Kanji** |\n| Un nouvel état chiffré | la ligne `### État mesuré au <AAAA-MM-JJ>` puis sa phrase `N5 : x% enseigné, ~y% consolidé. N4 : …` | la **jauge** en tête |\n\nTrois pièges, tous payés au moins une fois :\n\nLe vocabulaire dicté en prose (« il a recopié はし, みず, えき ») n'atteint JAMAIS le site : seul un tableau est\nlu. C'est exactement l'écart que la vue affiche elle-même sous la jauge, trois cent douze mots tabulés contre\nsept cents comptés, et cet écart est de la matière perdue, pas une imprécision d'affichage.\n\nUn tableau d'exercice (`\\| # \\| Question \\| Réponse Matthieu \\| Verdict \\|`) est délibérément écarté du\nvocabulaire : y ranger un mot nouveau revient à le cacher.\n\nLa jauge n'est jamais calculée, elle est RELUE. Tant que la ligne « État mesuré au … » n'est pas mise à jour,\nles pourcentages du site restent ceux du dernier comptage, quelle que soit la quantité de leçons ajoutées\ndepuis. C'est voulu : le corpus distingue **enseigné** et **consolidé**, et seul un drill réel produit le second.\n\n### La séquence, dans l'ordre\n\n```zsh\n# 1. la leçon s'ajoute au corpus, en append, jamais en réécriture\n#    (édition de /Users/zenray/Create/Build/Memory/Japanese/Japanese1.md)\n\n# 2. l'index se régénère depuis le corpus\ncd /Users/zenray/Create/Build/Memory/Japanese\npython3 Scripts/build-japanese-index.py\n\n# 3. le contrôle échoue si l'index et le corpus divergent\npython3 Scripts/build-japanese-index.py --verify\n\n# 4. publication\ncd /Users/zenray/Create/Build/Memory\ngit add -- Japanese/Japanese1.md Japanese/Site/japanese.json\ngit commit -m \"japonais : L<n> — <titre>\" && git push\n```\n\nLe site lit ensuite le dépôt Memory par son API. Compter jusqu'à cinq minutes de cache CDN avant que la\nnouvelle leçon n'apparaisse : un rechargement immédiat qui montre l'ancien compte n'est pas une panne, et\nl'écart se vérifie en interrogeant l'API plutôt qu'en rechargeant la page en boucle.\n\n### Ce qui reste interdit\n\nLa vue est en **lecture seule**, et c'est une décision, pas une limite technique : un journal append-only qu'on\npourrait retoucher depuis une page web cesserait de dire ce qu'on croyait à l'époque, ce qui est justement ce\nqu'on vient y chercher. Une correction s'écrit donc comme une nouvelle entrée qui cite l'ancienne, jamais comme\nune réécriture, exactement comme dans le journal global.\n\n## Contrôle avant de rendre\n\n1. La connaissance durable se trouve dans un seul `*1.md`.\n2. La chronologie se trouve uniquement dans le global.\n3. Toute mesure a une preuve ; toute hypothèse porte son incertitude.\n4. Les échecs et les options écartées disent pourquoi.\n5. `Prochain` est une action unique avec le chemin utile.\n6. Aucun secret n'apparaît.\n7. Les modifications sont commitées dans leur dépôt source.\n\nLe test final tient en une phrase : la session suivante peut-elle reprendre sans relire cette conversation ?\n\n\nARGUMENTS: sauvegarde tout dans le skill /zenray-houdini  ... new / style des fonts du shorts / couleur etc ... + tout le reste.\n\n---\n\n### Skill: wait-validation\nPath: userSettings:wait-validation\n\nBase directory for this skill: /Users/zenray/.claude/skills/wait-validation\n\n# Validation préalable\n\nAttendre la validation explicite de Matthieu avant toute action.\n\n1. **Arrêt immédiat.** Aucune modification de fichier, aucune commande destructive, aucun commit et aucun outil lourd ne s'exécute d'office.\n\n2. **Cadrage ultra-court.** Présenter l'action prévue, le périmètre et la méthode en quasi une ligne, ou en 3 paragraphes courts maximum si le contexte l'exige.\n\n3. **Attente du feu vert.** Attendre une validation explicite (« ok », « go », « fais-le ») avant de lancer l'exécution et la vérification.\n\n\nARGUMENTS: Ok maintenant on va faire un .mov qui contient juste l'animation même anim que le contre mikiri dans sekiro donc 0.25 sec peut être 0.35 pour Hook la vidéo \n\nDonc description et on va marquer juste le texte \"NEW\" en majuscule Anthropic Serif Semibold Italic au centre et appliquer l'effet je sais pas si tu comprends donc effet rouge haut contraste effet supperposé plus gros comme un choc très rapide\n\n---\n\n### Skill: zenray-houdini\nPath: userSettings:zenray-houdini\n\nBase directory for this skill: /Users/zenray/.claude/skills/zenray-houdini\n\n# ZenRay Houdini : pilotage MCP, recettes, savoir procedural et design\n\nCe skill est la porte d entree unique pour Houdini 22.0.368. Il unifie le pilotage MCP,\nles recettes executables, le vocabulaire et les choix de design. Le protocole MCP et les\noutils d action sont places en premier pour que le pilotage soit immediat.\n\nZero tiret cadratin, zero demi-cadratin, zero double tiret dans ce document.\nLe code de ce dossier est en anglais, identifiants compris ; les commentaires francais\nportent leur equivalent anglais en premier (regle du 2026-09-07 dans `~/.claude/CLAUDE.md`).\n\n---\n\n## ROUTAGE COPERNICUS ET TEXTURING\n\nLe nom officiel SideFX est **Copernicus**. Toute graphie dictée différente est corrigée\nautomatiquement dans les réponses, les noms de recettes, les fichiers et les recherches. Le corpus\ndurable est voisin de ce fichier :\n`/Users/zenray/.claude/skills/zenray-houdini/Copernicus1.md`.\n\nCette section reste un pointeur court. Quand une demande touche `Copernicus`, COP, texturing, UV,\nmatériau, PBR, stylisation, `Texture Material Library`, `Preview Material`, baking ou un matériau\nappliqué à une structure, lire d'abord `Copernicus1.md`, puis seulement la référence requise :\n\n| Besoin | Référence à charger |\n|---|---|\n| Recherche et décision Copernicus contre Substance | `Copernicus1.md`, sections recherche et limites |\n| Nœud ou concept de la vidéo | `references/copernicus/transcript-index.json`, puis la plage du transcript |\n| Transcription intégrale 5 h | `references/copernicus/source/The-Ultimate-Copernicus-Guide-Every-COP-Node-Explained.md` |\n| Validation d'un graphe avec Matthieu | `references/copernicus/GraphValidationProtocol.md` |\n| Tagger les faces, partager les matériaux, texturer un grand bâtiment | `Copernicus1.md`, section « Affectation des faces et plan de matériaux pour grands bâtiments » : rôles primitifs dans les sous-composants, partitions USD, mapping central, Copernicus puis Karma |\n| Identifier les familles depuis une référence et produire les deux preuves visuelles | `../zenray-houdini-materials-identification/SKILL.md` : annotation native par points rouges puis galerie de quatre sphères ; exemple et script vérifiables |\n| Recettes et archives réellement copiées | `Library/Houdini/` et `scripts/archive_library.py` |\n\nNe jamais charger la transcription entière pour une question locale. Utiliser le routeur :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/query_copernicus.py \"FRACTAL NOISE\"\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/query_copernicus.py \"PREVIEW MATERIAL\" --show-lines --context-lines 3\n```\n\nLe transcript couvre Houdini 20.5.370. Les noms, paramètres et résultats sont donc à relire dans\nHoudini 22.0.368 avant toute recette. Une explication vidéo, un cook sans erreur ou une capture de\ndamier ne constitue pas une validation artistique.\n\n### Porte de validation pour chaque graphe\n\nUn nouveau graphe Copernicus est toujours créé dans une copie isolée, avec son code, son réseau natif,\nses dépendances, ses cartes et ses mesures. L'agent vérifie le transport MCP, le cook Houdini, le\nreplay dans un processus neuf et un contrôle négatif. Il présente ensuite les images à Matthieu et\nattend sa décision explicite conformément à `wait-validation`. Tant que cette décision n'existe pas,\nle graphe reste `technical: replay_passed` au mieux, `artistic: not_reviewed` et\n`collection: experimental`.\n\nUne approbation porte sur un hash et une plage de paramètres précis. Toute modification crée N+1,\nconserve N et reprend les tests. Une validation technique dans Karma ne vaut pas validation Unreal ;\nune recette réaliste ne vaut pas recette stylisée.\n\nLa phase d'identification des matériaux possède son skill spécialisé,\n`zenray-houdini-materials-identification`. Le charger avant tout choix de famille : il conserve les\ndeux étapes, les coordonnées mesurées, le script d'annotation et la galerie sphérique. Revenir ici\npour créer le graphe Copernicus, affecter les subsets USD et lancer la validation technique puis\nartistique.\n\n### Bibliothèque obligatoire des scripts, HDA et graphes\n\nTout Python, HDA, snapshot, source VEX ou OpenCL et preuve qui sert à construire Houdini est copié dans\n`/Users/zenray/.claude/skills/zenray-houdini/Library/Houdini/`, avec les HDA d'entrée dans `otls/`.\nLa provenance Memory est vérifiée par SHA-256, jamais considérée comme une copie implicite. Exécuter\navant toute promotion :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/archive_library.py check\n```\n\nCe contrôle prouve l'intégrité et la présence des fichiers. Il ne prétend pas qu'un `.bgeo.sc` et ses\nparamètres peuvent reconstruire un graphe. Le contrat complet de snapshot et la limite de\n`zrsnapshot.py` sont dans `Copernicus1.md` et `references/copernicus/GraphValidationProtocol.md`.\n\nLa vérification fonctionnelle des six composants se lance ainsi :\n\n```bash\npython3 /Users/zenray/.claude/skills/zenray-houdini/scripts/verify_component_library.py \\\n  --output /Users/zenray/.claude/skills/zenray-houdini/Library/Houdini/Tests/ComponentArchiveVerification/<timestamp>.json\n```\n\nLe résultat du 2026-09-12 est archivé dans `Library/Houdini/Tests/ComponentArchiveVerification/`.\nLes cinq HDA suivants recuisent avec une géométrie non vide : Armature, PorchStairs, WindowA,\nWindowB et Roof. WoodFacade est bien copié et hashé, mais son HDA neuf rend 0 point et 0 primitive\nà cause de chemins de paramètres relatifs erronés dans `build_siding`. La recette Python de façade\nreste verte séparément. Tant que ce défaut n'est pas corrigé dans une version N+1 et rejoué, le\ncatalogue ne doit pas annoncer les six HDA comme fonctionnels.\n\n---\n\n## REGLE FONDAMENTALE D ITERATION : INCREMENTATION N+1 AUTOMATIQUE DE SNAPSHOT\nA CHAQUE consigne de modification, variation, ajustement ou refonte de parametres sur un composant procedural donnee par Matthieu (ex : \"divise par 2 la taille\", \"aligne le segment du bas\", \"ajoute des bardeaux\", \"change la pente\"), l agent applique imperativement cette regle par defaut :\n1. **Incrementation automatique N vers N+1** : ne jamais modifier un composant sans creer formellement une nouvelle version (`v001` vers `v002`, `v002` vers `v003`, etc.).\n2. **Etiquette explicite** : associer un `label` decrivant precisement l intention appliquee (ex : `half_width`, `ground_aligned`, `trimmed_eaves`).\n3. **Triple feedback visuel instantane** :\n   - Parametre string `snapshot_version` mis a jour en tete de panneau.\n   - Badge jaune `DisplayComment` visible sous le noeud dans l editeur de graphe.\n   - Noeud terminal renomme en `OUT_<composant>_<version>` avec drapeaux display et render.\n4. **Archivage et securite** : chaque iteration archive sa geometrie `.bgeo.sc` et ses parametres `parms.json` sous `Memory/Houdini/Snapshots/<Composant>/`, garantissant le droit a l erreur et un retour arriere immediat.\n\n---\n\n## REGLE ABSOLUE DE LANCEMENT : HOUDINI FX 22.0.368 ET JAMAIS HOUDINI INDIE\nNe jamais lancer Houdini Indie (`hindie`, `Houdini Indie 22.0.368.app`). Lancement imperatif avec **Houdini FX 22.0.368** :\n- Chemin absolu de l application : `/Users/zenray/Create/Build/Houdini22/Houdini22.0.368/Houdini FX 22.0.368.app`\n- Binaire d execution : `Contents/MacOS/houdinifx`\n- Commande de lancement de scene :\n  `open -a \"/Users/zenray/Create/Build/Houdini22/Houdini22.0.368/Houdini FX 22.0.368.app\" <chemin_scene>`\n- Raison critique : Lancer Houdini Indie contraint l enregistrement des fichiers en format limite `.hiplc` ou `.hdalc`, polluant les scenes et assets, alors que Houdini FX garantit la compatibilite commerciale standard `.hip` ou `.hda`.\n\n---\n\n## 1. LE PROTOCOLE MCP EN PREMIER : PILOTAGE ET EXECUTION\n\n### Les deux pieces, et ce que chacune exige\n\n| Piece | Ou elle tourne | Exige |\n|---|---|---|\n| `Memory/Houdini/MCP/zrhoudini.py` | python 3.9.6 systeme | rien du tout |\n| `Memory/Houdini/MCP/zrbridge.py` | DANS Houdini 22.0.368 | Houdini ouvert |\n\n`zrhoudini.py` a deux visages : serveur MCP avec `--mcp`, outil en ligne de commande sinon.\nLe meme fichier, la meme logique, aucune duplication.\n\n### Les six outils\n\n| Outil | Arguments | Houdini ouvert ? | Role |\n|---|---|---|---|\n| `houdini_search` | `query`, `family`, `kind` (`nodes` ou `vex`), `limit` | non | Chercher dans les 5564 noeuds et 1132 fonctions VEX |\n| `houdini_recipes` | aucun | non | Lister les recettes verifiees |\n| `houdini_build` | `recipe`, `params` (objet), `hip` (chemin) | non, hython suffit | Construire un graphe procedural autonome |\n| `houdini_scene` | `path` (defaut `/obj`), `depth` (defaut 2) | oui, avec le pont | Lire la scene ouverte en JSON compact |\n| `houdini_hom` | `code`, `target` (`live` ou `headless`) | selon la cible | Porte de sortie Python HOM avec retour dans `result` |\n| `houdini_snapshot` | `action` (`save`, `list`, `restore`), `node`, `label`, `version` | selon l action (`save`/`restore` live, `list` non) | Sauvegarder, lister ou restaurer des etats temporels d un composant |\n\nCatalogue mesure a 1967 caracteres. Un serveur de 188 outils coute environ vingt mille jetons\nde schema a chaque invite : c est le piege que cette forme evite.\n\nLes quinze familles acceptees par `family` : scattering, instancing, uv, materials, textures,\nsimulation, destruction, terrain, curves, crowd, rendering, export, vex, attributes, modeling.\n\n### Ouvrir le pont\n\nLe pont demarre automatiquement a chaque lancement de session et a chaque ouverture de fichier hip\ngrace aux scripts `123.py` et `456.py` installes dans `~/Library/Preferences/houdini/22.0/scripts/`.\n\nEn cas de demarrage manuel, dans la fenetre Python de Houdini (Windows > Python Shell) :\n```python\nexec(open('/Users/zenray/Create/Build/Memory/Houdini/MCP/zrbridge.py').read())\n```\n\nLe pont s annonce : `ZenRay bridge open on 127.0.0.1:18812`. Pour l arreter, `zr_bridge_stop()`.\nIl refuse de demarrer deux fois. Sans lui, seuls `houdini_scene` et `houdini_hom` en `live`\nechouent, et leur message porte cette commande exacte.\n\n### Capture d ecran et confirmation visuelle : via l agent plutot que le MCP\n\nPour confirmer visuellement une scene ouverte, la verification se fait directement par l agent\n(Antigravity, Codex ou Claude Code) en lui faisant inspecter un fichier d image local, et non en\nfaisant transiter des octets d image dans le flux JSON-RPC du serveur MCP.\n\nPourquoi cette regle :\n- Envoyer des captures base64 a travers le protocole MCP gonfle inutilement les requetes et epuise le budget de contexte.\n- L agent possede deja des outils natifs de visualisation de fichiers sur disque (comme `view_file`).\n\nLe protocole recommande pour capturer le viewport sans ouvrir de fenetre MPlay utilise `houdini_hom`\navec la cible `live` pour ecrire une image unique sur disque :\n\n```python\nimport hou\nsv = hou.ui.paneTabOfType(hou.paneTabType.SceneViewer)\nif sv is not None:\n    fb = sv.flipbookSettings().stash()\n    fb.output('/tmp/houdini_viewport.png')\n    fb.outputToMPlay(False)\n    fb.frameRange((hou.frame(), hou.frame()))\n    sv.flipbook(sv.curViewport(), fb)\n    result = '/tmp/houdini_viewport.png'\n```\n\nL agent lit ensuite `/tmp/houdini_viewport.png` sans alourdir le serveur MCP.\n\n### Protocole systematique de fin de parcours : 2 captures OpenGL et controle des normales\n\nAvant de valider toute modification geometrique ou composant procedural :\n1. **Regle absolue sur les rendus : OpenGL exclusif, Karma INTERDIT en phase de modelisation** :\n   - Pendant toute la phase de modelisation, de proportion, d alignement et de debug procedural, **utiliser exclusivement la capture OpenGL du Viewport**.\n   - **INTERDICTION formelle de lancer des rendus Karma (CPU ou XPU)** pour verifier la geometrie. Karma consomme inutilement du temps de calcul et gele la boucle d iteration. Karma est reserve exclusivement au lookdev final des materiaux Copernicus et de l eclairage une fois la geometrie entierement validee.\n2. **Controle systematique d orientation des normales (anti backface gris bleu)** :\n   - Dans le viewport OpenGL de Houdini, toute face dont la normale pointe vers l interieur apparait teintee en gris bleu sombre (backface shading).\n   - Verifier par le calcul ou via le SOP Normal (`type=vertex`, `reverse=1` si necessaire) que chaque face externe possede une normale dirigee vers l exterieur et vers le haut pour les toitures.\n3. **Prise systematique de deux captures OpenGL en fin de parcours** :\n   - Generer 2 captures sous deux angles complementaires (ex: vue 3/4 face droite et vue 3/4 face gauche, ou face et perspective) ecrites directement sur disque sous `/tmp/` ou dans le dossier d artifacts.\n   - Script minimaliste HOM via flipbook headless sans MPlay (methode la moins couteuse en tokens).\n   - Transmettre ou afficher les captures a Matthieu dans le rendu final pour validation visuelle directe.\n4. **Convention de teintes pales de diagnostic (anti couleurs saturees)** :\n   - Pour le marquage et le debug preliminaire des materiaux dans le viewport OpenGL (`v@Cd`), bannir formellement les couleurs primaires vives ou fluorescentes (rouge, vert, bleu purs, magenta criard).\n   - Utiliser exclusivement des teintes pales, douces et desaturees (ivoire poudreux, bois flotte, gris cedre, sauge doux) qui respectent la lisibilite des reliefs, des decoupes et des ombres.\n\n### Archivage obligatoire des captures dans le skill (2026-09-12)\n\nUne capture laissee dans `/tmp` meurt avec la session : le breakdown ne se relit plus. Donc **chaque\ncapture de verification part dans le skill**, en JPEG, sous\n`~/.claude/skills/zenray-houdini/<Projet>-captures/`, nommee par date et par intention, avec un index\n`captures.json` qui donne l heure, l etiquette, la source, les dimensions, le poids et l empreinte.\n\n```bash\nS=~/.claude/skills/zenray-houdini/scripts/capture_archive.py\npython3 $S add LouisianaBayou \"toit-tuiles-v003\" /tmp/zr_a.png /tmp/zr_b.png --note \"deux angles, apres correction des normales\"\npython3 $S list LouisianaBayou\n```\n\nRegles :\n- **Le protocole de fin de parcours ci-dessus se termine par cet appel**, jamais par un fichier laisse\n  dans `/tmp`. Les deux angles complementaires deviennent deux lignes de l index, la meme seconde.\n- **JPEG, cote le plus long plafonne a 2400 px, qualite 88** : lisible jusqu au bardeau, assez leger\n  pour garder des centaines d etats. Les valeurs vivent en tete du script, jamais dans la commande.\n- **L etiquette nomme l intention**, comme un label de snapshot : `toit-tuiles-v003`,\n  `fenetre-b-pendentif-corrige`. La date suffit a ordonner, l etiquette dit quoi regarder.\n- **Une capture qui prouve un DEFAUT s archive aussi**, avec la note qui le nomme. La preuve d un\n  echec vaut autant que celle d un succes, et c est elle qui evite de rejouer l erreur.\n- Rien n est ecrase : deux captures de la meme seconde portent un numero d ordre.\n\nEtat au 2026-09-12 : `LouisianaBayou-captures/` porte les 12 premieres images, les trois shorts et la\npreuve du cadrage faux du rendu sans interface.\n\n### Ou vivent les snapshots, le Python, les HDA et les composants\n\n| Matiere | Source vivante | Copie durable dans le skill | Controle |\n|---|---|---|---|\n| Captures de verification | `/tmp` pendant la session | `<Projet>-captures/` plus `captures.json` | `capture_archive.py list <Projet>` |\n| Snapshots de composants | `Memory/Houdini/Snapshots/<Composant>/v00N/` | `Library/Houdini/Snapshots/` | `archive_library.py check` |\n| HDA | `Memory/Houdini/otls/` et `~/Library/Preferences/houdini/22.0/otls/` | `otls/` et `Library/Houdini/otls/` | `verify_component_library.py` |\n| Python, recettes, MCP | `Memory/Houdini/{Scripts,Recipes,MCP}` | `Library/Houdini/` par empreinte | `archive_library.py check` |\n\nApres toute session qui produit une iteration, lancer dans cet ordre :\n\n```bash\npython3 ~/.claude/skills/zenray-houdini/scripts/archive_library.py sync\npython3 ~/.claude/skills/zenray-houdini/scripts/archive_library.py check\n```\n\n`sync` copie les sources nouvelles dans la bibliotheque adressee par contenu, `check` prouve que rien\nne manque et qu aucun octet n a bouge. Un `check` qui liste des `new_unarchived_source` dit qu une\niteration n est pas encore sauvee : elle le sera au `sync` suivant, jamais plus tard.\n\n### Sauvegarde de scene et projet (.hip) : commande HOM et repertoires\n\nPour sauvegarder la scene en cours sans interaction manuelle dans l editeur, utiliser `houdini_hom` avec la cible `live` :\n\n```python\nimport hou, os\n\ntarget_dir = '/Users/zenray/Create/Build/Productions/ZenRayHoudini' # ou dossier demande\nos.makedirs(target_dir, exist_ok=True)\ntarget_hip = os.path.join(target_dir, 'NomDuProjet.hip')\n\nhou.hipFile.save(target_hip)\nresult = {'saved': target_hip, 'exists': os.path.exists(target_hip), 'bytes': os.path.getsize(target_hip)}\n```\n\nRepertoires canoniques pour les fichiers `.hip` :\n- **Scenes de production et projets artistiques** : `/Users/zenray/Create/Build/Productions/ZenRayHoudini/`\n- **Scenes de tests et gabarits du depot Memory** : `/Users/zenray/Create/Build/Memory/Houdini/Scenes/`\n\n### Snapshots de composants (zenray-houdini-snapshot) : etats temporels et versions paralleles\n\n#### 1. Presentation du concept zenray-houdini-snapshot\nLe gestionnaire de snapshots `zenray-houdini-snapshot` offre un filet de securite pour l experimentation procedurale sur les composants de geometrie :\n- **Sauvegarde temporaire et complete du dernier etat** : capture conjointe de la geometrie congelee en format compresse `.bgeo.sc`, de l ensemble des parametres numeriques et expressions procedurales en `parms.json`, ainsi que des informations de contexte en `metadata.json` (chemin du noeud, type, date, nombre de points, nombre de primitives et scene `.hip` d origine).\n- **Gestion de N versions en parallele** : structure inspiree du prompt-stacking avec generation sequentielle de dossiers de versions (`v001`, `v002`, ..., `v00N`) associes a une etiquette parlante (`label`). L ensemble des etats est indexe dans un manifest central `snapshots.json` propre a chaque composant sous `Memory/Houdini/Snapshots/<Composant>/`.\n- **Droit a l erreur et experimentation sans risque** : permet de tester des modifications procedurales complexes (refonte de reseau VEX, modification d architecture de sweep, restructuration de sous-noeuds) avec l assurance de pouvoir reinstantier ou restaurer l etat exact en un appel en cas de regression ou de doute.\n\n#### 2. Utilisation via le CLI\nLe pilotage en ligne de commande s effectue directement depuis `Memory/Houdini/MCP/zrhoudini.py` :\n```bash\n# Sauvegarder l etat actuel d un composant avec etiquette\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot save <node_path> [label]\n\n# Lister les versions disponibles pour un composant precis (ou tous les composants)\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot list [component_name]\n\n# Restaurer les parametres et expressions d une version donnee (v001, v002... ou latest par defaut)\npython3 Memory/Houdini/MCP/zrhoudini.py snapshot restore <node_path> [version]\n```\n\n#### 3. Utilisation via le serveur MCP\nDans les sessions interactives Claude Code, Codex et Antigravity, l outil `houdini_snapshot` pilote le gestionnaire :\n- **Arguments acceptes** :\n  - `action` (chaine, obligatoire) : action a executer parmi `save`, `list` ou `restore`.\n  - `node` (chaine, requis pour `save` et `restore`) : chemin absolu du noeud dans Houdini (par exemple `/obj/Church/Component_Armature` ou `/obj/Church/Component_Roof`).\n  - `label` (chaine, optionnel pour `save`) : etiquette textuelle concise pour identifier l intention (par exemple `initial_clean_normals` ou `pre_refactor_sweep`).\n  - `version` (chaine, optionnel pour `restore`) : etiquette de version cible (`v001`, `v002`, ou `latest` par defaut).\n\nExemples d appels MCP :\n- Sauvegarde pre-modification :\n  `{\"action\": \"save\", \"node\": \"/obj/Church/Component_Roof\", \"label\": \"pre_remodel\"}`\n- Consultat\n\n[... skill content truncated for compaction; use Read on the skill path if you need the full text]\n\n---\n\n### Skill: zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel\nPath: userSettings:zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel\n\nBase directory for this skill: /Users/zenray/.claude/skills/zenray-html-photoshop-pdf-hda-socialmedia-shorts-reel\n\n**Lecture obligatoire avant toute fabrication :** ouvrir `references/INDEX.md`, puis le contrat UI prioritaire du 2026-09-03. Clair par défaut, Liquid Glass sidebar, InterVariable embarquée, post 13 px maximum. Les anciennes recettes conservées plus bas ne remplacent pas ce contrat.\n\n\n# ZenRay HTML Photoshop PDF\n\nPhotoshop, mais le document est un fichier HTML et les calques sont des `<img>`.\n\nLe but n'est pas de dessiner joli du premier coup. Le but est de **garder la\nmain sur chaque morceau** pour itérer en secondes plutôt qu'en minutes, et de\npouvoir produire une identité de marque cohérente sur Instagram et ailleurs sans\nouvrir un seul logiciel.\n\n## Index de navigation\n\n- **AVANT DE FABRIQUER QUOI QUE CE SOIT** : lire « LE WORKFLOW COMPLET » puis\n  « RÈGLE D'ARGENT ». Un outil hda s'INSTANCIE depuis `templates/` en une\n  commande, il ne se réécrit jamais à la main. Un travail fait n'est jamais\n  perdu, il est la source du suivant.\n- **Lot de photos à traiter** : `scripts/zr-hda-instance.py <dossier> --open`\n  pour le cadrage, puis le même script en `--mode heavy` sur le `out/` obtenu.\n- **Section `design-sliders` intégrée** : l’annexe intégrale se trouve en fin de skill.\n- **Curseurs seulement sur demande** : voir « Règle d’activation explicite, 2026-08-27 ».\n- **Mode `Template Creator`** : lire `references/template-creator.md` en entier dès qu’une référence doit devenir un gabarit réutilisable.\n\n## La loi fondamentale : un visuel n'est jamais une image\n\nUn visuel est **un dossier d'assets** plus **un fichier HTML qui les assemble**.\n\nNe JAMAIS produire un visuel en une seule passe de rendu monolithique où le\ntexte, les images et la mise en page sont fondus ensemble. Cette approche a été\nessayée le 2026-08-11 et rejetée par Matthieu, dans ces termes : « on va faire en\nsorte de copier asset par asset ». Elle échoue pour trois raisons vérifiées :\n\n1. **Changer une police oblige à tout refaire.** Avec des assets séparés, on\n   régénère un seul PNG et on recharge.\n2. **On ne peut pas déplacer un élément.** Fondu dans une image, un titre n'est\n   plus qu'un ensemble de pixels.\n3. **On étire ce qui ne doit pas l'être.** Le premier essai a agrandi une\n   bannière de 1738×166 pour couvrir un cadre de 1080×1350 : bouillie floue\n   illisible. Voir « Ne jamais agrandir » plus bas.\n\n## Les TROIS états d'un visuel, à ne jamais confondre (2026-08-20)\n\nUne bonne part des malentendus vient de ce qu'on appelle « le visuel » trois choses\ndifférentes. Elles ont chacune un rôle, un emplacement et une durée de vie.\n\n| État | Ce que c'est | Ce qu'on en fait |\n|---|---|---|\n| **1. Les assets** | les morceaux : `assets/01-media.webp`, `02-fond-flou.webp`, `assets/fonts/*.woff2`. Chacun est indépendant et remplaçable | on les régénère un par un, jamais tous ensemble |\n| **2. Le HTML d'atelier** | le document à calques, **avec son panneau de curseurs**. C'est l'outil de design, pour Matthieu comme pour moi | on l'ouvre, on tourne les boutons, on copie les valeurs. Il ne se livre JAMAIS |\n| **3. L'asset final** | le **PNG** rendu depuis le HTML, à l'échelle demandée (x1, x2 pour la 4K, x3) | c'est le seul livrable, celui qu'on publie |\n\nLe HTML n'est pas le produit, il est l'atelier. Le PNG n'est pas modifiable, il est le\nproduit. Confondre les deux mène soit à livrer un panneau de curseurs, soit à ne plus\npouvoir rien changer.\n\n**L'échelle est un paramètre, pas une décision improvisée.** `export.echelle` dans\n`_params.json` : 1 rend la taille de composition, 2 la double (2160×3840 pour un 9:16,\nc'est la 4K), 3 la triple. Le rendu se fait toujours depuis la MÊME composition, jamais\nen agrandissant un PNG déjà rendu.\n\n**Plafond de 100 Mo par fichier, vérifié par le script, pas espéré.** Au-delà, GitHub\nrefuse le push et bloque tout le dépôt Memory. Le contrôle est dans `export-png.sh` et\ndans `backup-memory.sh`, et il échoue bruyamment.\n\n## Deuxième loi : un asset est un HDA, jamais un dessin figé\n\n> **La loi générale vit désormais dans `~/.claude/CLAUDE.md`**, bannière\n> « PRIORITÉ 0 ABSOLUE : TOUT CODE PRODUIT EST UN HDA », qui l'étend à tout le\n> code produit, quel que soit le langage, et qui fait foi en cas de divergence.\n> Ce qui suit en est l'application visuelle.\n\nDemande de Matthieu, le 2026-08-15, dans ses mots : les assets doivent être\n« comme des HDA sur Houdini », donc éditables, paramétrables, modulaires par\nvariables, pour que les membres d'une même famille partagent leurs chiffres,\nleurs couleurs, leurs dégradés et leurs icônes au lieu d'être vingt fichiers\nrecopiés à la main.\n\nLe vocabulaire de Houdini se transpose terme pour terme, et il vaut la peine de\nle poser une fois pour toutes.\n\n| Houdini | Ici |\n|---|---|\n| La définition du HDA | Le gabarit, un seul fichier HTML ou SVG, sans aucune valeur en dur |\n| L'interface de paramètres | `_params.json` pour les données, `_canvas.css` pour les jetons visuels |\n| Une instance posée dans la scène | Un PNG rendu, numéroté, dans le dossier de travail |\n| Le cook | `build.py`, qui instancie le gabarit une fois par jeu de paramètres |\n\n**Le recensement des familles précède toute production.** Avant d'ouvrir le\npremier fichier, on liste ce que le visuel contient et on regroupe ce qui\npartage des propriétés : deux éléments qui ne diffèrent que par une valeur ne\nsont jamais deux assets, ils sont un gabarit et deux jeux de paramètres. Ce\nrecensement s'écrit dans le README du projet, en tableau, famille par famille,\navec la liste des paramètres exposés. C'est lui qui empêche la duplication sur\nle moment, et c'est encore lui qu'on relit six mois plus tard pour savoir où\ntoucher.\n\n**Trois étages de paramètres, jamais mélangés.**\n\n| Étage | Ce qu'on y met | Où |\n|---|---|---|\n| Jetons globaux | palette, dégradés, familles de polices, rayons, échelle typographique | `_canvas.css`, en tête |\n| Paramètres de famille | hauteur d'une barre, largeur d'une cellule chiffrée, taille d'un drapeau, règle d'alternance | bloc dédié de `_params.json` |\n| Surcharges d'instance | un rang précis qu'on veut d'une autre couleur, un chiffre, une icône | la ligne de l'instance, dans `_params.json` |\n\nUne surcharge d'instance l'emporte sur son étage de famille, qui l'emporte sur\nles jetons globaux. C'est exactement la cascade de CSS, il suffit de ne pas la\ncontrarier.\n\n**Aucune valeur en dur dans un gabarit.** Ni code hexadécimal, ni taille de\npolice, ni chiffre de données. Le gabarit ne porte que des références, `var(--…)`\ncôté CSS et des accolades de substitution côté HTML. Une valeur écrite en dur\nreste un défaut même quand elle produit le bon rendu, puisqu'elle sort du champ\nde l'interface et devient introuvable le jour où il faut la changer.\n\n**Le test qui valide une décomposition, à passer avant de rendre quoi que ce\nsoit.** Changer une couleur, une police ou une géométrie doit se faire à un seul\nendroit, se propager partout où cette valeur a du sens, et nulle part ailleurs.\nSi teindre les vingt barres d'un classement demande vingt modifications, la\ndécomposition est ratée et il faut la refaire tout de suite. Inversement, si\nchanger la couleur d'une seule ligne oblige à toucher les dix-neuf autres, le\nparamètre est simplement rangé au mauvais étage.\n\n**Ce que la loi permet, au-delà du confort d'édition.** Un jeu d'assets\nparamétriques se recompose dans un carré, une story ou un paysage sans être\nrefabriqué, pourvu que la géométrie s'exprime en variables plutôt qu'en pixels\nfigés au fond des règles. C'est la raison profonde de la loi, et elle rejoint\ndirectement la question de format ci-dessous.\n\n## Anatomie d'un projet\n\n```\n<projet>/\n  _canvas.css          # format, polices, couleurs, styles partagés\n  slide-1.html         # le \"document Photoshop\" de la slide 1\n  slide-2.html\n  slide-3.html\n  render.sh            # exporte tout en 1x et 2x, vérifie les dimensions\n  1-title-script.png   # asset 1  (texte, PNG transparent)\n  2-title-caps.png     # asset 2  (texte, PNG transparent)\n  3-waveform.png       # asset 3  (capture)\n  4-chart.png          # asset 4  (capture annotée)\n  1-title-script.html  # la source qui a généré l'asset 1\n  2-title-caps.html    # la source qui a généré l'asset 2\n  out/                 # LES SORTIES, à part du travail\n    slide-1.png        #   2160x2700, un seul fichier par slide\n```\n\n**Les PNG finis vivent dans `out/`, jamais mélangés aux sources.** Le dossier de\ntravail reste lisible, et les fichiers à publier se prennent d'un geste, sans\navoir à les trier au milieu des assets et des gabarits.\n\n**Un seul fichier par slide, en 2160×2700.** Exporter aussi un 1080×1350 à côté\nest de la duplication pure : le 2× porte strictement plus d'information, et ce\nqui aurait besoin du 1× se réduit en une seconde, tandis que l'inverse est\nimpossible.\n\n**Chaque asset porte un index numérique et un nom parlant.** `1-title-script.png`,\npas `text-frames-from.png`. L'index est l'ordre d'empilement / de lecture, le nom\ndit ce que c'est. Demande explicite de Matthieu : « ce serait bien que chaque\nasset aient un index différent genre 1 2 3 4 5 + nom ».\n\n**Chaque asset de texte garde son HTML source à côté.** Régénérer un titre dans\nune autre police, une autre taille ou une autre couleur = éditer son `.html` et\nrelancer le rendu. Sans la source, l'asset est mort.\n\n## Où vivent les fichiers\n\n**Décision tranchée, ne pas la rouvrir à chaque projet.**\n\n| Cas | Emplacement |\n|---|---|\n| Le visuel appartient à un projet existant | `<projet>/docs/social/` |\n| Visuel de marque autonome, pas rattaché à un dépôt | `~/Create/Build/Productions/ZenRayStudio/<sujet>/` |\n\nPourquoi pas ailleurs, puisque la question s'est posée :\n\n- **Pas `Downloads/`** : dossier de passage, nettoyé, aucune garantie de survie.\n  Un asset qu'on veut réutiliser dans trois mois n'y a rien à faire.\n- **Pas `Memory/`** : c'est le dépôt de connaissance, synchronisé vers GitHub,\n  et il a déjà payé des incidents de taille (`GH001`, fichiers > 100 Mo). Y\n  déverser des PNG de production est une mauvaise idée structurelle.\n- **`Productions/`** est déjà le foyer de ce qui est fabriqué. Les visuels y\n  sont, et quand ils servent un dépôt précis ils voyagent avec lui, versionnés\n  au même endroit que le code qu'ils annoncent.\n\n## Le format se demande, il ne se présume jamais\n\nRègle posée par Matthieu le 2026-08-15 : le skill disait 4:5, il faut désormais\n**toujours poser la question du format avant de fabriquer quoi que ce soit**, en\nmême temps que celle de la résolution de sortie. Le 4:5 reste le défaut proposé,\nparce qu'il occupe le plus de surface dans le fil Instagram, mais ce n'est qu'un\ndéfaut, jamais une règle.\n\n**L'ordre de décision, tel que Matthieu l'a fixé le 2026-08-15.** D'abord, si le\nprompt précise un format, ce format s'applique, sans question. Ensuite, si aucun\nformat n'est précisé mais qu'une image de référence est fournie, **le format est\ncelui de la source**, mesuré sur elle et non deviné. Enfin, dans tous les autres\ncas, la question se pose avant de fabriquer quoi que ce soit. Pour une suite de\nvisuels, la même chaîne se rejoue à chaque fois : le prompt d'abord, la source\nensuite, la question en dernier recours.\n\n**La résolution de sortie, elle, ne se demande presque jamais.** La règle est un\nagrandissement à facteur entier, deux, trois ou quatre selon le rapport, choisi\ncomme le plus petit entier qui atteint ou dépasse 3840 pixels sur le grand côté.\nUn 4:5 part donc en fois trois, soit 3240 × 4050, un carré en fois quatre, une\nstory ou un paysage en fois deux. Aucune sortie ne descend en dessous de cette\nbarre sans une raison explicite.\n\n| Format | Canevas | Facteur | Sortie livrée |\n|---|---|---|---|\n| 4:5 portrait, défaut Instagram | 1080 × 1350 | ×3 | 3240 × 4050 |\n| 1:1 carré | 1080 × 1080 | ×4 | 4320 × 4320 |\n| 9:16 story et reel | 1080 × 1920 | ×2 | 2160 × 3840 |\n| 16:9 paysage, YouTube | 1920 × 1080 | ×2 | 3840 × 2160 |\n| 1:2 bandeau vertical | 1080 × 2160 | ×2 | 2160 × 4320 |\n| 3:4 | 1080 × 1440 | ×3 | 3240 × 4320 |\n| 2:3 affiche | 1080 × 1620 | ×3 | 3240 × 4860 |\n| 4:3 | 1440 × 1080 | ×3 | 4320 × 3240 |\n\nLe facteur se calcule, il ne se retient pas : `ceil(3840 / grand_côté_du_canevas)`,\nborné à quatre. `render.sh` le fait seul et vérifie la dimension obtenue.\n\n**Le canevas garde une hauteur fixe, quel que soit le format.** C'est une planche\nà dessin, pas une page web, et du contenu qui déborde reste un défaut de mise en\npage. `render.sh` refuse de livrer quand les dimensions ne tombent pas juste,\nparce qu'un mauvais format qui passe en silence finit recadré par Instagram sans\nque personne comprenne pourquoi.\n\n**Le 2x et le 4K se rendent, ils ne s'agrandissent pas.** Le facteur d'échelle\nrefait le rendu à la résolution demandée. Agrandir un PNG déjà rendu produirait\nexactement le flou que tout ce skill cherche à éviter.\n\n**Un seul fichier par slide et par format demandé.** Exporter en plus un 1x à\ncôté du 4K est de la duplication pure, puisque la grande résolution porte\nstrictement plus d'information et se réduit en une seconde.\n\n\n**Le canevas a une hauteur FIXE.** Il ne grandit pas avec son contenu. C'est une\nplanche à dessin, pas une page web. Du contenu qui déborde est un bug de mise en\npage à corriger, jamais une raison d'allonger le cadre. `render.sh` refuse de\nlivrer si les dimensions ne tombent pas juste, parce qu'un export à la mauvaise\ntaille se fait recadrer par Instagram sans prévenir personne.\n\n**Le 2x se rend, il ne s'agrandit pas.** `--force-device-scale-factor=2` refait\nle rendu à double résolution. Agrandir le PNG 1x produirait exactement le flou\nqu'on cherche à éviter.\n\n## Les polices\n\nToutes les polices installées vivent dans `~/Library/Fonts/`. On les charge par\n`@font-face` avec une URL `file://` absolue, ce qui marche en rendu Chromium\nheadless sans installation ni réseau.\n\n```css\n@font-face {\n  font-family: 'DidonesqueStencil';\n  src: url('file:///Users/zenray/Library/Fonts/Didonesque-Stencil-Bold.otf') format('opentype');\n}\n```\n\n**Le catalogue visuel est dans `fontbook.html`, à côté de ce fichier.** L'ouvrir\ndans un navigateur pour voir chaque police rendue, avec son chemin exact prêt à\ncopier. Le régénérer après toute installation de police :\n\n```bash\n~/.claude/skills/zenray-html-photoshop-pdf/scripts/build-fontbook.sh\n```\n\nLe trio de marque établi jusqu'ici, à réutiliser par défaut pour rester cohérent :\n\n| Rôle | Police | Fichier |\n|---|---|---|\n| Titre display | Didonesque Stencil Bold | `Didonesque-Stencil-Bold.otf` |\n| Signature manuscrite | Golden Hopes | `GoldenHopes_PERSONAL_USE_ONLY.otf` |\n| Texte courant | Anthropic Sans (Medium / SemiBold) | `AnthropicSans-*.ttf` |\n\nGolden Hopes est sous licence **usage personnel uniquement**. Le signaler avant\ntout usage commercial ; ne pas l'employer en silence sur un visuel qui vend.\n\n## Fabriquer un asset de texte\n\nUn fichier HTML minuscule, une seule ligne de texte, fond transparent.\n\n```html\n<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<style>\n  @font-face { font-family:'X'; src:url('file:///Users/zenray/Library/Fonts/X.otf') format('opentype'); }\n  html, body { margin:0; padding:0; background: transparent; }\n  .wrap { width:1900px; height:400px; display:flex; align-items:center; justify-content:center; }\n  .txt  { font-family:'X'; font-size:200px; color:#2b2b2b; }\n</style></head>\n<body><div class=\"wrap\"><div class=\"txt\">ZenRay Dictate</div></div></body></html>\n```\n\nRendu, **transparence obligatoire** :\n\n```bash\nchrome --headless=new --disable-gpu --hide-scrollbars \\\n  --default-background-color=00000000 \\\n  --window-size=1900,400 --screenshot=\"2-title-caps.png\" \"file://$PWD/2-title-caps.html\"\n```\n\nSans `--default-background-color=00000000`, le PNG sort avec un fond blanc opaque\nqui écrasera tout ce qu'il recouvre dans la composition. Vérifier après coup que\nle mode est bien `RGBA` :\n\n```bash\npython3 -c \"from PIL import Image; im=Image.open('2-title-caps.png'); print(im.mode, im.size)\"\n```\n\nPrévoir un cadre nettement plus large que le texte attendu : un glyphe coupé au\nbord est irrécupérable, alors que du vide transparent ne coûte rien.\n\n## Découper une image de référence en assets\n\nQuand Matthieu fournit un visuel à reproduire, **mesurer, ne pas estimer à\nl'œil**. Les frontières entre panneaux se trouvent en cherchant les ruptures de\ncouleur ligne par ligne.\n\n```python\nfrom PIL import Image\nim = Image.open(src).convert(\"RGB\"); w,h = im.size; px = im.load()\nprev = None\nfor y in range(h):\n    row = [px[x,y] for x in range(0, w, 10)]\n    avg = tuple(sum(c[i] for c in row)/len(row) for i in range(3))\n    if prev and sum(abs(avg[i]-prev[i]) for i in range(3)) > 25:\n        print(\"rupture à y =\", y)\n    prev = avg\n```\n\nPour retrouver la position d'un texte dans une référence, scanner sa couleur\nd'encre et relever la boîte englobante. Ça a donné, sur le gabarit Switzerland,\ndes panneaux de 588 px séparés par un cadre de 3 px et une position de titre au\npixel près, là où l'estimation visuelle se serait trompée de plusieurs dizaines\nde pixels.\n\n## Mode `Template Creator` : une référence devient une machine\n\nDès que Matthieu demande d’identifier une mise en page, de reproduire une référence avec\nune autre image, ou de fabriquer un template à partir d’une ou plusieurs captures, lire\n`references/template-creator.md` en entier puis suivre son contrat. Ce mode produit une\nspécification JSON exécutable et, pour chaque template, un dossier contenant un PNG guide 4K\net son Markdown jumeau. Un guide ne montre jamais plus d’un template.\n\nSur un raster, le mode décrit uniquement le type (`serif`, `sans`, `mono`, `other`), la largeur\n(`condensed`, `normal`, `expanded`) et l’interlettrage. Il ne nomme jamais une famille de fonte\net ne lance aucun font matching. La fonte de rendu est un choix séparé, documenté comme tel.\n\nDans le mode Template Creator, dès que le document contient une image, les réglages photo complets\ndeviennent automatiques. Les fichiers canoniques sont\n`assets/photo-controls/zr-photo-adjustments.js` et\n`assets/photo-controls/zr-photo-adjustments.css`. Ils s’emploient tels quels, sans recopier\nleurs constantes dans chaque projet.\n\n## Annoter une capture (surlignage, flèches, cadres)\n\nComposer par-dessus l'original avec un calque translucide, jamais en repeignant\nles pixels d'origine.\n\n```python\nfrom PIL import Image, ImageDraw\nsrc = Image.open(path).convert(\"RGBA\")\noverlay = Image.new(\"RGBA\", src.size, (0,0,0,0))\nImageDraw.Draw(overlay).rectangle([x0, 0, x1, src.height], fill=(255,214,0,128))  # 128 = 50%\nImage.alpha_composite(src, overlay).convert(\"RGB\").save(out)\n```\n\nLocaliser la cible par mesure, comme ci-dessus : pour surligner une barre précise\nd'un graphique, scanner la ligne à mi-hauteur pour trouver ses bornes exactes en\nx, puis élargir de quelques pixels pour que la bande se lise comme « cette\ncolonne » et pas comme « ce rectangle ».\n\n## Composer\n\nLe fichier `slide-N.html` est le document. Les assets y entrent en `<img>`, et\ntous les réglages remontent en variables CSS **en haut du fichier**, pour qu'un\najustement soit une ligne à changer et non une chasse dans le corps du style.\n\n```html\n<link rel=\"stylesheet\" href=\"_canvas.css\">\n<style>\n  .lockup img.script { width: 380px; }\n  .lockup img.caps   { width: 936px; }\n</style>\n...\n<div class=\"canvas\">\n  <div class=\"question\">…</div>\n  <div class=\"spacer\"></div>\n  <div class=\"lockup\">\n    <img class=\"script\" src=\"1-title-script.png\">\n    <img class=\"caps\"   src=\"2-title-caps.png\">\n  </div>\n  <div class=\"spacer\"></div>\n  <div class=\"waveform\"><img src=\"3-waveform.png\"></div>\n</div>\n```\n\n`.spacer` répartit l'espace restant dans un cadre à hauteur fixe, au lieu de tout\nempiler en haut.\n\n## Un asset qu'on n'a pas ne s'invente pas, il reste un trou déclaré\n\nRègle de Matthieu, le 2026-08-15 : « si tu n'as pas l'asset tu n'inventes rien tu\nlaisses en transparent, ou blanc. » Ell\n\n[... skill content truncated for compaction; use Read on the skill path if you need the full text]\n</system-reminder>"}],"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"5f649d7d-3f0b-4e40-9aeb-39c6fa2e2eab","version":"2.1.266","gitBranch":"main","slug":"swirling-zooming-hartmanis"}
