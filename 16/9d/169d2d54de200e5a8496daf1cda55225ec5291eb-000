nt ALWAYS wraps content in { markdown }, even with raw=1, even for JSON.\n// A bare r.json() returns the envelope instead of the data, and the list stays empty with no error\n// whatsoever. Same unwrapping as ZenRayJapanese, which paid the lesson first.\n// FR : la liste reste vide sans la moindre erreur, et rien ne signale l'enveloppe.\nconst readJson = (path) =>\n  fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { cache: 'no-store' })\n    .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))\n    .then((payload) => {\n      if (!payload || !payload.markdown || payload.missing) throw new Error(`${path} unreadable`)\n      return JSON.parse(payload.markdown)\n    })\n\nexport default function ZenRayHoudiniVocabulary() {\n  const [index, setIndex] = useState(null)\n  const [nodes, setNodes] = useState(null)\n  const [vexFunctions, setVexFunctions] = useState(null)\n  const [error, setError] = useState(null)\n  const [query, setQuery] = useState('')\n  const [family, setFamily] = useState('all')\n  const [tab, setTab] = useState('nodes')\n  const requested = useRef(false)\n\n  useEffect(() => {\n    if (requested.current) return\n    requested.current = true\n    Promise.all([readJson(VOCABULARY.index), readJson(VOCABULARY.nodes), readJson(VOCABULARY.vex)])\n      .then(([loadedIndex, loadedNodes, loadedVex]) => {\n        setIndex(loadedIndex); setNodes(loadedNodes); setVexFunctions(loadedVex)\n      })\n      .catch((caught) => setError(String(caught.message || caught)))\n  }, [])\n\n  const families = useMemo(() => ['all', ...(index?.families || [])], [index])\n\n  const results = useMemo(() => {\n    const source = tab === 'nodes' ? nodes : vexFunctions\n    if (!source) return []\n    const needle = query.trim().toLowerCase()\n    return source.filter((entry) => {\n      if (family !== 'all' && !(entry.f || []).includes(family)) return false\n      if (needle.length < VOCABULARY.minCharacters) return family !== 'all'\n      return entry.n.toLowerCase().includes(needle) || (entry.s || '').toLowerCase().includes(needle)\n    })\n  }, [tab, nodes, vexFunctions, query, family])\n\n  if (error) {\n    return (\n      <div className=\"zhd-voc-state\">\n        Vocabulaire illisible : {error}.<br />\n        Le regenerer avec <code>hython Memory/Houdini/Scripts/build-houdini-vocab.py</code>.\n      </div>\n    )\n  }\n  if (!index) return <div className=\"zhd-voc-state\">Lecture de l index Houdini…</div>\n\n  const visible = results.slice(0, VOCABULARY.maxResults)\n\n  return (\n    <div className=\"zhd-voc\">\n      <div className=\"zhd-voc-measures\">\n        <span><strong>Houdini {index.houdini_version}</strong> mesure sur cette machine</span>\n        <span>{index.total_nodes} types de noeuds</span>\n        <span>{index.nodes_with_summary} avec resume officiel</span>\n        <span>{index.total_vex} fonctions VEX</span>\n      </div>\n\n      <div className=\"zhd-voc-bar\">\n        <div className=\"zhd-tabs\">\n          <button type=\"button\" className={`zhd-tab-btn ${tab === 'nodes' ? 'active' : ''}`} onClick={() => setTab('nodes')}>\n            <Icon name=\"cube\" size={14} /><span>Noeuds ({index.total_nodes})</span>\n          </button>\n          <button type=\"button\" className={`zhd-tab-btn ${tab === 'vex' ? 'active' : ''}`} onClick={() => setTab('vex')}>\n            <Icon name=\"chevron.left.forwardslash.chevron.right\" size={14} /><span>VEX ({index.total_vex})</span>\n          </button>\n        </div>\n        <div className=\"zhd-search-box\">\n          <Icon name=\"magnifyingglass\" size={14} className=\"zhd-search-icon\" />\n          <input className=\"zhd-search-input\" type=\"text\" value={query} placeholder=\"scatter, copytopoints, fit01, heightfield…\"\n                 onChange={(event) => setQuery(event.target.value)} />\n        </div>\n      </div>\n\n      <div className=\"zhd-domain-pills\">\n        {families.map((entry) => (\n          <button key={entry} type=\"button\" className={`zhd-domain-pill ${family === entry ? 'active' : ''}`} onClick={() => setFamily(entry)}>\n            <span>{entry}</span>\n            {entry !== 'all' && index.by_family?.[entry] ? <em className=\"zhd-voc-counter\">{index.by_family[entry]}</em> : null}\n          </button>\n        ))}\n      </div>\n\n      {query.trim().length < VOCABULARY.minCharacters && family === 'all' ? (\n        <div className=\"zhd-voc-state\">\n          Chercher un terme, ou choisir une famille. Le vocabulaire complet ne s affiche jamais d un bloc :\n          {index.total_nodes} lignes ne se lisent pas.\n        </div>\n      ) : (\n        <>\n          <div className=\"zhd-voc-count\">\n            {results.length} resultat{results.length > 1 ? 's' : ''}\n            {results.length > VOCABULARY.maxResults ? `, ${VOCABULARY.maxResults} affiches, affiner la recherche` : ''}\n          </div>\n          <ul className=\"zhd-voc-list\">\n            {visible.map((entry) => (\n              <li key={`${entry.c || 'vex'}/${entry.n}`} className=\"zhd-voc-row\">\n                <code className=\"zhd-voc-name\">{entry.c ? `${entry.c}/${entry.n}` : entry.n}</code>\n                <span className=\"zhd-voc-summary\">{entry.s || (entry.u ? entry.u[0] : '')}</span>\n                <span className=\"zhd-voc-families\">{(entry.f || []).join(' · ')}</span>\n              </li>\n            ))}\n          </ul>\n        </>\n      )}\n    </div>\n  )\n}\nEOF\necho \"ZenRayHoudiniVocabulary.jsx écrit\"","description":"Rename and rewrite the vocabulary panel in English"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1016,"cache_read_input_tokens":388540,"output_tokens":3859,"output_tokens_details":{"thinking_tokens":811},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":