{"parentUuid":"c689260a-9b1a-4fdd-983f-f5596fc8e7b0","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CeoqPu57U1JmUsXk1aec7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PeuLZv4sF2fg8n9eoyHGTn","name":"Bash","input":{"command":"cat > Houdini/MCP/zrhoudini.py <<'PYEOF'\n#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"ZenRay Houdini : un outil, deux visages, zero dependance.\n\n  python3 zrhoudini.py <commande>      en ligne de commande, pour un humain ou un script\n  python3 zrhoudini.py --mcp           en serveur MCP sur stdio, pour n importe quel agent\n\nPOURQUOI CETTE FORME (2026-09-07). Trois agents pilotent cette machine, Claude Code Desktop, Codex\net Antigravity. Un outil qui ne parle qu a l un d eux est un outil a refaire trois fois. Le\nprotocole MCP est du JSON-RPC delimite par des retours a la ligne : il n a rien de prive, et il\ns ecrit avec la bibliotheque standard. C est exactement le raisonnement du client MCP Unreal ecrit\nle 2026-08-21, et c est ce qui permet a ce fichier de tourner sur le python 3.9.6 livre par macOS,\nsans `pip install`, sans environnement virtuel, sans rien qui puisse pourrir.\n\nL INCIDENT QUI JUSTIFIE CE CHOIX est visible dans cette session meme : le serveur MCP `reaper`\nconfigure sur ce Mac ne demarre plus, parce qu il pointe vers le python d un venv qui a disparu.\nUne dependance est une promesse qu il faudra tenir tous les jours.\n\nQUATRE OUTILS, PAS CENT QUATRE-VINGT-HUIT. Un serveur qui expose 188 outils injecte environ vingt\nmille jetons de schema dans CHAQUE invite : l agent paie ce catalogue avant d avoir rien fait. A\nl oppose, un serveur qui n expose qu un `exec` Python laisse l agent aveugle, inventer des noms de\nparametres et bruler des allers-retours. Le point d equilibre tient en quatre verbes : voir,\ninstancier, chercher, et une porte de sortie.\n\nCE QU IL FAUT POUR CHAQUE OUTIL :\n\n  chercher     rien. Les JSON du vocabulaire suffisent, Houdini peut etre ferme.\n  recettes     rien pour lister ; hython pour instancier.\n  instancier   hython, en headless. Houdini n a pas besoin d etre ouvert.\n  scene        Houdini OUVERT, avec le pont zrbridge.py lance dedans.\n  hom          le pont pour la scene vivante, hython sinon.\n\"\"\"\nimport json, os, socket, subprocess, sys\nfrom pathlib import Path\n\n# ── INTERFACE DE PARAMETRES (loi HDA : rien en dur plus bas) ─────────────────────────────────────\nRACINE = Path(__file__).resolve().parent.parent            # Memory/Houdini\nP = {\n    'hython': os.environ.get('ZR_HYTHON',\n              '/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/bin/hython'),\n    'pont_hote': os.environ.get('ZR_PONT_HOTE', '127.0.0.1'),\n    'pont_port': int(os.environ.get('ZR_PONT_PORT', '18812')),\n    'pont_delai': 20.0,\n    'noeuds': RACINE / 'Site' / 'houdini-noeuds.json',\n    'vex': RACINE / 'Site' / 'houdini-vex.json',\n    'index': RACINE / 'Site' / 'houdini-vocabulaire.json',\n    'recette': RACINE / 'Scripts' / 'recette.py',\n    'vocab': RACINE / 'Scripts' / 'build-houdini-vocab.py',\n    'bridge': RACINE / 'MCP' / 'zrbridge.py',\n    'limite_defaut': 25,\n    'limite_max': 200,\n    'delai_hython': 600,\n    'protocole_mcp': '2025-06-18',\n    'nom_serveur': 'zenray-houdini',\n    'version_serveur': '1.0.0',\n}\n\n\n# ══ LE FOND, partage par la ligne de commande et par le serveur ═════════════════════════════════\n\ndef _lire(chemin):\n    if not Path(chemin).exists():\n        raise RuntimeError(f'{chemin} absent. Le regenerer : hython Scripts/build-houdini-vocab.py')\n    return json.loads(Path(chemin).read_text(encoding='utf-8'))\n\n\ndef _hython(args):\n    \"\"\"Lance hython et rend sa sortie JSON. hython bavarde des avertissements de plugins sur la\n    sortie standard : on ne garde que la derniere ligne qui est un JSON valide, jamais la premiere.\"\"\"\n    if not Path(P['hython']).exists():\n        return {'ok': False, 'erreur': f\"hython introuvable : {P['hython']}. Houdini est-il installe ?\"}\n    r = subprocess.run([P['hython']] + args, capture_output=True, text=True, timeout=P['delai_hython'])\n    for ligne in reversed((r.stdout or '').splitlines()):\n        ligne = ligne.strip()\n        if ligne.startswith('{') or ligne.startswith('['):\n            try:\n                return json.loads(ligne)\n            except ValueError:\n                continue\n    return {'ok': False, 'erreur': 'hython n a rend aucun JSON',\n            'sortie': (r.stdout or '')[-1200:], 'erreurs': (r.stderr or '')[-1200:]}\n\n\ndef _pont(requete):\n    \"\"\"Parle a la session Houdini ouverte. Un refus de connexion n est PAS une absence de Houdini :\n    c est presque toujours le pont qui n a pas ete lance dans la session.\"\"\"\n    try:\n        with socket.create_connection((P['pont_hote'], P['pont_port']), timeout=P['pont_delai']) as s:\n            s.sendall((json.dumps(requete, ensure_ascii=False) + '\\n').encode('utf-8'))\n            brut = b''\n            while not brut.endswith(b'\\n'):\n                m = s.recv(1 << 20)\n                if not m:\n                    break\n                brut += m\n        return json.loads(brut.decode('utf-8'))\n    except (ConnectionRefusedError, OSError) as e:\n        return {'ok': False, 'erreur': f'pont injoignable sur {P[\"pont_hote\"]}:{P[\"pont_port\"]} ({e}). '\n                f'Dans la fenetre Python de Houdini : exec(open(\"{P[\"bridge\"]}\").read())'}\n\n\ndef outil_chercher(q='', famille='', genre='noeuds', limite=P['limite_defaut']):\n    \"\"\"Cherche dans le vocabulaire moissonne. Houdini n a pas besoin d etre ouvert.\"\"\"\n    limite = max(1, min(int(limite), P['limite_max']))\n    source = _lire(P['noeuds'] if genre == 'noeuds' else P['vex'])\n    t = (q or '').strip().lower()\n    trouves = []\n    for x in source:\n        if famille and famille not in (x.get('f') or []):\n            continue\n        if t and t not in x['n'].lower() and t not in (x.get('s') or '').lower():\n            continue\n        trouves.append(x)\n    return {'ok': True, 'genre': genre, 'total': len(trouves), 'rendus': min(len(trouves), limite),\n            'resultats': [\n                {'nom': (f\"{x['c']}/{x['n']}\" if x.get('c') else x['n']),\n                 'resume': x.get('s') or '',\n                 'familles': x.get('f') or [],\n                 **({'signatures': x['u'][:2]} if x.get('u') else {}),\n                 **({'deprecie': True} if x.get('d') else {})}\n                for x in trouves[:limite]]}\n\n\ndef outil_recettes():\n    \"\"\"Liste les graphes deja verifies, avec leurs parametres reglables.\"\"\"\n    r = _hython([str(P['recette']), '--lister', '--json'])\n    return {'ok': True, 'recettes': r} if isinstance(r, list) else r\n\n\ndef outil_instancier(recette, params=None, hip=''):\n    \"\"\"Construit un graphe, le cuit, et rend le verdict de ses controles.\"\"\"\n    args = [str(P['recette']), '--construire', recette, '--json']\n    for clef, valeur in (params or {}).items():\n        args += ['--p', f'{clef}={valeur}']\n    if hip:\n        args += ['--hip', hip]\n    r = _hython(args)\n    if hip and r.get('ok'):\n        r['hip'] = hip\n    return r\n\n\ndef outil_scene(chemin='/obj', profondeur=2):\n    \"\"\"Rend la scene OUVERTE en JSON compact : chemins, types, erreurs, comptes de geometrie.\"\"\"\n    return _pont({'op': 'scene', 'chemin': chemin, 'profondeur': int(profondeur)})\n\n\ndef outil_hom(code, cible='live'):\n    \"\"\"Porte de sortie. Poser la valeur a rendre dans une variable nommee `resultat`.\"\"\"\n    if cible == 'live':\n        return _pont({'op': 'hom', 'code': code})\n    enveloppe = (\n        'import hou, json\\n'\n        'espace = {\"hou\": hou, \"resultat\": None}\\n'\n        f'exec(compile({code!r}, \"<zrhoudini>\", \"exec\"), espace)\\n'\n        'r = espace.get(\"resultat\")\\n'\n        'try: json.dumps(r)\\n'\n        'except TypeError: r = repr(r)\\n'\n        'print(json.dumps({\"ok\": True, \"resultat\": r}, ensure_ascii=False))\\n'\n    )\n    return _hython(['-c', enveloppe])\n\n\n# ══ LE CATALOGUE MCP, volontairement court ══════════════════════════════════════════════════════\n\nOUTILS = [\n    {'name': 'houdini_chercher',\n     'description': \"Cherche un noeud ou une fonction VEX dans le vocabulaire complet de Houdini 22 \"\n                    \"(5564 noeuds, 1132 fonctions). Houdini n a pas besoin d etre ouvert.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'q': {'type': 'string', 'description': 'terme cherche dans le nom ou le resume'},\n         'famille': {'type': 'string', 'description': 'scattering, instancing, uv, materials, textures, '\n                     'simulation, destruction, terrain, curves, crowd, rendering, export, vex, attributes, modeling'},\n         'genre': {'type': 'string', 'enum': ['noeuds', 'vex'], 'description': 'defaut noeuds'},\n         'limite': {'type': 'integer'}}},\n     'fn': lambda a: outil_chercher(a.get('q', ''), a.get('famille', ''), a.get('genre', 'noeuds'),\n                                    a.get('limite', P['limite_defaut']))},\n    {'name': 'houdini_recettes',\n     'description': \"Liste les graphes Houdini deja construits ET verifies, avec leurs parametres.\",\n     'inputSchema': {'type': 'object', 'properties': {}},\n     'fn': lambda a: outil_recettes()},\n    {'name': 'houdini_instancier',\n     'description': \"Construit une recette en headless, la cuit, verifie que la geometrie n est pas \"\n                    \"vide et rend chaque controle. Ecrit un .hip si un chemin est donne.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'recette': {'type': 'string'},\n         'params': {'type': 'object', 'description': 'surcharges, par exemple {\"nombre_points\": 1200}'},\n         'hip': {'type': 'string', 'description': 'chemin du .hip a ecrire, facultatif'}},\n         'required': ['recette']},\n     'fn': lambda a: outil_instancier(a['recette'], a.get('params'), a.get('hip', ''))},\n    {'name': 'houdini_scene',\n     'description': \"Rend la scene Houdini OUVERTE en JSON compact : chemins, types, erreurs, \"\n                    \"comptes de points et de primitives. Exige le pont zrbridge.py lance dans Houdini.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'chemin': {'type': 'string', 'description': 'defaut /obj'},\n         'profondeur': {'type': 'integer', 'description': 'defaut 2'}}},\n     'fn': lambda a: outil_scene(a.get('chemin', '/obj'), a.get('profondeur', 2))},\n    {'name': 'houdini_hom',\n     'description': \"Porte de sortie : execute du code HOM. cible=live parle a la session ouverte, \"\n                    \"cible=headless lance hython. Poser la valeur a rendre dans `resultat`.\",\n     'inputSchema': {'type': 'object', 'properties': {\n         'code': {'type': 'string'},\n         'cible': {'type': 'string', 'enum': ['live', 'headless']}},\n         'required': ['code']},\n     'fn': lambda a: outil_hom(a['code'], a.get('cible', 'live'))},\n]\n\n\ndef _servir_mcp():\n    \"\"\"JSON-RPC delimite par des retours a la ligne, sur stdin et stdout. Rien d autre.\"\"\"\n    def repondre(msg):\n        sys.stdout.write(json.dumps(msg, ensure_ascii=False) + '\\n')\n        sys.stdout.flush()\n\n    for ligne in sys.stdin:\n        ligne = ligne.strip()\n        if not ligne:\n            continue\n        try:\n            req = json.loads(ligne)\n        except ValueError:\n            continue\n        methode, ident, params = req.get('method'), req.get('id'), req.get('params') or {}\n        # Une notification n a pas d identifiant : y repondre casse certains clients.\n        if ident is None:\n            continue\n        if methode == 'initialize':\n            repondre({'jsonrpc': '2.0', 'id': ident, 'result': {\n                'protocolVersion': P['protocole_mcp'],\n                'capabilities': {'tools': {}},\n                'serverInfo': {'name': P['nom_serveur'], 'version': P['version_serveur']}}})\n        elif methode == 'tools/list':\n            repondre({'jsonrpc': '2.0', 'id': ident, 'result': {\n                'tools': [{k: o[k] for k in ('name', 'description', 'inputSchema')} for o in OUTILS]}})\n        elif methode == 'tools/call':\n            nom = params.get('name')\n            outil = next((o for o in OUTILS if o['name'] == nom), None)\n            if outil is None:\n                repondre({'jsonrpc': '2.0', 'id': ident,\n                          'error': {'code': -32602, 'message': f'outil inconnu : {nom}'}})\n                continue\n            try:\n                res = outil['fn'](params.get('arguments') or {})\n                erreur = not res.get('ok', True)\n            except Exception as e:\n                res, erreur = {'ok': False, 'erreur': f'{type(e).__name__}: {e}'}, True\n            repondre({'jsonrpc': '2.0', 'id': ident, 'result': {\n                'content': [{'type': 'text', 'text': json.dumps(res, ensure_ascii=False, indent=1)}],\n                'isError': erreur}})\n        elif methode in ('ping', 'shutdown'):\n            repondre({'jsonrpc': '2.0', 'id': ident, 'result': {}})\n        else:\n            repondre({'jsonrpc': '2.0', 'id': ident,\n                      'error': {'code': -32601, 'message': f'methode non geree : {methode}'}})\n\n\ndef _cli(argv):\n    if not argv or argv[0] in ('-h', '--help', 'aide'):\n        print(__doc__)\n        print('Commandes : etat | chercher <terme> [famille] [noeuds|vex] | recettes | '\n              'instancier <recette> [clef=valeur ...] | scene [chemin] [profondeur] | '\n              'hom <code> [live|headless]')\n        return 0\n    cmd, reste = argv[0], argv[1:]\n    if cmd == 'etat':\n        pont = _pont({'op': 'ping'})\n        idx = _lire(P['index']) if Path(P['index']).exists() else {}\n        res = {'ok': True,\n               'hython': {'chemin': P['hython'], 'present'