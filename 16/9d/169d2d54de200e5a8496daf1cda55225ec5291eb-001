"+    # 2. Master Title: pre-rendered title layer pasted onto base_frame","+    base_frame.paste(title_layer, (0, 0), title_layer)","+    ","+    # 3. Master Subtitles in CANON LINE-BY-LINE (ONLY for t < 15.0s, removed in last 3s as requested)","+    if frame_idx < 900: # 15.0s * 60fps = 900 frames","+        cue_idx = frame_idx // 180","+        cue_idx = min(cue_idx, len(rendered_cues) - 1)","+        f_rel = frame_idx % 180","+        cdata = rendered_cues[cue_idx]","+        ","+        # Line 1 pops at f_rel = 0","+        if f_rel < len(cdata['l1_frames']):","+            part1 = cdata['l1_frames'][f_rel]","+        else:","+            part1 = cdata['l1_steady']","+        if part1 is not None:","+            im1, px1, py1 = part1","+            base_frame.paste(im1, (px1, py1), im1)","+            ","+        # Line 2 pops in CANON after canon_delay (40 frames = 0.67s)","+        if f_rel >= canon_delay:","+            k = f_rel - canon_delay","+            if k < len(cdata['l2_frames']):","+                part2 = cdata['l2_frames'][k]","+            else:","+                part2 = cdata['l2_steady']","+            if part2 is not None:","+                im2, px2, py2 = part2","+                base_frame.paste(im2, (px2, py2), im2)","+","+    p_out.stdin.write(base_frame.tobytes())","+","+p_out.stdin.close()","+p_out.wait()","+","+p1.stdout.close()","+p2.stdout.close()","+","+# Convert to MP4 with faststart","+print('Encoding MP4...')","+subprocess.run([","+    'ffmpeg', '-y', '-i', out_mov,","+    '-c:v', 'copy', '-c:a', 'copy',","+    '-movflags', '+faststart', out_mp4","+], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)","+","+# Generate thumbnails from frame at t=13.5s (f_rel = 90 frames in cue 4: both lines steady!)","+print('Generating final thumbnails...')","+thumb_dir = '/Users/zenray/Downloads/tmp-3D-houdini/thumbnails'","+os.makedirs(thumb_dir, exist_ok=True)","+t_4k_jpg = os.path.join(thumb_dir, 'thumbnail-materials-layers-9x16-4k.jpg')","+t_4k_png = os.path.join(thumb_dir, 'thumbnail-materials-layers-9x16-4k.png')","+t_no_capsule = '/Users/zenray/Downloads/tmp-3D-houdini/test_thumbnail_no_capsule.jpg'","+","+subprocess.run(['ffmpeg', '-y', '-ss', '00:00:13.5', '-i', out_mov, '-vframes', '1', '-q:v', '2', t_4k_jpg], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)","+subprocess.run(['ffmpeg', '-y', '-ss', '00:00:13.5', '-i', out_mov, '-vframes', '1', t_4k_png], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)","+subprocess.run(['cp', t_4k_jpg, t_no_capsule], check=True)","+","+print('All outputs successfully generated with canon line-by-line subtitles and fixed title!')"]}],"created":true},{"filePath":"/Users/zenray/.claude/Memory1/Skills/zenray-houdini/SKILL.md","hunks":[{"oldStart":23,"oldLines":6,"newStart":23,"newLines":7,"lines":[" |---|---|---|"," | `component`, `composant`, `armature`, `roof`, `toit`, `window`, `fenetre`, `porch`, `vestibule`, `stairs`, `escalier`, `hda`, `geometry`, `geo`, `snapshot`, `v001`, `v002`, `v00N` | `Components1.md` | Fiches detaillees des 7 composants, codes VEX, parametres HDA, logique procédurale et historique des snapshots |"," | `copernicus`, `texture`, `texturing`, `material`, `materiau`, `pbr`, `peeling`, `bois peint`, `bois expose`, `bardeaux`, `bois fenetres`, `normal map`, `roughness`, `substance`, `image de reference`, `reproduire`, `readout`, `height map` | `Copernicus1.md` | Graphes proceduraux Copernicus, recettes de texturing PBR, liaison Solaris MaterialX et export textures |","+| `short`, `shorts`, `reel`, `reels`, `sous-titre`, `subtitle`, `titre`, `compositeur`, `canon`, `LUFS`, `9:16`, `vertical`, `tiktok`, `instagram` | `Shorts1.md` | Corpus complet des shorts verticaux 4K : compositeur Python, animation canon, typographie Sectra, audio LUFS, livrables, historique des retours |"," | `layout`, `double panneau`, `split`, `panneau`, `texture a gauche`, `geo a droite`, `lookdev` | `SKILL.md` (section Workspace Layout) | Configuration a 2 panneaux (Composite View gauche / Scene View Karma XPU droite) |"," | `uv`, `variation`, `offset`, `per-plank`, `modulo`, `sprintf`, `unroll`, `trim` | `SKILL.md` & `Components1.md` (UV Knowledge Tricks) | Methode ZenRay UV Texture Variation Offset V2 et Per-Plank UV |"," "]}]},{"filePath":"/Users/zenray/.claude/Memory1/Skills/zenray-houdini/Shorts1.md","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":348,"lines":["+# Shorts1","+","+Corpus route des shorts et reels verticaux ZenRay. Il absorbe le 2026-09-14 les deux skills","+`zenray-realisation-shorts-reels` et `zenray-shorts-reel-realisation`, supprimes le meme jour","+parce qu ils dupliquaient et contredisaient le corpus. Le contenu ci-dessous est repris sans","+reecriture ; les titres sont seulement descendus d un niveau pour tenir dans ce fichier.","+","+Le script compositeur vit desormais dans","+`Library/Houdini/Scripts/render_short_4k_compositor.py` (4K natif, 18,00 s, 60 ips).","+","+---","+","+## Realisation Complete de Shorts et Reels Verticaux : Copernicus 18s","+","+Ce document constitue la reference technique absolue et la synthese de production du Short vertical 9:16 consacre a la texturation procedurale de bois sous Copernicus dans Houdini.","+","+### 1. Contexte et Objectif de Production","+","+Le projet vise a produire un format court vertical ultra dynamique (18,00 secondes a 60 fps) pour exposer le travail de recherche technique de Matthieu Huguet sur Houdini 20.5 et le nouveau module Copernicus (remplacant procedural de Substance Designer integre directement dans le graphe 3D).","+","+L eglise en bois de cypre du bayou louisianais sert de support heroique. L objectif est de demontrer l empilement rigoureux des calques de texture :","+1. Les joints et fentes de planches (Planks & Seams).","+2. Les fibres fines directionnelles (Fine Fibers).","+3. Les nœuds de bois organiques avec fissures radiales (Organic Wood Knots).","+4. Les cernes paraboliques de dosse (Cathedral Waves).","+5. Le composite final melange pret pour Karma XPU (Composite Lookdev Substrate).","+","+### 2. Chronologie des Feedbacks et Arbitrages","+","+Durant les 10 iterations de la session, 13 ajustements majeurs ont ete operes pour atteindre la perfection editoriale :","+","+1. **Suppression de la capsule de titre :** Remplacement du cartouche sombre par un lettrage pur blanc avec contour fin 4px.","+2. **Proscription absolue d image importee :** Refuscategorique de coller une image de reference dans Copernicus. Le procedural s exprime exclusivement par des bruits natifs et des coordonnees mathematiques.","+3. **Rectification des nœuds de bois :** Passage d une forme carree artificielle a une silhouette circulaire naturelle avec micro-fissures radiales par Voronoi.","+4. **Elargissement des cernes cathedrales :** Baisse de la frequence spatiale pour une visibilite immediate sur petit ecran mobile.","+5. **Enregistrement de captures OBS reelles :** Remplacement des rushs perimes par une capture live de 12s du reseau Copernicus en action.","+6. **Timeline verrouillee a 18,00 secondes :** 3s d accroche 3D, 12s de navigation dans le graphe, 3s de defile de spheres.","+7. **Normalisation sonore EBU R128 :** Calibrage exact a -14 LUFS avec fondus in (0,2s) et out (0,8s).","+8. **Nettoyage des 3 dernieres secondes :** Retrait integral des sous-titres jaunes devant les spheres 3D pour laisser respirer les reflets du materiau.","+9. **Ordre du defile des spheres :** 15s Fiber Knot, 16s Cathedral Waves, 17s Composite Blend.","+10. **Typographie 2 lignes et Auto-Fit :** Condensation des sous-titres en 2 lignes et detection automatique de la taille maximale (entre 40pt et 62pt) pour tenir dans la largeur sans rogner.","+11. **Animation en canon ligne par ligne :** Declenchement de la ligne 1 a t=0 avec pop d echelle (0.50 vers 1.18 puis 1.00), suivi de la ligne 2 a 40 frames (0,67s) pour creer un rythme percutant.","+12. **Reparation du bug de titre masquant Procedural :** Isolation du titre sur calque RGBA separe pour bannir toute collision de variables w1/w2.","+13. **Generation multi-livrables :** Sauvegarde des deux variantes musicales (Kokuhaku et The Witcher) sous formats MOV et MP4, totalisant 4 fichiers finaux valides.","+","+### 3. Architecture du Compositeur Python / FFmpeg","+","+Le moteur de rendu `/tmp/compose_final_perfect_18s.py` s appuie sur une architecture de streaming bidirectionnel sans ecriture de fichiers temporaires sur disque :","+- Deux processus FFmpeg lisent les rushs videos sources (la turntable 3D et le walkthrough OBS) et injectent les pixels bruts `rgb24` via stdout.","+- Le script Python lit les paquets de pixels, assemble les calques avec Pillow (titre fixe isole, sous-titres animes en canon, spheres recadrees).","+- Le frame composite est injecte directement dans le stdin d un encodeur FFmpeg `libx264` fonctionnant en preset slow et CRF 17.","+- L ancien benchmark Full HD de 7,6 secondes est obsolete. Le compositeur officiel produit maintenant les 1080 images directement en 2160x3840 a 60 fps ; son temps se mesure apres le prochain rendu complet.","+","+### 4. Organisation des Composants du Skill","+","+Le dossier `components/` rassemble les briques operationnelles reutilisables :","+- `components/01-feedback-history.md` : Retours detailles et lecons techniques.","+- `components/02-python-compositor-script.py` : Script Python complet et autonome.","+- `components/03-canon-subtitles-animation.md` : Formule mathematique du pop et logique canon.","+- `components/04-audio-processing-normalization.md` : Protocoles de mastering sonore mobile.","+- `components/05-typography-and-title-rules.md` : Chartes typographiques et protection de calques.","+- `components/06-deliverables-and-specs.md` : Tableau de controle et commandes ffprobe.","+","+### 5. Matrice Finale des Fichiers Produits","+","+Tous les livrables sont archives et disponibles dans `/Users/zenray/Downloads/tmp-3D-houdini/` :","+- `short-materials-layers-kokuhaku.mov` (2.6 MB, audio Kokuhaku normalise -14 LUFS)","+- `short-materials-layers-kokuhaku.mp4` (2.6 MB, audio Kokuhaku)","+- `short-materials-layers-thewitcher.mov` (2.8 MB, audio The Witcher cut 09:24 normalise -14 LUFS)","+- `short-materials-layers-thewitcher.mp4` (2.8 MB, audio The Witcher)","+- `short-materials-layers.mov` (2.6 MB, version canonique par defaut)","+- `short-materials-layers.mp4` (2.6 MB, version canonique par defaut)","+- `thumbnails/` : vignettes certifiees 2160x3840 extraites directement du master 4K natif.","+","+---","+","+## Historique Chronologique des Feedbacks Utilisateur et Corrections","+","+Ce document consigne l ensemble des retours de Matthieu Huguet lors de la session de production du Short Copernicus 18s, la reponse technique apportee et la regle d or apprise.","+","+### Retour 1 : Suppression de la capsule de titre","+- **Observation Matthieu :** « enleve la capsule du titre et save »","+- **Diagnostic :** La vignette et le short utilisaient un cartouche noir arrondi (capsule) sous le titre. Matthieu voulait epurer le look pour un rendu luxe editorial direct.","+- **Correction appliquee :** Suppression du rectangle arrondi noir semi-transparent sous le texte. Le titre se detache directement en blanc avec un subtil contour noir (stroke width 4px).","+- **Regle retenue :** Ne jamais imposer de capsule par defaut lorsque la direction artistique privilegie l epuration typographique sur fond d image.","+","+### Retour 2 : Non au copier-coller d image dans Copernicus","+- **Observation Matthieu :** « TU M AS JUSTE COLLE L IMG REF TU TE FOUS DE MA GUEULE NE FAIS PLUS JAMAIS L ERREUR UNE IMAGE REF NE DOIT JAMAIS ETRE COPIE DIRECTEMENT DANS LE GRAPH CE N EST PAS COMME CA QUE MARCHE LE PROCEDURAL ET COPERNICUS OU MEME SUBSTANCE DESIGNER. PAS COLLE, REFERENCE POUR S EN INSPIRER »","+- **Diagnostic :** Un noeud `file` contenant directement l image de reference avait ete importe dans le graphe au lieu de concevoir les calques en pur procedural (noises, patterns, warps).","+- **Correction appliquee :** Destruction immediate du noeud image dans le graphe Copernicus. Reconstruction complete du materiau a l aide de generateurs proceduraux mathematiques natifs.","+- **Regle d or absolue :** Une image de reference sert uniquement d inspiration visuelle externe. Dans un outil procedural (Copernicus, Substance Designer, Houdini SOPs), tout se construit par fonctions mathematiques et bruits proceduraux.","+","+### Retour 3 : Forme des noeuds de bois (Wood Knot L3)","+- **Observation Matthieu :** « les knot L3 ne sont pas assez ronds et pourquoi le shorts c est devenu n imp alors qu on a defini le style final »","+- **Diagnostic :** Le bruit procedurale applique sur le noeud generait des formes trop etirees ou rectangulaires au lieu de nœuds de bois organiques concentriques.","+- **Correction appliquee :** Recalibrage des coordonnees polaires, ajout d un masque d ellipticite circulaire doux et insertion de micro-fissures radiales par Voronoi warp.","+- **Regle retenue :** Un nœud de bois organique commence toujours par une geometrie centrale quasi-circulaire perturbee par les fibres qui l enveloppent.","+","+### Retour 4 : Agrandissement des vagues cathedrales (Cathedral Waves)","+- **Observation Matthieu :** « ET LES WAVES cathedral wave sont quasi parfaite il faut juste les agrandir un peu »","+- **Diagnostic :** La frequence spatiale des cernes de dosse (tangential grain) etait legerement trop serree pour une lisibilite ideale a l echelle smartphone.","+- **Correction appliquee :** Diminution de l echelle de frequence du generateur de bandes pour espacer et elargir les motifs de cernes paraboliques.","+","+### Retour 5 : Remplacement des captures par des enregistrements OBS reels","+- **Observation Matthieu :** « Non c est pas les bonnes images il faut rerecord des images reels car la les layers ne sont plus a jour »","+- **Diagnostic :** Les captures video utilisees dans le montage montraient l ancienne version du graphe avant la refonte procedurale des calques.","+- **Correction appliquee :** Nouvel enregistrement OBS en direct sur la session active d Houdini (walkthrough fluide de 12 secondes montrant la structure des calques ordonnee de gauche a droite).","+","+### Retour 6 : Structure stricte de 18 secondes","+- **Observation Matthieu :** « le shorts devait faire 18 sec. avec a la fin 3 sec de sphere material »","+- **Diagnostic :** Le premier jet faisait 15 secondes. Il manquait l espace dedie pour faire defiler les spheres de materiaux.","+- **Correction appliquee :** Extension de la timeline a 18,00 secondes exactes (1080 frames a 60 fps). Repartition : 0 a 3s lookdev eglise, 3 a 15s walkthrough graphe, 15 a 18s defile des spheres.","+","+### Retour 7 : Normalisation audio YouTube","+- **Observation Matthieu :** « le son est bon mais il manque et fade in / out + normalisation audio youtube. -14 ou + 14 je sais pas »","+- **Diagnostic :** L audio etait extrait brut sans adaptation a la norme de diffusion des plateformes mobiles.","+- **Correction appliquee :** Normalisation standard EBU R128 a -14 LUFS integree via ffmpeg loudnorm, avec fondu entrant de 0,2s et fondu sortant de 0,8s a 17,2s.","+","+### Retour 8 : Suppression des sous-titres sur les spheres","+- **Observation Matthieu :** « Corrections les 3 dernieres secondes enleve simplement le sous titres jaune ca passe devant et on en a pas besoin »","+- **Diagnostic :** Les sous-titres jaunes apparaissaient encore au centre bas entre 15s et 18s et masquaient le reflet et le relief du materiau 3D.","+- **Correction appliquee :** Condition stricte `if frame_idx < 900` (avant 15,0s) sur le calque de sous-titrage. Les 3 dernieres secondes sont totalement epurees.","+","+### Retour 9 : Ordre du defile des spheres 3D","+- **Observation Matthieu :** « Dans les 3 dernieres seconde Inverse aussi l ordre c est d abord et fiber knot puis waves puis enfin blend »","+- **Diagnostic :** L ordre initial etait Grain -> Blend -> Knot.","+- **Correction appliquee :** Reagencement precis : 15 a 16s Fiber Knot, 16 a 17s Cathedral Waves, 17 a 18s Composite Blend.","+","+### Retour 10 : Passage de 3 lignes a 2 lignes et Auto-Fit","+- **Observation Matthieu :** « je vois que t as fait trois lignes j aurais prefere 2 lignes ou tu condenses le texte a la taille max en px sans crop »","+- **Diagnostic :** Trois lignes de texte saturaient verticalement le bas de l image.","+- **Correction appliquee :** Reecriture des 5 cues en 2 lignes nettes. Creation d un algorithme d auto-fit descendant (de 62pt a 40pt) pour trouver la taille maximale en pixels qui tient dans 960px de largeur sans deborder.","+","+### Retour 11 : Animation en canon ligne par ligne","+- **Observation Matthieu :** « NON C EST ANIME LIGNE PAR LIGNE EN CANON »","+- **Diagnostic :** Les deux lignes de sous-titres apparaissaient simultanement avec le meme pop.","+- **Correction appliquee :** Decouplage temporel. Ligne 1 apparait a frame 0 du cue avec un pop dynamique (echelle 0.50 vers 1.18 puis 1.00 en 18 frames). Ligne 2 declenche son propre pop avec un retard de 40 frames (0,67 seconde plus tard). Effet rythmique percutant.","+","+### Retour 12 : Bug d affichage du titre fixe (Procedural manquant)","+- **Observation Matthieu :** « LE TITRE EST CASSE »","+- **Diagnostic :** Dans la boucle de mesure des mots des sous-titres, les variables `w1` et `w2` etaient ecrasees par le script, ce qui faussait le positionnement du calque titre et masquait le mot central « Procedural ».","+- **Correction appliquee :** Isolation totale du titre : precalcule sur un canevas RGBA statique (`title_layer`) une seule fois au demarrage du script et colle a chaque frame sur le flux video sans aucune interference de variables.","+","+### Retour 13 : Choix musical et multi-livrables (Kokuhaku et The Witcher)","+- **Observation Matthieu :** « en fait remet la musique : kokuhaku-18s.m4a et on a fini fais le en premier rapidement mais garde l ancienne version avec le son different mais met l extension kokuhaku ou the witcher. 4 outputs car .mov et .mp4 »","+- **Correction appliquee :** Production de 4 fichiers finaux rigoureusement identiques en image mais dotes de leurs bandes-son respectives, avec nommage explicite et verification ffprobe.","+","+---","+","+## Algorithme d Animation en Canon Ligne par Ligne","+","+Ce composant documente la technique d animation des sous-titres utilisee pour maximiser l impact et la retention sur les plateformes courtes (Shorts, Reels, TikTok).","+","+### 1. Principe de l animation en canon","+","+Contrairement a un affichage statique ou a un pop simultane de tout le texte, l animation en canon decoupe le message en deux etapes visuelles distinctes :","+1. **Ligne 1 (Accroche immediate) :** Declenchee a l instant exact du debut du cue (frame relative f_rel = 0).","+2. **Ligne 2 (Resolution / Rythme) :** Declenchee avec un retard fixe appele canon delay (40 frames a 60 fps, soit exactement 0,67 seconde).","+","+Ce decalage force l oeil de l internaute a lire la premiere ligne avant d accueillir le punch de la seconde ligne, maintenant l attention en eveil permanent.","+","+### 2. Courbe d impact punchy (Punch Scale Curve)","+","+L animation utilise une courbe de rebond dynamique en 18 images (0,30 seconde a 60 fps) calibree pour eviter tout effet de flottement elastique mou.","+","+```python","+## Definition de la courbe : liste de tuples (echelle, opacite_alpha)","+punch_curve = [","+    (0.50, 0.00), # Frame 0 : invisible, miniature","+    (0.65, 0.40), # Frame 1 : apparition rapide","+    (0.85, 0.75), # Frame 2 : montee en puissance","+    (1.02, 1.00), # Frame 3 : opacite complete, depassement","+    (1.14, 1.00), # Frame 4 : overshoot","+    (1.18, 1.00), # Frame 5 : pic d impact (punch max)","+    (1.16, 1.00), # Frame 6 : debut du rappel","+    (1.11, 1.00), # Frame 7","+    (1.06, 1.00), # Frame 8","+    (1.02, 1.00), # Frame 9","+    (0.99, 1.00), # Frame 10 : leger sous-depassement","+    (0.98, 1.00), # Frame 11","+    (0.99, 1.00), # Frame 12","+    (1.00, 1.00), # Frame 13 a 17 : stabilisation parfaite","+    (1.00, 1.00),","+    (1.00, 1.00),","+    (1.00, 1.00),","+    (1.00, 1.00),","+]","+```","+","+### 3. Precalcul en memoire vive","+","+Pour garantir un rendu video superieur a 140 fps sans saturer le processeur, toutes les images de redimensionnement de chaque ligne sont precalculees en amont dans la structure `rendered_cues` :","+- Les cartes de texte haute definition sont rasterisees une seule fois.","+- Les 18 variations d echelle et d alpha sont stockees en liste de surfaces PIL RGBA.","+- Lors de la boucle principale de composition video, un simple collage `base_frame.paste(im, pos, im)` s execute a la volee sans calcul trigonometrique ni convolution redondante.","+","+---","+","+## Normalisation et Traitement Audio pour Shorts et Reels","+","+Ce composant decrit la methode normalisee pour adapter n importe quelle source audio YouTube au standard de diffusion mobile (-14 LUFS).","+","+### 1. Pourquoi normaliser a -14 LUFS","+","+YouTube Shorts, Instagram Reels et TikTok appliquent des algorithmes stricts de Loudness Normalization. Un fichier mixe trop fort (au-dessus de -14 LUFS integre) est ecrase par le compresseur de la plateforme, ce qui detruit la dynamique et introduit de la saturation. Un fichier trop bas passe inapercu et parait amorphe sur telephone.","+","+La cible ideale est :","+- **Volume integre (I) :** -14.0 LUFS","+- **True Peak (TP) :** -1.0 dBFS (pour eviter tout ecretage lors de la recompression codec)","+- **Loudness Range (LRA) :** 7 a 11 LU","+","+### 2. Commandes FFmpeg de decoupe et normalisation","+","+#### Etape 1 : Extraction du segment musical (ex: 18,00 secondes a partir du point de depart choisi)","+```bash","+ffmpeg -y -ss 00:09:24.00 -i source_full.mp3 -t 18.00 -c copy segment_raw.mp3","+```","+","+#### Etape 2 : Mesure de loudness","+```bash","+ffmpeg -i segment_raw.mp3 -af loudnorm=I=-14:TP=-1.0:LRA=11:print_format=json -f null -","+```","+","+#### Etape 3 : Application de la normalisation avec fondus d entree et de sortie","+Pour eviter un depart brutal et clore proprement la fin du short :","+- Fondu d ouverture doux (fade in) : 0,20 a 0,50 seconde au debut.","+- Fondu de fermeture (fade out) : 0,80 seconde avant la fin (commence a 17,20s pour finir a 18,00s).","+","+```bash","+ffmpeg -y -i segment_raw.mp3 -af \"loudnorm=I=-14:TP=-1.0:LRA=11,afade=t=in:ss=0:d=0.2,afade=t=out:st=17.2:d=0.8\" -c:a aac -b:a 320k -ar 48000 master_audio_18s.m4a","+```","+","+### 3. Multiplexage video et audio","+","+Lors de la generation finale, l audio est encode en AAC 48 kHz stereo 320 kbps avec l option `-shortest` pour que la fin de la bande son verrouille parfaitement la duree de la video.","+","+---","+","+## Typographie, Titrage et Prevention du Masquage de Calques","+","+Ce composant resume la charte typographique de ZenRay et la regle d isolation memoire contre les collisions de variables.","+","+### 1. La formule officielle Sectra","+","+Le titre entier utilise **GT Sectra Bold Italic**. Le fichier officiel est `GT-Sectra-LCGV-Bold-Italic.otf`, installe dans `~/Library/Fonts`.","+","+Exemple officiel : `Houdini Procedural Texturing`, entierement en GT Sectra Bold Italic.","+","+La taille n est jamais choisie a l estime. Le compositeur travaille directement sur un canevas 2160x3840, descend depuis 400 px et mesure la boîte reelle avec `textbbox`, contour compris. Il retient la premiere taille qui tient dans la marge horizontale de 64 px et la bande verticale de y=440 a y=820. Sur le titre officiel, le maximum mesure est 151 px avec une boîte x=69,5 a x=2090,5. La taille 152 px mesure 2036 px de large et depasse de 4 px la zone sure de 2032 px.","+","+L auto-fit reste enferme dans `title_layer`. Il ne modifie jamais `cues_2lines`, qui garde exactement deux lignes par cue, ni le rendu randomise des sous-titres. La frame de controle se prend a t=1,5s pour afficher les deux lignes apres leur animation canon.","+","+Le titre tri-polices precedent reste disponible sous le profil **`mixed-deprecated`** pour reproduire un ancien rendu : `Houdini` en Sectra, `Procedural` en Inter Tight Italic 700 et `Texturing` en Anthropic Mono Bold incline. Il n est jamais la valeur par defaut.","+","+### 2. Prevention de collision de variables (Le piege w1 / w2)","+","+#### Le probleme rencontre en session","+Dans une premiere version du script compositeur, le titre etait dessine frame par frame en mesurant les largeurs avec `t_w1` et `t_w2`. Plus bas dans la boucle de sous-titrage, une variable temporaire nommee `w1` etait utilisee pour mesurer la largeur de la premiere ligne de sous-titre.","+A cause d une reassignation involontaire, la coordonnee X du mot central `Procedural` devenait egale a la coordonnee du mot `Houdini`, superposant les lettres et effacant le mot central du short.","+","+#### La solution architecturale absolue","+**Toujours isoler le calque de titrage statique sur un canevas dedie.**","+```python","+## Creation d un calque titre statique RGBA","+title_layer = Image.new('RGBA', (W, H), (0, 0, 0, 0))","+d_title = ImageDraw.Draw(title_layer)","+","+## Rendu officiel complet du titre une seule fois au boot","+for title_font_size in range(400, 9, -1):","+    title_stroke_width = max(1, round(title_font_size * 8 / 132))","+    title_font = ImageFont.truetype(p_sectra_bold_italic, title_font_size)","+    title_bbox = d_title.textbbox((0, title_baseline_y), title_text, font=title_font, stroke_width=title_stroke_width, anchor='ls')","+    if title_bbox[2] - title_bbox[0] <= W - 128 and title_bbox[1] >= 440 and title_bbox[3] <= 820:","+        title_tx = (W - (title_bbox[2] - title_bbox[0])) / 2 - title_bbox[0]","+        break","+d_title.text((title_tx, title_baseline_y), title_text, font=title_font, fill=(255, 255, 255), stroke_width=title_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')","+","+## Dans la boucle d images video : aucun calcul, collage pur","+base_frame.paste(title_layer, (0, 0), title_layer)","+```","+","+### 3. Auto-Fit typographique des sous-titres","+","+Pour eviter tout debordement d ecran sur petit smartphone, une boucle descendante teste la largeur totale de chaque ligne de sous-titre avant le rendu :","+```python","+MAX_W = 1880","+best_size = 80","+for test_size in range(124, 76, -1):","+    f_inter = ImageFont.truetype(p_inter, test_size)","+    # verification du cumul des largeurs de mots","+    if all_lines_fit:","+        best_size = test_size","+        break","+```","+Le texte est ainsi presente a la plus grande taille possible sans jamais risquer de coupe.","+","+---","+","+## Specifications et Controle Qualite des 4 Masters Livrables","+","+Ce document specifie les 4 sorties video generees pour clore le projet Short Copernicus 18s.","+","+### 1. Matrice des Livrables","+","+| Fichier | Bande Son | Format | Resolution | FPS | Codec Video | Codec Audio | Poids |","+|---|---|---|---|---|---|---|---|","+| `short-materials-layers-kokuhaku.mov` | Kokuhaku 18s | QuickTime Master | 2160x3840 | 60 | H.264 High CRF 17 | AAC 48k 320k | Mesure apres rendu |","+| `short-materials-layers-kokuhaku.mp4` | Kokuhaku 18s | Web Faststart | 2160x3840 | 60 | H.264 High | AAC 48k 248k | Mesure apres rendu |","+| `short-materials-layers-thewitcher.mov` | The Witcher 18s | QuickTime Master | 2160x3840 | 60 | H.264 High CRF 17 | AAC 48k 320k | Mesure apres rendu |","+| `short-materials-layers-thewitcher.mp4` | The Witcher 18s | Web Faststart | 2160x3840 | 60 | H.264 High | AAC 48k 315k | Mesure apres rendu |","+","+Les fichiers de base `short-materials-layers.mov` et `short-materials-layers.mp4` sont egalement maintenus synchronises sur la version retenue Kokuhaku.","+","+### 2. Vignettes de couverture (Thumbnails)","+","+Generees a l instant exact t = 13,50 secondes (ou les deux lignes de sous-titres sont parfaitement stables et visibles) :","+- `thumbnail-materials-layers-9x16-4k.jpg` et `.png` : extraits directement du master natif 2160x3840, sans agrandissement.","+- `test_thumbnail_no_capsule.jpg` : reference epuree sans cartouche sombre.","+","+### 3. Script de verification automatique ffprobe","+","+Pour certifier les livrables avant mise en ligne :","+```bash","+for f in short-materials-layers-kokuhaku.mov short-materials-layers-kokuhaku.mp4 short-materials-layers-thewitcher.mov short-materials-layers-thewitcher.mp4; do","+  echo \"Validation de $f...\"","+  ffprobe -v error -show_entries stream=codec_name,width,height,r_frame_rate,duration -of default=noprint_wrappers=1 \"$f\"","+done","+```","+Critères de conformite stricts :","+- Duree video : 18.000000 secondes.","+- Duree audio : 17.984000 a 18.000000 secondes.","+- Taux de rafraichissement : 60/1.","+- Dimensions : 2160x3840 natives.","+","+---","+","+## Archivage des posts, repris du skill supprime zenray-shorts-reel-realisation","+","+Chaque court metrage s accompagne immediatement :","+- d un fichier post trilingue (EN / 日本語 / FR) sous `Memory/Posts/YYYY-MM-DD-<sujet>/` ;","+- d une phrase de politesse chaleureuse avec signature emoji Damien Richard :","+  `thanks for reading, like for more! ᕙ(`▿´)ᕗ` ;","+- d une consignation de synthese dans `Memory/SocialMedia/SocialMedia1.md`.","+","+Le reste de ce skill supprime est ecarte volontairement : il prescrivait 1080x1920, un titre","+AnthropicSans SemiBold Italic, les jaunes `#FFDC33` et `#EDC853` et un pop de 0,92 vers 1,05, tous","+contredits par la regle 4K, par le titre Sectra, par le jaune `#FFE144` et par la courbe 0,50 vers","+1,18 en vigueur depuis le 2026-09-14."]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/zenray/.claude/Memory1/Skills/zenray-houdini/Library/Houdini/Scripts/render_short_4k_compositor.py","/Users/zenray/.claude/Memory1/Skills/zenray-houdini/SKILL.md","/Users/zenray/.claude/Memory1/Skills/zenray-houdini/Shorts1.md"]}},"sourceToolAssistantUUID":"cf3be8ec-824d-4